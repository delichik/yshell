# RPM spec template for the prebuilt gTerm binary.
#
# Rendered by `cargo xtask dist --formats rpm` (see xtask/src/installers.rs):
# @VERSION@/@RELEASE@ come from the release label and @ARCH@ is the RPM
# architecture (x86_64, aarch64, ...). The Host entry binary (gterm), role
# binaries, desktop entry, hicolor icons, LICENSE and README are placed in
# <topdir>/SOURCES by the build tool.
%global debug_package %{nil}

Name:           gterm
Version:        @VERSION@
Release:        @RELEASE@
Summary:        Multi-protocol terminal and SFTP client
License:        GPL-3.0-only
URL:            https://github.com/delichik/yshell
BuildArch:      @ARCH@

# The GUI libraries are loaded at runtime (dlopen), so rpm cannot detect them.
# N4: rfd's GTK3 backend links against GTK directly (not dlopen), so declare it.
Requires:       gtk3
Requires:       libX11
Requires:       libX11-xcb
Requires:       libXcursor
Requires:       libXrandr
Requires:       libXi
Requires:       libXinerama
Requires:       libXrender
Requires:       libXfixes
Requires:       libxkbcommon
Requires:       libxkbcommon-x11
Requires:       fontconfig

%description
gTerm is a native, cross-platform multi-protocol terminal and SFTP client with a
session manager, terminal tabs, SFTP browser, tunnels and quick commands.

%install
# gterm is the Host entry; role binaries are spawned as children and must live
# beside it in /usr/bin (sibling lookup).
install -D -m 0755 %{_sourcedir}/gterm %{buildroot}/usr/bin/gterm
install -D -m 0755 %{_sourcedir}/gterm-ui %{buildroot}/usr/bin/gterm-ui
install -D -m 0755 %{_sourcedir}/gterm-session-worker %{buildroot}/usr/bin/gterm-session-worker
install -D -m 0755 %{_sourcedir}/gterm-mcp-daemon %{buildroot}/usr/bin/gterm-mcp-daemon
install -D -m 0644 %{_sourcedir}/gterm.desktop %{buildroot}/usr/share/applications/gterm.desktop
for sz in 16x16 32x32 48x48 128x128 256x256 512x512; do
  install -D -m 0644 %{_sourcedir}/icons/$sz/gterm.png %{buildroot}/usr/share/icons/hicolor/$sz/apps/gterm.png
done
install -D -m 0644 %{_sourcedir}/gterm.svg %{buildroot}/usr/share/icons/hicolor/scalable/apps/gterm.svg
install -D -m 0644 %{_sourcedir}/LICENSE %{buildroot}/usr/share/licenses/gterm/LICENSE
install -D -m 0644 %{_sourcedir}/README.md %{buildroot}/usr/share/doc/gterm/README.md
mkdir -p %{buildroot}/usr/share/gterm/fonts
cp -a %{_sourcedir}/fonts/. %{buildroot}/usr/share/gterm/fonts/ || true
mkdir -p %{buildroot}/usr/share/gterm/themes
cp -a %{_sourcedir}/themes/. %{buildroot}/usr/share/gterm/themes/ || true

%files
/usr/bin/gterm
/usr/bin/gterm-ui
/usr/bin/gterm-session-worker
/usr/bin/gterm-mcp-daemon
/usr/share/applications/gterm.desktop
/usr/share/icons/hicolor/*/apps/gterm.png
/usr/share/icons/hicolor/scalable/apps/gterm.svg
/usr/share/gterm/fonts
/usr/share/gterm/themes
%license /usr/share/licenses/gterm/LICENSE
%doc /usr/share/doc/gterm/README.md

%changelog
* Thu Jan 01 2026 gTerm maintainers - @VERSION@-@RELEASE@
- Automated release build.
