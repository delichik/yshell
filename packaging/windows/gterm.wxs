<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 source for the gTerm MSI, rendered by `cargo xtask dist` with the
  msi format selected (see xtask/src/installers.rs). @VERSION@ is a three part
  numeric version, @BINARY@/@SHELL_BIN@/@SESSION_WORKER_BIN@/@MCP_DAEMON_BIN@/
  @README@/@LICENSE@/@LICENSE_RTF@/@FONTS_DIR@/@THEMES_DIR@/@ICON@ are absolute paths.
  `@BINARY@` is the headless Host entry (gterm.exe); the role executables (GUI
  UI, SessionWorker, MCP daemon) are installed in INSTALLFOLDER beside it
  because the Host spawns them as children in the same directory. Fonts must sit
  beside the exe as INSTALLFOLDER\fonts\ — see resolve_fonts_dir() in
  crates/yshell-terminal. Themes must sit beside the exe as
  INSTALLFOLDER\themes\ — see resolve_shipped_themes_dir() in
  crates/yshell-config.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="gTerm"
           Language="1033"
           Version="@VERSION@"
           Manufacturer="gTerm"
           UpgradeCode="{483C68E0-EEEA-47BE-A2A9-8E99A73012BF}">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="gTerm multi-protocol terminal and SFTP client"
             Comments="https://github.com/delichik/yshell" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of gTerm is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="@LICENSE_RTF@" />
    <Icon Id="GTermIcon.ico" SourceFile="@ICON@" />
    <Property Id="ARPPRODUCTICON" Value="GTermIcon.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="gTerm">
          <Component Id="GTermExecutable" Guid="{B454BD78-5C13-41FB-A1B4-5ACB11EEC51D}">
            <File Id="GTermExe" Source="@BINARY@" KeyPath="yes" />
          </Component>
          <!-- Role executables spawned by the Host entry: GUI UI,
               SessionWorker and MCP daemon. Installed beside gterm.exe in the
               same directory (sibling lookup); no separate shortcuts. -->
          <Component Id="GTermUiExecutable" Guid="{6D2A8E41-9F3C-4B62-AD71-5C0E93D27B82}">
            <File Id="GTermUiExe" Source="@SHELL_BIN@" KeyPath="yes" />
          </Component>
          <Component Id="GTermSessionWorkerExecutable" Guid="{9E5C7B12-4A6D-4F83-B2E0-71C4D5A69823}">
            <File Id="GTermSessionWorkerExe" Source="@SESSION_WORKER_BIN@" KeyPath="yes" />
          </Component>
          <Component Id="GTermMcpDaemonExecutable" Guid="{C1D84F63-2B7A-4E95-8A3F-6E05B29D7C34}">
            <File Id="GTermMcpDaemonExe" Source="@MCP_DAEMON_BIN@" KeyPath="yes" />
          </Component>
          <Component Id="GTermDocs" Guid="{81F67662-0FCB-4E83-BBFA-58D5237D52E3}">
            <File Id="GTermReadme" Source="@README@" />
            <File Id="GTermLicense" Source="@LICENSE@" />
          </Component>
          <Directory Id="FontsFolder" Name="fonts">
            <Component Id="GTermFonts" Guid="{A7E2C91F-4B5D-4E8A-9C1D-6F3A2B8E0D47}">
              <File Id="FontDejaVuRegular" Source="@FONTS_DIR@\DejaVuSansMono.ttf" KeyPath="yes" />
              <File Id="FontDejaVuBold" Source="@FONTS_DIR@\DejaVuSansMono-Bold.ttf" />
              <File Id="FontDejaVuOblique" Source="@FONTS_DIR@\DejaVuSansMono-Oblique.ttf" />
              <File Id="FontDejaVuBoldOblique" Source="@FONTS_DIR@\DejaVuSansMono-BoldOblique.ttf" />
              <File Id="FontNotoCjk" Source="@FONTS_DIR@\NotoSansMonoCJKsc-GB2312-Subset.otf" />
              <File Id="FontLicenseDejaVu" Source="@FONTS_DIR@\LICENSE-DejaVu.txt" />
              <File Id="FontLicenseNoto" Source="@FONTS_DIR@\LICENSE-NotoSansMonoCJK-OFL-1.1.txt" />
            </Component>
          </Directory>
          <Directory Id="ThemesFolder" Name="themes">
            <Component Id="GTermThemes" Guid="{C8F1A4B2-6D7E-4F90-A1B2-3C4D5E6F7081}">
              <File Id="Theme_afterglow" Source="@THEMES_DIR@\afterglow.toml" KeyPath="yes" />
              <File Id="Theme_ansi_colors_on_black" Source="@THEMES_DIR@\ansi-colors-on-black.toml" />
              <File Id="Theme_ansi_colors_on_white" Source="@THEMES_DIR@\ansi-colors-on-white.toml" />
              <File Id="Theme_arthur" Source="@THEMES_DIR@\arthur.toml" />
              <File Id="Theme_belafonte_day" Source="@THEMES_DIR@\belafonte-day.toml" />
              <File Id="Theme_black_on_white" Source="@THEMES_DIR@\black-on-white.toml" />
              <File Id="Theme_chalk" Source="@THEMES_DIR@\chalk.toml" />
              <File Id="Theme_chalkboard" Source="@THEMES_DIR@\chalkboard.toml" />
              <File Id="Theme_codeschool" Source="@THEMES_DIR@\codeschool.toml" />
              <File Id="Theme_dracula" Source="@THEMES_DIR@\dracula.toml" />
              <File Id="Theme_earthsong" Source="@THEMES_DIR@\earthsong.toml" />
              <File Id="Theme_espresso" Source="@THEMES_DIR@\espresso.toml" />
              <File Id="Theme_gruvbox_dark" Source="@THEMES_DIR@\gruvbox-dark.toml" />
              <File Id="Theme_idletoes" Source="@THEMES_DIR@\idletoes.toml" />
              <File Id="Theme_ir_black" Source="@THEMES_DIR@\ir-black.toml" />
              <File Id="Theme_new_black" Source="@THEMES_DIR@\new-black.toml" />
              <File Id="Theme_new_white" Source="@THEMES_DIR@\new-white.toml" />
              <File Id="Theme_nord" Source="@THEMES_DIR@\nord.toml" />
              <File Id="Theme_obsidian" Source="@THEMES_DIR@\obsidian.toml" />
              <File Id="Theme_one_dark" Source="@THEMES_DIR@\one-dark.toml" />
              <File Id="Theme_pastel_on_black" Source="@THEMES_DIR@\pastel-on-black.toml" />
              <File Id="Theme_pastel_on_white" Source="@THEMES_DIR@\pastel-on-white.toml" />
              <File Id="Theme_solarized_dark" Source="@THEMES_DIR@\solarized-dark.toml" />
              <File Id="Theme_solarized_light" Source="@THEMES_DIR@\solarized-light.toml" />
              <File Id="Theme_tokyo_night" Source="@THEMES_DIR@\tokyo-night.toml" />
              <File Id="Theme_white_on_black" Source="@THEMES_DIR@\white-on-black.toml" />
              <File Id="Theme_xterm" Source="@THEMES_DIR@\xterm.toml" />
              <File Id="Theme_yshell_default" Source="@THEMES_DIR@\yshell-default.toml" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="gTerm" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="GTermShortcut" Guid="{C37B2301-F921-4F1B-9DF1-0D651972933A}">
        <Shortcut Id="StartMenuShortcut"
                  Name="gTerm"
                  Description="gTerm multi-protocol terminal and SFTP client"
                  Target="[INSTALLFOLDER]gterm.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="GTermIcon.ico" />
        <RemoveFolder Id="CleanUpShortcut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\gTerm"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="GTermFeature" Title="gTerm" Level="1">
      <ComponentRef Id="GTermExecutable" />
      <ComponentRef Id="GTermUiExecutable" />
      <ComponentRef Id="GTermSessionWorkerExecutable" />
      <ComponentRef Id="GTermMcpDaemonExecutable" />
      <ComponentRef Id="GTermDocs" />
      <ComponentRef Id="GTermFonts" />
      <ComponentRef Id="GTermThemes" />
      <ComponentRef Id="GTermShortcut" />
    </Feature>
  </Product>
</Wix>
