msgid "Quick Connect error: {0}"
msgstr "快速连接错误：{0}"

#: ui/text_formats.slint:426
msgctxt "MainWindow"
msgid "Saved active runtime session as profile `{0}`. Config now contains {1} saved session(s)."
msgstr "已将活动运行时会话保存为配置 `{0}`。配置中现有 {1} 个已保存会话。"

#: ui/text_formats.slint:429
msgctxt "MainWindow"
msgid "Deleted saved session `{0}` and persisted the updated config."
msgstr "已删除已保存会话 `{0}`，并持久化更新后的配置。"

#: ui/text_formats.slint:434
msgctxt "MainWindow"
msgid "Connected to {0}."
msgstr "已连接到 {0}。"

#: ui/text_formats.slint:437
msgctxt "MainWindow"
msgid "Connecting to {0} ..."
msgstr "正在连接 {0}…"

#: ui/text_formats.slint:440
msgctxt "MainWindow"
msgid "Waiting for confirmation to continue the connection to {0}."
msgstr "等待确认以继续连接到 {0}。"

#: ui/text_formats.slint:443
msgctxt "MainWindow"
msgid "Could not connect to {0}."
msgstr "无法连接到 {0}。"

#: ui/text_formats.slint:446
msgctxt "MainWindow"
msgid "Password required for {0}."
msgstr "需要 {0} 的密码。"

#: ui/text_formats.slint:449
msgctxt "MainWindow"
msgid "Could not connect to {0} with the supplied password."
msgstr "使用所提供的密码无法连接到 {0}。"

#: ui/text_formats.slint:452
msgctxt "MainWindow"
msgid "Reconnected to {0}."
msgstr "已重新连接到 {0}。"

#: ui/text_formats.slint:455
msgctxt "MainWindow"
msgid "Reopened the session for {0}, but the shell is not live."
msgstr "已重新打开 {0} 的会话，但 shell 未在线。"

#: ui/text_formats.slint:458
msgctxt "MainWindow"
msgid "Could not reconnect the session."
msgstr "无法重新连接该会话。"

#: ui/text_formats.slint:461
msgctxt "MainWindow"
msgid "Host key confirmation is required before reconnecting."
msgstr "重连前需要确认主机密钥。"

#: ui/text_formats.slint:465
msgctxt "MainWindow"
msgid "Host key confirmed for {0}. Enter the password to continue."
msgstr "已确认 {0} 的主机密钥。请输入密码以继续。"

#: ui/text_formats.slint:468
msgctxt "MainWindow"
msgid "Host key confirmation is required for {0} before the password prompt."
msgstr "在输入密码前，需要先确认 {0} 的主机密钥。"

#: ui/text_formats.slint:471
msgctxt "MainWindow"
msgid "{0} recorded target(s); keep up to {1}."
msgstr "已记录 {0} 个目标；最多保留 {1} 个。"

#: ui/text_formats.slint:474
msgctxt "MainWindow"
msgid "Authentication requires input before reconnecting."
msgstr "重连前需要输入认证信息。"

#: ui/text_formats.slint:477
msgctxt "MainWindow"
msgid "Resized runtime terminal to {0}."
msgstr "终端尺寸已调整为 {0}。"

#: ui/text_formats.slint:480
msgctxt "MainWindow"
msgid "Loaded local directory `{0}` ({1} items)."
msgstr "已加载本地目录 `{0}`（{1} 项）。"

#: ui/text_formats.slint:484
msgctxt "MainWindow"
msgid "Sending key input to {n} tab."
msgid_plural "Sending key input to {n} tabs."
msgstr[0] "正在向 {n} 个标签发送按键输入。"

#: ui/text_formats.slint:488
msgctxt "MainWindow"
msgid "Stopped sending key input."
msgstr "已停止发送按键输入。"

#: ui/text_formats.slint:491
msgctxt "MainWindow"
msgid "No other connected terminal tab can receive key input."
msgstr "没有其它已连接的终端标签可以接收按键输入。"

#: ui/text_formats.slint:495
msgctxt "MainWindow"
msgid "`{0}` now receives key input."
msgstr "`{0}` 现在接收按键输入。"

#: ui/text_formats.slint:497
msgctxt "MainWindow"
msgid "`{0}` no longer receives key input."
msgstr "`{0}` 不再接收按键输入。"

#: ui/text_formats.slint:505
msgctxt "MainWindow"
msgid "Close Session"
msgstr "关闭会话"

#: ui/text_formats.slint:506
msgctxt "MainWindow"
msgid "Close Tabs"
msgstr "关闭标签"

#: ui/text_formats.slint:511
msgctxt "MainWindow"
msgid "Close `{0}`? Its active connection will be disconnected."
msgstr "关闭 `{0}`？其活动连接将被断开。"

