msgid "Close {n} tab"
msgid_plural "Close {n} tabs"
msgstr[0] "关闭 {n} 个标签"

#: ui/text_formats.slint:515
msgctxt "MainWindow"
msgid "{n} of them has an active connection and will be disconnected."
