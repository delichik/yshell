// Shared tab row model for the global tab bar and per-pane split strips.
export struct WorkspaceTab {
    id: string,
    title: string,
    /// 状态文字（`connected`/`disconnected` 已改为角标，这里只剩 `connecting`）。
    state_text: string,
    /// 图标右下角的连接状态角标（`connected` / `disconnected` / `failed` /
    /// 空 = 不显示角标）。
    connection_badge: string,
    /// `new` / `terminal` / `sftp` — drives the tab icon.
    mode_text: string,
    connected: bool,
    active: bool,
    /// N6：该会话正在写日志（标签角标 REC）。
    logging: bool,
    /// N9：同步发送按键角色（空 / `source` / `target`；标签角标 SRC/RCV）。
    sync_role_text: string,
    /// WP4：未读输出计数（0 = 不显示角标）。
    unread: int,
}
