import { Theme } from "../theme.slint";
import { Icon } from "basic/icons.slint";
// Self-drawn menu popup used for the app menu bar and the context menus.
//
// The popup fills the window: a transparent scrim captures clicks outside the
// panel and the panel is positioned at the requested window coordinates.
// Drawing order matters: instantiate popups after the main content and before
// the modal dialogs so they stay above the content and below the dialogs.
// 形态：WinUI 3 Flyout / MenuFlyout（§5.11）——8px 圆角、32px 行高、16px 勾选列、
// 右侧 caption 快捷键、禁用项 36% 不透明、单层阴影。

export struct MenuEntry {
    label: string,
    shortcut: string,
    enabled: bool,
    checked: bool,
    separator: bool,
    /// 禁用项的原因说明：hover 该行时由内置 Tooltip 显示（空串 = 不显示）。
    /// 带默认值，既有条目无需逐条填写（S1 会话树空白区菜单的 disabled + tooltip 契约）。
    tooltip: string = "",
}

component MenuPopupRow inherits Rectangle {
    in property <MenuEntry> entry: {
        label: "",
        shortcut: "",
        enabled: false,
        checked: false,
        separator: false,
    };
    callback selected();

    height: root.entry.separator ? 9px : Theme.row-height-list;
    // 禁用项：整行 36% 不透明（颜色不再额外套 text-disabled，避免双重变暗）
    opacity: (root.entry.enabled || root.entry.separator) ? 1.0 : 0.36;
    border-radius: Theme.radius-control;
    background: (row-touch.has-hover && root.entry.enabled && !root.entry.separator) ? Theme.subtle-hover : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    // 分隔线（上下各留 4px）
    // 浮层底上 layer-stroke 对比不足（截图里几乎看不见），改用 divider token
    Rectangle {
        visible: root.entry.separator;
        x: Theme.spacing-8;
        y: (parent.height - 1px) / 2;
        width: parent.width - 2 * Theme.spacing-8;
        height: 1px;
        background: Theme.divider;
    }

    // 勾选列：16px，勾选色 accent；左内边距 8
    Icon {
        visible: !root.entry.separator && root.entry.checked;
        name: "check";
        icon-color: Theme.accent;
        icon-size: Theme.icon-size-small;
        x: Theme.spacing-8;
        y: (parent.height - self.height) / 2;
    }

    Text {
        visible: !root.entry.separator;
        text: root.entry.label;
        // 缩进 = 内边距 8 + 勾选列 16 + 间距 8 = 32（§5.11）
        x: Theme.spacing-8 + Theme.icon-size-small + Theme.spacing-8;
        // A11：标签宽度再扣掉右侧快捷键的实际宽度 + 间距，长文案不会再压到快捷键上。
        width: parent.width - self.x - Theme.spacing-8
            - (root.entry.shortcut != "" ? shortcut_text.width + Theme.spacing-8 : 0px);
        height: parent.height;
        color: Theme.text-primary;
        font-size: Theme.font-body;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    shortcut_text := Text {
        visible: !root.entry.separator && root.entry.shortcut != "";
        text: root.entry.shortcut;
        x: parent.width - self.width - Theme.spacing-8;
        height: parent.height;
        color: Theme.text-tertiary;
        font-size: Theme.font-caption;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    row-touch := TouchArea {
        enabled: root.entry.enabled && !root.entry.separator;
        clicked => { root.selected(); }
    }

    // 禁用项：hover 时用内置 Tooltip 说明原因（S1 空白区菜单的 Import/Expand/Collapse）。
    // 只对带 tooltip 的条目生成 TooltipArea/PopupWindow（空串不生成）。
    // `Tooltip.text` 是 styled-text：@markdown 里用 `\{...}` 插值（未转义的花括号是字面量）。
    if root.entry.tooltip != "" : Tooltip {
        text: @markdown("\{root.entry.tooltip}");
    }
}

export component MenuPopup inherits Rectangle {
    in property <bool> open: false;
    in property <[MenuEntry]> entries: [];
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    in property <length> panel-width: 230px;
    /// A1：遮罩顶部内缩。菜单栏的下拉菜单把它设为菜单栏高度，让菜单栏区域的
    /// 点击落回菜单栏本身——否则展开菜单后点另一个一级菜单会被遮罩吃掉，
    /// 表现为"切菜单只留下标题高亮、弹层不渲染"。右键菜单保持 0（全窗遮罩）。
    in property <length> scrim-top: 0px;

    callback selected(int);
    callback dismissed();

    visible: self.open;
    background: transparent;

    // A2：弹层根 FocusScope —— 打开时聚焦，`Esc` = dismissed()（与 L2 弹窗同一套
    // 语义，但只消费 Esc，其余按键继续冒泡）。关闭后的焦点回交由宿主负责
    // （main_window 的 restore-focus-after-menu）。
    popup_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            // Esc 键码按 `event.text` 比较（与各弹窗/session_tree 的写法一致）。
            if (event.text == "\u{001b}") {
                root.dismissed();
                return accept;
            }
            return reject;
        }

        // Scrim: captures any click outside of the panel and dismisses the popup.
        TouchArea {
            // A1：菜单栏下拉菜单的遮罩从菜单栏下方开始，菜单栏自身仍可点击/悬停切换。
            y: root.scrim-top;
            height: parent.height - root.scrim-top;
            clicked => { root.dismissed(); }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.dismissed();
                }
            }
        }

        panel := Rectangle {
            // A15：贴边留 8px（窗口右/下缘不再只剩 4–5px，圆角与描边不被裁）。
            x: min(max(root.anchor-x, 8px), max(root.width - root.panel-width - 8px, 8px));
            y: min(max(root.anchor-y, 8px), max(root.height - self.height - 8px, 8px));
            width: root.panel-width;
            height: entries-layout.preferred-height;
            background: Theme.flyout-background;
            border-width: 1px;
            border-color: Theme.layer-stroke;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-color: Theme.shadow-color;
            drop-shadow-offset-y: Theme.shadow-offset-y;

            // Swallow clicks on the panel background so they do not reach the scrim.
            TouchArea { }

            entries-layout := VerticalLayout {
                padding: 4px;
                spacing: 0px;

                for entry[i] in root.entries : MenuPopupRow {
                    entry: entry;
                    selected => { root.selected(i); }
                }
            }
        }
    }

    /// A2：宿主把键盘焦点交给弹层（例如从终端按键兜底路径调用，见 WS-D 报告）。
    public function focus-popup() {
        popup_scope.focus();
    }

    // A2：打开时弹层持有焦点，Esc 才能被上面的 key-pressed 捕获。
    changed open => {
        if (root.open) {
            popup_scope.focus();
        }
    }
}
