import { Theme } from "../theme.slint";
import { WinButton, WinToggle } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

// Legacy overlay ConfirmDialog (unused by live path; live confirms use CompactConfirmWindow).
// Kept for visual parity with the tool-window confirm body if anything still hosts it.

export component ConfirmDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title-text: @tr("Confirm");
    in property <string> message-text: "";
    in property <string> confirmation-token: "";
    in property <string> confirmation-placeholder: "";
    in-out property <string> confirmation-text: "";
    in property <string> confirm-label: @tr("Confirm");
    in property <string> cancel-label: @tr("Cancel");
    in property <bool> destructive: false;
    in property <bool> show-dont-ask-again: false;
    in-out property <bool> dont-ask-again: false;

    callback confirmed();
    callback canceled();

    private property <length> dialog-width: Theme.dialog-width;
    private property <length> content-width:
        root.dialog-width - 2 * 1px - 2 * Theme.tool-window-padding;

    states [
        opened when root.open: {
            opacity: 1.0;
            in { animate opacity { duration: Theme.duration-normal; easing: ease-out; } }
            out { animate opacity { duration: Theme.duration-faster; easing: ease-in; } }
        }
        closed when !root.open: { opacity: 0.0; }
    ]
    visible: root.open || self.opacity > 0.01;
    background: Theme.scrim;

    dialog_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.canceled();
                return accept;
            }
            return reject;
        }

        TouchArea {
            clicked => { root.canceled(); }
        }

        Rectangle {
            x: (parent.width - root.dialog-width) / 2;
            y: max((parent.height - self.height) / 2, 40px);
            width: root.dialog-width;
            height: min(body.preferred-height, parent.height - 2 * Theme.spacing-24);
            background: Theme.panel-background;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.control-stroke;

            TouchArea { }

            body := VerticalLayout {
                padding: Theme.tool-window-padding;
                spacing: Theme.spacing-12;

                Text {
                    text: root.title-text;
                    color: Theme.text-primary;
                    font-size: Theme.font-subtitle;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                }

                Text {
                    text: root.message-text;
                    color: root.confirmation-token != "" ? Theme.critical : Theme.text-secondary;
                    wrap: word-wrap;
                    width: root.content-width;
                }

                confirm_input := WinTextInput {
                    height: root.confirmation-token != "" ? Theme.control-height : 0px;
                    visible: root.confirmation-token != "";
                    enabled: root.confirmation-token != "";
                    text <=> root.confirmation-text;
                    placeholder-text: root.confirmation-placeholder;
                }

                if root.show-dont-ask-again : WinToggle {
                    text: @tr("Don't ask again");
                    checked <=> root.dont-ask-again;
                    horizontal-stretch: 0;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-8;

                    WinButton {
                        text: root.cancel-label;
                        clicked => { root.canceled(); }
                    }

                    WinButton {
                        text: root.confirm-label;
                        accent: !root.destructive && root.confirmation-token == "";
                        critical: root.destructive || root.confirmation-token != "";
                        enabled: root.confirmation-token == "" || root.confirmation-text == root.confirmation-token;
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
    }

    public function focus-dialog() {
        if (root.confirmation-token != "") {
            confirm_input.focus-input();
        } else {
            dialog_scope.focus();
        }
    }

    changed open => {
        if (root.open) {
            if (root.confirmation-token != "") {
                confirm_input.focus-input();
            } else {
                dialog_scope.focus();
            }
        }
    }
}
