// 自绘顶栏（阶段 B）：WinUI 3 MenuBar + 窗口标题栏控件。
//
// 无系统装饰（MainWindow.no-frame）时本行同时承担：
//   * 最左应用图标
//   * 一级菜单 File / Edit / Session / View / Help（左对齐）
//   * 空白区拖动（非 Windows 用 WindowMoveArea；Windows 走原生移动循环）与双击最大化
//   * 窄窗右栏 chevron
//   * 最小化 / 最大化·还原 / 关闭
//
// New Session 强调按钮已移除：新建走 File 菜单、快捷键与其它既有入口。
import { Theme } from "../theme.slint";
import { WinIconButton } from "basic/controls.slint";
import { Icon } from "basic/icons.slint";
import { MenuEntry, MenuPopup } from "menu_popup.slint";

// Windows 原生标题栏拖动检测：`MenuBar.native-title-drag` 为 true 时
// `WindowMoveArea` 关闭，由本组件在空白区/应用图标上接管左键拖动。
//
// 按下后移动超过阈值才上报 `drag-requested`，单击（收起菜单）与双击（最大化）
// 仍是普通 TouchArea 行为。系统移动循环会吞掉按键释放，Slint 之后可能补发一次
// clicked；用 drag-triggered 吞掉那一次，避免拖动结束时误触单击动作。
component TitleBarDragTouch inherits TouchArea {
    in property <bool> native-drag: false;
    callback clicked-blank();
    callback double-clicked-blank();
    callback drag-requested();

    private property <length> press-x: 0px;
    private property <length> press-y: 0px;
    private property <bool> armed: false;
    private property <bool> drag-triggered: false;

    pure function abs-length(value: length) -> length {
        value < 0px ? -value : value;
    }

    pointer-event(event) => {
        if (!root.native-drag) {
            return;
        }
        if (event.button == PointerEventButton.left) {
            if (event.kind == PointerEventKind.down) {
                root.drag-triggered = false;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.armed = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.armed = false;
            }
        }
    }

    moved => {
        if (root.native-drag && root.armed
            && (root.abs-length(self.mouse-x - root.press-x) >= 4px
                || root.abs-length(self.mouse-y - root.press-y) >= 4px)) {
            root.armed = false;
            root.drag-triggered = true;
            root.drag-requested();
        }
    }

    clicked => {
        if (root.drag-triggered) {
            root.drag-triggered = false;
        } else {
            root.clicked-blank();
        }
    }

    double-clicked => {
        root.double-clicked-blank();
    }
}

// 菜单栏项（WinUI 3 MenuBar 形态）：24px 行高、4px 圆角、展开态高亮
component MenuTitle inherits Rectangle {
    in property <string> label: @tr("MenuBar" => "File");
    in property <bool> open: false;
    /// 是否已有任一菜单展开（`root.open_menu_index >= 0`）：展开态下悬停到另一个
    /// 一级菜单要直接切换（标准 MenuBar 行为），未展开时悬停不动作。
    in property <bool> menu-open: false;
    callback activated();
    /// 菜单已展开且指针悬停到本项：由 main_window 切换到本项对应的菜单。
    callback hovered();

    // E19：Slint 没有 menu-item 角色，用 button 语义 + 菜单名作为可访问标签。
    accessible-role: button;
    accessible-label: root.label;

    height: Theme.control-height-compact;
    width: title-text.preferred-width + 20px;
    border-radius: Theme.radius-control;
    background: root.open ? Theme.subtle-selected : title-touch.pressed ? Theme.subtle-pressed : title-touch.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    title-text := Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-body;
        x: 10px;
        height: parent.height;
        vertical-alignment: center;
    }

    title-touch := TouchArea {
        // A14（B 轮2 #62 / M 轮2 中#11）：设计语言 §5 要求菜单/按钮保持默认箭头，
        // 这里不再设 mouse-cursor: pointer。
        clicked => { root.activated(); }
        // 悬停切换：仅在已有菜单展开时生效；PointerEventKind.move 覆盖指针移入本项的过渡。
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move && root.menu-open) {
                root.hovered();
            }
        }
    }
}

/// WinUI 3 标题栏按钮：46×顶栏高、直角、关闭悬停用系统红。
component CaptionButton inherits Rectangle {
    in property <string> kind: "minimize";
    /// 最大化态：方框换成还原（叠方）。
    in property <bool> window-maximized: false;
    callback clicked();

    private property <bool> is-close: root.kind == "close";
    private property <string> access-label:
        root.kind == "minimize" ? @tr("MenuBar" => "Minimize")
        : root.kind == "close" ? @tr("MenuBar" => "Close")
        : root.window-maximized ? @tr("MenuBar" => "Restore")
        : @tr("MenuBar" => "Maximize");
    private property <color> glyph-color: root.is-close && touch.has-hover
        ? Theme.caption-close-hover-text
        : Theme.text-primary;

    width: 46px;
    height: 100%;
    background: root.is-close
        ? (touch.pressed ? Theme.caption-close-pressed
            : touch.has-hover ? Theme.caption-close-hover : transparent)
        : (touch.pressed ? Theme.subtle-pressed
            : touch.has-hover ? Theme.subtle-hover : transparent);
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.access-label;
    accessible-action-default => { root.clicked(); }

    // 最小化 / 关闭用图标；最大化·还原用几何方框。
    // close 的 SVG 描边比 minus 更内缩，同为 10px 时 X 会显得更小，故关闭用 12px。
    if root.kind == "minimize" : Icon {
        name: "minus";
        icon-color: root.glyph-color;
        icon-size: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.kind == "maximize" && !root.window-maximized : Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: 1px;
        border-color: root.glyph-color;
        background: transparent;
    }
    if root.kind == "maximize" && root.window-maximized : Rectangle {
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: transparent;

        // 后层方框（偏右上）
        Rectangle {
            x: 2px;
            y: 0px;
            width: 8px;
            height: 8px;
            border-width: 1px;
            border-color: root.glyph-color;
            background: transparent;
        }
        // 前层方框（偏左下，盖住后层一角）
        Rectangle {
            x: 0px;
            y: 2px;
            width: 8px;
            height: 8px;
            border-width: 1px;
            border-color: root.glyph-color;
            background: Theme.window-background;
        }
    }
    if root.kind == "close" : Icon {
        name: "close";
        icon-color: root.glyph-color;
        icon-size: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 单行自绘顶栏：[图标] 一级菜单 …… [窄窗 chevron] [─ □ ×]
export component MenuBar inherits Rectangle {
    in property <int> open-index: -1;
    /// 窄窗口下显示右栏展开/收起按钮（§4.2：<1120px）
    in property <bool> dock-toggle-visible: false;
    /// 右栏当前是否被自动折叠（决定 chevron 方向）。
    in property <bool> right-collapsed: false;
    /// 宿主 Window.maximized，驱动还原字形。
    in property <bool> window-maximized: false;
    /// Windows：标题栏拖动走 Win32 原生移动循环（见 win_chrome.rs），
    /// 不再使用 WindowMoveArea → winit drag_window()。
    in property <bool> native-title-drag: false;

    /// 点击一级菜单：index = 0..4，anchor-x = 该项的窗口绝对 x。
    callback menu-activated(int, length);
    /// 菜单已展开时悬停到另一项：index = 0..4，anchor-x = 该项的窗口绝对 x。
    callback menu-hovered(int, length);
    /// 点击菜单栏空白（非一级标题）：收起已展开的菜单。
    callback menu-dismiss-requested();
    /// Windows 原生拖动：标题栏空白/应用图标上的左键拖动已过阈值。
    callback title-drag-requested();
    callback toggle-right-side();
    callback minimize-requested();
    callback maximize-toggle-requested();
    callback close-requested();

    height: Theme.bar-height-menubar;
    vertical-stretch: 0;
    background: Theme.window-background;

    // 底部分隔线：无系统标题栏时与内容区划界。
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: 100%;
        background: Theme.layer-stroke;
    }

    HorizontalLayout {
        spacing: 0px;
        alignment: stretch;

        // 可拖动区：图标 + 菜单 + 弹性空白 + 窄窗 chevron。
        // 菜单/按钮的 TouchArea 仍可点击；空白区拖动窗口、双击最大化。
        //
        // 注意：内层必须用 alignment: stretch（不能用 center）。center 会忽略
        // horizontal-stretch，把菜单整组居中，并把弹性拖动区压成 0 宽，导致
        // 拖动/双击最大化失效，菜单也不在左边。
        //
        // WIN-2/WIN-3：Windows 下禁用 WindowMoveArea（winit drag_window() 的
        // dragging 守卫在最大化/还原循环后可能卡住），改由下方 TitleBarDragTouch
        // 上报 title-drag-requested，交给 win32 原生移动循环。
        WindowMoveArea {
            enabled: !root.native-title-drag;
            horizontal-stretch: 1;
            height: 100%;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 2px;
                alignment: stretch;
                // 应用图标与 MenuTitle（24px）垂直居中，避免图标相对菜单文字偏上/偏下。
                // 不设纵向 padding：顶栏已是 §4.1 的 32px，再留 4px 会把 32px 的
                // 面板折叠按钮挤出内容区。
                cross-axis-alignment: center;

                // 最左应用图标（落在拖动区内，可拖窗；无独立点击）。
                Rectangle {
                    width: Theme.control-height-compact;
                    height: Theme.control-height-compact;
                    horizontal-stretch: 0;
                    background: transparent;

                    Icon {
                        name: "terminal";
                        icon-color: Theme.text-primary;
                        icon-size: Theme.icon-size-small;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    // Windows 原生拖动模式下图标也是标题栏拖动区；非原生模式由
                    // 外层 WindowMoveArea 处理，这里不创建覆盖层。
                    if root.native-title-drag : TitleBarDragTouch {
                        native-drag: true;
                        drag-requested() => { root.title-drag-requested(); }
                    }
                }

                file_menu_title := MenuTitle {
                    label: @tr("MenuBar" => "File");
                    open: root.open-index == 0;
                    menu-open: root.open-index >= 0;
                    horizontal-stretch: 0;
                    hovered => { root.menu-hovered(0, file_menu_title.absolute-position.x); }
                    activated => { root.menu-activated(0, file_menu_title.absolute-position.x); }
                }
                edit_menu_title := MenuTitle {
                    label: @tr("MenuBar" => "Edit");
                    open: root.open-index == 1;
                    menu-open: root.open-index >= 0;
                    horizontal-stretch: 0;
                    hovered => { root.menu-hovered(1, edit_menu_title.absolute-position.x); }
                    activated => { root.menu-activated(1, edit_menu_title.absolute-position.x); }
                }
                session_menu_title := MenuTitle {
                    label: @tr("MenuBar" => "Session");
                    open: root.open-index == 2;
                    menu-open: root.open-index >= 0;
                    horizontal-stretch: 0;
                    hovered => { root.menu-hovered(2, session_menu_title.absolute-position.x); }
                    activated => { root.menu-activated(2, session_menu_title.absolute-position.x); }
                }
                view_menu_title := MenuTitle {
                    label: @tr("MenuBar" => "View");
                    open: root.open-index == 3;
                    menu-open: root.open-index >= 0;
                    horizontal-stretch: 0;
                    hovered => { root.menu-hovered(3, view_menu_title.absolute-position.x); }
                    activated => { root.menu-activated(3, view_menu_title.absolute-position.x); }
                }
                help_menu_title := MenuTitle {
                    label: @tr("MenuBar" => "Help");
                    open: root.open-index == 4;
                    menu-open: root.open-index >= 0;
                    horizontal-stretch: 0;
                    hovered => { root.menu-hovered(4, help_menu_title.absolute-position.x); }
                    activated => { root.menu-activated(4, help_menu_title.absolute-position.x); }
                }

                // 弹性空白：拖动主区域；双击切换最大化；菜单展开时单击收起。
                // Windows 原生拖动模式下由 TitleBarDragTouch 过阈值后上报
                // title-drag-requested（WindowMoveArea 已禁用）。
                // 同时保证窗口 max-width 无界（见 main_window 尺寸约束说明）。
                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    TitleBarDragTouch {
                        native-drag: root.native-title-drag;
                        clicked-blank() => {
                            if (root.open-index >= 0) {
                                root.menu-dismiss-requested();
                            }
                        }
                        double-clicked-blank() => { root.maximize-toggle-requested(); }
                        drag-requested() => { root.title-drag-requested(); }
                    }
                }

                if root.dock-toggle-visible : WinIconButton {
                    horizontal-stretch: 0;
                    icon: root.right-collapsed ? "chevron-left" : "chevron-right";
                    accessible-name: root.right-collapsed
                        ? @tr("MainWindow" => "Expand tool panels")
                        : @tr("MainWindow" => "Collapse tool panels");
                    clicked => { root.toggle-right-side(); }
                }
            }
        }

        CaptionButton {
            horizontal-stretch: 0;
            kind: "minimize";
            clicked => { root.minimize-requested(); }
        }
        CaptionButton {
            horizontal-stretch: 0;
            kind: "maximize";
            window-maximized: root.window-maximized;
            clicked => { root.maximize-toggle-requested(); }
        }
        CaptionButton {
            horizontal-stretch: 0;
            kind: "close";
            clicked => { root.close-requested(); }
        }
    }
}

// 5 个一级菜单的 MenuPopup（模型数组仍由 main_window 持有并传入）。
// 宿主在窗口层级实例化本组件（内容之后、模态弹窗之前）。
export component MenuBarPopups inherits Rectangle {
    in property <int> open-index: -1;
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    /// 遮罩顶部内缩（统一顶栏高度）。
    in property <length> scrim-top: Theme.bar-height-menubar;
    in property <[MenuEntry]> file-entries: [];
    in property <[MenuEntry]> edit-entries: [];
    in property <[MenuEntry]> session-entries: [];
    in property <[MenuEntry]> view-entries: [];
    in property <[MenuEntry]> help-entries: [];

    /// (菜单序号 0..4, 条目序号)；点击后的动作由宿主执行（保持原 dispatch 位置）。
    callback selected(int, int);
    callback dismissed();

    // 作为 Window 直接子项（与拆分前的 MenuPopup 相同）：root 由 Slint 自动铺满
    // 窗口，内层 Popup 显式取父尺寸，保持锚点钳制与全屏 scrim 与拆分前一致。
    background: transparent;

    file_menu_popup := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open-index == 0;
        entries: root.file-entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 230px;
        // A1：遮罩从菜单栏下方开始，点击其它一级菜单不再被遮罩吞掉。
        scrim-top: root.scrim-top;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(0, index); }
    }

    edit_menu_popup := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open-index == 1;
        entries: root.edit-entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 210px;
        scrim-top: root.scrim-top;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(1, index); }
    }

    session_menu_popup := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open-index == 2;
        entries: root.session-entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 260px;
        scrim-top: root.scrim-top;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(2, index); }
    }

    view_menu_popup := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open-index == 3;
        entries: root.view-entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 250px;
        scrim-top: root.scrim-top;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(3, index); }
    }

    help_menu_popup := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open-index == 4;
        entries: root.help-entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 210px;
        scrim-top: root.scrim-top;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(4, index); }
    }
}
