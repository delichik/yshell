// 终端工作区：标签条（N0：多标签 + 横向滚动）+ TerminalView + 内边距
// + 终端/标签右键菜单 Popup。
//
// 拆分自 `ui/main_window.slint`（R1 结构重构），N0 重写标签条内部：
//   * 根继承 `VerticalLayout`：与拆分前主区的那个 VerticalLayout 完全同形
//     （默认间距、同样的两个子块），避免组件化引入布局差异。
//   * 终端投影全部由宿主传入；终端回调原样透传给宿主回调。
//   * 标签条改为 `for tab in root.tabs` 的 repeater + Flickable 横向滚动
//     （滚轮/按住拖动，见 N0 设计 §5）；标签本体复刻 `WinTab` 的视觉，
//     额外提供右键菜单与关闭回调。
//   * Popup 实例放在 `TerminalWorkspacePopups` / `TabBarPopups` 里，必须在
//     main_window 的"内容之后、模态弹窗之前"实例化，保持原有绘制层级。
//   * `@tr` 文案搬移后显式带上原组件上下文（`@tr("MainWindow" => ...)`）。
import { Theme } from "../theme.slint";
import { MenuEntry, MenuPopup } from "menu_popup.slint";
import { TerminalView } from "terminal_view.slint";
import { WorkspaceSplitView } from "workspace_split.slint";
import { WorkspaceTab } from "workspace_tab_model.slint";
import { WorkspaceTabBar } from "workspace_tab_bar.slint";
import { WorkspacePaneLeaf, WorkspaceSplitter } from "workspace_pane_model.slint";
import { QuickConnectPage, QuickConnectRow, QuickLinkRow } from "../pages/quick_connect.slint";
import { SftpPanel } from "sftp_panel.slint";
import { FileCrumb, FileRow } from "file_pane.slint";
import { SftpTabPage } from "sftp_tab_page.slint";

export { WorkspaceTab }

export component TerminalWorkspace inherits VerticalLayout {
    in property <[WorkspaceTab]> tabs: [];
    // E21：这些默认值都会被宿主投影覆盖；置空避免投影到达前闪现英文（muse 轮1 中#35）
    in property <string> title-text: "";
    in property <string> body-text: "";
    /// N2/TAB-3：单终端内容是否可见/可交互。QC 全页覆盖内容区时为 false，
    /// 但终端实例仍按内容区尺寸保留在底层（终端视口 out 属性据此保持有效）。
    /// 分屏时由叶子/overlay 承接 QC。
    in property <bool> terminal-visible: true;
    /// `new` / `terminal` / `sftp` — chooses the content page.
    in property <string> active-tab-mode-text: "terminal";
    /// 是否显示快速连接内容（非分屏全页，或分屏时叠在 QC 叶子上）。
    in property <bool> quick-connect-visible: false;
    in property <image> terminal-image;
    in property <int> cursor-column: 0;
    in property <int> cursor-row: 0;
    in property <int> scroll-offset: 0;
    in property <bool> selection-active: false;
    in property <string> search-summary-text: "";
    in property <string> status-text: "";
    in property <bool> find-visible: false;
    /// 可见行与查找词与宿主双向绑定（终端内部会写回查找词）。
    in-out property <[string]> visible-lines: [];
    in-out property <string> search-query-text: "";
    /// WP2：正则查找开关。
    in-out property <bool> search-regex: false;

    // --- SFTP tab page projection (focused tab). -------------------------
    in property <[FileRow]> sftp-rows;
    in property <[FileCrumb]> sftp-crumbs;
    in property <int> sftp-selected-index: -1;
    in property <string> sftp-sort-column: "name";
    in property <bool> sftp-sort-ascending: true;
    in property <string> sftp-sort-text: "Name ↑";
    in property <bool> sftp-show-hidden: false;
    in property <int> sftp-item-count: 0;
    in property <int> sftp-dir-count: 0;
    in property <int> sftp-selected-count: 0;
    in property <string> sftp-empty-text: "";
    in property <string> sftp-error-text: "";
    in property <bool> sftp-connected: false;
    in property <bool> sftp-remote-edit-active: false;
    in property <string> sftp-remote-edit-text: "";
    in-out property <string> sftp-path-text: "/";
    in property <[FileRow]> sftp-local-rows;
    in property <[FileCrumb]> sftp-local-crumbs;
    in property <string> sftp-local-path-text: "/";
    in property <string> sftp-local-path-separator: "/";
    in property <bool> sftp-local-show-hidden: false;
    in property <string> sftp-local-sort-column: "name";
    in property <bool> sftp-local-sort-ascending: true;
    in property <string> sftp-local-sort-text: "Name ↑";
    in property <int> sftp-local-item-count: 0;
    in property <int> sftp-local-dir-count: 0;
    in property <int> sftp-local-selected-count: 0;
    in property <string> sftp-local-empty-text: "";
    in property <string> sftp-local-error-text: "";
    in property <bool> sftp-local-retry-visible: true;
    in property <string> sftp-local-title-text: "";
    in property <string> sftp-local-selected-name-text: "";
    in property <string> sftp-local-selection-key: "";
    in property <string> sftp-selection-key: "";
    in property <float> sftp-column-ratio: 0.5;
    callback sftp-refresh();
    callback sftp-up();
    callback sftp-home();
    callback sftp-open-path(string);
    callback sftp-open-crumb(int);
    callback sftp-sort-by(string);
    callback sftp-toggle-hidden();
    callback sftp-select-row(int, bool, bool);
    callback sftp-activate-row(int);
    callback sftp-context-menu-requested(int, length, length);
    callback sftp-panel-menu-requested(length, length);
    callback sftp-save-edit();
    callback sftp-cancel-edit();
    pure callback sftp-drag-remote-transfer(string) -> data-transfer;
    callback sftp-drop-on-remote-row(int, data-transfer, DragAction);
    callback sftp-drop-on-remote-blank(data-transfer, DragAction);
    callback sftp-local-up();
    callback sftp-local-home();
    callback sftp-local-refresh();
    callback sftp-local-open-path(string);
    callback sftp-local-sort-by(string);
    callback sftp-local-toggle-hidden();
    callback sftp-local-select-row(int, bool, bool);
    callback sftp-local-activate-row(int);
    callback sftp-local-context-menu-requested(int, length, length);
    callback sftp-local-retry();
    pure callback sftp-drag-local-transfer(string) -> data-transfer;
    callback sftp-drop-on-local(data-transfer, DragAction);
    callback sftp-copy-selection();
    callback sftp-cut-selection();
    callback sftp-paste-cross-pane();
    callback sftp-column-ratio-changed(float);

    // 分屏视口：宿主写入聚焦叶归一化几何；本地扣 chrome。
    // UI-1：host 8px padding 已移除；叶描边左右边压在 TerminalView 的 6px 左右
    // pad 上，不占 cell 区；只有叶底边会盖住终端内容，所以宽度 chrome 只算 TV
    // 左右 pad，高度 chrome = TV 上下 pad + tab 栏 + 叶底边描边（避免裁掉末行）。
    in property <float> split-focused-leaf-w: 1.0;
    in property <float> split-focused-leaf-h: 1.0;
    in property <float> split-focused-leaf-x: 0.0;
    in property <float> split-focused-leaf-y: 0.0;
    in property <bool> split-qc-shown: false;
    in property <bool> split-focused-quick-connect: false;
    in property <float> split-qc-leaf-x: 0.0;
    in property <float> split-qc-leaf-y: 0.0;
    in property <float> split-qc-leaf-w: 0.0;
    in property <float> split-qc-leaf-h: 0.0;
    property <float> split-tv-pad-x-px: 2.0 * Theme.terminal-padding-x / 1px;
    property <float> split-tv-pad-y-px: 2.0 * Theme.terminal-padding-y / 1px;
    property <float> split-tab-bar-px: Theme.bar-height-tabs / 1px;
    /// 叶描边宽度（与 workspace_split.slint 的 SplitPaneLeaf.border-width 一致）。
    property <length> split-leaf-border: 2px;
    property <float> split-leaf-bottom-border-px: root.split-leaf-border / 1px;
    property <float> split-pane-chrome-w-px: root.split-tv-pad-x-px;
    property <float> split-pane-chrome-h-px:
        root.split-tv-pad-y-px + root.split-tab-bar-px + root.split-leaf-bottom-border-px;
    property <float> split-inner-width-px: Math.max(split_host.width / 1px, 1.0);
    property <float> split-inner-height-px: Math.max(split_host.height / 1px, 1.0);
    /// 单窗格 single_unit 的 1px 描边同样压住终端表面底边，视口高度要扣掉。
    property <length> single-pane-border: 1px;
    property <float> single-pane-bottom-border-px: root.single-pane-border / 1px;

    /// 单终端：取 TerminalView；分屏：聚焦叶几何 × 内区 − chrome。
    out property <float> terminal-viewport-width-px: root.split-active
        ? Math.max(root.split-inner-width-px * root.split-focused-leaf-w - root.split-pane-chrome-w-px, 1.0)
        : terminal_view.terminal-viewport-width-px;
    out property <float> terminal-viewport-height-px: root.split-active
        ? Math.max(root.split-inner-height-px * root.split-focused-leaf-h - root.split-pane-chrome-h-px, 1.0)
        : Math.max(terminal_view.terminal-viewport-height-px - root.single-pane-bottom-border-px, 1.0);
    /// W5-A2：终端是否持有键盘焦点（模态弹窗关闭后的焦点恢复据此避让终端）。
    /// P1：分屏时读聚焦叶子里的 TerminalView。
    out property <bool> terminal-focused: root.split-active
        ? split_view.terminal-focused
        : terminal_view.terminal-focused;

    // E10：查找栏关闭后把焦点交还终端（打开时的聚焦由 TerminalView 内的 Timer 负责，
    // 这里不碰条件元素）。终端不可见（Quick Connect 页）时不动焦点。
    changed find-visible => {
        if (!root.find-visible && root.terminal-visible) {
            root.focus-terminal();
        }
    }

    // 分屏切换聚焦 pane 后把键盘焦点落到新叶子（投影写回 focused-pane 时触发）。
    changed split-focused-pane => {
        if (root.split-active && root.terminal-visible) {
            root.focus-terminal();
        }
    }

    // TAB-6：覆盖层关闭（Esc/提交成功）后，分屏模式把焦点还给聚焦叶的终端。
    changed split-focused-quick-connect => {
        if (root.split-active && !root.split-focused-quick-connect) {
            root.focus-terminal();
        }
    }

    // N7：terminal-focused 由 TerminalView 的 FocusScope.has-focus 驱动。窗口失去
    // OS 焦点时它翻 false、重新激活时翻 true —— 后者即"该窗口被激活"的信号
    // （终端持有焦点时 focus-gained 事件到不了窗口级 shortcut_scope）。
    changed terminal-focused => {
        if (root.terminal-focused) {
            root.window-activated();
        }
    }

    /// A2/E23：宿主在菜单/弹层关闭后把键盘焦点还给终端（WS-A 的焦点回退请求）。
    /// 终端不可见（Quick Connect 页）时不动焦点，避免抢 QC 输入框。
    public function focus-terminal() {
        if (root.quick-connect-visible && !root.split-active) {
            return;
        }
        if (root.split-active && root.split-focused-quick-connect) {
            return;
        }
        if (root.split-active) {
            split_view.focus-terminal();
        } else if (root.terminal-visible) {
            terminal_view.focus-terminal();
        }
    }

    /// Ctrl+O / File > Quick Connect：聚焦 QC 输入框。
    ///
    /// 按分屏状态选择实例（不能依赖 `split-qc-shown`：打开覆盖层的同一投影里它
    /// 尚未写回）。两个页面实例都常驻，隐藏时聚焦也是安全的。
    public function focus-quick-connect() {
        if (root.split-active) {
            split_qc_page.focus-quick-connect();
        } else {
            full_qc_page.focus-quick-connect();
        }
    }

    /// N7：终端 FocusScope 刚拿到焦点（窗口激活 / 点击终端）。宿主据此把该窗口
    /// 标记为交互窗口（多窗口下键盘/终端动作要作用到正确窗口的活动会话）。
    callback window-activated();
    callback new-session();
    callback open-find();
    callback activate-tab(string);
    callback close-tab(string);
    /// 参数：tab id, 当前显示名, x, y。
    callback tab-context-menu-requested(string, string, length, length);
    /// 双击标签：复制 session（参数 = tab id）。
    callback duplicate-tab-requested(string);
    callback context-menu-requested(length, length);
    // WP4：分屏动作。
    callback focus-split-pane(int);
    callback close-split-pane(int);
    callback set-split-ratio(int, float);
    /// 标签拖拽载荷 / 落到 pane / 边缘分屏。
    pure callback drag-tab-transfer(string) -> data-transfer;
    callback drop-tab-on-pane(int, data-transfer);
    callback drop-tab-split(data-transfer, int, string);
    callback terminal-key(string, bool, bool, bool, bool);
    callback terminal-scroll(int);
    callback terminal-scroll-to-bottom();
    callback terminal-selection-begin(float, float);
    callback terminal-selection-update(float, float);
    callback terminal-selection-end(float, float);
    callback terminal-select-word-at(float, float);
    callback copy-visible();
    callback paste-clipboard();
    callback clear-terminal();
    callback find-text(string);
    callback find-next();
    callback find-prev();
    callback find-regex-changed(bool);
    callback dismiss-find();
    // WP1：连接 overlay 动作（透传 TerminalView）。
    callback connection-retry();
    callback connection-cancel();
    callback connection-copy-error();

    // --- N2：快速连接页（工作区自持；分屏时叠在对应叶子上）----------------
    in-out property <string> quick-connect-input-text: "";
    in property <string> quick-connect-error-text: "";
    in property <string> quick-connect-summary-text: "";
    in property <bool> quick-connect-history-enabled: true;
    in property <string> quick-connect-last-target-text: "";
    in property <[QuickConnectRow]> quick-connect-rows: [];
    in property <[QuickLinkRow]> quick-link-rows: [];
    callback quick-connect-input-changed(string);
    callback quick-connect-submit(string);
    callback quick-connect-connect-target(string);
    callback quick-connect-pin-target(string);
    callback quick-connect-copy-target(string);
    callback quick-connect-remove-link(string);
    callback quick-connect-save-as-session(string);
    callback quick-connect-clear-history();

    /// WP1：连接 overlay 投影（由宿主绑定）。
    in property <bool> connection-overlay-visible: false;
    in property <string> connection-overlay-target: "";
    in property <string> connection-overlay-stage: "";
    in property <string> connection-overlay-error: "";
    in property <bool> connection-overlay-failed: false;
    in property <bool> connection-overlay-pending: false;

    // --- WP4：分屏 -----------------------------------------------------------
    in property <bool> split-active: false;
    in property <int> split-focused-pane: 0;
    in property <image> terminal-image-secondary;
    in property <[WorkspacePaneLeaf]> split-leaves: [];
    in property <[WorkspaceSplitter]> split-splitters: [];
    /// 未分屏拖拽分区：`dir:small|equal|major`。
    property <string> single-drop-preview: "";
    property <bool> single-drop-hovering: single_drop.has-drag && root.single-drop-preview != "";
    property <float> single-drop-share:
        root.single-drop-preview == "up:small" || root.single-drop-preview == "down:small"
            || root.single-drop-preview == "left:small" || root.single-drop-preview == "right:small" ? 0.25
        : root.single-drop-preview == "up:major" || root.single-drop-preview == "down:major"
            || root.single-drop-preview == "left:major" || root.single-drop-preview == "right:major" ? 0.7
        : 0.5;
    property <bool> single-drop-vertical:
        root.single-drop-preview == "up:small" || root.single-drop-preview == "up:equal" || root.single-drop-preview == "up:major"
        || root.single-drop-preview == "down:small" || root.single-drop-preview == "down:equal" || root.single-drop-preview == "down:major";
    property <bool> single-drop-on-start:
        root.single-drop-preview == "up:small" || root.single-drop-preview == "up:equal" || root.single-drop-preview == "up:major"
        || root.single-drop-preview == "left:small" || root.single-drop-preview == "left:equal" || root.single-drop-preview == "left:major";

    /// 目标区六段：最外=小、次外=均分、最内=大部分；轴向取更靠近的边。
    pure function split-zone(x: length, y: length, w: length, h: length) -> string {
        if (h <= 0px || w <= 0px) { return "right:equal"; }
        if (Math.min(y / h, 1.0 - y / h) <= Math.min(x / w, 1.0 - x / w)) {
            if (y < h / 6) { return "up:small"; }
            if (y < h * 2 / 6) { return "up:equal"; }
            if (y < h * 3 / 6) { return "up:major"; }
            if (y < h * 4 / 6) { return "down:major"; }
            if (y < h * 5 / 6) { return "down:equal"; }
            return "down:small";
        }
        if (x < w / 6) { return "left:small"; }
        if (x < w * 2 / 6) { return "left:equal"; }
        if (x < w * 3 / 6) { return "left:major"; }
        if (x < w * 4 / 6) { return "right:major"; }
        if (x < w * 5 / 6) { return "right:equal"; }
        return "right:small";
    }

    // split-leaf-border 已在上方声明（视口 chrome 与 QC overlay 共用）。
    property <length> split-inner-w: split_host.width;
    property <length> split-inner-h: split_host.height;
    /// 次 pane 视口（取第一个非聚焦叶近似；多叶时宿主可再细化）。
    in property <float> split-secondary-leaf-w: 0.5;
    in property <float> split-secondary-leaf-h: 1.0;
    out property <float> terminal-viewport-secondary-width-px: root.split-active
        ? Math.max(root.split-inner-width-px * root.split-secondary-leaf-w - root.split-pane-chrome-w-px, 1.0)
        : 0;
    out property <float> terminal-viewport-secondary-height-px: root.split-active
        ? Math.max(root.split-inner-height-px * root.split-secondary-leaf-h - root.split-pane-chrome-h-px, 1.0)
        : 0;

    // 未分屏：tab 栏 + terminal 一体（spacing 0）；分屏时折叠，改用叶内各自 tab 栏。
    // TAB-3：tab 栏常驻——未分屏时单窗格始终展开（零标签 / QC 全页也一样），
    // 只有分屏才折叠。QC 页改为内容区覆盖层（见 single_content），不再参与单窗格折叠。
    single_host := Rectangle {
        clip: true;
        min-height: 0px;
        max-height: !root.split-active ? 100000px : 0px;
        background: Theme.window-background;
        VerticalLayout {
            padding: 0px;
            spacing: 0;

            // 同框：描边包住 tab+terminal；预览盖满整框按实际占比。
            // UI-1：pane 直角贴边，不再有 8px 外边距与圆角卡片观感。
            single_unit := Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                border-width: root.single-pane-border;
                border-color: Theme.terminal-border;
                border-radius: 0px;
                background: Theme.window-background;
                clip: true;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 0;

                    WorkspaceTabBar {
                        tabs: root.tabs;
                        drop-enabled: false;
                        activate-tab(id) => { root.activate-tab(id); }
                        close-tab(id) => { root.close-tab(id); }
                        duplicate-tab(id) => { root.duplicate-tab-requested(id); }
                        tab-context-menu-requested(id, title, x, y) => {
                            root.tab-context-menu-requested(id, title, x, y);
                        }
                        new-session() => { root.new-session(); }
                        drag-tab-transfer(id) => { return root.drag-tab-transfer(id); }
                        tab-bar-dropped(_data) => { }
                    }

                    // TAB-3：内容区常驻；QC 全页作为覆盖层叠在这里（tab 栏之下），
                    // 终端视图保持满尺寸垫底，视口 out 属性不受 QC 显隐影响。
                    single_content := Rectangle {
                        vertical-stretch: 1;
                        min-height: 0px;
                        background: Theme.terminal-background;
                        clip: true;

                        single_drop := DropArea {
                            width: 100%;
                            height: 100%;
                            enabled: !root.split-active && root.terminal-visible;
                            can-drop(event) => {
                                root.single-drop-preview = root.split-zone(
                                    event.position.x, event.position.y, self.width, self.height
                                );
                                return DragAction.move;
                            }
                            dropped(event) => {
                                root.drop-tab-split(
                                    event.data,
                                    0,
                                    root.split-zone(event.position.x, event.position.y, self.width, self.height)
                                );
                                root.single-drop-preview = "";
                                return DragAction.move;
                            }

                            terminal_view := TerminalView {
                                width: 100%;
                                height: 100%;
                                embedded: true;
                                view-visible: root.terminal-visible && !root.split-active;
                                // TAB-3：QC 覆盖内容区时终端仍按满尺寸布局（视口 out 有效），
                                // 但不再接收鼠标/键盘/焦点——输入归 QC 页。
                                interactive: root.terminal-visible && !root.split-active;
                                title: root.title-text;
                                log-output: root.body-text;
                                visible-lines <=> root.visible-lines;
                                terminal-image: root.terminal-image;
                                cursor-column: root.cursor-column;
                                cursor-row: root.cursor-row;
                                scroll-offset: root.scroll-offset;
                                selection-active: root.selection-active;
                                search-query <=> root.search-query-text;
                                search-summary: root.search-summary-text;
                                search-regex <=> root.search-regex;
                                footer-status: root.status-text;
                                find-visible: root.find-visible && !root.split-active;
                                connection-overlay-visible: root.connection-overlay-visible && !root.split-active;
                                connection-overlay-target: root.connection-overlay-target;
                                connection-overlay-stage: root.connection-overlay-stage;
                                connection-overlay-error: root.connection-overlay-error;
                                connection-overlay-failed: root.connection-overlay-failed;
                                connection-overlay-pending: root.connection-overlay-pending;
                                connection-retry() => { root.connection-retry(); }
                                connection-cancel() => { root.connection-cancel(); }
                                connection-copy-error() => { root.connection-copy-error(); }
                                key-pressed(text, ctrl, alt, shift, meta) => { root.terminal-key(text, ctrl, alt, shift, meta); }
                                scroll-lines(delta) => { root.terminal-scroll(delta); }
                                scroll-to-bottom() => { root.terminal-scroll-to-bottom(); }
                                selection-begin(x, y) => { root.terminal-selection-begin(x, y); }
                                selection-update(x, y) => { root.terminal-selection-update(x, y); }
                                selection-end(x, y) => { root.terminal-selection-end(x, y); }
                                select-word-at(x, y) => { root.terminal-select-word-at(x, y); }
                                copy-visible() => { root.copy-visible(); }
                                paste-clipboard() => { root.paste-clipboard(); }
                                clear-terminal() => { root.clear-terminal(); }
                                find-text(query) => { root.find-text(query); }
                                find-next() => { root.find-next(); }
                                find-prev() => { root.find-prev(); }
                                find-regex-changed(enabled) => { root.find-regex-changed(enabled); }
                                dismiss-find() => { root.dismiss-find(); }
                                context-menu-requested(x, y) => { root.context-menu-requested(x, y); }
                            }

                            // 预览在 DropArea 末子，避免盖住后丢失 has-drag。
                            if root.single-drop-hovering : Rectangle {
                                x: root.single-drop-vertical ? 0px
                                    : (root.single-drop-on-start ? 0px : parent.width * (1.0 - root.single-drop-share));
                                y: !root.single-drop-vertical ? 0px
                                    : (root.single-drop-on-start ? 0px : parent.height * (1.0 - root.single-drop-share));
                                width: root.single-drop-vertical ? parent.width : parent.width * root.single-drop-share;
                                height: root.single-drop-vertical ? parent.height * root.single-drop-share : parent.height;
                                background: Theme.selection-fill;
                                border-width: 1px;
                                border-color: Theme.accent;
                            }
                        }

                        // SFTP tab: fixed two columns (local left, remote
                        // right). Declared after the terminal DropArea so it
                        // covers the terminal surface when active.
                        sftp_page := SftpTabPage {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            visible: root.active-tab-mode-text == "sftp";
                            rows: root.sftp-rows;
                            crumbs: root.sftp-crumbs;
                            selected-index: root.sftp-selected-index;
                            sort-column: root.sftp-sort-column;
                            sort-ascending: root.sftp-sort-ascending;
                            sort-text: root.sftp-sort-text;
                            show-hidden: root.sftp-show-hidden;
                            item-count: root.sftp-item-count;
                            dir-count: root.sftp-dir-count;
                            selected-count: root.sftp-selected-count;
                            empty-text: root.sftp-empty-text;
                            error-text: root.sftp-error-text;
                            connected: root.sftp-connected;
                            remote-edit-active: root.sftp-remote-edit-active;
                            remote-edit-text: root.sftp-remote-edit-text;
                            path-text <=> root.sftp-path-text;
                            local-rows: root.sftp-local-rows;
                            local-crumbs: root.sftp-local-crumbs;
                            local-path-text: root.sftp-local-path-text;
                            local-path-separator: root.sftp-local-path-separator;
                            local-show-hidden: root.sftp-local-show-hidden;
                            local-sort-column: root.sftp-local-sort-column;
                            local-sort-ascending: root.sftp-local-sort-ascending;
                            local-sort-text: root.sftp-local-sort-text;
                            local-item-count: root.sftp-local-item-count;
                            local-dir-count: root.sftp-local-dir-count;
                            local-selected-count: root.sftp-local-selected-count;
                            local-empty-text: root.sftp-local-empty-text;
                            local-error-text: root.sftp-local-error-text;
                            local-retry-visible: root.sftp-local-retry-visible;
                            local-title-text: root.sftp-local-title-text;
                            local-selected-name-text: root.sftp-local-selected-name-text;
                            local-selection-key: root.sftp-local-selection-key;
                            sftp-selection-key: root.sftp-selection-key;
                            column-ratio: root.sftp-column-ratio;
                            column-ratio-changed(ratio) => { root.sftp-column-ratio-changed(ratio); }
                            refresh => { root.sftp-refresh(); }
                            up => { root.sftp-up(); }
                            home => { root.sftp-home(); }
                            open-path(path) => { root.sftp-open-path(path); }
                            open-crumb(index) => { root.sftp-open-crumb(index); }
                            sort-by(column) => { root.sftp-sort-by(column); }
                            toggle-hidden => { root.sftp-toggle-hidden(); }
                            select-row(index, ctrl, shift) => { root.sftp-select-row(index, ctrl, shift); }
                            activate-row(index) => { root.sftp-activate-row(index); }
                            context-menu-requested(index, x, y) => { root.sftp-context-menu-requested(index, x, y); }
                            panel-menu-requested(x, y) => { root.sftp-panel-menu-requested(x, y); }
                            save-edit => { root.sftp-save-edit(); }
                            cancel-edit => { root.sftp-cancel-edit(); }
                            drag-remote-transfer(key) => { return root.sftp-drag-remote-transfer(key); }
                            drop-on-remote-row(index, data, action) => { root.sftp-drop-on-remote-row(index, data, action); }
                            drop-on-remote-blank(data, action) => { root.sftp-drop-on-remote-blank(data, action); }
                            local-up => { root.sftp-local-up(); }
                            local-home => { root.sftp-local-home(); }
                            local-refresh => { root.sftp-local-refresh(); }
                            local-open-path(path) => { root.sftp-local-open-path(path); }
                            local-sort-by(column) => { root.sftp-local-sort-by(column); }
                            local-toggle-hidden => { root.sftp-local-toggle-hidden(); }
                            local-select-row(index, ctrl, shift) => { root.sftp-local-select-row(index, ctrl, shift); }
                            local-activate-row(index) => { root.sftp-local-activate-row(index); }
                            local-context-menu-requested(index, x, y) => { root.sftp-local-context-menu-requested(index, x, y); }
                            local-retry => { root.sftp-local-retry(); }
                            drag-local-transfer(key) => { return root.sftp-drag-local-transfer(key); }
                            drop-on-local(data, action) => { root.sftp-drop-on-local(data, action); }
                            copy-selection => { root.sftp-copy-selection(); }
                            cut-selection => { root.sftp-cut-selection(); }
                            paste-cross-pane => { root.sftp-paste-cross-pane(); }
                        }

                        // TAB-3：未分屏 QC 全页改为内容区覆盖层——只盖终端 I/O，
                        // 不盖 tab 栏，也不再替换整个单窗格。声明在 DropArea 之后保证置顶；
                        // 隐藏时保留实例（focus-quick-connect 始终可调用）。
                        full_qc_page := QuickConnectPage {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            visible: root.quick-connect-visible && !root.split-active;
                            input-text: root.quick-connect-input-text;
                            input-error-text: root.quick-connect-error-text;
                            summary-text: root.quick-connect-summary-text;
                            history-enabled: root.quick-connect-history-enabled;
                            last-target-text: root.quick-connect-last-target-text;
                            recent-rows: root.quick-connect-rows;
                            link-rows: root.quick-link-rows;
                            input-changed(text) => {
                                root.quick-connect-input-text = text;
                                root.quick-connect-input-changed(text);
                            }
                            submit(text) => { root.quick-connect-submit(text); }
                            connect-target(target) => { root.quick-connect-connect-target(target); }
                            pin-target(target) => { root.quick-connect-pin-target(target); }
                            copy-target(target) => { root.quick-connect-copy-target(target); }
                            remove-link(id) => { root.quick-connect-remove-link(id); }
                            save-as-session(target) => { root.quick-connect-save-as-session(target); }
                            clear-history() => { root.quick-connect-clear-history(); }
                        }
                    }
                }
            }
        }
    }

    // WP4：分屏内容区（与单终端互斥折叠）。QC 活动时仍保持几何——QC 叠在对应叶子上。
    split_host := Rectangle {
        clip: true;
        min-height: 0px;
        max-height: root.split-active ? 100000px : 0px;
        background: Theme.window-background;

        VerticalLayout {
            padding: 0px;
            split_view := WorkspaceSplitView {
                vertical-stretch: 1;
                leaves: root.split-leaves;
                splitters: root.split-splitters;
                focused-pane: root.split-focused-pane;
                primary-image: root.terminal-image;
                secondary-image: root.terminal-image-secondary;
                cursor-column: root.cursor-column;
                cursor-row: root.cursor-row;
                scroll-offset: root.scroll-offset;
                selection-active: root.selection-active;
                search-query <=> root.search-query-text;
                search-summary: root.search-summary-text;
                search-regex <=> root.search-regex;
                find-visible: root.find-visible;
                connection-overlay-visible: root.connection-overlay-visible;
                connection-overlay-target: root.connection-overlay-target;
                connection-overlay-stage: root.connection-overlay-stage;
                connection-overlay-error: root.connection-overlay-error;
                connection-overlay-failed: root.connection-overlay-failed;
                connection-overlay-pending: root.connection-overlay-pending;
                view-visible: root.split-active;
                quick-connect-summary-text: root.quick-connect-summary-text;
                quick-connect-history-enabled: root.quick-connect-history-enabled;
                quick-connect-last-target-text: root.quick-connect-last-target-text;
                quick-connect-rows: root.quick-connect-rows;
                quick-link-rows: root.quick-link-rows;
                focus-pane(pane-id) => {
                    if (root.split-active) {
                        root.focus-split-pane(pane-id);
                    }
                }
                terminal-key(text, ctrl, alt, shift, meta) => {
                    root.terminal-key(text, ctrl, alt, shift, meta);
                }
                terminal-scroll(delta) => { root.terminal-scroll(delta); }
                terminal-scroll-to-bottom() => { root.terminal-scroll-to-bottom(); }
                terminal-selection-begin(x, y) => { root.terminal-selection-begin(x, y); }
                terminal-selection-update(x, y) => { root.terminal-selection-update(x, y); }
                terminal-selection-end(x, y) => { root.terminal-selection-end(x, y); }
                terminal-select-word-at(x, y) => { root.terminal-select-word-at(x, y); }
                copy-visible() => { root.copy-visible(); }
                paste-clipboard() => { root.paste-clipboard(); }
                clear-terminal() => { root.clear-terminal(); }
                find-text(query) => { root.find-text(query); }
                find-next() => { root.find-next(); }
                find-prev() => { root.find-prev(); }
                find-regex-changed(enabled) => { root.find-regex-changed(enabled); }
                dismiss-find() => { root.dismiss-find(); }
                context-menu-requested(x, y) => { root.context-menu-requested(x, y); }
                connection-retry() => { root.connection-retry(); }
                connection-cancel() => { root.connection-cancel(); }
                connection-copy-error() => { root.connection-copy-error(); }
                ratio-changed(split-id, value) => { root.set-split-ratio(split-id, value); }
                tab-dropped-on-pane(pane-id, data) => { root.drop-tab-on-pane(pane-id, data); }
                tab-split-dropped(data, pane-id, dir) => { root.drop-tab-split(data, pane-id, dir); }
                activate-tab(id) => { root.activate-tab(id); }
                close-tab(id) => { root.close-tab(id); }
                duplicate-tab(id) => { root.duplicate-tab-requested(id); }
                tab-context-menu-requested(id, title, x, y) => {
                    root.tab-context-menu-requested(id, title, x, y);
                }
                new-session() => { root.new-session(); }
                drag-tab-transfer(id) => { return root.drag-tab-transfer(id); }
                quick-connect-input-changed(text) => { root.quick-connect-input-changed(text); }
                quick-connect-submit(text) => { root.quick-connect-submit(text); }
                quick-connect-connect-target(target) => { root.quick-connect-connect-target(target); }
                quick-connect-pin-target(target) => { root.quick-connect-pin-target(target); }
                quick-connect-copy-target(target) => { root.quick-connect-copy-target(target); }
                quick-connect-remove-link(id) => { root.quick-connect-remove-link(id); }
                quick-connect-save-as-session(target) => { root.quick-connect-save-as-session(target); }
                quick-connect-clear-history() => { root.quick-connect-clear-history(); }
                sftp-refresh() => { root.sftp-refresh(); }
                sftp-up() => { root.sftp-up(); }
                sftp-home() => { root.sftp-home(); }
                sftp-open-path(path) => { root.sftp-open-path(path); }
                sftp-open-crumb(index) => { root.sftp-open-crumb(index); }
                sftp-sort-by(column) => { root.sftp-sort-by(column); }
                sftp-toggle-hidden() => { root.sftp-toggle-hidden(); }
                sftp-select-row(index, ctrl, shift) => { root.sftp-select-row(index, ctrl, shift); }
                sftp-activate-row(index) => { root.sftp-activate-row(index); }
                sftp-context-menu-requested(index, x, y) => { root.sftp-context-menu-requested(index, x, y); }
                sftp-panel-menu-requested(x, y) => { root.sftp-panel-menu-requested(x, y); }
                sftp-save-edit() => { root.sftp-save-edit(); }
                sftp-cancel-edit() => { root.sftp-cancel-edit(); }
                sftp-drag-remote-transfer(key) => { return root.sftp-drag-remote-transfer(key); }
                sftp-drop-on-remote-row(index, data, action) => { root.sftp-drop-on-remote-row(index, data, action); }
                sftp-drop-on-remote-blank(data, action) => { root.sftp-drop-on-remote-blank(data, action); }
                sftp-local-up() => { root.sftp-local-up(); }
                sftp-local-home() => { root.sftp-local-home(); }
                sftp-local-refresh() => { root.sftp-local-refresh(); }
                sftp-local-open-path(path) => { root.sftp-local-open-path(path); }
                sftp-local-sort-by(column) => { root.sftp-local-sort-by(column); }
                sftp-local-toggle-hidden() => { root.sftp-local-toggle-hidden(); }
                sftp-local-select-row(index, ctrl, shift) => { root.sftp-local-select-row(index, ctrl, shift); }
                sftp-local-activate-row(index) => { root.sftp-local-activate-row(index); }
                sftp-local-context-menu-requested(index, x, y) => { root.sftp-local-context-menu-requested(index, x, y); }
                sftp-local-retry() => { root.sftp-local-retry(); }
                sftp-drag-local-transfer(key) => { return root.sftp-drag-local-transfer(key); }
                sftp-drop-on-local(data, action) => { root.sftp-drop-on-local(data, action); }
                sftp-copy-selection() => { root.sftp-copy-selection(); }
                sftp-cut-selection() => { root.sftp-cut-selection(); }
                sftp-paste-cross-pane() => { root.sftp-paste-cross-pane(); }
                sftp-column-ratio-changed(ratio) => { root.sftp-column-ratio-changed(ratio); }
            }
        }

        // QC 叠在对应叶子 terminal 内容区（几何由宿主按叶子归一化坐标写入）。
        // UI-1：host 8px padding 已移除，base 为 0；2px 内缩仅为避开叶描边。
        split_qc_page := QuickConnectPage {
            x: root.split-inner-w * root.split-qc-leaf-x + root.split-leaf-border;
            y: root.split-inner-h * root.split-qc-leaf-y + root.split-leaf-border + Theme.bar-height-tabs;
            width: !root.split-qc-shown ? 0px
                : root.split-inner-w * root.split-qc-leaf-w - 2 * root.split-leaf-border;
            height: !root.split-qc-shown ? 0px
                : root.split-inner-h * root.split-qc-leaf-h - 2 * root.split-leaf-border - Theme.bar-height-tabs;
            clip: true;
            input-text: root.quick-connect-input-text;
            input-error-text: root.quick-connect-error-text;
            summary-text: root.quick-connect-summary-text;
            history-enabled: root.quick-connect-history-enabled;
            last-target-text: root.quick-connect-last-target-text;
            recent-rows: root.quick-connect-rows;
            link-rows: root.quick-link-rows;
            input-changed(text) => {
                root.quick-connect-input-text = text;
                root.quick-connect-input-changed(text);
            }
            submit(text) => { root.quick-connect-submit(text); }
            connect-target(target) => { root.quick-connect-connect-target(target); }
            pin-target(target) => { root.quick-connect-pin-target(target); }
            copy-target(target) => { root.quick-connect-copy-target(target); }
            remove-link(id) => { root.quick-connect-remove-link(id); }
            save-as-session(target) => { root.quick-connect-save-as-session(target); }
            clear-history() => { root.quick-connect-clear-history(); }
        }
    }
}

// 终端右键菜单 Popup（宿主在窗口层级实例化）。
export component TerminalWorkspacePopups inherits Rectangle {
    in property <bool> open: false;
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    in property <[MenuEntry]> entries: [];

    callback selected(int);
    callback dismissed();

    // 作为 Window 直接子项（与拆分前的 MenuPopup 相同）：root 由 Slint 自动铺满
    // 窗口，内层 Popup 显式取父尺寸，保持锚点钳制与全屏 scrim 与拆分前一致。
    background: transparent;

    terminal_context_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open;
        entries: root.entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 200px;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(index); }
    }
}

// N0：标签右键菜单 Popup（与终端菜单同层级，宿主在窗口层级实例化）。
export component TabBarPopups inherits Rectangle {
    in property <bool> open: false;
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    in property <[MenuEntry]> entries: [];

    callback selected(int);
    callback dismissed();

    background: transparent;

    tab_context_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open;
        entries: root.entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 240px;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(index); }
    }
}
