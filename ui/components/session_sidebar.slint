// 左导航（NavigationView 形态）：会话栏主体 + 窄窗口图标条 + 宽度拖拽把手 +
// 三个右键菜单 Popup + New Folder 弹窗。
//
// 拆分自 `ui/main_window.slint`（R1 结构重构）：只搬代码，不改布局/文案/行为。
// 约定：
//   * 显隐/宽度/图标条判定（`nav-column-visible`/`nav-rail-visible`/
//     `nav-effective-width`）与拖拽状态仍由 main_window 持有，由宿主传入/回调上报。
//   * Popup 实例放在 `SessionSidebarPopups` 里，必须在 main_window 的
//     "内容之后、模态弹窗之前"实例化，保持原有绘制层级；open 判定用宿主的
//     `context_menu_token`（同一时刻只有一个右键菜单展开，与拆分前一致）。
//   * `@tr` 文案搬移后显式带上原组件上下文（`@tr("MainWindow" => ...)` /
//     `@tr("NewFolderDialog" => ...)`），保证 gettext 的 (msgctxt, msgid) 不变。
import { Theme } from "../theme.slint";
import { WinButton, WinCard, WinIconButton } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";
import { MenuEntry, MenuPopup } from "menu_popup.slint";
import { SessionTree, SessionTreeRow } from "session_tree.slint";

// S1：会话树空白区菜单的 `New Folder…` 弹窗正文 —— 只负责取名。
// 由 `new_folder_window.slint` + ToolWindowChrome 承载；标题由 chrome 提供。
//
// L2：`Esc` = Cancel（`canceled()`）；宿主据此清空名称。
export component NewFolderDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> message-text: @tr("Create a folder in the session tree root.");
    in-out property <string> name-text: "";
    /// P4：可覆盖占位（标签重命名勿再用 "Folder name"）。
    in property <string> placeholder-text: @tr("Folder name");
    in property <string> confirm-label: @tr("Create");
    in property <string> cancel-label: @tr("Cancel");
    callback confirmed(string);
    callback canceled();

    visible: root.open;
    background: transparent;

    dialog_scope := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.canceled();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            width: root.width;
            height: root.height;
            spacing: Theme.spacing-16;

            Text {
                text: root.message-text;
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            WinCard {
                vertical-stretch: 0;

                VerticalLayout {
                    spacing: Theme.spacing-8;

                    Text {
                        text: root.placeholder-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                    }

                    name_input := WinTextInput {
                        text <=> root.name-text;
                        placeholder-text: root.placeholder-text;
                        accepted => {
                            if (root.name-text != "") {
                                root.confirmed(root.name-text);
                            }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                background: transparent;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;
                vertical-stretch: 0;

                WinButton {
                    text: root.cancel-label;
                    clicked => { root.canceled(); }
                }

                WinButton {
                    text: root.confirm-label;
                    accent: true;
                    enabled: root.name-text != "";
                    clicked => { root.confirmed(root.name-text); }
                }
            }
        }
    }

    public function focus-dialog() {
        name_input.focus-input();
    }

    changed open => {
        if (root.open) {
            name_input.focus-input();
        }
    }
}

// 会话面板内容（N3）：标题条/折叠/⋯ 菜单由通用 `PanelFrame` 承担，本组件只渲染
// 搜索框 + SAVED + 会话树。
//
// 几何节奏与拆分前保持一致（PanelFrame 标题 44 + 内容 pad 12），保证会话树
// 行坐标不变。
export component SessionSidebarContent inherits Rectangle {
    /// 搜索词：与宿主窗口属性双向绑定（`<=>`）。
    in-out property <string> search-text: "";
    in property <[SessionTreeRow]> tree-rows: [];
    in property <string> selected-id: "";
    in property <string> empty-text: "";

    callback update-search(string);
    callback select-row(string);
    callback activate-row(string);
    callback toggle-folder(string);
    /// 会话树行右键：宿主负责"先选中再弹菜单"
    callback row-context-menu-requested(string, length, length);
    /// 会话树空白区/侧栏背景右键（S1）
    callback blank-menu-requested(length, length);
    /// A9：空白区左键 = 清空选中（契约 §5.2）。当前未接线：
    /// 需 `tool_dock.slint` 转发 → `main_window.clear_saved_session_selection()` → Rust。
    callback clear-selection();

    background: transparent;

    // ---------------------------------------------------- 小高度降级（PANEL-2）
    // 面板契约：搜索框（工具行）与 SAVED 标签（说明文字）是可隐藏的次级内容，
    // 会话树始终保留（SessionTree 自带 2 行 = 56px 的最小高度）。阈值由 token
    // 行高推导：
    //   96  = 搜索 32 + 间距 8 + 树 2 行 56（再低连搜索也让位，只留树）
    //   120 = 96 + SAVED 16 + 间距 8（>=120 才恢复 SAVED）
    // 120px 面板（PanelFrame 头 44 + 内容 padding 16 → 内容 60）下两者都隐藏，
    // 树仍有 60px；不会出现搜索框/标签把树挤出面板的半行裁切。
    private property <bool> shows-search: root.height >= Theme.control-height
        + Theme.spacing-8 + 2 * Theme.row-height-tree;
    private property <bool> shows-saved: root.shows-search
        && root.height >= Theme.control-height + 2 * Theme.spacing-8
            + Theme.line-caption + 2 * Theme.row-height-tree;

    // S1：左栏背景右键 = 会话树空白区菜单（树内空白处由 SessionTree
    // 自己上报；这里兜住树下方/侧栏其余空白）。
    // A9：左键 = 清空选中（与右键菜单同一片命中区）。
    TouchArea {
        clicked => { root.clear-selection(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.blank-menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
        }
    }

    // 侧栏节奏（§5.4）：内边距由 PanelFrame 的 `content-padding: 8` 提供；
    // A6：这里此前又加了一层 8px，实际内缩 16px，比其它面板深一格，去掉。
    VerticalLayout {
        spacing: Theme.spacing-8;
        alignment: start;

        WinTextInput {
            visible: root.shows-search;
            text <=> root.search-text;
            placeholder-text: @tr("MainWindow" => "Search sessions");
            edited => { root.update-search(self.text); }
        }

        // 已保存会话：完整树结构（展开/折叠、单击选中、双击打开、
        // 右键菜单、搜索过滤都在组件内完成；旧的多行文本投影不再渲染）
        Text {
            visible: root.shows-saved;
            text: @tr("MainWindow" => "SAVED");
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
        }

        SessionTree {
            // A7：吃掉面板剩余高度（不再有 320px 硬上限与树下死区）。
            vertical-stretch: 1;
            rows: root.tree-rows;
            selected-id: root.selected-id;
            empty-text: root.empty-text;
            select(id) => { root.select-row(id); }
            activate(id) => { root.activate-row(id); }
            toggle-folder(id) => { root.toggle-folder(id); }
            blank-clicked => { root.clear-selection(); }
            context-menu-requested(id, x, y) => {
                root.row-context-menu-requested(id, x, y);
            }
            blank-context-menu-requested(x, y) => {
                root.blank-menu-requested(x, y);
            }
        }
    }
}

// 左导航图标条（§4.2：<960px 折叠为 48px，可点按钮展开）。
export component SessionSidebarRail inherits Rectangle {
    /// 图标条空白处右键 → 最小菜单（New Session / 展开会话栏）
    callback rail-menu-requested(length, length);
    callback expand-navigation();

    // A25：图标条按钮的悬停提示文案（`Tooltip` 走 @markdown 插值）。
    private property <string> new-session-tooltip: @tr("MainWindow" => "New Session");
    private property <string> expand-navigation-tooltip: @tr("MainWindow" => "Expand navigation");

    width: Theme.nav-rail-width;
    background: Theme.layer-fill;

    // S1：图标条空白处右键 → 最小菜单（New Session / 展开会话栏）。
    TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.rail-menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: Theme.spacing-4;
        alignment: start;

        // A25（B 轮2 #54）：<960px 折叠成图标条后不再只剩一个 chevron ——
        // 这里至少给"新建会话"入口。按任务要求复用既有回调路径：`+` 打开图标条菜单
        // （第一项即 New Session），零跨组接线；一键直达的改动见 WS-A 报告请求。
        // Tooltip 必须挂在被悬停元素的子级，故用同尺寸容器包一层。
        Rectangle {
            width: Theme.control-height;
            height: Theme.control-height;
            background: transparent;

            WinIconButton {
                width: parent.width;
                height: parent.height;
                icon: "plus";
                accessible-name: @tr("MainWindow" => "New Session");
                clicked => {
                    // 菜单锚在按钮下方 4px，与图标条左缘对齐。
                    root.rail-menu-requested(
                        self.absolute-position.x,
                        self.absolute-position.y + self.height + Theme.spacing-4
                    );
                }
            }

            Tooltip {
                text: @markdown("\{root.new-session-tooltip}");
            }
        }

        // 展开会话栏（已有入口，A25 补 tooltip）
        Rectangle {
            width: Theme.control-height;
            height: Theme.control-height;
            background: transparent;

            WinIconButton {
                width: parent.width;
                height: parent.height;
                icon: "chevron-right";
                accessible-name: @tr("MainWindow" => "Expand navigation");
                clicked => { root.expand-navigation(); }
            }

            Tooltip {
                text: @markdown("\{root.expand-navigation-tooltip}");
            }
        }
    }
}

// 左导航拖拽把手（4px，悬停变色）；拖拽状态与宽度钳制仍在 main_window。
export component SessionSidebarHandle inherits Rectangle {
    in property <bool> dragging: false;

    /// 按下：上报指针窗口绝对 x（宿主记录锚点与起始宽度）
    callback drag-started(length);
    /// 拖动：上报指针窗口绝对 x（宿主换算新宽度）
    callback drag-moved(length);
    callback drag-finished();

    width: Theme.resize-handle-width;
    background: root.dragging || nav_resize_touch.has-hover ? Theme.accent : transparent;
    // 拖拽改变宽度即时生效（无动画）；只有悬停变色的 100ms 过渡
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    nav_resize_touch := TouchArea {
        mouse-cursor: col-resize;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.drag-started(self.absolute-position.x + self.mouse-x);
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.drag-finished();
                }
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-moved(self.absolute-position.x + self.mouse-x);
            }
        }
    }
}

// 左导航的三个右键菜单 Popup（会话树行 / 空白区 / 图标条）。
// 宿主在窗口层级实例化本组件；`selected(which, index)` 交给宿主 dispatch
// （which：0 = 行菜单、1 = 空白区菜单、2 = 图标条菜单）。
export component SessionSidebarPopups inherits Rectangle {
    in property <bool> row-menu-open: false;
    in property <bool> blank-menu-open: false;
    in property <bool> rail-menu-open: false;
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    in property <[MenuEntry]> row-entries: [];
    in property <[MenuEntry]> blank-entries: [];
    in property <[MenuEntry]> rail-entries: [];

    callback selected(int, int);
    callback dismissed();

    // 作为 Window 直接子项（与拆分前的 MenuPopup 相同）：root 由 Slint 自动铺满
    // 窗口，内层 Popup 显式取父尺寸，保持锚点钳制与全屏 scrim 与拆分前一致。
    background: transparent;

    saved_session_context_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.row-menu-open;
        entries: root.row-entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 230px;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(0, index); }
    }

    // S1：会话树空白区菜单（New Session / New Folder… / Refresh + 三个 disabled 项）。
    saved_session_blank_context_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.blank-menu-open;
        entries: root.blank-entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 250px;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(1, index); }
    }

    // S1：图标条最小菜单（New Session / 展开会话栏）。
    nav_rail_context_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.rail-menu-open;
        entries: root.rail-entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 220px;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(2, index); }
    }
}
