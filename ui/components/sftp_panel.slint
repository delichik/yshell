// SFTP 面板（N1 紧凑化 + 双栏 + 拖放 + 队列抽屉）。
//
// 结构（自上而下 / 窄宽上下叠放 / 宽面板左右并排）：
//   远端栏：components/file_pane.slint 的 FilePane（分段路径 + 列表 + 汇总）
//   传输抽屉：摘要一行（展开开关 + 计数 + Clear completed）→ 任务列表（行内操作）
//   本地栏：同一个 FilePane（本地数据）→ 两栏用的是同一个组件
//
// 规范：docs/product/ui-winui3-design-language.md §5.2 / §5.5 / §5.11 / §5.14
//       docs/product/context-menu-design.md §4（四套行菜单）/ §6（队列动作）
// 约定：颜色与尺寸只引用 Theme token；本文件导出 SftpPanel 与三个窗口级弹窗
//       （Entry / Conflict / Properties）以及行右键菜单 SftpContextMenu。
import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon } from "basic/icons.slint";
import { WinButton, WinIconButton, WinToggle } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";
import { MenuEntry, MenuPopup } from "menu_popup.slint";
import { FileCrumb, FilePane, FileRow, ListScrollBar } from "file_pane.slint";

export { FileCrumb, FileRow } from "file_pane.slint";

// ---------------------------------------------------------------- 数据结构

/// Slint-facing mirror of `runtime::transfer::TransferRowData`.
export struct SftpTransferRow {
    id: string,
    direction-id: string,
    direction-text: string,
    file-name-text: string,
    source-text: string,
    destination-text: string,
    status-id: string,
    status-text: string,
    progress-text: string,
    progress-percent: int,
    error-text: string,
    retry-count: int,
    max-retries: int,
    can-pause: bool,
    can-resume: bool,
    can-retry: bool,
    can-cancel: bool,
    can-remove: bool,
    is-active: bool,
    is-failed: bool,
    is-completed: bool,
}

// ---------------------------------------------------------------- 通用件

// 远端栏与本地栏都用 components/file_pane.slint 的 FilePane（同一个组件）。

// ---------------------------------------------------------------- 队列抽屉

/// 传输抽屉：摘要一行 + 展开后的任务列表（行内 pause/resume/retry/cancel/remove）。
component SftpTransferDrawer inherits Rectangle {
    in property <[SftpTransferRow]> rows;
    in property <bool> expanded: false;
    in property <int> total-count: 0;
    in property <int> active-count: 0;
    in property <int> paused-count: 0;
    in property <int> failed-count: 0;
    in property <int> completed-count: 0;
    in property <int> retryable-count: 0;
    /// PANEL-2：抽屉可占用的高度（SftpPanel 按剩余空间下发）。展开列表最多
    /// 分到「可用高度 − 摘要行」，低面板里不会再把内容撑出面板、盖住远端栏。
    in property <length> available-height: 100000px;

    private property <length> desired-list-height: root.rows.length == 0 ? 96px
        : min(root.rows.length * Theme.row-height-list + Theme.spacing-4, 240px);
    private property <length> available-list-height: max(0px,
        root.available-height - Theme.control-height);
    // PANEL-2：视口按行高整数倍对齐（保留 4px 底部余量），低面板收缩时
    // 也不会出现半行任务；不足一行时把列表归零（摘要行仍完整可见）。
    private property <length> expanded-list-height: min(
        root.desired-list-height,
        root.available-list-height < Theme.spacing-4 ? 0px
            : floor((root.available-list-height - Theme.spacing-4) / Theme.row-height-list)
                * Theme.row-height-list + Theme.spacing-4);

    callback toggle-expanded();
    callback pause(string);
    callback resume(string);
    callback retry(string);
    callback cancel(string);
    callback remove(string);
    callback clear-completed();

    background: Theme.layer-fill;
    border-radius: Theme.radius-control;

    VerticalLayout {
        spacing: 0;

        // --- 摘要行 ------------------------------------------------------
        HorizontalLayout {
            height: Theme.control-height;
            padding-left: Theme.spacing-8;
            padding-right: Theme.spacing-4;
            spacing: Theme.spacing-4;

            WinIconButton {
                icon: root.expanded ? "chevron-down" : "chevron-right";
                accessible-name: root.expanded ? @tr("Hide transfers") : @tr("Show transfers");
                clicked => { root.toggle-expanded(); }
            }

            // 固定尺寸容器：Icon 直接放在布局里会被布局改成 0 宽，软件渲染器
            // 对 0 尺寸图片会算出 NaN 并 panic（与 WinIconButton 同形）。
            Rectangle {
                width: Theme.icon-size-small;
                vertical-stretch: 1;
                background: transparent;

                Icon {
                    name: "download";
                    icon-color: Theme.text-secondary;
                    icon-size: Theme.icon-size-small;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Text {
                text: root.summary-text();
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // 图标按钮而非文字按钮：文字按钮（≈96px）会把摘要挤到只剩
            // "N 个任务 · N 进行中 · …"，丢掉「已暂停/失败/已完成」（B4）。
            // 用 `clear` 而非 `trash`，与行内「移除任务」区分。
            if root.completed-count > 0 : WinIconButton {
                icon: "clear";
                accessible-name: @tr("Clear completed");
                clicked => { root.clear-completed(); }
            }
        }

        // --- 展开的任务列表 ----------------------------------------------
        if root.expanded : Rectangle {
            clip: true;
            // 空队列展开也要有明确反馈（B3）：0 条时固定 96px 的空态区，
            // 而不是旧的 `min(0*32+4, 240) = 4px`；有条目时按行数取高。
            // PANEL-2：最终高度再受 `available-height` 约束，低面板下宁可
            // 列表变矮（仍可滚动）也不把抽屉底边裁出面板。
            height: root.expanded-list-height;

            if root.rows.length == 0 : Text {
                text: @tr("No transfer tasks yet");
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                x: Theme.spacing-8;
                width: parent.width - 2 * Theme.spacing-8;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            transfer_list := ListView {
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                for row[index] in root.rows : Rectangle {
                    height: Theme.row-height-list;
                    border-radius: Theme.radius-control;
                    background: row.is-failed ? Theme.attention-background
                        : Math.mod(index, 2) == 0 ? transparent : Theme.card-fill;

                    Text {
                        x: Theme.spacing-8;
                        y: 0;
                        width: 90px;
                        height: parent.height;
                        text: row.direction-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    // 文件名盒的右边界 = 进度列左边界 - 间距，两盒不再相交（B1）。
                    Text {
                        x: 98px;
                        y: 0;
                        width: max(0px, parent.width - 98px - root.action-width(row)
                            - root.progress-column-width - 2 * Theme.spacing-8);
                        height: parent.height;
                        text: row.file-name-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    // P3：与 Transfers 面板一致——进度条 + 状态文案。
                    VerticalLayout {
                        x: parent.width - root.action-width(row) - root.progress-column-width - Theme.spacing-8;
                        y: (parent.height - self.preferred-height) / 2;
                        width: root.progress-column-width;
                        spacing: 2px;
                        alignment: center;

                        if !row.is-failed : Rectangle {
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.control-stroke;
                            clip: true;

                            Rectangle {
                                width: parent.width * max(0, min(100, row.progress-percent)) / 100;
                                height: parent.height;
                                background: Theme.accent;
                                border-radius: 2px;
                            }
                        }

                        Text {
                            text: row.is-failed ? row.status-text : row.progress-text;
                            color: row.is-failed ? Theme.critical : Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            horizontal-alignment: right;
                            wrap: no-wrap;
                            overflow: elide;
                            width: parent.width;
                        }
                    }

                    // 行内动作：按状态显示可用的队列操作。
                    HorizontalLayout {
                        x: parent.width - root.action-width(row);
                        y: 0;
                        width: root.action-width(row);
                        height: parent.height;
                        spacing: 0;
                        alignment: end;

                        if row.can-pause : WinIconButton {
                            icon: "pause";
                            accessible-name: @tr("Pause transfer");
                            clicked => { root.pause(row.id); }
                        }
                        if row.can-resume : WinIconButton {
                            icon: "play";
                            accessible-name: @tr("Resume transfer");
                            clicked => { root.resume(row.id); }
                        }
                        if row.can-retry : WinIconButton {
                            icon: "refresh";
                            accessible-name: @tr("Retry transfer");
                            clicked => { root.retry(row.id); }
                        }
                        if row.can-cancel : WinIconButton {
                            icon: "close";
                            accessible-name: @tr("Cancel transfer");
                            clicked => { root.cancel(row.id); }
                        }
                        if row.can-remove : WinIconButton {
                            icon: "trash";
                            accessible-name: @tr("Remove transfer");
                            clicked => { root.remove(row.id); }
                        }
                    }
                }
            }

            // 自绘滚动条（B8）：与文件列表同一形态。
            ListScrollBar {
                x: parent.width - self.width;
                y: 0;
                height: parent.height;
                content-height: transfer_list.content-height;
                visible-height: transfer_list.visible-height;
                content-y <=> transfer_list.content-y;
                scroll-enabled: transfer_list.enabled;
            }
        }
    }

    /// P3：进度条 + 状态文案列。
    private property <length> progress-column-width: 76px;

    /// 该行实际可见的动作按钮数（最多 3 个：pause/retry/cancel 等互斥组合）。
    pure function action-count(row: SftpTransferRow) -> int {
        return (row.can-pause ? 1 : 0) + (row.can-resume ? 1 : 0) + (row.can-retry ? 1 : 0)
             + (row.can-cancel ? 1 : 0) + (row.can-remove ? 1 : 0);
    }

    /// 动作列宽按该行实际可见的按钮数计算（1/2/3 个 → 32/64/96px，B2）：
    /// 不再恒定预留 3×32，1 个按钮时右侧不留 64px 死区。
    pure function action-width(row: SftpTransferRow) -> length {
        return root.action-count(row) * Theme.control-height;
    }

    /// 摘要只列非零字段：字段全列时在 340px 面板里必然被省略号截掉
    /// 「已暂停/失败/已完成」（B4）。零任务时退化为 "0 transfer(s)"。
    pure function summary-text() -> string {
        return @tr("{0} transfer(s)", root.total-count)
            + (root.active-count > 0 ? @tr(" · {0} active", root.active-count) : "")
            + (root.paused-count > 0 ? @tr(" · {0} paused", root.paused-count) : "")
            + (root.failed-count > 0 ? @tr(" · {0} failed", root.failed-count) : "")
            + (root.completed-count > 0 ? @tr(" · {0} completed", root.completed-count) : "");
    }
}

// ---------------------------------------------------------------- 主面板

/// 双栏 SFTP 面板：远端栏 + 传输抽屉 + 本地栏（宽面板并排、窄面板上下叠放）。
export component SftpPanel inherits Rectangle {
    // 远端投影
    in property <[FileRow]> rows;
    in property <[FileCrumb]> crumbs;
    in property <int> selected-index: -1;
    in property <string> session-status-text: "";
    in property <string> sort-column: "name";
    in property <bool> sort-ascending: true;
    in property <string> sort-text: "Name ↑";
    in property <bool> show-hidden: false;
    in property <int> item-count: 0;
    in property <int> dir-count: 0;
    in property <int> selected-count: 0;
    in property <string> empty-text: "";
    in property <string> error-text: "";
    in property <bool> connected: false;
    in property <bool> remote-edit-active: false;
    in property <string> remote-edit-text: "";
    in-out property <string> path-text: "/";
    // 本地栏投影
    in property <[FileRow]> local-rows;
    in property <[FileCrumb]> local-crumbs;
    in property <string> local-path-text: "/";
    in property <bool> local-show-hidden: false;
    in property <string> local-sort-column: "name";
    in property <bool> local-sort-ascending: true;
    in property <string> local-sort-text: "Name ↑";
    in property <int> local-item-count: 0;
    in property <int> local-dir-count: 0;
    in property <int> local-selected-count: 0;
    in property <string> local-empty-text: "";
    in property <string> local-error-text: "";
    in property <bool> local-retry-visible: true;
    in property <bool> local-collapsed: false;
    in property <string> local-title-text: "";
    in property <string> local-selected-name-text: "";
    /// 本地栏已独立为 Local panel：默认不在 SFTP 内嵌（避免与停靠面板重复）。
    in property <bool> show-local: false;
    /// SFTP tab mode: always render the two columns (local left, remote right),
    /// even when the pane is narrow. No stacked/collapsed fallback.
    in property <bool> fixed-two-column: false;
    /// Left (local) column share, 0.2..0.8. Default 1:1.
    in property <float> column-ratio: 0.5;
    /// Show the transfer drawer. SFTP tabs use false; the standalone Transfers
    /// dock panel owns the queue.
    in property <bool> show-transfers: true;
    /// Local/remote split callback (sent while dragging the divider).
    callback column-ratio-changed(float);
    /// 本地/远端选择路径串（data 绑定依赖；载荷由宿主生成）。
    in property <string> local-selection-key: "";
    in property <string> sftp-selection-key: "";
    // 传输抽屉投影
    in property <[SftpTransferRow]> transfer-rows;
    in property <bool> transfer-expanded: false;
    in property <int> transfer-total-count: 0;
    in property <int> transfer-active-count: 0;
    in property <int> transfer-paused-count: 0;
    in property <int> transfer-failed-count: 0;
    in property <int> transfer-completed-count: 0;
    in property <int> transfer-retryable-count: 0;

    // --- 远端回调 ---------------------------------------------------------
    callback refresh();
    callback up();
    callback home();
    callback open-path(string);
    callback open-crumb(int);
    callback sort-by(string);
    callback toggle-hidden();
    callback select-row(int, bool, bool);
    callback activate-row(int);
    callback context-menu-requested(int, length, length);
    callback panel-menu-requested(length, length);
    callback save-edit();
    callback cancel-edit();
    pure callback drag-remote-transfer(string) -> data-transfer;
    callback drop-on-remote-row(int, data-transfer, DragAction);
    callback drop-on-remote-blank(data-transfer, DragAction);
    // --- 本地回调 ---------------------------------------------------------
    callback local-toggle-collapsed();
    callback local-up();
    callback local-home();
    callback local-refresh();
    callback local-open-path(string);
    callback local-sort-by(string);
    callback local-toggle-hidden();
    callback local-select-row(int, bool, bool);
    callback local-activate-row(int);
    callback local-context-menu-requested(int, length, length);
    callback local-redirect-requested();
    callback local-retry();
    pure callback drag-local-transfer(string) -> data-transfer;
    callback drop-on-local(data-transfer, DragAction);
    // --- 队列抽屉 ---------------------------------------------------------
    callback transfer-toggle-expanded();
    callback transfer-pause(string);
    callback transfer-resume(string);
    callback transfer-retry(string);
    callback transfer-cancel(string);
    callback transfer-remove(string);
    callback transfer-clear-completed();
    // --- 键盘剪贴板 -------------------------------------------------------
    callback copy-selection();
    callback cut-selection();
    callback paste-cross-pane();

    background: transparent;
    // 内容按可用高度分配；极端窄高时不再画到卡片外（B9）。
    clip: true;

    /// 宽面板（并排）阈值：两栏各 ≥ 280px；固定双栏模式不参与该判断。
    private property <bool> side-by-side: root.show-local && (root.fixed-two-column || root.width >= 600px);
    /// Left column width (local). Fixed two-column keeps it within the pane.
    private property <length> local-column-width: max(120px,
        min(root.width - 126px, root.width * clamp(root.column-ratio, 0.2, 0.8)));
    /// 传输抽屉的期望高度（摘要行 + 展开列表）。
    private property <length> drawer-desired-height: root.transfer-expanded
        ? Theme.control-height + (root.transfer-rows.length == 0 ? 96px
            : min(root.transfer-rows.length * Theme.row-height-list + Theme.spacing-4, 240px))
        : Theme.control-height;
    /// 面板内容区高度（扣掉上下内边距）。
    private property <length> content-space: max(0px, root.height - 2 * Theme.spacing-8);
    /// 叠放模式可分配给子块的总高度（再扣两个 4px 间隔）。
    private property <length> stacked-space: max(0px, root.content-space - 2 * Theme.spacing-4);
    /// 并排模式可分配的总高度（再扣一个 4px 间隔）。
    private property <length> side-space: max(0px, root.content-space - Theme.spacing-4);
    /// 远端栏压缩下限：面包屑/路径/列头/汇总 + 两行列表。
    private property <length> remote-min-height: 124px + 2 * Theme.row-height-list;
    /// PANEL-2：为远端栏保留的最低高度 = 头部 32 + 间距 4 + 汇总行 16。
    /// 低于此时 SftpRemotePane 会隐藏头部，只保留底部汇总行（列表 0 行）。
    /// 抽屉展开时先满足这个下限，再按剩余空间压缩任务列表，避免底边越界。
    private property <length> remote-reserve-height: Theme.control-height
        + Theme.spacing-4 + Theme.line-caption;
    /// 抽屉最多能占的高度：内容区 − 一个间隔 − 远端栏保留高度（不小于摘要行）。
    private property <length> drawer-available-height: max(Theme.control-height,
        root.content-space - Theme.spacing-4 - root.remote-reserve-height);
    /// 抽屉展开列表的期望高度（与 SftpTransferDrawer 内部公式一致）。
    private property <length> drawer-desired-list-height: max(0px,
        root.drawer-desired-height - Theme.control-height);
    private property <length> drawer-available-list-height: max(0px,
        root.drawer-available-height - Theme.control-height);
    /// PANEL-2：展开列表按行高整数倍收缩（与抽屉内部一致的 4px 底部余量），
    /// 保证「预留高度 == 抽屉首选高度」，不会把抽屉底边或远端栏挤出面板。
    private property <length> drawer-list-height: min(
        root.drawer-desired-list-height,
        root.drawer-available-list-height < Theme.spacing-4 ? 0px
            : floor((root.drawer-available-list-height - Theme.spacing-4)
                / Theme.row-height-list) * Theme.row-height-list + Theme.spacing-4);
    /// 抽屉占位高度（与 SftpTransferDrawer 的 available-height 一致）。
    private property <length> drawer-reserve-height: root.show-transfers
        ? Theme.control-height + root.drawer-list-height
        : 0px;
    /// 本地栏展开态下限：头部/路径/列头/汇总 + 一行列表。
    private property <length> local-min-height: 140px + Theme.row-height-list;
    /// 极端矮高：远端栏最小内容（124px）+ 抽屉 + 48px 紧凑条都放不下时，
    /// 本地栏让位（高度归零），避免远端栏内容画到抽屉/本地栏上（B9）。
    private property <bool> stacked-remote-fits: root.stacked-space - root.drawer-reserve-height
        >= 124px + 48px;
    /// 可用高度不足时本地栏退化为 48px 紧凑条（保留标题/当前路径/折叠入口），
    /// 而不是被挤到卡片外或静默消失（B9）。
    private property <bool> local-compact: root.local-collapsed
        || !root.stacked-remote-fits
        || root.stacked-space - root.drawer-reserve-height - root.remote-min-height < root.local-min-height;
    /// 本地栏展开时的期望高度（原 1/3 比例）。
    private property <length> local-preferred-block: root.local-compact
        ? 48px
        : max(root.local-min-height, root.height * 0.34);
    /// 远端栏先按「固定内容 + 整数行列表」取整高度（空间紧张时可 0 行，
    /// 下限是 124px 的固定内容），本地栏吃剩余高度；余量（<32px）落在本地栏
    /// 内部底部，不会出现在远端汇总行与传输条之间。
    private property <int> stacked-remote-rows: clamp(
        round(floor((root.stacked-space - root.drawer-reserve-height - root.local-preferred-block - 124px) / Theme.row-height-list)),
        0, 24);
    /// 叠放时远端栏高度（无内嵌本地栏时吃满剩余空间，并扣掉与抽屉之间的间隔；
    /// 旧实现漏扣这个 4px，抽屉底边会被 SftpPanel 的 clip 裁掉一条）。
    private property <length> stacked-remote-height: !root.show-local
        ? max(0px, root.content-space - root.drawer-reserve-height - Theme.spacing-4)
        : 124px + Theme.row-height-list * root.stacked-remote-rows;
    /// 本地栏高度 = 剩余高度（紧凑态下限 48px；放不下时归零，见 stacked-remote-fits）。
    /// PANEL-2：不再用 `max(local-min-block, …)` 强行抬高——低高度下让本地栏
    /// 拿真实剩余高度，由 FilePane 自己的降级布局兜底，避免把抽屉顶出面板。
    private property <length> local-section-height: !root.stacked-remote-fits ? 0px
        : max(0px, root.stacked-space - root.drawer-reserve-height - root.stacked-remote-height);
    /// 并排两栏的高度（扣掉抽屉）。
    private property <length> column-height: max(0px, root.side-space - root.drawer-reserve-height);
    /// 本地栏折叠开关：固定双栏模式不提供折叠。
    private property <bool> local-toggle-enabled: !root.fixed-two-column
        && (root.side-by-side
            || root.stacked-space - root.drawer-reserve-height - root.remote-min-height >= root.local-min-height);

    // 键盘剪贴板：Ctrl+C/X/V（跨栏语义见 runtime::clipboard）。
    pane_scope := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == "c") {
                    root.copy-selection();
                    return accept;
                }
                if (event.text == "x") {
                    root.cut-selection();
                    return accept;
                }
                if (event.text == "v") {
                    root.paste-cross-pane();
                    return accept;
                }
            }
            return reject;
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        VerticalLayout {
            // 与 sftp_panel 旧版一致：左右 4px 内边距，列表行与卡片标题对齐。
            padding-left: Theme.spacing-4;
            padding-right: Theme.spacing-4;
            padding-top: Theme.spacing-8;
            padding-bottom: Theme.spacing-8;
            spacing: Theme.spacing-4;

            if root.side-by-side : HorizontalLayout {
                height: root.column-height;
                spacing: 0px;

                // Fixed order: local on the left, remote on the right.
                if root.show-local : FilePane {
                    width: root.local-column-width;
                    height: root.column-height;
                    rows: root.local-rows;
                    crumbs: root.local-crumbs;
                    path-text: root.local-path-text;
                    path-placeholder-text: "/local/path";
                    show-hidden: root.local-show-hidden;
                    sort-column: root.local-sort-column;
                    sort-ascending: root.local-sort-ascending;
                    sort-text: root.local-sort-text;
                    item-count: root.local-item-count;
                    dir-count: root.local-dir-count;
                    selected-count: root.local-selected-count;
                    empty-text: root.local-empty-text;
                    error-text: root.local-error-text;
                    retry-visible: root.local-retry-visible;
                    collapsed: root.fixed-two-column ? false : root.local-collapsed;
                    toggle-enabled: root.local-toggle-enabled;
                    title-text: root.local-title-text;
                    selected-name-text: root.local-selected-name-text;
                    show-home-button: true;
                    toggle-collapsed => { root.local-toggle-collapsed(); }
                    home => { root.local-home(); }
                    refresh => { root.local-refresh(); }
                    open-path(path) => { root.local-open-path(path); }
                    sort-by(column) => { root.local-sort-by(column); }
                    toggle-hidden => { root.local-toggle-hidden(); }
                    select-row(index, ctrl, shift) => { root.local-select-row(index, ctrl, shift); }
                    activate-row(index) => { root.local-activate-row(index); }
                    context-menu-requested(index, x, y) => { root.local-context-menu-requested(index, x, y); }
                    retry => { root.local-retry(); }
                    selection-key: root.local-selection-key;
                    drag-payload(key) => { return root.drag-local-transfer(key); }
                    drop-on-blank(data, action) => { root.drop-on-local(data, action); }
                    focus-requested => { pane_scope.focus(); }
                }

                // Local/remote divider. Dragging sends the new left share to the
                // host; the ratio is per SFTP tab, not persisted.
                Rectangle {
                    width: 6px;
                    height: root.column-height;
                    background: transparent;

                    Rectangle {
                        x: 2.5px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.divider;
                    }

                    TouchArea {
                        x: -3px;
                        width: 12px;
                        height: 100%;
                        mouse-cursor: MouseCursor.col-resize;
                        moved => {
                            if (self.pressed) {
                                root.column-ratio-changed(clamp(
                                    ((self.absolute-position.x + self.mouse-x) - root.absolute-position.x) / 1px
                                        / Math.max(root.width / 1px, 1.0),
                                    0.2,
                                    0.8
                                ));
                            }
                        }
                    }
                }

                FilePane {
                    horizontal-stretch: 1;
                    // 高度由面板显式给出（而非布局反推）：栏内列表按整数行对齐时
                    // 不会形成布局回环（B7/B9）。
                    height: root.column-height;
                    rows: root.rows;
                    crumbs: root.crumbs;
                    selected-index: root.selected-index;
                    sort-column: root.sort-column;
                    sort-ascending: root.sort-ascending;
                    sort-text: root.sort-text;
                    show-hidden: root.show-hidden;
                    item-count: root.item-count;
                    dir-count: root.dir-count;
                    selected-count: root.selected-count;
                    empty-text: root.empty-text;
                    error-text: root.error-text;
                    connected: root.connected;
                    remote-edit-active: root.remote-edit-active;
                    remote-edit-text: root.remote-edit-text;
                    title-text: @tr("Remote");
                    path-placeholder-text: "/remote/path";
                    show-panel-menu: true;
                    path-text <=> root.path-text;
                    focus-requested => { pane_scope.focus(); }
                    refresh => { root.refresh(); }
                    home => { root.home(); }
                    open-path(path) => { root.open-path(path); }
                    open-crumb(index) => { root.open-crumb(index); }
                    sort-by(column) => { root.sort-by(column); }
                    toggle-hidden => { root.toggle-hidden(); }
                    select-row(index, ctrl, shift) => { root.select-row(index, ctrl, shift); }
                    activate-row(index) => { root.activate-row(index); }
                    context-menu-requested(index, x, y) => { root.context-menu-requested(index, x, y); }
                    panel-menu-requested(x, y) => { root.panel-menu-requested(x, y); }
                    save-edit => { root.save-edit(); }
                    cancel-edit => { root.cancel-edit(); }
                    selection-key: root.sftp-selection-key;
                    drag-payload(key) => { return root.drag-remote-transfer(key); }
                    drop-on-row(index, data, action) => { root.drop-on-remote-row(index, data, action); }
                    drop-on-blank(data, action) => { root.drop-on-remote-blank(data, action); }
                }
            }

            if !root.side-by-side : FilePane {
                height: root.stacked-remote-height;
                rows: root.rows;
                crumbs: root.crumbs;
                selected-index: root.selected-index;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                sort-text: root.sort-text;
                show-hidden: root.show-hidden;
                item-count: root.item-count;
                dir-count: root.dir-count;
                selected-count: root.selected-count;
                empty-text: root.empty-text;
                error-text: root.error-text;
                connected: root.connected;
                remote-edit-active: root.remote-edit-active;
                remote-edit-text: root.remote-edit-text;
                title-text: @tr("Remote");
                path-placeholder-text: "/remote/path";
                show-panel-menu: true;
                path-text <=> root.path-text;
                focus-requested => { pane_scope.focus(); }
                refresh => { root.refresh(); }
                home => { root.home(); }
                open-path(path) => { root.open-path(path); }
                open-crumb(index) => { root.open-crumb(index); }
                sort-by(column) => { root.sort-by(column); }
                toggle-hidden => { root.toggle-hidden(); }
                select-row(index, ctrl, shift) => { root.select-row(index, ctrl, shift); }
                activate-row(index) => { root.activate-row(index); }
                context-menu-requested(index, x, y) => { root.context-menu-requested(index, x, y); }
                panel-menu-requested(x, y) => { root.panel-menu-requested(x, y); }
                save-edit => { root.save-edit(); }
                cancel-edit => { root.cancel-edit(); }
                selection-key: root.sftp-selection-key;
                drag-payload(key) => { return root.drag-remote-transfer(key); }
                drop-on-row(index, data, action) => { root.drop-on-remote-row(index, data, action); }
                drop-on-blank(data, action) => { root.drop-on-remote-blank(data, action); }
            }

            if root.show-transfers : SftpTransferDrawer {
                rows: root.transfer-rows;
                expanded: root.transfer-expanded;
                available-height: root.drawer-reserve-height;
                total-count: root.transfer-total-count;
                active-count: root.transfer-active-count;
                paused-count: root.transfer-paused-count;
                failed-count: root.transfer-failed-count;
                completed-count: root.transfer-completed-count;
                retryable-count: root.transfer-retryable-count;
                toggle-expanded => { root.transfer-toggle-expanded(); }
                pause(id) => { root.transfer-pause(id); }
                resume(id) => { root.transfer-resume(id); }
                retry(id) => { root.transfer-retry(id); }
                cancel(id) => { root.transfer-cancel(id); }
                remove(id) => { root.transfer-remove(id); }
                clear-completed => { root.transfer-clear-completed(); }
            }

            if root.show-local && !root.side-by-side : FilePane {
                height: root.local-section-height;
                rows: root.local-rows;
                crumbs: root.local-crumbs;
                path-text: root.local-path-text;
                path-placeholder-text: "/local/path";
                show-hidden: root.local-show-hidden;
                sort-column: root.local-sort-column;
                sort-ascending: root.local-sort-ascending;
                sort-text: root.local-sort-text;
                item-count: root.local-item-count;
                dir-count: root.local-dir-count;
                selected-count: root.local-selected-count;
                empty-text: root.local-empty-text;
                error-text: root.local-error-text;
                retry-visible: root.local-retry-visible;
                collapsed: root.local-compact;
                toggle-enabled: root.local-toggle-enabled;
                title-text: root.local-title-text;
                selected-name-text: root.local-selected-name-text;
                show-home-button: true;
                toggle-collapsed => { root.local-toggle-collapsed(); }
                home => { root.local-home(); }
                refresh => { root.local-refresh(); }
                open-path(path) => { root.local-open-path(path); }
                sort-by(column) => { root.local-sort-by(column); }
                toggle-hidden => { root.local-toggle-hidden(); }
                select-row(index, ctrl, shift) => { root.local-select-row(index, ctrl, shift); }
                activate-row(index) => { root.local-activate-row(index); }
                context-menu-requested(index, x, y) => { root.local-context-menu-requested(index, x, y); }
                retry => { root.local-retry(); }
                selection-key: root.local-selection-key;
                drag-payload(key) => { return root.drag-local-transfer(key); }
                drop-on-blank(data, action) => { root.drop-on-local(data, action); }
                focus-requested => { pane_scope.focus(); }
            }
        }
    }
}

// ---------------------------------------------------------------- 右键菜单

/// SFTP 上下文菜单（context-menu-design.md §4 四套 + 本地栏两套）。
///
/// 由宿主按右键位置传入 `target-kind` 与启用条件；条目文案与索引→动作 id 的
/// 映射都集中在这里，宿主只消费语义 id（`selected(string)`）。
export component SftpContextMenu inherits Rectangle {
    in property <bool> open: false;
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    /// file / dir / multi / blank / local / local-blank
    in property <string> target-kind: "blank";
    in property <bool> connected: false;
    in property <bool> has-selection: false;
    in property <bool> clipboard-has-remote: false;
    in property <bool> clipboard-has-local: false;
    in property <bool> show-hidden: false;
    in property <bool> remote-edit-active: false;

    callback selected(string);
    callback dismissed();

    visible: self.open;
    background: transparent;

    private property <[MenuEntry]> file-entries: [
        { label: @tr("Open"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Edit Remote File"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Download"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Download To..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Copy To..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Rename..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Delete..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Chmod..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Copy"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Copy Remote Path"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Properties"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") }
    ];

    private property <[MenuEntry]> dir-entries: [
        { label: @tr("Open"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Download"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Download To..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Copy To..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Upload Here..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("New Folder"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Rename..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Delete..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Chmod..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Copy"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Copy Remote Path"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Properties"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") }
    ];

    private property <[MenuEntry]> blank-entries: [
        { label: @tr("Upload Files..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("New Folder"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Refresh"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Show Hidden Files"), shortcut: "", enabled: true, checked: root.show-hidden, separator: false },
        { label: @tr("Copy Current Path"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Paste"), shortcut: "", enabled: root.clipboard-has-local, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Parent directory"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        // 行为是 `open_sftp_path("/")`（远端根），不是登录用户家目录，文案如实描述（B12）。
        { label: @tr("Root directory (/)"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Switch to Terminal"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") }
    ];

    private property <[MenuEntry]> multi-entries: [
        { label: @tr("Download Selected"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Copy To..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Delete Selected"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Chmod Selected..."), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Copy"), shortcut: "", enabled: root.connected, checked: false, separator: false },
        { label: @tr("Copy Remote Paths"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") }
    ];

    private property <[MenuEntry]> local-entries: [
        { label: @tr("Upload to Remote"), shortcut: "", enabled: root.connected && root.has-selection, checked: false, separator: false },
        { label: @tr("Move to Remote"), shortcut: "", enabled: root.connected && root.has-selection, checked: false, separator: false },
        { label: @tr("Copy"), shortcut: "", enabled: root.has-selection, checked: false, separator: false },
        { label: @tr("Copy Path"), shortcut: "", enabled: root.has-selection, checked: false, separator: false },
        { label: @tr("Delete Selected"), shortcut: "", enabled: root.has-selection, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Refresh"), shortcut: "", enabled: true, checked: false, separator: false },
        { label: @tr("Show Hidden Files"), shortcut: "", enabled: true, checked: root.show-hidden, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Switch to Terminal"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") }
    ];

    /// 本地栏空白处：与"选中文件"菜单分开（此前两者共用一套，导致空白处右键
    /// 弹出的也是文件菜单）。
    private property <[MenuEntry]> local-blank-entries: [
        { label: @tr("Refresh"), shortcut: "", enabled: true, checked: false, separator: false },
        { label: @tr("Show Hidden Files"), shortcut: "", enabled: true, checked: root.show-hidden, separator: false },
        { label: @tr("Copy Current Path"), shortcut: "", enabled: true, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Paste"), shortcut: "", enabled: root.clipboard-has-remote, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Switch to Terminal"), shortcut: "", enabled: root.connected, checked: false, separator: false, tooltip: root.connected ? "" : @tr("Connect to the remote host first.") }
    ];

    private property <[MenuEntry]> entries: root.target-kind == "file" ? root.file-entries
        : root.target-kind == "dir" ? root.dir-entries
        : root.target-kind == "multi" ? root.multi-entries
        : root.target-kind == "local" ? root.local-entries
        : root.target-kind == "local-blank" ? root.local-blank-entries
        : root.blank-entries;

    pure function action(index: int) -> string {
        if (root.target-kind == "file") {
            return root.file-action(index);
        }
        if (root.target-kind == "dir") {
            return root.dir-action(index);
        }
        if (root.target-kind == "multi") {
            return root.multi-action(index);
        }
        if (root.target-kind == "local") {
            return root.local-action(index);
        }
        if (root.target-kind == "local-blank") {
            return root.local-blank-action(index);
        }
        return root.blank-action(index);
    }

    pure function file-action(index: int) -> string {
        if (index == 0) { return "open"; }
        if (index == 1) { return "edit"; }
        if (index == 2) { return "download"; }
        if (index == 3) { return "download-to"; }
        if (index == 4) { return "copy-to"; }
        if (index == 6) { return "rename"; }
        if (index == 7) { return "delete"; }
        if (index == 8) { return "chmod"; }
        if (index == 10) { return "copy"; }
        if (index == 11) { return "copy-path"; }
        if (index == 13) { return "properties"; }
        return "";
    }

    pure function dir-action(index: int) -> string {
        if (index == 0) { return "open"; }
        if (index == 1) { return "download"; }
        if (index == 2) { return "download-to"; }
        if (index == 3) { return "copy-to"; }
        if (index == 4) { return "upload-here"; }
        if (index == 5) { return "new-folder"; }
        if (index == 7) { return "rename"; }
        if (index == 8) { return "delete"; }
        if (index == 9) { return "chmod"; }
        if (index == 11) { return "copy"; }
        if (index == 12) { return "copy-path"; }
        if (index == 14) { return "properties"; }
        return "";
    }

    pure function blank-action(index: int) -> string {
        if (index == 0) { return "upload"; }
        if (index == 1) { return "new-folder"; }
        if (index == 3) { return "refresh"; }
        if (index == 4) { return "toggle-hidden"; }
        if (index == 5) { return "copy-path-current"; }
        if (index == 7) { return "paste-into-remote"; }
        if (index == 9) { return "up"; }
        if (index == 10) { return "home"; }
        if (index == 11) { return "switch-to-terminal"; }
        return "";
    }

    pure function multi-action(index: int) -> string {
        if (index == 0) { return "download"; }
        if (index == 1) { return "copy-to"; }
        if (index == 2) { return "delete"; }
        if (index == 3) { return "chmod"; }
        if (index == 5) { return "copy"; }
        if (index == 6) { return "copy-path"; }
        return "";
    }

    pure function local-action(index: int) -> string {
        if (index == 0) { return "upload-selection"; }
        if (index == 1) { return "move-selection"; }
        if (index == 2) { return "copy-local"; }
        if (index == 3) { return "copy-local-path"; }
        if (index == 4) { return "delete-local-selection"; }
        if (index == 6) { return "local-refresh"; }
        if (index == 7) { return "local-toggle-hidden"; }
        if (index == 9) { return "switch-to-terminal"; }
        return "";
    }

    pure function local-blank-action(index: int) -> string {
        if (index == 0) { return "local-refresh"; }
        if (index == 1) { return "local-toggle-hidden"; }
        if (index == 2) { return "copy-local-path-current"; }
        if (index == 4) { return "paste-into-local"; }
        if (index == 6) { return "switch-to-terminal"; }
        return "";
    }

    menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open;
        entries: root.entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 240px;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(root.action(index)); }
    }
}

// ---------------------------------------------------------------- 输入弹窗

/// 输入类操作弹窗（New Folder / Rename / Chmod / Delete / Upload 路径回退 /
/// Download 目标 / Copy To 目标）。宿主在窗口层级实例化以便居中且不被面板裁剪。
export component SftpEntryDialog inherits Rectangle {
    in property <bool> open: false;
    /// new-folder / rename / chmod / delete / upload / download / copy-to
    in property <string> kind: "none";
    in property <string> selected-name-text: "";
    in property <string> selected-path-text: "";
    in property <int> selected-count: 0;
    in-out property <string> name-text: "";
    in-out property <string> permissions-text: "644";
    in-out property <string> local-path-text: "";

    callback create-folder(string);
    callback rename-selected(string);
    callback delete-selected();
    callback chmod-selected(string);
    callback upload-selected(string);
    callback download-selected(string);
    callback copy-to-selected(string);
    callback canceled();

    function is-name-kind() -> bool {
        return root.kind == "new-folder" || root.kind == "rename";
    }

    function shows-local-path() -> bool {
        return root.kind == "upload" || root.kind == "download" || root.kind == "copy-to";
    }

    function shows-delete-summary() -> bool {
        return root.kind == "delete";
    }

    function title-text() -> string {
        if (root.kind == "new-folder") { return @tr("New Folder"); }
        if (root.kind == "rename") { return @tr("Rename"); }
        if (root.kind == "chmod") { return @tr("Change Permissions"); }
        if (root.kind == "delete") { return @tr("Delete"); }
        if (root.kind == "upload") { return @tr("Upload File"); }
        if (root.kind == "download") { return @tr("Download"); }
        if (root.kind == "copy-to") { return @tr("Copy To..."); }
        return @tr("SFTP");
    }

    function hint-text() -> string {
        if (root.kind == "new-folder") { return @tr("Relative names are created inside the current remote directory."); }
        if (root.kind == "rename") { return @tr("Relative names stay inside the current remote directory."); }
        if (root.kind == "chmod") { return @tr("Three-digit octal permissions, for example 644 or 755."); }
        if (root.kind == "delete") {
            return root.selected-count > 1
                ? @tr("This permanently removes the {0} selected remote entries, directories recursively.", root.selected-count)
                : @tr("This permanently removes the remote entry.");
        }
        if (root.kind == "upload") { return @tr("Uploads the local file or directory into the current remote directory using its name."); }
        if (root.kind == "download") { return @tr("Downloads the selected remote entries into this local directory."); }
        if (root.kind == "copy-to") { return @tr("Downloads to a temporary copy and uploads it into this remote directory."); }
        return "";
    }

    function name-label() -> string {
        if (root.kind == "new-folder") { return @tr("Folder name"); }
        return @tr("New name");
    }

    function local-label() -> string {
        if (root.kind == "upload") { return @tr("Local file or directory"); }
        if (root.kind == "copy-to") { return @tr("Remote destination directory"); }
        return @tr("Local destination directory");
    }

    function primary-label() -> string {
        if (root.kind == "new-folder") { return @tr("Create Folder"); }
        if (root.kind == "rename") { return @tr("Rename"); }
        if (root.kind == "chmod") { return @tr("Apply"); }
        if (root.kind == "delete") { return @tr("Delete"); }
        if (root.kind == "upload") { return @tr("Upload"); }
        if (root.kind == "download") { return @tr("Download"); }
        if (root.kind == "copy-to") { return @tr("Copy"); }
        return @tr("Run");
    }

    function primary-enabled() -> bool {
        if (root.is-name-kind()) { return root.name-text != ""; }
        if (root.kind == "chmod") { return root.permissions-text != ""; }
        if (root.shows-local-path()) { return root.local-path-text != ""; }
        return true;
    }

    function confirm() {
        if (root.kind == "new-folder") { root.create-folder(root.name-text); }
        else if (root.kind == "rename") { root.rename-selected(root.name-text); }
        else if (root.kind == "chmod") { root.chmod-selected(root.permissions-text); }
        else if (root.kind == "delete") { root.delete-selected(); }
        else if (root.kind == "upload") { root.upload-selected(root.local-path-text); }
        else if (root.kind == "download") { root.download-selected(root.local-path-text); }
        else if (root.kind == "copy-to") { root.copy-to-selected(root.local-path-text); }
    }

    visible: self.open;
    background: Theme.scrim;

    dialog_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            // 破坏性弹窗（删除）不响应 Esc：只能在弹窗内显式选择操作（B23，
            // 设计语言 §5.10 / 契约 §1.2）。Esc 被吞掉，不冒泡给窗口。
            if (event.text == "\u{001b}") {
                if (root.kind != "delete") {
                    root.canceled();
                }
                return accept;
            }
            return reject;
        }

        // 遮罩点击关闭：仅非破坏性弹窗（B23）；同时保留命中层，吃掉点击，
        // 避免点穿到弹窗后面的面板。
        TouchArea {
            clicked => {
                if (root.kind != "delete") {
                    root.canceled();
                }
            }
        }

        Rectangle {
            x: (parent.width - 520px) / 2;
            y: max((parent.height - self.height) / 2, 40px);
            width: 520px;
            height: body.preferred-height;
            background: Theme.panel-background;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.control-stroke;

            TouchArea { }

            body := VerticalLayout {
                padding: Theme.spacing-20;
                spacing: 10px;

                Text {
                    text: root.title-text();
                    color: Theme.text-primary;
                    font-size: Theme.font-subtitle;
                    font-weight: Theme.weight-semibold;
                }

                Text {
                    text: root.hint-text();
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }

                if root.shows-delete-summary() : VerticalLayout {
                    spacing: Theme.spacing-4;

                    Text {
                        text: root.selected-count > 1
                            ? @tr("{0} entries", root.selected-count)
                            : root.selected-name-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-semibold;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    if root.selected-count <= 1 : Text {
                        text: root.selected-path-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                }

                if root.is-name-kind() : VerticalLayout {
                    spacing: Theme.spacing-4;

                    Text { text: root.name-label(); color: Theme.text-secondary; font-size: Theme.font-body; }
                    WinTextInput {
                        text <=> root.name-text;
                        placeholder-text: root.kind == "new-folder" ? "new-folder" : "new-name";
                    }
                }

                if root.kind == "chmod" : VerticalLayout {
                    spacing: Theme.spacing-4;

                    Text { text: @tr("Permissions (octal)"); color: Theme.text-secondary; font-size: Theme.font-body; }
                    WinTextInput {
                        text <=> root.permissions-text;
                        placeholder-text: "644";
                    }
                }

                if root.shows-local-path() : VerticalLayout {
                    spacing: Theme.spacing-4;

                    Text { text: root.local-label(); color: Theme.text-secondary; font-size: Theme.font-body; }
                    WinTextInput {
                        text <=> root.local-path-text;
                        placeholder-text: root.kind == "copy-to" ? "/remote/dir" : "/local/path";
                        font-family: Theme.font-mono;
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-8;

                    WinButton {
                        text: @tr("Cancel");
                        clicked => { root.canceled(); }
                    }

                    WinButton {
                        text: root.primary-label();
                        // 破坏性主按钮（Delete）用 critical 文案色 + 常态底，
                        // 不用蓝色强调实底（设计语言 §5.1 / B 轮2 #46，B22）；
                        // 与 ConfirmDialog 的 destructive 判定同形（critical 优先）。
                        accent: root.kind != "delete";
                        critical: root.kind == "delete";
                        enabled: root.primary-enabled();
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }

    public function focus-dialog() {
        dialog_scope.focus();
    }

    changed open => {
        if (root.open) {
            dialog_scope.focus();
        }
    }
}

// ---------------------------------------------------------------- 冲突弹窗

/// Ask 策略下的覆盖冲突：列出冲突路径，让用户选择后续策略并重跑。
export component SftpConflictDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> source-text: "";
    in property <string> destination-text: "";
    in property <int> conflict-count: 0;
    in property <string> conflict-paths-text: "";

    callback resolve(string);
    callback canceled();

    visible: self.open;
    background: Theme.scrim;

    dialog_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            // 覆盖冲突弹窗属于破坏性确认（Overwrite 会替换目标文件）：
            // 不响应 Esc，只能点按钮显式选择策略或取消（B23）。
            if (event.text == "\u{001b}") {
                return accept;
            }
            return reject;
        }

        // 遮罩点击不关闭冲突弹窗（设计语言 §5.10：遮罩点击仅非破坏性弹窗，B23）；
        // 空 TouchArea 仍吃掉点击，避免点穿到下面的面板。
        TouchArea { }

        Rectangle {
            x: (parent.width - 560px) / 2;
            y: max((parent.height - self.height) / 2, 40px);
            width: 560px;
            height: body.preferred-height;
            background: Theme.panel-background;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.control-stroke;

            TouchArea { }

            body := VerticalLayout {
                padding: Theme.spacing-20;
                spacing: 10px;

                Text {
                    text: @tr("Resolve name conflicts");
                    color: Theme.text-primary;
                    font-size: Theme.font-subtitle;
                    font-weight: Theme.weight-semibold;
                }

                Text {
                    text: @tr("{0} destination path(s) already exist.", root.conflict-count);
                    color: Theme.caution;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr("{0} → {1}", root.source-text, root.destination-text);
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: min(120px, conflicts-text.preferred-height + 2 * Theme.spacing-8);
                    background: Theme.control-fill;
                    border-radius: Theme.radius-control;
                    border-width: 1px;
                    border-color: Theme.control-stroke;
                    clip: true;

                    conflicts-text := Text {
                        x: Theme.spacing-8;
                        y: Theme.spacing-8;
                        width: parent.width - 2 * Theme.spacing-8;
                        text: root.conflict-paths-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                }

                Text {
                    text: @tr("Overwrite replaces them, Rename keeps both by adding a number, Skip leaves them untouched.");
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-8;

                    WinButton {
                        text: @tr("Cancel");
                        clicked => { root.canceled(); }
                    }
                    WinButton {
                        text: @tr("Skip");
                        clicked => { root.resolve("skip"); }
                    }
                    WinButton {
                        text: @tr("Rename");
                        clicked => { root.resolve("rename"); }
                    }
                    WinButton {
                        text: @tr("Overwrite");
                        accent: true;
                        clicked => { root.resolve("overwrite"); }
                    }
                }
            }
        }
    }

    public function focus-dialog() {
        dialog_scope.focus();
    }

    changed open => {
        if (root.open) {
            dialog_scope.focus();
        }
    }
}

// ---------------------------------------------------------------- 属性弹窗

/// 条目属性（Permissions/Modified 在窄宽列表里隐藏后从这里查看）。
export component SftpPropertiesDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> name-text: "";
    in property <string> path-text: "";
    in property <string> kind-text: "";
    in property <string> size-text: "";
    in property <string> modified-text: "";
    in property <string> permissions-text: "";

    callback copy-path();
    callback canceled();

    visible: self.open;
    background: Theme.scrim;

    dialog_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.canceled();
                return accept;
            }
            return reject;
        }

        TouchArea {
            clicked => { root.canceled(); }
        }

        Rectangle {
            x: (parent.width - 480px) / 2;
            y: max((parent.height - self.height) / 2, 40px);
            width: 480px;
            height: body.preferred-height;
            background: Theme.panel-background;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.control-stroke;

            TouchArea { }

            body := VerticalLayout {
                padding: Theme.spacing-20;
                spacing: 10px;

                Text {
                    text: @tr("Properties");
                    color: Theme.text-primary;
                    font-size: Theme.font-subtitle;
                    font-weight: Theme.weight-semibold;
                }

                GridLayout {
                    spacing: Theme.spacing-8;

                    Text { text: @tr("Name"); color: Theme.text-secondary; font-size: Theme.font-body; }
                    Text { text: root.name-text; color: Theme.text-primary; font-size: Theme.font-body; wrap: no-wrap; overflow: elide; }

                    Text { text: @tr("Path"); color: Theme.text-secondary; font-size: Theme.font-body; }
                    Text { text: root.path-text; color: Theme.text-primary; font-size: Theme.font-body; wrap: word-wrap; }

                    Text { text: @tr("Kind"); color: Theme.text-secondary; font-size: Theme.font-body; }
                    Text { text: root.kind-text; color: Theme.text-primary; font-size: Theme.font-body; }

                    Text { text: @tr("Size"); color: Theme.text-secondary; font-size: Theme.font-body; }
                    Text { text: root.size-text; color: Theme.text-primary; font-size: Theme.font-body; }

                    Text { text: @tr("Modified"); color: Theme.text-secondary; font-size: Theme.font-body; }
                    Text { text: root.modified-text; color: Theme.text-primary; font-size: Theme.font-body; }

                    Text { text: @tr("Permissions"); color: Theme.text-secondary; font-size: Theme.font-body; }
                    Text { text: root.permissions-text; color: Theme.text-primary; font-size: Theme.font-body; }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-8;

                    WinButton {
                        text: @tr("Copy Path");
                        clicked => { root.copy-path(); }
                    }
                    WinButton {
                        text: @tr("Close");
                        accent: true;
                        clicked => { root.canceled(); }
                    }
                }
            }
        }
    }

    public function focus-dialog() {
        dialog_scope.focus();
    }

    changed open => {
        if (root.open) {
            dialog_scope.focus();
        }
    }
}
