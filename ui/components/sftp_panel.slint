// SFTP 面板（WinUI 3 / Fluent 2 形态）。
//
// 结构（自上而下）：导航工具行 → 操作工具行 → 面包屑 → 路径输入 → 列头 → 文件列表
//                  → 远程编辑行（可选）→ 状态/汇总行。
// 规范：docs/product/ui-winui3-design-language.md §5.2 / §5.5 / §5.11 / §5.14
// 约定：颜色与尺寸只引用 Theme token；下方 `export` 属性/回调是主窗口与 Rust 的契约，
//      名字与类型保持不变（只新增了带默认值的可选 `session-connected`）。
import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon } from "basic/icons.slint";
import { WinButton, WinIconButton, WinListRow } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

// Slint-facing mirrors of the runtime SFTP row/crumb data.

export struct SftpRow {
    name: string,
    kind-text: string,
    size-text: string,
    modified-text: string,
    permissions-text: string,
    is-dir: bool,
}

export struct SftpCrumb {
    label: string,
    path: string,
}

// 可点击排序的列头：28px 高、caption 字号；排序列 text-primary + ↑/↓，其余 text-tertiary。
component SftpColumnHeader inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> ascending: true;
    in property <bool> right-aligned: false;
    callback activated();

    height: Theme.row-height-tree;
    border-radius: Theme.radius-control;
    background: header-touch.has-hover ? Theme.subtle-hover : transparent;

    Text {
        // 排序指示箭头属于文案：走 @tr 模板（§7.2 禁止在 Slint 里拼接成句）
        text: root.active
            ? (root.ascending ? @tr("{0} ↑", root.label) : @tr("{0} ↓", root.label))
            : root.label;
        color: root.active ? Theme.text-primary : Theme.text-tertiary;
        font-size: Theme.font-caption;
        font-weight: root.active ? Theme.weight-semibold : 400;
        x: 0;
        width: parent.width;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: root.right-aligned ? right : left;
        wrap: no-wrap;
        overflow: elide;
    }

    header_touch := TouchArea {
        clicked => { root.activated(); }
    }
}

// Single-column remote file manager: navigation toolbar, clickable breadcrumbs,
// action toolbar, sortable column headers, a virtualized ListView and the
// remote edit status line. Dialogs live in `SftpEntryDialog` so they can center
// on the window instead of being clipped to the narrow side panel.
export component SftpPanel inherits Rectangle {
    in property <[SftpRow]> rows;
    in property <[SftpCrumb]> crumbs;
    in property <int> selected-index: -1;
    in property <string> session-status-text: "";
    in property <string> sort-column: "name";
    in property <bool> sort-ascending: true;
    in property <string> sort-text: "Name ↑";
    in property <bool> show-hidden: false;
    in property <string> item-summary-text: "";
    /// 汇总行计数（Rust 只投影数字；单复数与句子由下方 item-summary-display 组装）。
    in property <int> item-count: 0;
    in property <int> dir-count: 0;
    in property <string> empty-text: "";
    in property <string> selected-name-text: "";
    in property <string> remote-edit-text: "";
    in property <bool> remote-edit-active: false;
    in-out property <string> path-text: "/";
    /// 新增（可选）：SFTP 会话是否已连接。主窗口暂未提供布尔值，默认 false 时状态点
    /// 用 text-tertiary（断开色）；绑定为 true 后状态点显示 success 绿点。
    in property <bool> session-connected: false;

    callback refresh();
    callback up();
    callback home();
    callback open-path(string);
    callback open-crumb(int);
    callback sort-by(string);
    callback toggle-hidden();
    callback select-row(int);
    callback activate-row(int);
    callback context-menu-requested(int, length, length);
    callback new-folder();
    callback upload();
    callback download();
    callback edit-remote();
    callback rename();
    callback delete();
    callback chmod();
    callback save-edit();
    callback cancel-edit();

    private property <bool> has-selection: root.selected-index >= 0;
    // 元数据列宽 + 列间距（Size / Modified / Permissions）：列头与数据行共用同一组值，
    // 避免两处漂移。296px 内容宽下的分配：Name 72 · Size 56 · Modified 96 · Perm 56，列间 8px。
    // theme.slint 暂无列宽 token，故集中在这里。
    private property <length> column-gap: Theme.spacing-8;
    private property <length> column-size-width: 56px;
    private property <length> column-modified-width: 96px;
    private property <length> column-permissions-width: 56px;
    // 元数据区总宽 = Size + gap + Modified + gap + Permissions
    private property <length> meta-width: root.column-size-width + root.column-gap
        + root.column-modified-width + root.column-gap + root.column-permissions-width;

    // 汇总行："{n} item(s) · {m} dir(s)"。复数用 @tr 模板，分隔符复用现有 msgid；
    // Rust 只投影计数，禁止在 Slint 里拼接成句（§7.2）。context 即组件名 SftpPanel。
    private property <string> item-summary-display:
        @tr("{0} · {1}",
            @tr("{n} item" | "{n} items" % root.item-count),
            @tr("{n} dir" | "{n} dirs" % root.dir-count));

    // Draws the "/" between two breadcrumbs without indexing out of bounds.
    pure function shows-crumb-separator(index: int) -> bool {
        if (index <= 0) {
            return false;
        }
        return root.crumbs[index - 1].label != "/";
    }

    // 卡片外壳（main_window）已提供 card-fill 表面，面板自身不再叠一层底色。
    background: transparent;

    // Panel background right click: keeps the selection, offers New Folder/Refresh.
    TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context-menu-requested(
                    -1,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y
                );
            }
        }
    }

    VerticalLayout {
        // 左右 4px：与卡片标题行（main_window 里 x = 12px）对齐，列表行也靠这个内边距
        padding-left: Theme.spacing-4;
        padding-right: Theme.spacing-4;
        padding-top: Theme.spacing-8;
        padding-bottom: Theme.spacing-8;
        spacing: Theme.spacing-4;

        // --- 工具行 1：导航（上一级 / 刷新 / 远端根目录）+ 隐藏文件开关 -----
        HorizontalLayout {
            height: Theme.control-height;
            spacing: Theme.spacing-4;

            WinIconButton {
                icon: "up";
                accessible-name: @tr("Parent directory");
                clicked => { root.up(); }
            }
            WinIconButton {
                icon: "refresh";
                accessible-name: @tr("Refresh");
                clicked => { root.refresh(); }
            }
            // 图标集里没有 home，用 globe 表示"远端根目录"
            WinIconButton {
                icon: "globe";
                accessible-name: @tr("Remote root directory");
                clicked => { root.home(); }
            }

            // 显式 stretch：Slint 在"没有人声明 stretch"时会平均分配剩余宽度，
            // 会让按钮被拉宽；这里让弹簧独占剩余空间，按钮保持内容宽度。
            nav_toolbar_spacer := Rectangle { horizontal-stretch: 1; }

            // 开关型动作：开启态用强调色实底表达（避免依赖会被内部赋值打断的双向绑定）
            WinButton {
                text: root.show-hidden ? @tr("Hidden: on") : @tr("Hidden: off");
                icon: "eye";
                accent: root.show-hidden;
                clicked => { root.toggle-hidden(); }
            }
        }

        // --- 工具行 2：文件操作（禁用态跟随选择）----------------------------
        HorizontalLayout {
            height: Theme.control-height;
            spacing: Theme.spacing-4;

            WinIconButton {
                icon: "plus";
                accessible-name: @tr("New folder");
                clicked => { root.new-folder(); }
            }
            WinIconButton {
                icon: "upload";
                accessible-name: @tr("Upload file");
                clicked => { root.upload(); }
            }
            WinIconButton {
                icon: "download";
                accessible-name: @tr("Download selected entry");
                enabled: root.has-selection;
                clicked => { root.download(); }
            }
            WinIconButton {
                icon: "edit";
                accessible-name: @tr("Edit remote file");
                enabled: root.has-selection;
                clicked => { root.edit-remote(); }
            }
            WinIconButton {
                icon: "trash";
                accessible-name: @tr("Delete selected entry");
                enabled: root.has-selection;
                clicked => { root.delete(); }
            }
            WinIconButton {
                icon: "shield";
                accessible-name: @tr("Change permissions");
                enabled: root.has-selection;
                clicked => { root.chmod(); }
            }

            action_toolbar_spacer := Rectangle { horizontal-stretch: 1; }
        }

        // --- 面包屑：当前段用主文本色，其余次文本色 -------------------------
        Rectangle {
            height: Theme.row-height-tree;
            background: Theme.control-fill;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.control-stroke;
            clip: true;

            HorizontalLayout {
                padding-left: Theme.spacing-4;
                padding-right: Theme.spacing-4;
                spacing: 0;

                for crumb[i] in root.crumbs : HorizontalLayout {
                    spacing: 0;

                    if root.shows-crumb-separator(i) : Text {
                        text: "/";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                    }

                    crumb_hit := Rectangle {
                        border-radius: Theme.radius-control;
                        background: crumb_hit_touch.has-hover ? Theme.subtle-hover : transparent;

                        HorizontalLayout {
                            padding-left: Theme.spacing-4;
                            padding-right: Theme.spacing-4;

                            Text {
                                text: crumb.label;
                                color: i == root.crumbs.length - 1 ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                                wrap: no-wrap;
                            }
                        }

                        crumb_hit_touch := TouchArea {
                            clicked => { root.open-crumb(i); }
                        }
                    }
                }

                // 面包屑左对齐：末尾弹簧吃掉剩余宽度（否则各段会被剩余宽度平均拉散）
                crumbs_spacer := Rectangle { horizontal-stretch: 1; }
            }
        }

        // --- 路径输入：WinTextInput（回车打开）-------------------------------
        // 自绘输入框自带 control-fill 底 / control-stroke 描边 / 聚焦强调条（§5.2），
        // 不再需要外层容器；placeholder 是路径格式示例，不翻译。
        WinTextInput {
            text <=> root.path-text;
            placeholder-text: "/remote/path";
            accepted => { root.open-path(self.text); }
        }

        // --- 列头 + 1px 分隔线（点击列头排序）-------------------------------
        Rectangle {
            height: Theme.row-height-tree;
            background: transparent;

            SftpColumnHeader {
                x: 0;
                width: parent.width - root.meta-width;
                height: parent.height;
                label: @tr("Name");
                active: root.sort-column == "name";
                ascending: root.sort-ascending;
                activated => { root.sort-by("name"); }
            }

            SftpColumnHeader {
                x: parent.width - root.meta-width;
                width: root.column-size-width;
                height: parent.height;
                label: @tr("Size");
                active: root.sort-column == "size";
                ascending: root.sort-ascending;
                right-aligned: true;
                activated => { root.sort-by("size"); }
            }

            SftpColumnHeader {
                x: parent.width - root.column-permissions-width - root.column-gap - root.column-modified-width;
                width: root.column-modified-width;
                height: parent.height;
                label: @tr("Modified");
                active: root.sort-column == "modified";
                ascending: root.sort-ascending;
                right-aligned: true;
                activated => { root.sort-by("modified"); }
            }

            SftpColumnHeader {
                x: parent.width - root.column-permissions-width;
                width: root.column-permissions-width;
                height: parent.height;
                // 短标签：56px 列宽放不下 "Permissions"（英文长标签会贴边/省略）
                label: @tr("Perm");
                active: root.sort-column == "permissions";
                ascending: root.sort-ascending;
                right-aligned: true;
                activated => { root.sort-by("permissions"); }
            }

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                // 浮层内表头下沿：divider 比 layer-stroke 强一档
                background: Theme.divider;
            }
        }

        // --- 文件列表（ListView 虚拟化，空态居中提示）-----------------------
        Rectangle {
            clip: true;
            vertical-stretch: 1;

            Text {
                visible: root.rows.length == 0;
                text: root.empty-text;
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                x: Theme.spacing-8;
                width: parent.width - 2 * Theme.spacing-8;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            ListView {
                for row[index] in root.rows : Rectangle {
                    height: Theme.row-height-list;
                    border-radius: Theme.radius-control;
                    // 选中 > 悬停；WinListRow 自身背景保持透明（见下方注释），
                    // 整行底色由这一层统一绘制，右侧元数据列同底色。
                    background: index == root.selected-index ? Theme.subtle-selected
                        : row_hit.has-hover ? Theme.subtle-hover
                        : transparent;

                    // 行图标：文件夹 / 文件（选中时转强调色，与 WinListRow 选中态一致）
                    Icon {
                        name: row.is-dir ? "folder" : "file";
                        icon-color: index == root.selected-index ? Theme.accent : Theme.text-secondary;
                        icon-size: Theme.icon-size-small;
                        x: 0;
                        y: (parent.height - self.height) / 2;
                    }

                    // 文件名：由 WinListRow 提供省略号与垂直居中；它自己的左内边距正好是
                    // 图标与文件名之间的 8px 间隔，右内边距让它不贴住元数据列。
                    WinListRow {
                        x: Theme.icon-size-small;
                        y: 0;
                        width: parent.width - root.meta-width - Theme.icon-size-small;
                        height: parent.height;
                        text: row.name;
                        // 底色 / 图标 / 悬停都由整行与独立图标表达，避免两层状态色叠加
                        selected: false;
                        alternate: false;
                    }

                    // 右侧元数据列：与列头共用 x / 宽度与对齐方式（三列都右对齐）
                    Text {
                        x: parent.width - root.meta-width;
                        width: root.column-size-width;
                        height: parent.height;
                        text: row.size-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    Text {
                        x: parent.width - root.column-permissions-width - root.column-gap - root.column-modified-width;
                        width: root.column-modified-width;
                        height: parent.height;
                        text: row.modified-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    Text {
                        x: parent.width - root.column-permissions-width;
                        width: root.column-permissions-width;
                        height: parent.height;
                        text: row.permissions-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    // 覆盖整行的命中区：单击选中 / 双击激活 / 右键（先选中再弹菜单）。
                    // WinListRow 自带的 TouchArea 只覆盖名称格且无法上报右键，故由它统一接管。
                    row_hit := TouchArea {
                        clicked => { root.select-row(index); }
                        double-clicked => { root.activate-row(index); }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                root.select-row(index);
                                root.context-menu-requested(
                                    index,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y
                                );
                            }
                        }
                    }
                }
            }
        }

        // --- 远程编辑进行中：caution 文案 + 保存/取消 ------------------------
        if root.remote-edit-active : HorizontalLayout {
            height: Theme.control-height;
            spacing: Theme.spacing-4;

            Text {
                text: root.remote-edit-text;
                color: Theme.caution;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }
            WinButton {
                text: @tr("Save Edit");
                accent: true;
                clicked => { root.save-edit(); }
            }
            WinButton {
                text: @tr("Cancel Edit");
                clicked => { root.cancel-edit(); }
            }
        }

        // --- 状态行 + 汇总行（§5.14：8px 圆点 + caption 文本）---------------
        Rectangle {
            height: 2 * Theme.line-caption + 2 * Theme.spacing-4;
            background: Theme.layer-fill;
            border-radius: Theme.radius-control;

            VerticalLayout {
                padding-left: Theme.spacing-8;
                padding-right: Theme.spacing-8;
                padding-top: Theme.spacing-4;
                padding-bottom: Theme.spacing-4;
                spacing: 0;

                // 会话状态：连接态 success 绿点，未连接/未知 text-tertiary 灰点
                HorizontalLayout {
                    height: Theme.line-caption;
                    spacing: Theme.spacing-8;

                    Rectangle {
                        width: Theme.spacing-8;
                        vertical-stretch: 1;
                        background: transparent;

                        Rectangle {
                            width: Theme.spacing-8;
                            height: Theme.spacing-8;
                            border-radius: Theme.spacing-4;
                            y: (parent.height - self.height) / 2;
                            background: root.session-connected ? Theme.success : Theme.text-tertiary;
                        }
                    }

                    Text {
                        text: root.session-status-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }

                Text {
                    // 汇总行：item/dir 计数与分隔符都在本组件内用 @tr 组装；
                    // sort-text / selected-name-text 已由 MainWindow 模板化。
                    text: root.selected-name-text != ""
                        ? @tr("{0} · selected: {1} · {2}", root.item-summary-display, root.selected-name-text, root.sort-text)
                        : @tr("{0} · {1}", root.item-summary-display, root.sort-text);
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }
    }
}

// Light modal used by the SFTP panel for New Folder / Rename / Chmod / Delete /
// Upload / Download. MainWindow instantiates it so it centers on the window and
// blocks the whole app like the other dialogs.
export component SftpEntryDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> kind: "none";
    in property <string> selected-name-text: "";
    in property <string> selected-path-text: "";
    in-out property <string> name-text: "";
    in-out property <string> permissions-text: "644";
    in-out property <string> local-path-text: "";

    callback create-folder(string);
    callback rename-selected(string);
    callback delete-selected();
    callback chmod-selected(string);
    callback upload-selected(string);
    callback download-selected(string);
    callback canceled();

    function is-name-kind() -> bool {
        return root.kind == "new-folder" || root.kind == "rename";
    }

    function shows-local-path() -> bool {
        return root.kind == "upload" || root.kind == "download";
    }

    function title-text() -> string {
        if (root.kind == "new-folder") { return @tr("New Folder"); }
        if (root.kind == "rename") { return @tr("Rename"); }
        if (root.kind == "chmod") { return @tr("Change Permissions"); }
        if (root.kind == "delete") { return @tr("Delete"); }
        if (root.kind == "upload") { return @tr("Upload File"); }
        if (root.kind == "download") { return @tr("Download File"); }
        return @tr("SFTP");
    }

    function hint-text() -> string {
        if (root.kind == "new-folder") { return @tr("Relative names are created inside the current remote directory."); }
        if (root.kind == "rename") { return @tr("Relative names stay inside the current remote directory."); }
        if (root.kind == "chmod") { return @tr("Three-digit octal permissions, for example 644 or 755."); }
        if (root.kind == "delete") { return @tr("This permanently removes the remote entry."); }
        if (root.kind == "upload") { return @tr("Uploads into the current remote directory using the local file name."); }
        if (root.kind == "download") { return @tr("Downloads the selected remote entry to this local path."); }
        return "";
    }

    function name-label() -> string {
        if (root.kind == "new-folder") { return @tr("Folder name"); }
        return @tr("New name");
    }

    function local-label() -> string {
        if (root.kind == "upload") { return @tr("Local file to upload"); }
        return @tr("Local destination path");
    }

    function primary-label() -> string {
        if (root.kind == "new-folder") { return @tr("Create Folder"); }
        if (root.kind == "rename") { return @tr("Rename"); }
        if (root.kind == "chmod") { return @tr("Apply"); }
        if (root.kind == "delete") { return @tr("Delete"); }
        if (root.kind == "upload") { return @tr("Upload"); }
        if (root.kind == "download") { return @tr("Download"); }
        return @tr("Run");
    }

    function primary-enabled() -> bool {
        if (root.is-name-kind()) { return root.name-text != ""; }
        if (root.kind == "chmod") { return root.permissions-text != ""; }
        if (root.shows-local-path()) { return root.local-path-text != ""; }
        return true;
    }

    function confirm() {
        if (root.kind == "new-folder") { root.create-folder(root.name-text); }
        else if (root.kind == "rename") { root.rename-selected(root.name-text); }
        else if (root.kind == "chmod") { root.chmod-selected(root.permissions-text); }
        else if (root.kind == "delete") { root.delete-selected(); }
        else if (root.kind == "upload") { root.upload-selected(root.local-path-text); }
        else if (root.kind == "download") { root.download-selected(root.local-path-text); }
    }

    visible: self.open;
    background: Theme.scrim;

    // Block interaction with the content behind the modal.
    TouchArea { }

    Rectangle {
        x: (parent.width - 520px) / 2;
        y: max((parent.height - self.height) / 2, 40px);
        width: 520px;
        height: body.preferred-height;
        background: Theme.panel-background;
        border-radius: Theme.radius-panel;
        border-width: 1px;
        border-color: Theme.control-stroke;

        body := VerticalLayout {
            padding: Theme.spacing-20;
            spacing: 10px;

            Text {
                text: root.title-text();
                color: Theme.text-primary;
                font-size: Theme.font-subtitle;
                font-weight: Theme.weight-semibold;
            }

            Text {
                text: root.hint-text();
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }

            if root.kind == "delete" : VerticalLayout {
                spacing: Theme.spacing-4;

                Text {
                    text: root.selected-name-text;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-semibold;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Text {
                    text: root.selected-path-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }

            if root.is-name-kind() : VerticalLayout {
                spacing: Theme.spacing-4;

                Text { text: root.name-label(); color: Theme.text-secondary; font-size: Theme.font-body; }
                // WinTextInput 自带 control-fill 底 + control-stroke 描边 + 聚焦强调条；
                // placeholder 是示例名（非 UI 文案），不翻译。
                WinTextInput {
                    text <=> root.name-text;
                    placeholder-text: root.kind == "new-folder" ? "new-folder" : "new-name";
                }
            }

            if root.kind == "chmod" : VerticalLayout {
                spacing: Theme.spacing-4;

                Text { text: @tr("Permissions (octal)"); color: Theme.text-secondary; font-size: Theme.font-body; }
                WinTextInput {
                    text <=> root.permissions-text;
                    placeholder-text: "644";
                }
            }

            if root.shows-local-path() : VerticalLayout {
                spacing: Theme.spacing-4;

                Text { text: root.local-label(); color: Theme.text-secondary; font-size: Theme.font-body; }
                WinTextInput {
                    text <=> root.local-path-text;
                    placeholder-text: "/local/path";
                }
            }

            // 操作区：右对齐、主操作在右（§5.10），全部用自绘 WinButton
            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;

                WinButton {
                    text: @tr("Cancel");
                    clicked => { root.canceled(); }
                }

                WinButton {
                    text: root.primary-label();
                    accent: true;
                    enabled: root.primary-enabled();
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
