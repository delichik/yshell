// Find Across SSH — cross-session match sidebar (terminal.html).
import { Theme } from "../theme.slint";

export struct FindAcrossMatchRow {
    tab-id: string,
    title: string,
    snippet: string,
    match-count: int,
}

export component FindAcrossPanel inherits Rectangle {
    in property <[FindAcrossMatchRow]> rows: [];
    in property <int> selected-index: -1;

    callback row-selected(int);

    width: 240px;
    background: Theme.window-background;

    Rectangle {
        x: 0;
        width: 1px;
        height: 100%;
        background: Theme.divider;
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        Rectangle {
            height: Theme.control-height;
            background: Theme.layer-fill;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: Theme.divider;
            }

            HorizontalLayout {
                padding-left: Theme.spacing-12;
                padding-right: Theme.spacing-12;
                spacing: Theme.spacing-8;
                cross-axis-alignment: center;

                Text {
                    text: @tr("Find Across SSH");
                    color: Theme.text-primary;
                    font-size: Theme.font-caption;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: no-wrap;
                    overflow: elide;
                }

                Text {
                    text: root.rows.length == 1
                        ? @tr("1 session")
                        : @tr("{0} sessions", root.rows.length);
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            width: 100%;
            interactive: true;
            content-width: self.width;
            content-height: list_layout.preferred-height;

            list_layout := VerticalLayout {
                width: parent.width;
                spacing: 0;

                for row[i] in root.rows : Rectangle {
                    height: 36px;
                    background: i == root.selected-index
                        ? Theme.subtle-selected
                        : row_touch.pressed
                            ? Theme.subtle-pressed
                            : row_touch.has-hover
                                ? Theme.subtle-hover
                                : transparent;
                    animate background { duration: Theme.duration-faster; easing: ease-out; }

                    row_touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.row-selected(i); }
                    }

                    VerticalLayout {
                        padding-left: Theme.spacing-12;
                        padding-right: Theme.spacing-12;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 2px;

                        Text {
                            text: row.title;
                            color: Theme.text-primary;
                            font-size: Theme.font-caption;
                            font-weight: Theme.weight-semibold;
                            wrap: no-wrap;
                            overflow: elide;
                        }

                        Text {
                            text: row.snippet;
                            color: Theme.text-tertiary;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-caption;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: 100%;
                        background: Theme.divider;
                    }
                }
            }
        }
    }
}
