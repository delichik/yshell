// Host key verification — decide whether to trust the presented key.
//
// first-trust: verify fingerprint, then Trust Once or Trust and Save.
// changed: treat as a security event — Cancel is the safe default; Replace
// is destructive and must be deliberate.

import { Theme } from "../theme.slint";
import { Icon } from "basic/icons.slint";
import { WinButton, WinInfoBar } from "basic/controls.slint";

component DetailRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";
    spacing: Theme.spacing-16;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        width: Theme.form-label-width-medium;
        vertical-alignment: top;
        wrap: word-wrap;
    }

    Text {
        text: root.value;
        color: Theme.text-primary;
        font-size: Theme.font-body;
        font-family: Theme.font-mono;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

export component HostKeyDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> prompt-text: "";
    in property <string> mode-text: "";
    in property <string> target-text: "";
    in property <string> known-hosts-path-text: "";
    in property <string> algorithm-text: "";
    in property <string> fingerprint-text: "";
    in property <string> expected-algorithm-text: "";
    in property <string> expected-fingerprint-text: "";

    callback cancel();
    callback trust-once();
    callback trust-and-save();
    callback dismissed();

    private property <bool> is-changed: root.mode-text == "changed";
    private property <bool> detail-visible:
        root.target-text != "" || root.known-hosts-path-text != ""
        || root.algorithm-text != "" || root.fingerprint-text != ""
        || root.expected-algorithm-text != "" || root.expected-fingerprint-text != "";

    visible: root.open;
    background: transparent;

    dialog_scope := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.cancel();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            width: root.width;
            height: root.height;
            spacing: Theme.spacing-16;

            // Lead: severity + what happened
            HorizontalLayout {
                spacing: Theme.spacing-12;
                alignment: start;

                Rectangle {
                    width: Theme.icon-size-large;
                    height: Theme.icon-size-large;
                    background: transparent;

                    Icon {
                        name: "warning";
                        icon-color: root.is-changed ? Theme.critical : Theme.caution;
                        icon-size: Theme.icon-size-large;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    spacing: Theme.spacing-4;
                    horizontal-stretch: 1;

                    Text {
                        text: root.is-changed
                            ? @tr("Host key changed for {0}.", root.target-text)
                            : root.target-text != ""
                                ? @tr("First-time host key for {0}.", root.target-text)
                                : @tr("Verify the host key before continuing.");
                        color: root.is-changed ? Theme.critical : Theme.text-primary;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-semibold;
                        wrap: word-wrap;
                    }

                    if !root.is-changed : Text {
                        text: @tr("Compare the fingerprint with a trusted source, then trust once or save it for next time.");
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                }
            }

            if root.is-changed : WinInfoBar {
                severity: "error";
                text: @tr("The presented key does not match the stored key. This may indicate a man-in-the-middle attack. Replace and Trust will overwrite the stored key; do so only if you verified the new key elsewhere.");
            }

            // Facts to verify
            VerticalLayout {
                spacing: Theme.spacing-12;

                if root.detail-visible && root.known-hosts-path-text != "" : DetailRow {
                    label: @tr("Known hosts");
                    value: root.known-hosts-path-text;
                }

                if root.detail-visible && root.is-changed && root.expected-algorithm-text != "" : DetailRow {
                    label: @tr("Expected");
                    value: @tr("{0} {1}", root.expected-algorithm-text, root.expected-fingerprint-text);
                }

                if root.detail-visible && root.algorithm-text != "" : DetailRow {
                    label: root.is-changed ? @tr("Presented") : @tr("Fingerprint");
                    value: @tr("{0} {1}", root.algorithm-text, root.fingerprint-text);
                }

                if !root.detail-visible && root.prompt-text != "" : Text {
                    text: root.prompt-text;
                    color: Theme.text-secondary;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.spacing-12;
                background: transparent;
            }

            Rectangle {
                height: 1px;
                vertical-stretch: 0;
                background: Theme.divider;
            }

            // Safe action first; destructive save/replace on the right.
            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;
                vertical-stretch: 0;
                padding-top: Theme.spacing-4;

                cancel_button := WinButton {
                    text: @tr("Cancel Connection");
                    clicked => { root.cancel(); }
                }

                WinButton {
                    text: @tr("Trust Once");
                    clicked => { root.trust-once(); }
                }

                WinButton {
                    text: root.is-changed
                        ? @tr("Replace and Trust")
                        : @tr("Trust and Save");
                    accent: !root.is-changed;
                    critical: root.is-changed;
                    clicked => { root.trust-and-save(); }
                }
            }
        }
    }

    public function focus-dialog() {
        cancel_button.focus-button();
    }

    changed open => {
        if (root.open) {
            cancel_button.focus-button();
        }
    }
}
