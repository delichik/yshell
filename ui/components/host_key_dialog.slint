// 主机密钥确认（ContentDialog 形态的模态弹窗）
//
// 承载原来挂在主界面里的主机密钥提示条：first-trust（首次信任）与 changed
// （主机密钥变化）两种模式共用一个弹窗，由 `mode-text` 切换。
// 形态：WinUI 3 ContentDialog（§5.10）——scrim 遮罩、panel-background 面板、
// subtitle 标题、右对齐操作区（主操作在右），右上角统一关闭按钮。
//
// 与 Rust 侧的约定：
//   * `mode-text` 取 "first-trust" / "changed"（无待确认提示时为空串）。
//   * 信息文本由 Rust 投影（多行），等宽展示，最多 8 行后内部滚动。
//   * changed 模式必须输入 REPLACE；Rust 侧 `replace_host_key_and_connect`
//     同样校验 `trim() == "REPLACE"`，这里同步禁用按钮，避免无谓的错误状态。
//
// L2（对话框 Esc / 遮罩点击关闭）：
//   * `open` 由宿主投影驱动（`visible: self.open`，与其它模态弹窗一致）。
//   * `Esc` / 遮罩点击 = Cancel（`cancel()`，Rust 侧同时清空 REPLACE 确认词）；
//     面板内空白处点击由面板 TouchArea 吞掉，不会穿透到遮罩误触取消。
//   * 危险操作默认焦点在根 FocusScope（不是 Replace Key 按钮），Enter 不误确认。

import { Theme } from "../theme.slint";
import { WinButton, WinIconButton, WinScrollIndicator } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

// 正文行（等宽；与 Rust 拆分字段一一对应）。
// 注意：同一文件内的局部组件必须先声明后使用。
component PromptLine inherits Text {
    in property <string> hint: "";
    text: root.hint;
    color: Theme.text-secondary;
    font-family: Theme.font-mono;
    font-size: Theme.font-body;
    wrap: word-wrap;
}

export component HostKeyDialog inherits Rectangle {
    in property <bool> open: false;
    /// 主机密钥信息（Rust 投影的多行文本；**过渡期回退用**，拆分字段齐全后不再显示）
    in property <string> prompt-text: "";
    /// "first-trust" | "changed"
    in property <string> mode-text: "";
    /// 拆分的正文字段（WS-D 投影、WS-A 绑定）：目标 `user@host:port`
    in property <string> target-text: "";
    /// known_hosts 文件路径
    in property <string> known-hosts-path-text: "";
    /// 本次提供的算法 / 指纹
    in property <string> algorithm-text: "";
    in property <string> fingerprint-text: "";
    /// changed 模式：已保存的算法 / 指纹（其它模式为空）
    in property <string> expected-algorithm-text: "";
    in property <string> expected-fingerprint-text: "";
    /// changed 模式的确认词（in-out：弹窗内编辑，宿主可读写）
    in-out property <string> confirmation-text: "";

    callback cancel();
    callback trust-once();
    callback trust-and-save();
    callback replace-key();
    callback confirmation-edited(string);
    /// 右上角 × 关闭，语义与 cancel() 相同（宿主自行决定处理方式）
    callback dismissed();

    // 正文：拆分字段任一非空即逐行渲染；否则回退到 `prompt-text`
    private property <bool> detail-visible:
        root.target-text != "" || root.known-hosts-path-text != ""
        || root.algorithm-text != "" || root.fingerprint-text != ""
        || root.expected-algorithm-text != "" || root.expected-fingerprint-text != "";

    visible: self.open;
    background: Theme.scrim;

    // L2：根 FocusScope 包住整个弹窗；Esc 沿焦点链冒泡到这里 → `cancel()`。
    dialog_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            // Esc 键码按 `event.text` 比较（与 session_tree 判 Enter 的做法一致）。
            if (event.text == "\u{001b}") {
                root.cancel();
                return accept;
            }
            return reject;
        }

        // 遮罩：点击 = 取消（与 Cancel 按钮同一路径）。
        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            x: (parent.width - 520px) / 2;
            y: max((parent.height - self.height) / 2, 40px);
            width: 520px;
            // 内容高于窗口时收缩（与同族弹窗一致）
            height: min(body.preferred-height, parent.height - 2 * Theme.spacing-24);
            background: Theme.panel-background;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.control-stroke;

            // 吞掉面板空白处的点击，避免穿透到遮罩触发取消。
            TouchArea { }

            body := VerticalLayout {
                padding: Theme.spacing-20;
                spacing: Theme.spacing-12;

                // 标题行（固定）：右侧统一关闭按钮
                HorizontalLayout {
                    spacing: Theme.spacing-8;

                    Text {
                        text: @tr("Host Key Confirmation");
                        color: Theme.text-primary;
                        font-size: Theme.font-subtitle;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    WinIconButton {
                        icon: "close";
                        accessible-name: @tr("Close");
                        clicked => { root.dismissed(); }
                    }
                }

                // 主机密钥信息：逐行结构化渲染（标签本地化）。约 8 行后内部滚动。
                // B 轮5：原上限写 `8 * Theme.line-body`(20px)=160px，而 14px 正文在本字体栈下
                // 的实测行高是 16px（`Theme.line-caption`），导致面板比内容高约 19px、
                // 操作行被推到底部；这里改成与实测行高同源的像素预算。
                prompt-box := Rectangle {
                    height: min(prompt.preferred-height, 8 * Theme.line-caption);
                    clip: true;
                    background: transparent;

                    prompt-scroll := Flickable {
                        width: parent.width;
                        height: parent.height;
                        interactive: true;
                        content-width: self.width;
                        content-height: prompt.preferred-height;

                        prompt := VerticalLayout {
                            width: prompt-scroll.width;
                            spacing: 2px;

                            // 首行：改动 / 首次
                            if root.detail-visible && root.target-text != "" : PromptLine {
                                hint: root.mode-text == "changed"
                                    ? @tr("Host key changed for {0}.", root.target-text)
                                    : @tr("First-time host key for {0}.", root.target-text);
                            }

                            if root.detail-visible && root.known-hosts-path-text != "" : PromptLine {
                                hint: @tr("Known hosts: {0}", root.known-hosts-path-text);
                            }

                            // 已保存的密钥只在 changed 模式显示（空值行不占位）
                            if root.detail-visible && root.mode-text == "changed" && root.expected-algorithm-text != "" : PromptLine {
                                hint: @tr("Expected: {0} {1}", root.expected-algorithm-text, root.expected-fingerprint-text);
                            }

                            if root.detail-visible && root.algorithm-text != "" : PromptLine {
                                hint: @tr("Presented: {0} {1}", root.algorithm-text, root.fingerprint-text);
                            }

                            if root.detail-visible && root.mode-text == "changed" : PromptLine {
                                hint: @tr("Type REPLACE to enable replacement.");
                            }

                            if root.detail-visible && root.mode-text != "changed" : PromptLine {
                                hint: @tr("Choose Trust Once or Trust and Save.");
                            }

                            // 兼容回退：宿主尚未提供拆分字段时显示原来的整段文本
                            if !root.detail-visible && root.prompt-text != "" : PromptLine {
                                hint: root.prompt-text;
                            }
                        }
                    }

                    // 滚动指示：E22 可复用组件（`content-y` 向下滚动为负值，组件内部取负）
                    WinScrollIndicator {
                        x: prompt-scroll.width - self.width - Theme.spacing-4;
                        y: Theme.spacing-4;
                        height: parent.height - 2 * Theme.spacing-4;
                        viewport-position: prompt-scroll.content-y;
                        content-extent: prompt-scroll.content-height;
                        viewport-extent: prompt-scroll.height;
                        thumb-min-length: 24px;
                    }
                }

                // changed 模式：警示文案 + REPLACE 确认输入
                if root.mode-text == "changed" : Text {
                    text: @tr("The presented key does not match the stored key. This may indicate a man-in-the-middle attack; replace it only if you verified the new key elsewhere.");
                    color: Theme.critical;
                    wrap: word-wrap;
                }

                if root.mode-text == "changed" : WinTextInput {
                    placeholder-text: @tr("Type REPLACE");
                    text <=> root.confirmation-text;
                    edited => { root.confirmation-edited(self.text); }
                }

                // 操作区：右对齐，主操作在最右
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-8;

                    WinButton {
                        text: @tr("Cancel");
                        clicked => { root.cancel(); }
                    }

                    if root.mode-text == "first-trust" : WinButton {
                        text: @tr("Trust Once");
                        clicked => { root.trust-once(); }
                    }

                    if root.mode-text == "first-trust" : WinButton {
                        text: @tr("Trust and Save");
                        accent: true;
                        clicked => { root.trust-and-save(); }
                    }

                    if root.mode-text == "changed" : WinButton {
                        text: @tr("Replace Key");
                        // 破坏性操作：critical 文案色（不做红色实底），且需输入 REPLACE
                        critical: true;
                        enabled: root.confirmation-text == "REPLACE";
                        clicked => { root.replace-key(); }
                    }
                }
            }
        }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        dialog_scope.focus();
    }

    // 打开时聚焦弹窗（Esc 需要焦点在弹窗内）。
    changed open => {
        if (root.open) {
            dialog_scope.focus();
        }
    }
}
