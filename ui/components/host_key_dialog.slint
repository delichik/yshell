// 主机密钥确认正文：说明 + 标签/值详情卡 + 警告 + 底栏。

import { Theme } from "../theme.slint";
import { WinButton, WinCard, WinInfoBar } from "basic/controls.slint";

component DetailRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> mono: true;
    spacing: Theme.spacing-16;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        width: Theme.form-label-width-medium;
        vertical-alignment: top;
        wrap: word-wrap;
    }

    Text {
        text: root.value;
        color: Theme.text-primary;
        font-size: Theme.font-body;
        font-family: root.mono ? Theme.font-mono : Theme.font-ui;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

export component HostKeyDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> prompt-text: "";
    in property <string> mode-text: "";
    in property <string> target-text: "";
    in property <string> known-hosts-path-text: "";
    in property <string> algorithm-text: "";
    in property <string> fingerprint-text: "";
    in property <string> expected-algorithm-text: "";
    in property <string> expected-fingerprint-text: "";

    callback cancel();
    callback trust-once();
    callback trust-and-save();
    callback dismissed();

    private property <bool> detail-visible:
        root.target-text != "" || root.known-hosts-path-text != ""
        || root.algorithm-text != "" || root.fingerprint-text != ""
        || root.expected-algorithm-text != "" || root.expected-fingerprint-text != "";

    visible: root.open;
    background: transparent;

    dialog_scope := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.cancel();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            width: root.width;
            height: root.height;
            spacing: Theme.spacing-16;

            Text {
                text: root.mode-text == "changed"
                    ? @tr("Host key changed for {0}.", root.target-text)
                    : root.target-text != ""
                        ? @tr("First-time host key for {0}.", root.target-text)
                        : @tr("Verify the host key before continuing.");
                color: Theme.text-primary;
                font-size: Theme.font-body;
                font-weight: Theme.weight-semibold;
                wrap: word-wrap;
            }

            if root.mode-text == "changed" : WinInfoBar {
                severity: "error";
                text: @tr("The presented key does not match the stored key. This may indicate a man-in-the-middle attack. Replace and Trust will overwrite the stored key; do so only if you verified the new key elsewhere.");
            }

            WinCard {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Theme.spacing-16;

                    if root.detail-visible && root.known-hosts-path-text != "" : DetailRow {
                        label: @tr("Known hosts");
                        value: root.known-hosts-path-text;
                        mono: true;
                    }

                    if root.detail-visible && root.mode-text == "changed" && root.expected-algorithm-text != "" : DetailRow {
                        label: @tr("Expected");
                        value: @tr("{0} {1}", root.expected-algorithm-text, root.expected-fingerprint-text);
                        mono: true;
                    }

                    if root.detail-visible && root.algorithm-text != "" : DetailRow {
                        label: @tr("Presented");
                        value: @tr("{0} {1}", root.algorithm-text, root.fingerprint-text);
                        mono: true;
                    }

                    if root.detail-visible && root.mode-text != "changed" : Text {
                        text: @tr("Choose Trust Once or Trust and Save.");
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }

                    if !root.detail-visible && root.prompt-text != "" : Text {
                        text: root.prompt-text;
                        color: Theme.text-secondary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 0px;
                        background: transparent;
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;
                vertical-stretch: 0;

                cancel_button := WinButton {
                    text: @tr("Cancel Connection");
                    clicked => { root.cancel(); }
                }

                WinButton {
                    text: @tr("Trust Once");
                    clicked => { root.trust-once(); }
                }

                WinButton {
                    text: root.mode-text == "changed"
                        ? @tr("Replace and Trust")
                        : @tr("Trust and Save");
                    accent: root.mode-text != "changed";
                    critical: root.mode-text == "changed";
                    clicked => { root.trust-and-save(); }
                }
            }
        }
    }

    public function focus-dialog() {
        cancel_button.focus-button();
    }

    changed open => {
        if (root.open) {
            cancel_button.focus-button();
        }
    }
}
