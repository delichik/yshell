// 管理器页面内容壳：焦点 / Esc / 内容槽（填满父级）。
//
// 标题栏与关闭由宿主 `ToolWindowChrome` 提供；本组件不再自绘标题或拖拽。
// 宽高用 `root.width`/`root.height`（由宿主赋绝对值），避免 `100%` 与
// Window.layoutinfo 形成 binding loop。

import { Theme } from "../theme.slint";

export component ManagerDialogShell inherits Rectangle {
    in property <bool> open: false;
    /// true = 高度跟内容（Folder Editor）；false = 吃掉剩余纵向空间。
    in property <bool> content-sized: false;
    callback close();

    visible: root.open;
    background: Theme.window-background;

    dialog_scope := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.close();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: root.width;
            height: root.height;
            spacing: Theme.spacing-12;

            content-slot := Rectangle {
                vertical-stretch: root.content-sized ? 0 : 1;
                min-height: 0px;
                background: transparent;

                VerticalLayout {
                    // 不绑 parent.width：由 VerticalLayout 分配列宽，避免 layoutinfo 回环。
                    height: root.content-sized ? self.preferred-height : parent.height;
                    spacing: Theme.spacing-12;
                    @children
                }
            }
        }
    }

    public function focus-dialog() {
        dialog_scope.focus();
    }

    changed open => {
        if (root.open) {
            dialog_scope.focus();
        }
    }
}
