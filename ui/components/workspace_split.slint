// WP4：递归分屏（最多 10 叶）。Rust 摊平几何；Slint 绝对定位叶子 + 把手。
//
// 布局约定：
//   * 每叶 = tab 栏 + terminal，同框描边（spacing 0）。
//   * DropArea 包整叶；tab 栏子区优先「移入」，余区六段分屏；预览盖满整叶。
import { Theme } from "../theme.slint";
import { TerminalView } from "terminal_view.slint";
import { WorkspaceTab } from "workspace_tab_model.slint";
import { WorkspaceTabBar } from "workspace_tab_bar.slint";
import { WorkspacePaneLeaf, WorkspaceSplitter } from "workspace_pane_model.slint";
import { QuickConnectPage, QuickConnectRow } from "../pages/quick_connect.slint";
import { SftpPaneData, SftpTabPage } from "sftp_tab_page.slint";

component SplitPaneLeaf inherits Rectangle {
    in property <bool> empty: false;
    in property <bool> focused: false;
    /// TAB-6：本叶被 Quick Connect 覆盖层盖住（只可能是聚焦叶）。终端实例仍按满尺寸
    /// 布局并保持存活，但不再接收键盘/鼠标/焦点；其它叶保持正常终端。
    in property <bool> quick-connect: false;
    /// `new` / `terminal` / `sftp`.
    in property <string> mode-text: "terminal";
    in property <string> quick-connect-input-text: "";
    in property <string> quick-connect-error-text: "";
    in property <string> quick-connect-summary-text: "";
    in property <bool> quick-connect-history-enabled: true;
    in property <[QuickConnectRow]> quick-connect-rows: [];
    in property <SftpPaneData> sftp;
    in property <image> terminal-image;
    /// 终端表面底色（跟随会话配色；见 `terminal_view.slint` 的同名属性）。
    in property <color> surface-background: Theme.terminal-surface;
    in property <int> pane-id: 0;
    in property <[WorkspaceTab]> tabs: [];

    in property <int> cursor-column: 0;
    in property <int> cursor-row: 0;
    in property <int> scroll-offset: 0;
    in property <bool> selection-active: false;
    in-out property <string> search-query: "";
    in property <string> search-summary: "";
    in-out property <bool> search-regex: false;
    in property <bool> find-visible: false;
    in property <bool> connection-overlay-visible: false;
    in property <string> connection-overlay-target: "";
    in property <string> connection-overlay-stage: "";
    in property <string> connection-overlay-error: "";
    in property <bool> connection-overlay-failed: false;
    in property <bool> connection-overlay-pending: false;
    in property <bool> view-visible: true;

    /// 终端交互：非空且当前标签是 Terminal 模式。
    property <bool> show-terminal: root.view-visible && !root.empty && root.mode-text == "terminal";
    out property <bool> terminal-focused: root.show-terminal && !root.quick-connect && root.focused && leaf_tv.terminal-focused;
    /// 内容区高度（叶高 − tab 栏），供宿主 QC overlay 对齐。
    out property <length> content-height: max(0px, root.height - Theme.bar-height-tabs);
    /// 拖拽分区规格：`up|down|left|right` + `:small|equal|major`；空 = 无悬停。
    property <string> drop-preview: "";
    property <bool> drop-hovering: split_drop.has-drag && root.drop-preview != "";
    property <length> tab-bar-h: Theme.bar-height-tabs;
    /// 被拖侧将占用的比例（小 0.25 / 均分 0.5 / 大 0.7）。
    property <float> drop-share:
        root.drop-preview == "up:small" || root.drop-preview == "down:small"
            || root.drop-preview == "left:small" || root.drop-preview == "right:small" ? 0.25
        : root.drop-preview == "up:major" || root.drop-preview == "down:major"
            || root.drop-preview == "left:major" || root.drop-preview == "right:major" ? 0.7
        : 0.5;
    property <bool> drop-vertical:
        root.drop-preview == "up:small" || root.drop-preview == "up:equal" || root.drop-preview == "up:major"
        || root.drop-preview == "down:small" || root.drop-preview == "down:equal" || root.drop-preview == "down:major";
    property <bool> drop-on-start:
        root.drop-preview == "up:small" || root.drop-preview == "up:equal" || root.drop-preview == "up:major"
        || root.drop-preview == "left:small" || root.drop-preview == "left:equal" || root.drop-preview == "left:major";

    /// 目标 pane 六段：最外=小、次外=均分、最内=大部分；轴向取更靠近的边。
    pure function split-zone(x: length, y: length, w: length, h: length) -> string {
        if (h <= 0px || w <= 0px) { return "right:equal"; }
        // 更靠近上下边 → 纵向六段；更靠近左右边 → 横向六段。
        if (Math.min(y / h, 1.0 - y / h) <= Math.min(x / w, 1.0 - x / w)) {
            if (y < h / 6) { return "up:small"; }
            if (y < h * 2 / 6) { return "up:equal"; }
            if (y < h * 3 / 6) { return "up:major"; }
            if (y < h * 4 / 6) { return "down:major"; }
            if (y < h * 5 / 6) { return "down:equal"; }
            return "down:small";
        }
        if (x < w / 6) { return "left:small"; }
        if (x < w * 2 / 6) { return "left:equal"; }
        if (x < w * 3 / 6) { return "left:major"; }
        if (x < w * 4 / 6) { return "right:major"; }
        if (x < w * 5 / 6) { return "right:equal"; }
        return "right:small";
    }

    callback focus-requested();
    callback key-pressed(string, bool, bool, bool, bool);
    callback scroll-lines(int);
    callback scroll-to-bottom();
    callback selection-begin(float, float);
    callback selection-update(float, float);
    callback selection-end(float, float);
    callback select-word-at(float, float);
    callback copy-visible();
    callback paste-clipboard();
    callback clear-terminal();
    callback find-text(string);
    callback find-next();
    callback find-prev();
    callback find-regex-changed(bool);
    callback dismiss-find();
    callback context-menu-requested(length, length);
    callback connection-retry();
    callback connection-cancel();
    callback connection-copy-error();
    /// 标签拖放到本叶 tab 栏（移入）。
    callback tab-dropped(data-transfer);
    /// 拖到 terminal 分区：up/down/left/right。
    callback tab-split-dropped(data-transfer, string);
    callback activate-tab(string);
    callback close-tab(string);
    callback tab-double-click(string);
    callback tab-context-menu-requested(string, string, length, length);
    callback new-session();
    pure callback drag-tab-transfer(string) -> data-transfer;

    // --- New Tab (Quick Connect) page -----------------------------------
    callback quick-connect-input-changed(string);
    callback quick-connect-submit(string);
    callback quick-connect-connect-target(string);
    callback quick-connect-copy-target(string);
    callback quick-connect-clear-history();

    // --- SFTP page ------------------------------------------------------
    callback sftp-refresh();
    callback sftp-up();
    callback sftp-home();
    callback sftp-open-path(string);
    callback sftp-open-crumb(int);
    callback sftp-sort-by(string);
    callback sftp-toggle-hidden();
    callback sftp-select-row(int, bool, bool);
    callback sftp-activate-row(int);
    callback sftp-context-menu-requested(int, length, length);
    callback sftp-panel-menu-requested(length, length);
    callback sftp-save-edit();
    callback sftp-cancel-edit();
    pure callback sftp-drag-remote-transfer(string) -> data-transfer;
    callback sftp-drop-on-remote-row(int, data-transfer, DragAction);
    callback sftp-drop-on-remote-blank(data-transfer, DragAction);
    callback sftp-local-up();
    callback sftp-local-home();
    callback sftp-local-refresh();
    callback sftp-local-open-path(string);
    callback sftp-local-sort-by(string);
    callback sftp-local-toggle-hidden();
    callback sftp-local-select-row(int, bool, bool);
    callback sftp-local-activate-row(int);
    callback sftp-local-context-menu-requested(int, length, length);
    callback sftp-local-retry();
    pure callback sftp-drag-local-transfer(string) -> data-transfer;
    callback sftp-drop-on-local(data-transfer, DragAction);
    callback sftp-copy-selection();
    callback sftp-cut-selection();
    callback sftp-paste-cross-pane();
    callback sftp-column-ratio-changed(float);

    min-width: 0px;
    min-height: 0px;
    clip: true;
    // 描边宽度固定：聚焦只换色，避免切换 active 时内容区被挤高/挤矮。
    // UI-1：pane 直角；底边 2px 会压住终端表面底部，viewport chrome 在
    // terminal_workspace.slint 里按 split-leaf-border 扣掉这一条底边。
    border-width: 2px;
    border-color: root.focused ? Theme.accent : Theme.control-stroke;
    border-radius: 0px;
    background: Theme.window-background;

    public function focus-terminal() {
        if (root.show-terminal && root.focused && !root.quick-connect) {
            leaf_tv.focus-terminal();
        }
    }

    // DropArea 包整叶：tab 栏子 DropArea 优先接「移入」；余区按六段分屏；预览盖满整叶。
    split_drop := DropArea {
        width: 100%;
        height: 100%;
        enabled: root.view-visible;
        can-drop(event) => {
            if (event.position.y < root.tab-bar-h) {
                root.drop-preview = "";
                return DragAction.none;
            }
            root.drop-preview = root.split-zone(
                event.position.x,
                event.position.y - root.tab-bar-h,
                self.width,
                self.height - root.tab-bar-h
            );
            return DragAction.move;
        }
        dropped(event) => {
            if (event.position.y < root.tab-bar-h) {
                root.drop-preview = "";
                return DragAction.none;
            }
            root.tab-split-dropped(
                event.data,
                root.split-zone(
                    event.position.x,
                    event.position.y - root.tab-bar-h,
                    self.width,
                    self.height - root.tab-bar-h
                )
            );
            root.drop-preview = "";
            return DragAction.move;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0;

            leaf_tabs := WorkspaceTabBar {
                tabs: root.tabs;
                drop-enabled: root.view-visible;
                activate-tab(id) => { root.activate-tab(id); }
                close-tab(id) => { root.close-tab(id); }
                tab-double-click(id) => { root.tab-double-click(id); }
                tab-context-menu-requested(id, title, x, y) => {
                    root.tab-context-menu-requested(id, title, x, y);
                }
                new-session() => {
                    root.focus-requested();
                    root.new-session();
                }
                drag-tab-transfer(id) => { return root.drag-tab-transfer(id); }
                tab-bar-dropped(data) => { root.tab-dropped(data); }
            }

            content := Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                background: Theme.terminal-background;
                clip: true;

                if root.empty : Text {
                    text: @tr("Activate a tab for this pane");
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                leaf_host := VerticalLayout {
                    width: 100%;
                    height: root.show-terminal ? 100% : 0%;
                    min-height: 0px;
                    max-height: root.show-terminal ? 100000px : 0px;
                    spacing: 0;

                    leaf_tv := TerminalView {
                        vertical-stretch: 1;
                        preferred-width: 0px;
                        preferred-height: 0px;
                        min-width: 0px;
                        min-height: 0px;
                        embedded: true;
                        // TAB-6：覆盖层可见时终端保持存活/渲染，但不接收输入。
                        interactive: root.show-terminal && root.focused && !root.quick-connect;
                        view-visible: root.show-terminal;
                        title: "";
                        log-output: "";
                        terminal-image: root.terminal-image;
                        surface-background: root.surface-background;
                        cursor-column: root.focused ? root.cursor-column : 0;
                        cursor-row: root.focused ? root.cursor-row : 0;
                        scroll-offset: root.focused ? root.scroll-offset : 0;
                        selection-active: root.focused && root.selection-active && !root.quick-connect;
                        search-query <=> root.search-query;
                        search-summary: root.focused ? root.search-summary : "";
                        search-regex <=> root.search-regex;
                        find-visible: root.show-terminal && root.focused && root.find-visible && !root.quick-connect;
                        connection-overlay-visible: root.show-terminal && root.focused && root.connection-overlay-visible && !root.quick-connect;
                        connection-overlay-target: root.connection-overlay-target;
                        connection-overlay-stage: root.connection-overlay-stage;
                        connection-overlay-error: root.connection-overlay-error;
                        connection-overlay-failed: root.connection-overlay-failed;
                        connection-overlay-pending: root.connection-overlay-pending;
                        focus-requested() => { root.focus-requested(); }
                        connection-retry() => { root.connection-retry(); }
                        connection-cancel() => { root.connection-cancel(); }
                        connection-copy-error() => { root.connection-copy-error(); }
                        key-pressed(text, ctrl, alt, shift, meta) => {
                            root.key-pressed(text, ctrl, alt, shift, meta);
                        }
                        scroll-lines(delta) => { root.scroll-lines(delta); }
                        scroll-to-bottom() => { root.scroll-to-bottom(); }
                        selection-begin(x, y) => { root.selection-begin(x, y); }
                        selection-update(x, y) => { root.selection-update(x, y); }
                        selection-end(x, y) => { root.selection-end(x, y); }
                        select-word-at(x, y) => { root.select-word-at(x, y); }
                        copy-visible() => { root.copy-visible(); }
                        paste-clipboard() => { root.paste-clipboard(); }
                        clear-terminal() => { root.clear-terminal(); }
                        find-text(q) => { root.find-text(q); }
                        find-next() => { root.find-next(); }
                        find-prev() => { root.find-prev(); }
                        find-regex-changed(e) => { root.find-regex-changed(e); }
                        dismiss-find() => { root.dismiss-find(); }
                        context-menu-requested(x, y) => { root.context-menu-requested(x, y); }
                    }
                }

                if root.mode-text == "new" : QuickConnectPage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    input-text: root.quick-connect-input-text;
                    input-error-text: root.quick-connect-error-text;
                    summary-text: root.quick-connect-summary-text;
                    history-enabled: root.quick-connect-history-enabled;
                    recent-rows: root.quick-connect-rows;
                    input-changed(text) => {
                        root.focus-requested();
                        root.quick-connect-input-changed(text);
                    }
                    submit(text) => { root.quick-connect-submit(text); }
                    connect-target(target) => { root.quick-connect-connect-target(target); }
                    copy-target(target) => { root.quick-connect-copy-target(target); }
                    clear-history() => { root.quick-connect-clear-history(); }
                }

                if root.mode-text == "sftp" : SftpTabPage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    rows: root.sftp.rows;
                    crumbs: root.sftp.crumbs;
                    selected-index: root.sftp.selected-index;
                    sort-column: root.sftp.sort-column-text;
                    sort-ascending: root.sftp.sort-ascending;
                    sort-text: root.sftp.sort-text;
                    show-hidden: root.sftp.show-hidden;
                    item-count: root.sftp.item-count;
                    dir-count: root.sftp.dir-count;
                    selected-count: root.sftp.selected-count;
                    empty-text: root.sftp.empty-text;
                    error-text: root.sftp.error-text;
                    connected: root.sftp.connected;
                    remote-edit-active: root.sftp.remote-edit-active;
                    remote-edit-text: root.sftp.remote-edit-text;
                    remote-edit-loading: root.sftp.remote-edit-loading;
                    remote-edit-loading-text: root.sftp.remote-edit-loading-text;
                    spinner-phase: root.sftp.spinner-phase;
                    path-text: root.sftp.path-text;
                    local-rows: root.sftp.local-rows;
                    local-path-text: root.sftp.local-path-text;
                    local-path-separator: root.sftp.local-path-separator;
                    local-show-hidden: root.sftp.local-show-hidden;
                    local-sort-column: root.sftp.local-sort-column-text;
                    local-sort-ascending: root.sftp.local-sort-ascending;
                    local-sort-text: root.sftp.local-sort-text;
                    local-item-count: root.sftp.local-item-count;
                    local-dir-count: root.sftp.local-dir-count;
                    local-selected-count: root.sftp.local-selected-count;
                    local-empty-text: root.sftp.local-empty-text;
                    local-error-text: root.sftp.local-error-text;
                    local-retry-visible: root.sftp.local-retry-visible;
                    local-title-text: @tr("Local");
                    local-selected-name-text: root.sftp.local-selected-name-text;
                    local-selection-key: root.sftp.local-selection-key;
                    sftp-selection-key: root.sftp.sftp-selection-key;
                    column-ratio: root.sftp.column-ratio;
                    column-ratio-changed(ratio) => {
                        root.focus-requested();
                        root.sftp-column-ratio-changed(ratio);
                    }
                    refresh => { root.focus-requested(); root.sftp-refresh(); }
                    up => { root.focus-requested(); root.sftp-up(); }
                    home => { root.focus-requested(); root.sftp-home(); }
                    open-path(path) => { root.focus-requested(); root.sftp-open-path(path); }
                    open-crumb(index) => { root.focus-requested(); root.sftp-open-crumb(index); }
                    sort-by(column) => { root.focus-requested(); root.sftp-sort-by(column); }
                    toggle-hidden => { root.focus-requested(); root.sftp-toggle-hidden(); }
                    select-row(index, ctrl, shift) => { root.focus-requested(); root.sftp-select-row(index, ctrl, shift); }
                    activate-row(index) => { root.focus-requested(); root.sftp-activate-row(index); }
                    context-menu-requested(index, x, y) => { root.focus-requested(); root.sftp-context-menu-requested(index, x, y); }
                    panel-menu-requested(x, y) => { root.focus-requested(); root.sftp-panel-menu-requested(x, y); }
                    save-edit => { root.focus-requested(); root.sftp-save-edit(); }
                    cancel-edit => { root.focus-requested(); root.sftp-cancel-edit(); }
                    drag-remote-transfer(key) => { return root.sftp-drag-remote-transfer(key); }
                    drop-on-remote-row(index, data, action) => { root.focus-requested(); root.sftp-drop-on-remote-row(index, data, action); }
                    drop-on-remote-blank(data, action) => { root.focus-requested(); root.sftp-drop-on-remote-blank(data, action); }
                    local-up => { root.focus-requested(); root.sftp-local-up(); }
                    local-home => { root.focus-requested(); root.sftp-local-home(); }
                    local-refresh => { root.focus-requested(); root.sftp-local-refresh(); }
                    local-open-path(path) => { root.focus-requested(); root.sftp-local-open-path(path); }
                    local-sort-by(column) => { root.focus-requested(); root.sftp-local-sort-by(column); }
                    local-toggle-hidden => { root.focus-requested(); root.sftp-local-toggle-hidden(); }
                    local-select-row(index, ctrl, shift) => { root.focus-requested(); root.sftp-local-select-row(index, ctrl, shift); }
                    local-activate-row(index) => { root.focus-requested(); root.sftp-local-activate-row(index); }
                    local-context-menu-requested(index, x, y) => { root.focus-requested(); root.sftp-local-context-menu-requested(index, x, y); }
                    local-retry => { root.focus-requested(); root.sftp-local-retry(); }
                    drag-local-transfer(key) => { return root.sftp-drag-local-transfer(key); }
                    drop-on-local(data, action) => { root.focus-requested(); root.sftp-drop-on-local(data, action); }
                    copy-selection => { root.focus-requested(); root.sftp-copy-selection(); }
                    cut-selection => { root.focus-requested(); root.sftp-cut-selection(); }
                    paste-cross-pane => { root.focus-requested(); root.sftp-paste-cross-pane(); }
                }

                if root.show-terminal && !root.focused : TouchArea {
                    width: parent.width;
                    height: parent.height;
                    enabled: root.view-visible;
                    mouse-cursor: MouseCursor.default;
                    clicked => { root.focus-requested(); }
                }
            }
        }

        if root.drop-hovering : Rectangle {
            x: root.drop-vertical ? 0px
                : (root.drop-on-start ? 0px : parent.width * (1.0 - root.drop-share));
            y: !root.drop-vertical ? 0px
                : (root.drop-on-start ? 0px : parent.height * (1.0 - root.drop-share));
            width: root.drop-vertical ? parent.width : parent.width * root.drop-share;
            height: root.drop-vertical ? parent.height * root.drop-share : parent.height;
            background: Theme.selection-fill;
            border-width: 1px;
            border-color: Theme.accent;
        }
    }
}

/// 递归分屏：按 Rust 摊平的叶子/把手绝对定位（最多 10 叶）。
export component WorkspaceSplitView inherits Rectangle {
    in property <[WorkspacePaneLeaf]> leaves: [];
    in property <[WorkspaceSplitter]> splitters: [];
    in property <int> focused-pane: 0;
    in property <image> primary-image;
    in property <image> secondary-image;

    in property <int> cursor-column: 0;
    in property <int> cursor-row: 0;
    in property <int> scroll-offset: 0;
    in property <bool> selection-active: false;
    in-out property <string> search-query: "";
    in property <string> search-summary: "";
    in-out property <bool> search-regex: false;
    in property <bool> find-visible: false;
    in property <bool> connection-overlay-visible: false;
    in property <string> connection-overlay-target: "";
    in property <string> connection-overlay-stage: "";
    in property <string> connection-overlay-error: "";
    in property <bool> connection-overlay-failed: false;
    in property <bool> connection-overlay-pending: false;
    in property <bool> view-visible: true;

    out property <bool> terminal-focused: false;

    /// New Tab page data shared by every leaf (per-tab input lives in the leaf).
    in property <string> quick-connect-summary-text: "";
    in property <bool> quick-connect-history-enabled: true;
    in property <[QuickConnectRow]> quick-connect-rows: [];
    /// 终端表面底色：聚焦叶用主 pane 的，其余叶用次 pane 的（跟随会话配色）。
    in property <color> primary-surface-background: Theme.terminal-surface;
    in property <color> secondary-surface-background: Theme.terminal-surface;

    callback focus-pane(int);
    callback terminal-key(string, bool, bool, bool, bool);
    callback terminal-scroll(int);
    callback terminal-scroll-to-bottom();
    callback terminal-selection-begin(float, float);
    callback terminal-selection-update(float, float);
    callback terminal-selection-end(float, float);
    callback terminal-select-word-at(float, float);
    callback copy-visible();
    callback paste-clipboard();
    callback clear-terminal();
    callback find-text(string);
    callback find-next();
    callback find-prev();
    callback find-regex-changed(bool);
    callback dismiss-find();
    callback context-menu-requested(length, length);
    callback connection-retry();
    callback connection-cancel();
    callback connection-copy-error();
    /// split_id, new ratio
    callback ratio-changed(int, float);
    callback tab-dropped-on-pane(int, data-transfer);
    callback tab-split-dropped(data-transfer, int, string);
    callback activate-tab(string);
    callback close-tab(string);
    callback tab-double-click(string);
    callback tab-context-menu-requested(string, string, length, length);
    callback new-session();
    pure callback drag-tab-transfer(string) -> data-transfer;

    // New Tab page.
    callback quick-connect-input-changed(string);
    callback quick-connect-submit(string);
    callback quick-connect-connect-target(string);
    callback quick-connect-copy-target(string);
    callback quick-connect-clear-history();

    // SFTP page.
    callback sftp-refresh();
    callback sftp-up();
    callback sftp-home();
    callback sftp-open-path(string);
    callback sftp-open-crumb(int);
    callback sftp-sort-by(string);
    callback sftp-toggle-hidden();
    callback sftp-select-row(int, bool, bool);
    callback sftp-activate-row(int);
    callback sftp-context-menu-requested(int, length, length);
    callback sftp-panel-menu-requested(length, length);
    callback sftp-save-edit();
    callback sftp-cancel-edit();
    pure callback sftp-drag-remote-transfer(string) -> data-transfer;
    callback sftp-drop-on-remote-row(int, data-transfer, DragAction);
    callback sftp-drop-on-remote-blank(data-transfer, DragAction);
    callback sftp-local-up();
    callback sftp-local-home();
    callback sftp-local-refresh();
    callback sftp-local-open-path(string);
    callback sftp-local-sort-by(string);
    callback sftp-local-toggle-hidden();
    callback sftp-local-select-row(int, bool, bool);
    callback sftp-local-activate-row(int);
    callback sftp-local-context-menu-requested(int, length, length);
    callback sftp-local-retry();
    pure callback sftp-drag-local-transfer(string) -> data-transfer;
    callback sftp-drop-on-local(data-transfer, DragAction);
    callback sftp-copy-selection();
    callback sftp-cut-selection();
    callback sftp-paste-cross-pane();
    callback sftp-column-ratio-changed(float);

    public function focus-terminal() { }

    for leaf in root.leaves : SplitPaneLeaf {
        x: root.width * leaf.x;
        y: root.height * leaf.y;
        width: root.width * leaf.w;
        height: root.height * leaf.h;
        empty: leaf.empty;
        quick-connect: leaf.quick-connect;
        mode-text: leaf.mode_text;
        quick-connect-input-text: leaf.quick_connect_input_text;
        quick-connect-error-text: leaf.quick_connect_error_text;
        quick-connect-summary-text: root.quick-connect-summary-text;
        quick-connect-history-enabled: root.quick-connect-history-enabled;
        quick-connect-rows: root.quick-connect-rows;
        sftp: leaf.sftp;
        pane-id: leaf.pane-id;
        tabs: leaf.tabs;
        focused: leaf.focused;
        terminal-image: leaf.focused ? root.primary-image : root.secondary-image;
        surface-background: leaf.focused ? root.primary-surface-background : root.secondary-surface-background;
        cursor-column: root.cursor-column;
        cursor-row: root.cursor-row;
        scroll-offset: root.scroll-offset;
        selection-active: root.selection-active;
        search-query <=> root.search-query;
        search-summary: root.search-summary;
        search-regex <=> root.search-regex;
        find-visible: root.find-visible;
        connection-overlay-visible: root.connection-overlay-visible;
        connection-overlay-target: root.connection-overlay-target;
        connection-overlay-stage: root.connection-overlay-stage;
        connection-overlay-error: root.connection-overlay-error;
        connection-overlay-failed: root.connection-overlay-failed;
        connection-overlay-pending: root.connection-overlay-pending;
        view-visible: root.view-visible;
        focus-requested() => { root.focus-pane(leaf.pane-id); }
        key-pressed(t, c, a, s, m) => { root.terminal-key(t, c, a, s, m); }
        scroll-lines(d) => { root.terminal-scroll(d); }
        scroll-to-bottom() => { root.terminal-scroll-to-bottom(); }
        selection-begin(x, y) => { root.terminal-selection-begin(x, y); }
        selection-update(x, y) => { root.terminal-selection-update(x, y); }
        selection-end(x, y) => { root.terminal-selection-end(x, y); }
        select-word-at(x, y) => { root.terminal-select-word-at(x, y); }
        copy-visible() => { root.copy-visible(); }
        paste-clipboard() => { root.paste-clipboard(); }
        clear-terminal() => { root.clear-terminal(); }
        find-text(q) => { root.find-text(q); }
        find-next() => { root.find-next(); }
        find-prev() => { root.find-prev(); }
        find-regex-changed(e) => { root.find-regex-changed(e); }
        dismiss-find() => { root.dismiss-find(); }
        context-menu-requested(x, y) => { root.context-menu-requested(x, y); }
        connection-retry() => { root.connection-retry(); }
        connection-cancel() => { root.connection-cancel(); }
        connection-copy-error() => { root.connection-copy-error(); }
        tab-dropped(data) => { root.tab-dropped-on-pane(leaf.pane-id, data); }
        tab-split-dropped(data, dir) => { root.tab-split-dropped(data, leaf.pane-id, dir); }
        activate-tab(id) => { root.activate-tab(id); }
        close-tab(id) => { root.close-tab(id); }
        tab-double-click(id) => { root.tab-double-click(id); }
        tab-context-menu-requested(id, title, x, y) => {
            root.tab-context-menu-requested(id, title, x, y);
        }
        new-session() => { root.new-session(); }
        drag-tab-transfer(id) => { return root.drag-tab-transfer(id); }
        quick-connect-input-changed(text) => { root.quick-connect-input-changed(text); }
        quick-connect-submit(text) => { root.quick-connect-submit(text); }
        quick-connect-connect-target(target) => { root.quick-connect-connect-target(target); }
        quick-connect-copy-target(target) => { root.quick-connect-copy-target(target); }
        quick-connect-clear-history() => { root.quick-connect-clear-history(); }
        sftp-refresh() => { root.sftp-refresh(); }
        sftp-up() => { root.sftp-up(); }
        sftp-home() => { root.sftp-home(); }
        sftp-open-path(path) => { root.sftp-open-path(path); }
        sftp-open-crumb(index) => { root.sftp-open-crumb(index); }
        sftp-sort-by(column) => { root.sftp-sort-by(column); }
        sftp-toggle-hidden() => { root.sftp-toggle-hidden(); }
        sftp-select-row(index, ctrl, shift) => { root.sftp-select-row(index, ctrl, shift); }
        sftp-activate-row(index) => { root.sftp-activate-row(index); }
        sftp-context-menu-requested(index, x, y) => { root.sftp-context-menu-requested(index, x, y); }
        sftp-panel-menu-requested(x, y) => { root.sftp-panel-menu-requested(x, y); }
        sftp-save-edit() => { root.sftp-save-edit(); }
        sftp-cancel-edit() => { root.sftp-cancel-edit(); }
        sftp-drag-remote-transfer(key) => { return root.sftp-drag-remote-transfer(key); }
        sftp-drop-on-remote-row(index, data, action) => { root.sftp-drop-on-remote-row(index, data, action); }
        sftp-drop-on-remote-blank(data, action) => { root.sftp-drop-on-remote-blank(data, action); }
        sftp-local-up() => { root.sftp-local-up(); }
        sftp-local-home() => { root.sftp-local-home(); }
        sftp-local-refresh() => { root.sftp-local-refresh(); }
        sftp-local-open-path(path) => { root.sftp-local-open-path(path); }
        sftp-local-sort-by(column) => { root.sftp-local-sort-by(column); }
        sftp-local-toggle-hidden() => { root.sftp-local-toggle-hidden(); }
        sftp-local-select-row(index, ctrl, shift) => { root.sftp-local-select-row(index, ctrl, shift); }
        sftp-local-activate-row(index) => { root.sftp-local-activate-row(index); }
        sftp-local-context-menu-requested(index, x, y) => { root.sftp-local-context-menu-requested(index, x, y); }
        sftp-local-retry() => { root.sftp-local-retry(); }
        sftp-drag-local-transfer(key) => { return root.sftp-drag-local-transfer(key); }
        sftp-drop-on-local(data, action) => { root.sftp-drop-on-local(data, action); }
        sftp-copy-selection() => { root.sftp-copy-selection(); }
        sftp-cut-selection() => { root.sftp-cut-selection(); }
        sftp-paste-cross-pane() => { root.sftp-paste-cross-pane(); }
        sftp-column-ratio-changed(ratio) => { root.sftp-column-ratio-changed(ratio); }
    }

    for handle in root.splitters : Rectangle {
        x: root.width * handle.x;
        y: root.height * handle.y;
        width: Math.max(root.width * handle.w, 4px);
        height: Math.max(root.height * handle.h, 4px);
        background: Theme.divider;
        TouchArea {
            width: handle.vertical ? 8px : parent.width;
            height: handle.vertical ? parent.height : 8px;
            x: handle.vertical ? -2px : 0;
            y: handle.vertical ? 0 : -2px;
            mouse-cursor: handle.vertical ? MouseCursor.col-resize : MouseCursor.row-resize;
            moved => {
                if (self.pressed) {
                    if (handle.vertical) {
                        root.ratio-changed(
                            handle.split-id,
                            (
                                ((self.absolute-position.x + self.mouse-x) - root.absolute-position.x) / 1px
                                    / Math.max(root.width / 1px, 1.0)
                                - handle.parent-x
                            ) / Math.max(handle.parent-w, 0.001)
                        );
                    } else {
                        root.ratio-changed(
                            handle.split-id,
                            (
                                ((self.absolute-position.y + self.mouse-y) - root.absolute-position.y) / 1px
                                    / Math.max(root.height / 1px, 1.0)
                                - handle.parent-y
                            ) / Math.max(handle.parent-h, 0.001)
                        );
                    }
                }
            }
        }
    }
}
