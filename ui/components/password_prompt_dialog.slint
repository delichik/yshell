// Password prompt body — one job: collect a password for this connection attempt.
// Chrome title comes from PasswordPromptWindow; this is message + field + footer.

import { Theme } from "../theme.slint";
import { WinButton } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

export component PasswordPromptDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> message-text: "";
    in-out property <string> password-text: "";
    in property <bool> connect-enabled: false;

    callback cancel();
    callback submit();

    visible: root.open;
    background: transparent;

    dialog_scope := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.cancel();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            width: root.width;
            height: root.height;
            spacing: Theme.spacing-16;

            if root.message-text != "" : Text {
                text: root.message-text;
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: Theme.spacing-8;
                vertical-stretch: 0;

                Text {
                    text: @tr("Password");
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                password-input := WinTextInput {
                    text <=> root.password-text;
                    placeholder-text: @tr("Password");
                    input-type: password;
                    accepted => { if root.connect-enabled { root.submit(); } }
                }

                Text {
                    text: @tr("Used for this connection only. It is not saved unless you choose to remember it elsewhere.");
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.spacing-12;
                background: transparent;
            }

            Rectangle {
                height: 1px;
                vertical-stretch: 0;
                background: Theme.divider;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;
                vertical-stretch: 0;
                padding-top: Theme.spacing-4;

                WinButton {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }

                WinButton {
                    text: @tr("Connect");
                    accent: true;
                    enabled: root.connect-enabled;
                    clicked => { root.submit(); }
                }
            }
        }
    }

    public function focus-dialog() {
        password-input.focus-input();
    }

    changed open => {
        if (root.open) {
            password-input.focus-input();
        }
    }
}
