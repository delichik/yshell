// 连接需要密码时的输入弹窗（WinUI 3 ContentDialog 形态，§5.10）。
//
// 触发：认证方式为 password / keyboard-interactive 的已保存会话在密钥库里找不到
// 密码时，Rust 侧把连接挂起并投影 `password-prompt-visible = true`（见
// crates/yshell-app/src/runtime.rs 的 `PendingPasswordPrompt`）。
// 密码只用于本次连接尝试：不写密钥库、不落盘（"保存密码"待后续任务）。
//
// 形态：scrim 遮罩 + 居中面板 + subtitle 标题 + 密码输入（WinTextInput
// `input-type: password`）+ 右对齐操作区（主操作在右）。
//
// 与宿主（MainWindow）的约定：
//   * `open` 由宿主投影驱动（与 ConfirmDialog 的 `open` 命名一致；`visible` 是
//     Slint 内建属性，组件不能重新声明）。
//   * `password-text` 为 in-out：弹窗内编辑，宿主关闭弹窗时清空回填值。
//   * `connect-enabled` 由宿主按空密码禁用主按钮；Rust 侧仍会校验兜底。
//
// L2（对话框 Esc / 遮罩点击关闭）：
//   * `Esc` 与遮罩点击走与 Cancel 按钮完全相同的 `cancel()` 路径；宿主（Rust）
//     在弹窗关闭后的投影里清空 `password_prompt_value_text`，避免密码残留。
//   * 面板内空白处点击由面板 TouchArea 吞掉，不会穿透到遮罩误触取消。

import { Theme } from "../theme.slint";
import { WinButton } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

export component PasswordPromptDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title-text: @tr("Password required");
    in property <string> message-text: "";
    in-out property <string> password-text: "";
    in property <bool> connect-enabled: false;

    callback cancel();
    callback submit();

    visible: self.open;
    background: Theme.scrim;

    // L2：根 FocusScope 包住整个弹窗；密码输入框是它的子元素，Esc 从输入框
    // 沿父链冒泡到这里 → `cancel()`（与 Cancel 按钮同一路径）。
    dialog_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            // Esc 键码按 `event.text` 比较（与 session_tree 判 Enter 的做法一致）。
            if (event.text == "\u{001b}") {
                root.cancel();
                return accept;
            }
            return reject;
        }

        // 遮罩：点击 = 取消（与 Cancel 按钮同一路径）。
        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            x: (parent.width - 420px) / 2;
            y: max((parent.height - self.height) / 2, 40px);
            width: 420px;
            height: body.preferred-height;
            background: Theme.panel-background;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.control-stroke;

            // 吞掉面板空白处的点击，避免穿透到遮罩触发取消。
            TouchArea { }

            body := VerticalLayout {
                padding: Theme.spacing-20;
                spacing: Theme.spacing-12;

                Text {
                    text: root.title-text;
                    color: Theme.text-primary;
                    font-size: Theme.font-subtitle;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                }

                Text {
                    text: root.message-text;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }

                // 密码输入（WinTextInput 自带 control-fill 底 + control-stroke 描边 + 聚焦强调条）
                password-input := WinTextInput {
                    text <=> root.password-text;
                    placeholder-text: @tr("Password");
                    input-type: password;
                    // 回车 = 主操作（空密码时与 Connect 按钮一样不触发）
                    accepted => { if root.connect-enabled { root.submit(); } }
                }

                // 操作区：右对齐，主操作（Connect）在最右
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-8;

                    WinButton {
                        text: @tr("Cancel");
                        clicked => { root.cancel(); }
                    }

                    WinButton {
                        text: @tr("Connect");
                        accent: true;
                        enabled: root.connect-enabled;
                        clicked => { root.submit(); }
                    }
                }
            }
        }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        password-input.focus-input();
    }

    // 打开时把键盘焦点给密码框（终端/快捷键 FocusScope 不抢输入）；
    // Esc 仍从密码框沿父链冒泡到 `dialog_scope`。
    changed open => {
        if (root.open) {
            password-input.focus-input();
        }
    }
}
