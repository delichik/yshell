// 连接需要密码时的输入弹窗（WinUI 3 ContentDialog 形态，§5.10）。
//
// 触发：认证方式为 password / keyboard-interactive 的已保存会话在密钥库里找不到
// 密码时，Rust 侧把连接挂起并投影 `password-prompt-visible = true`（见
// crates/yshell-app/src/runtime.rs 的 `PendingPasswordPrompt`）。
// 密码只用于本次连接尝试：不写密钥库、不落盘（"保存密码"待后续任务）。
//
// 形态：独立工具窗口内填满父级 + subtitle 标题 + 密码输入 + 右对齐操作区。
//
// 与宿主（MainWindow）的约定：
//   * `open` 由宿主投影驱动（与 ConfirmDialog 的 `open` 命名一致；`visible` 是
//     Slint 内建属性，组件不能重新声明）。
//   * `password-text` 为 in-out：弹窗内编辑，宿主关闭弹窗时清空回填值。
//   * `connect-enabled` 由宿主按空密码禁用主按钮；Rust 侧仍会校验兜底。
//
// L2（对话框 Esc 关闭）：`Esc` 与 Cancel 按钮同一路径；宿主关闭时清空密码回填值。

import { Theme } from "../theme.slint";
import { WinButton } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

export component PasswordPromptDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title-text: @tr("Password required");
    in property <string> message-text: "";
    in-out property <string> password-text: "";
    in property <bool> connect-enabled: false;

    callback cancel();
    callback submit();

    private property <length> content-width:
        Theme.tool-window-width-standard - 2 * Theme.spacing-20;

    visible: root.open;
    background: Theme.window-background;

    dialog_scope := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.cancel();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
                width: root.width;
                height: root.height;
                padding: Theme.spacing-20;
                spacing: Theme.spacing-12;

                Text {
                    text: root.title-text;
                    color: Theme.text-primary;
                    font-size: Theme.font-subtitle;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                    // 显式宽度：避免布局在宽度未定时估算 preferred-height（B 轮5 同族问题）
                    width: root.content-width;
                }

                Text {
                    text: root.message-text;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    width: root.content-width;
                }

                // 密码输入（WinTextInput 自带 control-fill 底 + control-stroke 描边 + 聚焦强调条）
                // P4：宽度/内边距已与 AuthPromptDialog 同为 460；Enter/Esc/焦点与认证弹窗对齐。
                password-input := WinTextInput {
                    text <=> root.password-text;
                    placeholder-text: @tr("Password");
                    input-type: password;
                    // 回车 = 主操作（空密码时与 Connect 按钮一样不触发）
                    accepted => { if root.connect-enabled { root.submit(); } }
                }

                // 操作区：右对齐，主操作（Connect）在最右（与 AuthPromptDialog 密码页一致）
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing-8;

                    WinButton {
                        text: @tr("Cancel");
                        clicked => { root.cancel(); }
                    }

                    WinButton {
                        text: @tr("Connect");
                        accent: true;
                        enabled: root.connect-enabled;
                        clicked => { root.submit(); }
                    }
                }
            }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        password-input.focus-input();
    }

    // 打开时把键盘焦点给密码框（终端/快捷键 FocusScope 不抢输入）；
    // Esc 仍从密码框沿父链冒泡到 `dialog_scope`。
    changed open => {
        if (root.open) {
            password-input.focus-input();
        }
    }
}
