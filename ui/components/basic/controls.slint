// YShell 基础控件（WinUI 3 / Fluent 2 形态）。
//
// 规范：docs/product/ui-winui3-design-language.md §5
// 所有控件只用 Theme token 表达颜色与尺寸；状态：默认 / 悬停 / 按下 / 选中 / 禁用。

import { Theme } from "../../theme.slint";
import { Icon } from "icons.slint";

// ---------------------------------------------------------------- 焦点
/// §3.5 键盘焦点环：2px 双色环（focus-outer 外 + focus-inner 内），贴合控件圆角 +2px。
/// 环画在控件外缘 2px 处，可能被外层 `clip` 裁掉。
/// 可见性只认 `FocusReason.tab-navigation`：鼠标点击走 TouchArea → `.focus()`（programmatic），不画环。
/// 键盘焦点环（原型 `.btn:focus-visible`）：2px 内环 + 4px accent 外晕。
export component FocusRing inherits Rectangle {
    in property <bool> visible-ring: false;
    in property <length> radius: Theme.radius-control;
    /// 被装饰控件的尺寸（组件根元素不能引用 `parent`，由调用方传入）
    in property <length> target-width: 0px;
    in property <length> target-height: 0px;

    // 外晕：贴控件外缘向外 4px（box-shadow 0 0 0 4px accent 的近似）。
    x: -4px;
    y: -4px;
    width: root.target-width + 8px;
    height: root.target-height + 8px;
    border-radius: root.radius + 4px;
    border-width: 4px;
    border-color: Theme.accent;
    background: transparent;
    opacity: root.visible-ring ? 1 : 0;
    animate opacity { duration: Theme.duration-faster; easing: ease-out; }

    // 内环：2px focus-inner，贴控件外缘（outline-offset ≈ 1）。
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-radius: root.radius + 1px;
        border-width: 2px;
        border-color: Theme.focus-inner;
        background: transparent;
    }
}

// ---------------------------------------------------------------- 按钮
export component WinButton inherits Rectangle {
    in property <string> text: "";
    /// 图标名（空字符串 = 无图标），见 icons.slint
    in property <string> icon: "";
    /// 主操作（强调色实底，每屏建议 ≤1）
    in property <bool> accent: false;
    /// 次级操作（无底无描边，悬停才出现底色）
    in property <bool> subtle: false;
    /// 破坏性操作：文字用 `critical` 色（不做红色实底）
    in property <bool> critical: false;
    /// 悬停提示（规范：所有可点按钮都要有 title）；空 = 不显示。
    in property <string> tooltip-text: "";
    in property <bool> enabled <=> touch.enabled;
    callback clicked();
    /// 键盘焦点（调用方可用它做弹窗默认焦点/焦点链断言）
    out property <bool> has-focus: button_focus.has-focus;

    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    // Disabled accent keeps a soft accent fill + primary text so primary
    // actions (e.g. QC Connect) stay readable instead of nearly invisible.
    // Critical = critical 描边（原型 `.btn-danger`），不是大红实心。
    border-color: !enabled
        ? (accent ? transparent : critical ? Theme.critical : Theme.control-stroke)
        : accent ? transparent
        : subtle ? transparent
        : critical ? Theme.critical
        : Theme.control-stroke;
    background: !enabled
        ? (accent ? Theme.accent-soft : Theme.control-fill-disabled)
        : accent ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : subtle ? (touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent)
        : critical ? (touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : Theme.control-fill-solid)
        : (touch.pressed ? Theme.control-fill-pressed-solid : touch.has-hover ? Theme.control-fill-hover-solid : Theme.control-fill-solid);
    animate background { duration: Theme.duration-faster; easing: ease-out; }
    animate border-color { duration: Theme.duration-faster; easing: ease-out; }

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    // E1：键盘焦点环（仅键盘聚焦时可见）
    FocusRing {
        visible-ring: root.keyboard-focus && root.enabled;
        radius: root.border-radius;
        target-width: root.width;
        target-height: root.height;
    }

    // E1：键盘可达性 —— FocusScope 承载 Tab 焦点与 Enter/Space 触发；禁用时不可聚焦。
    // `focus-on-click: false`：不抢 TouchArea 的按下事件，鼠标点击的聚焦由 TouchArea 显式调用。
    button_focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
    }

    private property <bool> keyboard-focus: false;

    // 统一规则（§5.1）：水平内边距一律 12，图标↔文字 8；不再按 accent/subtle/有无图标分支
    HorizontalLayout {
        padding-left: Theme.spacing-12;
        padding-right: Theme.spacing-12;
        spacing: Theme.spacing-8;
        alignment: center;

        if root.icon != "" : Rectangle {
            width: Theme.icon-size-small;
            vertical-stretch: 1;
            background: transparent;

            Icon {
                name: root.icon;
                icon-color: root.text-color;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        label := Text {
            text: root.text;
            color: root.text-color;
            font-size: Theme.font-body;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            animate color { duration: Theme.duration-faster; easing: ease-out; }
        }
    }

    // 禁用强调色：软底 + 主文字，比 text-secondary 更易辨认（QC Connect 空态）。
    private property <brush> text-color: !root.enabled
        ? (root.accent ? Theme.text-primary : Theme.text-disabled)
        : root.accent ? Theme.accent-text
        : root.critical ? Theme.critical
        : Theme.text-primary;

    touch := TouchArea {
        // 鼠标按下即把焦点移入按钮（§3.5：点击聚焦但焦点环只在键盘路径显示）
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                button_focus.focus();
            }
        }
        clicked => { root.clicked(); }
    }

    // §5.7：所有可点按钮都要有悬停提示（文字钮 title 与可见文案一致或略完整）。
    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }

    /// 供宿主/弹窗把键盘焦点移入本按钮（`focus` 是内建函数名，不能直接复用）
    public function focus-button() {
        button_focus.focus();
    }
}

// 加载指示器：8 个点围成一圈，最亮的一个按相位绕圈（宿主每次刷新推进一格）。
//
// 点的位置写死（24×24 框、半径 10px、点 4px）：Slint 的 `Rectangle` 不支持旋转，
// 用固定位置 + 亮度相位实现同样的"转圈"观感。
export component WinSpinner inherits Rectangle {
    /// 相位（0..7）：宿主每次刷新推进一格。
    in property <int> phase: 0;
    in property <color> dot-color: Theme.text-secondary;

    width: 24px;
    height: 24px;
    background: transparent;

    /// 第 i 个点的横坐标（8 个点均分圆周）。
    pure function dot-x(index: int) -> length {
        if (index == 1 || index == 2) { return 17px; }
        if (index == 3 || index == 4) { return 10px; }
        if (index == 5 || index == 6) { return 3px; }
        return 20px;
    }

    /// 第 i 个点的纵坐标。
    pure function dot-y(index: int) -> length {
        if (index == 0 || index == 7) { return 0px; }
        if (index == 1 || index == 2) { return 3px; }
        if (index == 3 || index == 4) { return 17px; }
        return 20px;
    }

    /// 亮度：相位领先的那个最亮，越靠后越淡。
    pure function dot-opacity(index: int) -> float {
        return 1.0 - Math.mod(index - root.phase + 8, 8) * 0.11;
    }

    for i in 8 : Rectangle {
        x: root.dot-x(i);
        y: root.dot-y(i);
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.dot-color;
        opacity: root.dot-opacity(i);
    }
}

// 图标按钮：32×32 方形。
// 默认无底（面板头 / 菜单栏 / 标签条）；`bordered` 对齐原型 `.btn-icon`（管理器工具条）。
export component WinIconButton inherits Rectangle {
    in property <string> icon: "more";
    in property <string> accessible-name: "";
    /// Tooltip 文案（§5.7：图标化操作必须带提示）。空 = 不显示。
    /// 约定：与 `accessible-name` 用同一份文案，保证"看到的提示"和"读到的名字"一致。
    in property <string> tooltip-text: "";
    /// 原型 `.btn-icon`：1px control-stroke + solid 底（管理器工具条）。
    in property <bool> bordered: false;
    /// 主操作图标钮（accent 实底，如 Add）。
    in property <bool> accent: false;
    in property <bool> enabled <=> touch.enabled;
    callback clicked();
    /// 键盘焦点（E1）
    out property <bool> has-focus: button_focus.has-focus;

    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: root.bordered || root.accent ? 1px : 0px;
    border-color: !root.enabled ? Theme.control-stroke
        : root.accent ? Theme.accent
        : root.bordered ? Theme.control-stroke
        : transparent;
    background: !root.enabled
        ? (root.accent || root.bordered ? Theme.control-fill-disabled : transparent)
        : root.accent
            ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
            : root.bordered
                ? (touch.pressed ? Theme.control-fill-pressed-solid : touch.has-hover ? Theme.control-fill-hover-solid : Theme.control-fill-solid)
                : (touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent);
    animate background { duration: Theme.duration-faster; easing: ease-out; }
    animate border-color { duration: Theme.duration-faster; easing: ease-out; }

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.clicked(); }

    FocusRing {
        visible-ring: root.keyboard-focus && root.enabled;
        radius: root.border-radius;
        target-width: root.width;
        target-height: root.height;
    }

    // E1：与 WinButton 同款键盘壳（Tab 可达 + Enter/Space 触发 + 禁用不可聚焦）
    button_focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
    }

    private property <bool> keyboard-focus: false;

    Icon {
        name: root.icon;
        icon-color: !root.enabled ? Theme.text-disabled
            : root.accent ? Theme.accent-text
            : Theme.text-primary;
        // 纯图标按钮：32×32 命中区，图标 20 由 x/y 居中（不用 padding）
        icon-size: Theme.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // §5.7：图标化操作要有 Tooltip。
    if root.tooltip-text != "" : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                button_focus.focus();
            }
        }
        clicked => { root.clicked(); }
    }

    /// 供宿主把键盘焦点移入本按钮
    public function focus-button() {
        button_focus.focus();
    }
}

/// Fluent 分段控件（原型 `.methods`）：描边轨道 + 26px 段；选中 = accent 底。
export component WinMethodSeg inherits Rectangle {
    in property <[string]> labels: [];
    in-out property <int> selected-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    // 原型 `.methods`：`width: fit-content; max-width: field-w`——不跟着表单列拉满，
    // 否则会比上面的 Username / Password 输入框更宽一截。
    horizontal-stretch: 0;
    max-width: Theme.form-field-width;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.control-stroke;
    background: Theme.subtle-selected;
    opacity: root.enabled ? 1.0 : 0.4;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for label[index] in root.labels : Rectangle {
            height: Theme.control-height - 6px;
            border-radius: Theme.radius-control - 1px;
            background: index == root.selected-index ? Theme.accent
                : seg_touch.pressed ? Theme.subtle-pressed
                : seg_touch.has-hover ? Theme.subtle-hover
                : transparent;
            animate background { duration: Theme.duration-faster; easing: ease-out; }

            HorizontalLayout {
                padding-left: Theme.spacing-12;
                padding-right: Theme.spacing-12;
                alignment: center;

                Text {
                    text: label;
                    color: index == root.selected-index ? Theme.accent-text : Theme.text-primary;
                    font-size: Theme.font-label;
                    font-weight: index == root.selected-index ? Theme.weight-semibold : 400;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }

            seg_touch := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.selected-index = index;
                    root.selected(index);
                }
            }
        }
    }
}

// ---------------------------------------------------------------- 选择类（§5.3）
/// §5.3 Switch：轨道 40×20、滑块 12、位移动画 167ms（`Theme.duration-fast`）；
/// On = accent，Off = control-fill + control-stroke。整行（轨道 + 文案）可点。
///
/// 右侧状态文案（On/Off、Enabled/Disabled、Use/Don't use …）由调用方按原型给；
/// 空文案 = 只显示轨道（紧凑行/工具栏）。**文本型布尔一律用本组件**，不要用方框冒充开关。
export component WinSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled <=> touch.enabled;
    /// 右侧状态文案；空 = 不显示文案。
    in property <string> text: "";
    /// 无障碍名称（通常是同一 form-row 左侧的 label）。
    in property <string> accessible-name: "";
    callback toggled();
    /// 键盘焦点（E1）
    out property <bool> has-focus: switch_focus.has-focus;

    // 行高 32（= `control-height`）；轨道 20、文案行高与轨道在行内垂直居中。
    height: Theme.control-height;
    background: transparent;

    accessible-role: switch;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.text;
    accessible-action-default => { if (root.enabled) { root.toggle(); } }

    FocusRing {
        visible-ring: root.keyboard-focus && root.enabled;
        radius: Theme.radius-control;
        target-width: root.width;
        target-height: root.height;
    }

    // E1：键盘壳（Tab 可达 + Enter/Space 切换 + 禁用不可聚焦）
    switch_focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.toggle();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
    }

    private property <bool> keyboard-focus: false;

    // 轨道 + 右侧状态文案：普通横向布局（不再绝对定位 / 不再给 Text 显式 width），
    // 宽度由内容 preferred-width 决定。显式 width 与 preferred-width 会形成循环，
    // 窄容器里会塌成 48px 导致文案压到轨道上。
    content := HorizontalLayout {
        alignment: start;
        spacing: Theme.spacing-8;
        cross-axis-alignment: center;

        track := Rectangle {
            width: Theme.switch-width;
            height: Theme.switch-height;
            horizontal-stretch: 0;
            border-radius: Theme.switch-height / 2;
            border-width: 1px;
            border-color: !root.enabled ? Theme.control-stroke
                : root.checked ? Theme.accent
                : touch.has-hover ? Theme.text-secondary
                : Theme.control-stroke;
            background: !root.enabled ? Theme.control-fill-disabled
                : root.checked ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
                : touch.pressed ? Theme.control-fill-pressed-solid
                : touch.has-hover ? Theme.control-fill-hover-solid
                : Theme.control-fill-solid;
            animate background { duration: Theme.duration-fast; easing: ease-out; }
            animate border-color { duration: Theme.duration-fast; easing: ease-out; }

            // 滑块：Off 贴左（`switch-padding`），On 贴右。
            Rectangle {
                width: Theme.switch-knob-size;
                height: Theme.switch-knob-size;
                y: (parent.height - self.height) / 2;
                x: root.checked
                    ? parent.width - self.width - Theme.switch-padding
                    : Theme.switch-padding;
                border-radius: Theme.switch-knob-size / 2;
                background: !root.enabled ? Theme.text-disabled
                    : root.checked ? Theme.accent-text
                    : Theme.text-secondary;
                animate x { duration: Theme.duration-fast; easing: ease-out; }
                animate background { duration: Theme.duration-fast; easing: ease-out; }
            }
        }

        // 右侧上下文文案（可选；空文本不进布局）。原型 `.form-switch` = 13px。
        if root.text != "" : Text {
            text: root.text;
            color: !root.enabled ? Theme.text-disabled : Theme.text-secondary;
            font-size: Theme.font-label;
            vertical-alignment: center;
            horizontal-stretch: 0;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    // 组件宽度 = 轨道 + 可选文案；布局本身同样用 preferred-width，二者一致。
    width: content.preferred-width;

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                switch_focus.focus();
            }
        }
        clicked => { root.toggle(); }
    }

    function toggle() {
        root.checked = !root.checked;
        root.toggled();
    }

    /// 供宿主把键盘焦点移入本控件
    public function focus-switch() {
        switch_focus.focus();
    }
}

/// §5.3 CheckBox：20×20、圆角 4、选中 accent 实底 + check 图标。
/// 用于**多选/勾选**语义（权限九宫格、查找 regex 选项、确认框「不再询问」等），不是开关。
export component WinCheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled <=> touch.enabled;
    /// 右侧标签文案；空 = 只有勾选框（表格/紧凑行）。
    in property <string> text: "";
    /// 无障碍名称（无标签时必填）。
    in property <string> accessible-name: "";
    callback toggled();
    /// 键盘焦点（E1）
    out property <bool> has-focus: check_focus.has-focus;

    height: Theme.control-height;
    // 标签自然宽度用隐形 measure，勿把 label.width 绑回 parent.width，
    // 也勿 `width: layout.preferred-width`（父宽依赖子 preferred 会再次循环，
    // 确认框 Don't ask again 会把整窗撑崩/看不见）。
    width: Theme.choice-size + (root.text == "" ? 0px : Theme.spacing-8 + label-measure.preferred-width);
    background: transparent;

    accessible-role: checkbox;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.text;
    accessible-action-default => { if (root.enabled) { root.toggle(); } }

    FocusRing {
        visible-ring: root.keyboard-focus && root.enabled;
        radius: Theme.radius-control;
        target-width: root.width;
        target-height: root.height;
    }

    // E1：键盘壳（Tab 可达 + Enter/Space 切换 + 禁用不可聚焦）
    check_focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.toggle();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
    }

    private property <bool> keyboard-focus: false;

    // 仅测量：不参与命中、不设 width，避免与 root.width 互相依赖。
    label-measure := Text {
        visible: false;
        text: root.text;
        font-size: Theme.font-body;
        wrap: no-wrap;
    }

    marker := Rectangle {
        width: Theme.choice-size;
        height: Theme.choice-size;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-control;
        border-width: 1px;
        border-color: !root.enabled ? Theme.text-disabled : root.checked ? Theme.accent : Theme.text-secondary;
        background: !root.enabled ? Theme.control-fill-disabled
            : root.checked ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
            : touch.pressed ? Theme.control-fill-pressed-solid
            : touch.has-hover ? Theme.control-fill-hover-solid
            : Theme.control-fill-solid;
        animate background { duration: Theme.duration-faster; easing: ease-out; }
        animate border-color { duration: Theme.duration-faster; easing: ease-out; }

        Icon {
            visible: root.checked;
            name: "check";
            icon-color: root.enabled ? Theme.accent-text : Theme.text-disabled;
            icon-size: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    if root.text != "" : Text {
        x: Theme.choice-size + Theme.spacing-8;
        y: 0;
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Theme.text-disabled : Theme.text-primary;
        font-size: Theme.font-body;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                check_focus.focus();
            }
        }
        clicked => { root.toggle(); }
    }

    function toggle() {
        root.checked = !root.checked;
        root.toggled();
    }

    /// 供宿主把键盘焦点移入本控件
    public function focus-check() {
        check_focus.focus();
    }
}

/// §5.3 Radio：20×20 圆形标记 + 内圆点，用于互斥选项（如 Logging → Format）。
export component WinRadio inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled <=> touch.enabled;
    /// 右侧标签文案；空 = 只有圆形标记。
    in property <string> text: "";
    /// 无障碍名称（无标签时必填）。
    in property <string> accessible-name: "";
    callback toggled();
    /// 键盘焦点（E1）
    out property <bool> has-focus: radio_focus.has-focus;

    height: Theme.control-height;
    width: Theme.choice-size + (root.text == "" ? 0px : Theme.spacing-8 + label-text.preferred-width);
    background: transparent;

    // 互斥语义：已选中时再点不取消（与原生 radio 一致）。
    accessible-role: radio-button;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.text;
    accessible-action-default => { if (root.enabled) { root.toggle(); } }

    FocusRing {
        visible-ring: root.keyboard-focus && root.enabled;
        radius: Theme.choice-size / 2;
        target-width: root.width;
        target-height: root.height;
    }

    radio_focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.toggle();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
    }

    private property <bool> keyboard-focus: false;

    marker := Rectangle {
        width: Theme.choice-size;
        height: Theme.choice-size;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.choice-size / 2;
        border-width: 1px;
        border-color: !root.enabled ? Theme.text-disabled : root.checked ? Theme.accent : Theme.text-secondary;
        background: !root.enabled ? Theme.control-fill-disabled
            : touch.has-hover && !root.checked ? Theme.control-fill-hover-solid
            : Theme.control-fill-solid;
        animate background { duration: Theme.duration-faster; easing: ease-out; }
        animate border-color { duration: Theme.duration-faster; easing: ease-out; }

        Rectangle {
            visible: root.checked;
            width: Theme.choice-size / 2;
            height: Theme.choice-size / 2;
            border-radius: Theme.choice-size / 4;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.enabled ? Theme.accent : Theme.text-disabled;
            animate background { duration: Theme.duration-faster; easing: ease-out; }
        }
    }

    label-text := Text {
        visible: root.text != "";
        x: Theme.choice-size + Theme.spacing-8;
        y: 0;
        width: parent.width - (Theme.choice-size + Theme.spacing-8);
        height: parent.height;
        text: root.text;
        color: !root.enabled ? Theme.text-disabled : Theme.text-primary;
        font-size: Theme.font-body;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                radio_focus.focus();
            }
        }
        clicked => { root.toggle(); }
    }

    // 互斥语义：已选中时再点不取消。
    function toggle() {
        if (root.checked) {
            return;
        }
        root.checked = true;
        root.toggled();
    }

    /// 供宿主把键盘焦点移入本控件
    public function focus-radio() {
        radio_focus.focus();
    }
}

/// 工具栏/图标切换按钮（如文件面板「显示隐藏文件」）：32×32 命中区；
/// 选中 accent 前景 + accent-soft 底。语义是“切换动作”的图标按钮，
/// 不要用开关冒充；文本型布尔请用 `WinSwitch` / `WinCheckBox`。
export component WinIconToggle inherits Rectangle {
    in property <string> icon: "eye";
    /// 无障碍名称（图标按钮必填）。
    in property <string> accessible-name: "";
    in-out property <bool> checked: false;
    in property <bool> enabled <=> touch.enabled;
    callback toggled();
    /// 键盘焦点（E1）
    out property <bool> has-focus: toggle_focus.has-focus;

    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: !root.enabled ? Theme.control-stroke : root.checked ? Theme.accent : Theme.control-stroke;
    background: !root.enabled ? Theme.control-fill-disabled
        : root.checked ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent-soft)
        : touch.pressed ? Theme.control-fill-pressed-solid
        : touch.has-hover ? Theme.control-fill-hover-solid
        : Theme.control-fill-solid;
    animate background { duration: Theme.duration-faster; easing: ease-out; }
    animate border-color { duration: Theme.duration-faster; easing: ease-out; }

    accessible-role: checkbox;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.accessible-name;
    accessible-action-default => { if (root.enabled) { root.toggle(); } }

    FocusRing {
        visible-ring: root.keyboard-focus && root.enabled;
        radius: Theme.radius-control;
        target-width: root.width;
        target-height: root.height;
    }

    // E1：键盘壳（Tab 可达 + Enter/Space 切换 + 禁用不可聚焦）
    toggle_focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.toggle();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
    }

    private property <bool> keyboard-focus: false;

    Icon {
        name: root.icon;
        icon-color: !root.enabled ? Theme.text-disabled : root.checked ? Theme.accent : Theme.text-primary;
        icon-size: Theme.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                toggle_focus.focus();
            }
        }
        clicked => { root.toggle(); }
    }

    function toggle() {
        root.checked = !root.checked;
        root.toggled();
    }

    /// 供宿主把键盘焦点移入本控件
    public function focus-toggle() {
        toggle_focus.focus();
    }
}

// ---------------------------------------------------------------- 卡片
/// 卡片容器：调用方通过 `@children` 提供内容（列布局）
export component WinCard inherits Rectangle {
    background: Theme.card-fill;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.card-stroke;

    VerticalLayout {
        padding: Theme.spacing-12;
        spacing: Theme.spacing-8;
        @children
    }
}

/// 卡片标题行：可选图标 + 标题 + 右侧操作（`@children`）
export component WinCardHeader inherits Rectangle {
    in property <string> title: "";
    in property <string> icon: "";
    height: Theme.control-height;
    background: transparent;

    HorizontalLayout {
        // 卡片头本身无内边距（外层卡片提供 12）：图标 16 ↔ 文字 8
        spacing: Theme.spacing-8;

        if root.icon != "" : Rectangle {
            width: Theme.icon-size-small;
            vertical-stretch: 1;

            Icon {
                name: root.icon;
                icon-color: Theme.text-secondary;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            wrap: no-wrap;
            // E3：标题让位于右侧操作区，长标题省略而不是撑破卡片
            overflow: elide;
            horizontal-stretch: 1;
        }

        @children
    }
}

// ---------------------------------------------------------------- 列表 / 导航
/// 导航项（NavigationView 形态）：40px 行高，选中态带 3×16 强调条
export component WinNavItem inherits Rectangle {
    in property <string> icon: "terminal";
    in property <string> text: "";
    /// 右侧次要信息（如用户名 / 状态）
    in property <string> detail: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    /// 二级缩进（会话树子项）
    in property <bool> indented: false;
    callback clicked();

    height: Theme.row-height-nav;
    border-radius: Theme.radius-control;
    background: !enabled ? transparent
        : selected ? Theme.subtle-selected
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    // E19：读屏可读的列表项语义（选中态用 item-selected 表达）
    accessible-role: list-item;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;

    // §8「焦点可见」：导航项必须键盘可达 + 有焦点环
    // （此前分区导航完全没有 FocusScope，Tab 走不到、也没有焦点提示）。
    FocusRing {
        visible-ring: root.keyboard-focus && root.enabled;
        radius: root.border-radius;
        target-width: root.width;
        target-height: root.height;
    }

    nav_focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
    }

    private property <bool> keyboard-focus: false;

    // 选中指示条（原型 `.nav-item`：left 4 · 3×16）
    Rectangle {
        visible: root.selected;
        x: 4px;
        y: (parent.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: root.indented ? 32px : 12px;
        padding-right: 8px;
        spacing: 12px;
        // 固定高度图标盒 + 交叉轴居中，避免 stretch 行里图标相对文字光学偏下（MCP link 等）。
        cross-axis-alignment: center;

        Rectangle {
            width: Theme.icon-size;
            height: Theme.icon-size;
            background: transparent;

            Icon {
                name: root.icon;
                icon-color: root.enabled ? Theme.text-primary : Theme.text-disabled;
                // 与包裹容器同源：容器宽 = Theme.icon-size，图标也显式取同一 token
                icon-size: Theme.icon-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.text;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
            font-size: Theme.font-body;
            font-weight: root.selected ? Theme.weight-semibold : 400;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.detail != "" : Text {
            text: root.detail;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            // E3：次要信息不能让主文本被挤没，也不能溢出容器
            overflow: elide;
            horizontal-stretch: 0;
            max-width: Theme.nav-width / 2;
        }
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                nav_focus.focus();
            }
        }
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

/// 列表行（文件列表 / 传输队列）
export component WinListRow inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <string> detail: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> alternate: false;
    callback clicked();
    callback double-clicked();

    height: Theme.row-height-list;
    border-radius: Theme.radius-control;
    background: !enabled ? transparent
        : selected ? Theme.subtle-selected
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover
        : alternate ? Theme.card-fill : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    // E19：读屏可读的列表项语义
    accessible-role: list-item;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        if root.icon != "" : Rectangle {
            width: Theme.icon-size-small;
            vertical-stretch: 1;
            background: transparent;

            Icon {
                name: root.icon;
                icon-color: root.selected ? Theme.accent : Theme.text-secondary;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.text;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
            font-size: Theme.font-body;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.detail != "" : Text {
            text: root.detail;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            // E3：次要信息不能溢出容器
            overflow: elide;
            horizontal-stretch: 0;
            max-width: Theme.nav-width / 2;
        }
    }

    touch := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
        double-clicked => { if (root.enabled) { root.double-clicked(); } }
    }
}

// ---------------------------------------------------------------- 标签页 / Pivot
/// 工作区标签（TabView 形态，32px 行高，可关闭）
export component WinTab inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> active: false;
    in property <bool> closable: true;
    callback clicked();
    callback close-requested();

    height: Theme.bar-height-tabs;
    horizontal-stretch: 0;
    border-radius: Theme.radius-control;
    // 原型 `.tab[aria-selected=true]`：底透明，仅底部 accent 指示条。
    background: active ? transparent : tab-hover.pressed ? Theme.subtle-pressed : tab-hover.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    // E19：标签语义（参考 1.18 内建 Tab 的实现：tab + item-selected）
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;

    // 活动标签底部强调条（原型 left/right inset 8）
    Rectangle {
        // §6.3 #7：切换标签时强调条淡入淡出（100ms / ease-out）。
        opacity: root.active ? 1.0 : 0.0;
        animate opacity { duration: Theme.duration-faster; easing: ease-out; }
        x: 8px;
        y: parent.height - 2px;
        width: parent.width - 16px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }

    HorizontalLayout {
        // 标签页例外（审计规则）：文本左 10；有关闭按钮时右 4，关闭按钮 18×18、间距 8
        padding-left: 10px;
        padding-right: root.closable ? 4px : 10px;
        spacing: Theme.spacing-8;
        alignment: center;

        if root.icon != "" : Rectangle {
            width: Theme.icon-size-small;
            vertical-stretch: 1;
            background: transparent;

            Icon {
                name: root.icon;
                icon-color: root.active ? Theme.text-primary : Theme.text-secondary;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.text;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }

        if root.closable : Rectangle {
            // §5.6：关闭按钮 16px、圆角 4；命中区仍是 32×32。
            width: 16px;
            height: 16px;
            // 关闭钮是写死 16px 的固定尺寸子项 → 显式交叉轴居中。
            // 不能用手写 `y:`：本行一旦出现 cross-axis-* 对齐，布局会绑定每个子项的 y。
            cross-axis-self-alignment: center;
            border-radius: Theme.radius-control;
            background: close-touch.pressed ? Theme.subtle-pressed : close-touch.has-hover ? Theme.control-fill-hover : transparent;

            Icon {
                name: "close";
                icon-color: Theme.text-secondary;
                icon-size: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            close-touch := TouchArea {
                // 命中区 32×32（§8 最小点击目标）：视觉盒仍 18×18、图标 12 不变。
                // 相对视觉盒偏移：x = 18 + 4 − 32 = −10（右缘落在标签右内边距 4px 处 = 标签右缘），
                // y = (18 − 32) / 2 = −7（纵向覆盖 0..32，正好是 32px 标签高度）。
                // 命中区不参与布局，不撑大标签；左/上/下超出视觉盒但完整落在标签内。
                width: Theme.control-height;
                height: Theme.control-height;
                x: parent.width + Theme.spacing-4 - self.width;
                y: (parent.height - self.height) / 2;
                clicked => { root.close-requested(); }
            }
        }
    }

    tab-hover := TouchArea {
        // 关闭命中区（右 32px）让给 close-touch：整标签命中区声明在布局之后，
        // 输入遍历会先命中它，否则关闭点击会被标签本体抢走。
        width: root.closable ? parent.width - Theme.control-height : parent.width;
        clicked => { root.clicked(); }
    }
}

/// Pivot / 分段切换项（右侧工具面板顶部）
export struct PivotItem {
    title: string,
    icon: string,
}

export component WinPivotBar inherits Rectangle {
    in property <[PivotItem]> items: [];
    in-out property <int> current: 0;
    callback selected(int);

    height: Theme.control-height;
    background: transparent;

    HorizontalLayout {
        padding: 2px;
        spacing: 4px;

        for item[i] in root.items : Rectangle {
            height: Theme.control-height - Theme.spacing-4;
            border-radius: Theme.radius-control;
            background: i == root.current ? Theme.layer-fill : pivot-touch.pressed ? Theme.subtle-pressed : pivot-touch.has-hover ? Theme.subtle-hover : transparent;
            animate background { duration: Theme.duration-faster; easing: ease-out; }

            HorizontalLayout {
                padding-left: Theme.spacing-12;
                padding-right: Theme.spacing-12;
                spacing: Theme.spacing-8;
                alignment: center;

                Rectangle {
                    width: Theme.icon-size-small;
                    vertical-stretch: 1;
                    background: transparent;

                    Icon {
                        name: item.icon;
                        icon-color: i == root.current ? Theme.text-primary : Theme.text-secondary;
                        icon-size: Theme.icon-size-small;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: item.title;
                    color: i == root.current ? Theme.text-primary : Theme.text-secondary;
                    font-size: Theme.font-body;
                    font-weight: i == root.current ? Theme.weight-semibold : 400;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    // E3：长标题省略，不撑破分段条
                    overflow: elide;
                }
            }

            pivot-touch := TouchArea {
                clicked => { root.current = i; root.selected(i); }
            }
        }
    }
}

// ---------------------------------------------------------------- 提示条
/// InfoBar：安全提示 / 连接告警（warning 用于主机密钥变更）
export component WinInfoBar inherits Rectangle {
    /// "info" | "success" | "warning" | "error"
    in property <string> severity: "warning";
    in property <string> title: "";
    in property <string> text: "";
    callback dismissed();

    // 图标按 severity 选择：现有图标集没有 info / error 专用图标，
    // info 用 shield、error 用 warning（语义最接近）；未知 severity 回退 warning。
    private property <string> severity-icon:
        root.severity == "success" ? "check"
        : root.severity == "error" ? "warning"
        : root.severity == "info" ? "shield"
        : "warning";
    // 图标语义色（E4：背景/描边/文字按 severity 分档，见下方 banner-* token）
    private property <brush> severity-icon-color:
        root.severity == "success" ? Theme.success
        : root.severity == "error" ? Theme.critical
        : root.severity == "info" ? Theme.text-secondary
        : Theme.caution;
    // E4：不再让 success/error 共用 warning 的黄底
    private property <brush> severity-background:
        root.severity == "success" ? Theme.banner-success-background
        : root.severity == "error" ? Theme.banner-error-background
        : root.severity == "info" ? Theme.banner-info-background
        : Theme.banner-warning-background;
    private property <brush> severity-stroke:
        root.severity == "success" ? Theme.banner-success-stroke
        : root.severity == "error" ? Theme.banner-error-stroke
        : root.severity == "info" ? Theme.banner-info-stroke
        : Theme.banner-warning-stroke;
    private property <brush> severity-text:
        root.severity == "success" ? Theme.banner-success-text
        : root.severity == "error" ? Theme.banner-error-text
        : root.severity == "info" ? Theme.banner-info-text
        : Theme.banner-warning-text;

    background: root.severity-background;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: root.severity-stroke;

    HorizontalLayout {
        padding: Theme.spacing-12;
        spacing: Theme.spacing-12;
        alignment: start;

        Icon {
            name: root.severity-icon;
            icon-color: root.severity-icon-color;
        }

        VerticalLayout {
            spacing: 4px;
            alignment: start;

            if root.title != "" : Text {
                text: root.title;
                color: root.severity-text;
                font-size: Theme.font-body;
                font-weight: Theme.weight-semibold;
                wrap: word-wrap;
            }

            if root.text != "" : Text {
                text: root.text;
                color: root.severity-text;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            @children
        }
    }
}

// ---------------------------------------------------------------- 下拉（ComboBox）
/// §5.2 ComboBox：32px 高、`control-fill` 底 + `control-stroke` 描边；展开用
/// PopupWindow（菜单形态 §5.11：勾选当前项、点选关闭）。
///
/// 不做系统字体枚举——选项由调用方投影（D15：预设 + 已导入路径）。
export component WinComboBox inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    /// 无选中或越界时的占位文案。
    in property <string> placeholder-text: "";
    /// 可选：把 `model` 里的稳定 id 映射为界面文案（i18n 场景由 `@tr` 模板函数提供）。
    /// 默认关闭；未开启时行为不变（直接显示 model 文本）。
    in property <bool> has-label-map: false;
    pure callback label-for(string) -> string;
    callback selected(int);

    private property <string> current-text:
        root.current-index >= 0 && root.current-index < root.model.length
            ? (root.has-label-map
                ? root.label-for(root.model[root.current-index])
                : root.model[root.current-index])
            : "";

    height: Theme.control-height;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    // 原型：描边保持 control-stroke；悬停只改底色；聚焦用底部 accent 条。
    border-color: Theme.control-stroke;
    background: !root.enabled ? Theme.control-fill-disabled
        : combo_focus.has-focus ? Theme.card-fill
        : touch.pressed ? Theme.control-fill-pressed-solid
        : touch.has-hover ? Theme.control-fill-hover-solid
        : Theme.control-fill-solid;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-label: root.current-text != "" ? root.current-text : root.placeholder-text;

    FocusRing {
        visible-ring: root.keyboard-focus && root.enabled;
        radius: root.border-radius;
        target-width: root.width;
        target-height: root.height;
    }

    // 聚焦时底部 2px 强调条（与 WinTextInput 同形态）
    Rectangle {
        visible: combo_focus.has-focus && root.enabled;
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }

    HorizontalLayout {
        // 原型 `.select` 左内边距 10；右侧留给 chevron。
        padding-left: 10px;
        padding-right: Theme.spacing-8;
        spacing: Theme.spacing-8;

        Text {
            text: root.current-text != "" ? root.current-text : root.placeholder-text;
            color: !root.enabled ? Theme.text-disabled
                : root.current-text != "" ? Theme.text-primary
                : Theme.text-tertiary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: no-wrap;
            overflow: elide;
        }

        Rectangle {
            width: Theme.icon-size-small;
            vertical-stretch: 1;
            background: transparent;

            Icon {
                name: "chevron-down";
                icon-color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    private property <bool> keyboard-focus: false;

    combo_focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                popup.show();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { root.keyboard-focus = false; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                combo_focus.focus();
            }
        }
        clicked => { popup.show(); }
    }

    // close-on-click-outside：点选项本身不立刻关掉，由点击回调里 close()。
    popup := PopupWindow {
        width: max(root.width, 180px);
        y: root.height + 2px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.flyout-background;
            border-width: 1px;
            border-color: Theme.card-stroke;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-color: Theme.shadow-color;
            drop-shadow-offset-y: Theme.shadow-offset-y;
            height: items-layout.preferred-height;

            items-layout := VerticalLayout {
                padding: 4px;
                spacing: 0px;

                for item[index] in root.model : Rectangle {
                    height: Theme.row-height-list;
                    border-radius: Theme.radius-control;
                    background: item_touch.pressed ? Theme.subtle-pressed : item_touch.has-hover ? Theme.subtle-hover : transparent;

                    HorizontalLayout {
                        padding-left: Theme.spacing-8;
                        padding-right: Theme.spacing-8;
                        spacing: Theme.spacing-8;

                        // 勾选列 16px（§5.11）
                        Rectangle {
                            width: Theme.icon-size-small;
                            vertical-stretch: 1;
                            background: transparent;

                            if index == root.current-index : Icon {
                                name: "check";
                                icon-color: Theme.accent;
                                icon-size: Theme.icon-size-small;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: root.has-label-map ? root.label-for(item) : item;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }

                    item_touch := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.selected(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- 滚动提示
/// 可滚动区域的 4px 自绘滚动提示（E22）：不参与布局、不吞鼠标事件，
/// 由调用方叠加在滚动区右/下缘；形态与 settings 的自绘条一致（4px 圆角条）。
///
/// 用法：
///   WinScrollIndicator {
///       x: scroll-area.width - self.width - Theme.spacing-4;   // 垂直滚动时贴右缘
///       height: scroll-area.height - 2 * Theme.spacing-4;
///       viewport-position: flick.content-y;   // 绑 Flickable.content-x/-y（≤0）
///       content-extent: flick.content-height; // 绑 content-width/-height
///       viewport-extent: flick.height;        // 绑 Flickable 自身宽/高
///   }
export component WinScrollIndicator inherits Rectangle {
    /// 滚动位置：`Flickable.content-x/-y`（0 = 起点，负值 = 已滚动）
    in property <length> viewport-position: 0px;
    /// 内容总尺寸：`Flickable.content-width/-height`
    in property <length> content-extent: 0px;
    /// 视口尺寸：Flickable 自身宽/高
    in property <length> viewport-extent: 0px;
    in property <length> track-width: Theme.spacing-4;
    /// 滑块长度下限（settings 的竖向列表用 24px；标签条这类 24–28px 短轨道应传更小值）
    in property <length> thumb-min-length: 16px;

    width: track-width;
    visible: root.content-extent > root.viewport-extent + 0.5px;
    background: transparent;

    // 滑块长度 = 视口/内容，下限保证可辨
    private property <float> thumb-extent: Math.max(
        self.height / 1px * Math.min(1.0, root.viewport-extent / Math.max(1px, root.content-extent)),
        root.thumb-min-length / 1px
    );
    // 进度：0 = 起点，1 = 终点。viewport-position ≤ 0，取负才是前进量。
    private property <float> progress: Math.max(
        0.0,
        Math.min(1.0, -root.viewport-position / Math.max(1px, root.content-extent - root.viewport-extent))
    );

    Rectangle {
        width: parent.width;
        height: root.thumb-extent * 1px;
        y: (parent.height - self.height) * root.progress;
        border-radius: self.width / 2;
        background: Theme.text-tertiary;
    }
}
