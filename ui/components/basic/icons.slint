// Fluent 风格线性图标（20×20 viewBox，1.5px 描边，PNG 40×40 资源）。
//
// 规范：docs/product/ui-winui3-design-language.md §5.16
// 用法：Icon { name: "plus"; icon-color: Theme.text-primary; }
//
// 为什么是位图而不是矢量 Path：Slint 的软件渲染器不实现 Path（draw_path 为空），
// 矢量图标会完全不可见。资源由 scripts/ui-icons/generate.sh 从 SVG 源生成，
// 通过 Image.colorize 跟随主题着色（悬停/选中/禁用状态都能变色）。

import { Theme } from "../../theme.slint";

export component Icon inherits Image {
    in property <string> name: "plus";
    in property <brush> icon-color: Theme.text-primary;
    in property <length> icon-size: Theme.icon-size;

    width: icon-size;
    height: icon-size;
    image-fit: contain;
    colorize: icon-color;

    source:
        name == "check" ? @image-url("../../icons/check.png")
        : name == "chevron-down" ? @image-url("../../icons/chevron-down.png")
        : name == "chevron-left" ? @image-url("../../icons/chevron-left.png")
        : name == "chevron-right" ? @image-url("../../icons/chevron-right.png")
        : name == "clear" ? @image-url("../../icons/clear.png")
        : name == "close" ? @image-url("../../icons/close.png")
        : name == "code" ? @image-url("../../icons/code.png")
        : name == "connect" ? @image-url("../../icons/connect.png")
        : name == "copy" ? @image-url("../../icons/copy.png")
        : name == "download" ? @image-url("../../icons/download.png")
        : name == "edit" ? @image-url("../../icons/edit.png")
        : name == "eye" ? @image-url("../../icons/eye.png")
        : name == "file" ? @image-url("../../icons/file.png")
        : name == "folder" ? @image-url("../../icons/folder.png")
        : name == "globe" ? @image-url("../../icons/globe.png")
        : name == "home" ? @image-url("../../icons/home.png")
        : name == "link" ? @image-url("../../icons/link.png")
        : name == "minus" ? @image-url("../../icons/minus.png")
        : name == "more" ? @image-url("../../icons/more.png")
        : name == "paste" ? @image-url("../../icons/paste.png")
        : name == "pause" ? @image-url("../../icons/pause.png")
        : name == "play" ? @image-url("../../icons/play.png")
        : name == "plus" ? @image-url("../../icons/plus.png")
        : name == "refresh" ? @image-url("../../icons/refresh.png")
        : name == "search" ? @image-url("../../icons/search.png")
        : name == "settings" ? @image-url("../../icons/settings.png")
        : name == "shield" ? @image-url("../../icons/shield.png")
        : name == "terminal" ? @image-url("../../icons/terminal.png")
        : name == "trash" ? @image-url("../../icons/trash.png")
        : name == "up" ? @image-url("../../icons/up.png")
        : name == "upload" ? @image-url("../../icons/upload.png")
        : name == "warning" ? @image-url("../../icons/warning.png")
        : @image-url("../../icons/plus.png");
}
