// 状态栏（26px）：连接态圆点 + 目标摘要 + 状态文案 + 弹性空白 + 右侧日志区（N6）。
//
// 拆分自 `ui/main_window.slint`（R1 结构重构）：只搬代码，不改布局/文案/行为。
// WP1：左侧增加连接状态点（连接中呼吸）+ user@host 摘要 + busy 指示。
import { Theme } from "../theme.slint";
import { Icon } from "basic/icons.slint";

export component StatusBar inherits Rectangle {
    // A32（D14）：默认空（宿主投影启动时写入，避免闪现英文 "Ready"）。
    in property <string> message: "";
    /// WP1：连接态 id（`idle` / `connecting` / `connected` / `failed` / `disconnected` / `pending`）。
    in property <string> connection-state: "idle";
    /// WP1：`user@host:port` 摘要（无会话时为空）。
    in property <string> connection-target: "";
    /// WP1：握手/连接进行中。
    in property <bool> busy: false;
    /// N6：日志区是否可用（有活动会话）。
    in property <bool> logging-usable: false;
    /// N6：活动会话是否正在记录（REC 圆点）。
    in property <bool> logging-active: false;
    /// N6：日志区文案（宿主渲染；空 = 只显示入口标签）。
    in property <string> logging-text: "";
    // --- N9：同步发送按键（chip + 一键停止 + 一次性提示）------------------------
    /// 是否正在同步发送按键。
    in property <bool> sync-active: false;
    /// 同步目标数（宿主渲染 `SYNC → n targets` 的输入）。
    in property <int> sync-target-count: 0;
    /// 目标选择模式 id（`all`/`visible`/`selected`；供 accessible label/说明）。
    in property <string> sync-mode-text: "all";
    /// chip 文案（宿主用 @tr 模板渲染；空 = 无同步）。
    in property <string> sync-text: "";
    /// 一次性提示（目标断开移除 / 控制键广播 / 源关闭；空 = 无）。
    in property <string> sync-notice-text: "";
    /// 终端视口列×行（无活动会话时为 0，不显示）。
    in property <int> terminal-cols: 0;
    in property <int> terminal-rows: 0;
    /// 光标列/行（0-based 投影；显示为 1-based）。
    in property <int> cursor-col: 0;
    in property <int> cursor-row: 0;

    callback logging-clicked();
    callback sync-stop-clicked();

    // 固定高度 + 不参与纵向拉伸：Slint 1.18 起 stretch 默认为 1，否则会被
    // 主内容区挤扁，表现为状态栏「消失一截」。
    height: Theme.bar-height-status;
    vertical-stretch: 0;
    clip: true;
    background: Theme.layer-fill;

    property <color> connection-dot-color:
        root.connection-state == "connected" ? Theme.success
        : root.connection-state == "connecting" || root.connection-state == "pending" ? Theme.caution
        : root.connection-state == "failed" ? Theme.critical
        : Theme.text-tertiary;

    HorizontalLayout {
        padding-left: Theme.spacing-12;
        padding-right: Theme.spacing-12;
        spacing: Theme.spacing-8;
        cross-axis-alignment: center;

        // WP1：连接状态点（连接中 1.5s 呼吸；设计 §6.3）。
        if root.connection-target != "" : Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.connection-dot-color;
            opacity: root.connection-state == "connecting" ? 0.4 : 1.0;
            animate opacity {
                // §6.3 连接中呼吸（1.5s 无限 alternate）。
                // 时长必须绑 Theme token，否则"减少动画"关不掉它（§6.4.4）。
                duration: Theme.duration-breathe;
                easing: ease-in-out;
                iteration-count: root.connection-state == "connecting" ? -1 : 0;
                direction: alternate;
            }
            accessible-role: none;
            vertical-stretch: 0;
        }

        // §8「状态不靠颜色」：圆点之外补一个状态词，
        // 否则绿点/黄点/红点只能靠颜色区分（读屏用户更是什么都拿不到）。
        if root.connection-target != "" : Text {
            text: root.connection-state == "connected" ? @tr("StatusBar" => "Connected")
                : root.connection-state == "connecting" ? @tr("StatusBar" => "Connecting")
                : root.connection-state == "pending" ? @tr("StatusBar" => "Pending")
                : root.connection-state == "failed" ? @tr("StatusBar" => "Failed")
                : @tr("StatusBar" => "Disconnected");
            color: root.connection-state == "connected" ? Theme.text-primary
                : root.connection-state == "failed" ? Theme.critical
                : Theme.text-secondary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            horizontal-stretch: 0;
        }

        // 失败态状态文案已含 user@host，再显示 target 会叠成难辨的一长串。
        // stretch + min-width:0：窄窗下优先 elide 目标，把中间 message 留给状态文案。
        if root.connection-target != "" && root.connection-state != "failed" : Text {
            text: root.connection-target;
            color: Theme.text-primary;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }

        // P2：Busy 仅在非 connecting/pending 时显示（连接中已有呼吸点，避免叠字）。
        if root.busy && root.connection-state != "connecting" && root.connection-state != "pending" : Text {
            text: @tr("StatusBar" => "Busy");
            color: Theme.caution;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            horizontal-stretch: 0;
        }

        // 消息吃掉中间剩余宽度并 elide，避免长文案把右侧尺寸/日志区顶出可视范围。
        Text {
            text: root.message;
            color: Theme.text-secondary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }

        // 终端尺寸 + 光标（有活动视口时显示；光标按 1-based 给用户看）。
        if root.terminal-cols > 0 && root.terminal-rows > 0 : Text {
            text: @tr("StatusBar" => "{0}×{1}", root.terminal-cols, root.terminal-rows);
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            font-family: Theme.font-mono;
            vertical-alignment: center;
            wrap: no-wrap;
            horizontal-stretch: 0;
        }

        if root.terminal-cols > 0 && root.terminal-rows > 0 : Text {
            text: @tr("StatusBar" => "{0}:{1}", root.cursor-col + 1, root.cursor-row + 1);
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            font-family: Theme.font-mono;
            vertical-alignment: center;
            wrap: no-wrap;
            horizontal-stretch: 0;
        }

        // N9：同步发送按键 chip（`SYNC → n targets` + 一键停止）与一次性提示。
        // 整条 chip 是命中区：点击 = 停止同步（非同步态 = 清除残留提示）。
        if root.sync-active || root.sync-notice-text != "" : Rectangle {
            min-width: 32px;
            border-radius: Theme.radius-control;
            background: sync-touch.pressed ? Theme.subtle-pressed
                : sync-touch.has-hover ? Theme.subtle-hover
                : (root.sync-notice-text != "" ? Theme.attention-background : transparent);
            animate background { duration: Theme.duration-faster; easing: ease-out; }

            HorizontalLayout {
                padding-left: Theme.spacing-8;
                padding-right: Theme.spacing-8;
                spacing: Theme.spacing-4;
                alignment: center;

                if root.sync-active : Text {
                    text: root.sync-text;
                    color: Theme.accent;
                    font-size: Theme.font-caption;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }

                if root.sync-notice-text != "" : Text {
                    text: root.sync-notice-text;
                    color: Theme.caution;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }

                // 一键停止的可点提示（步进/键盘可操作：整条 chip 是 button 角色的命中区）。
                // 12px 图标是写死尺寸的子项 → 显式交叉轴居中，否则贴行顶、高于文字。
                if root.sync-active : Icon {
                    name: "close";
                    icon-color: Theme.accent;
                    icon-size: 12px;
                    cross-axis-self-alignment: center;
                }
            }

            sync-touch := TouchArea {
                accessible-role: button;
                accessible-label: root.sync-active
                    ? @tr("StatusBar" => "Stop sending key input")
                    : @tr("StatusBar" => "Dismiss key input sync notice");
                clicked => { root.sync-stop-clicked(); }
            }
        }

        // N6：日志入口（REC 指示 + 文案；点击 = 日志菜单，与终端右键菜单同一入口）。
        if root.logging-usable : Rectangle {
            // A10：命中区至少 32px 宽（§8）。状态栏本身只有 26px 高，纵向命中
            // 受 bar-height-status token 限制（详见 WS-A 报告遗留）。
            min-width: 32px;
            border-radius: Theme.radius-control;
            background: logging-touch.pressed ? Theme.subtle-pressed : logging-touch.has-hover ? Theme.subtle-hover : transparent;
            animate background { duration: Theme.duration-faster; easing: ease-out; }

            HorizontalLayout {
                padding-left: Theme.spacing-8;
                padding-right: Theme.spacing-8;
                spacing: Theme.spacing-4;
                alignment: center;

                // REC 圆点：仅在记录中显示（避免静态元素占位）。
                // 文本等价物：`logging-text` 已渲染 "REC · 模式 · 文件"，下面的
                // accessible-label 同时覆盖"正在记录"与入口语义。
                if root.logging-active : Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.critical;
                    // 写死 8px 的圆点 → 显式交叉轴居中（否则贴 chip 顶边）。
                    cross-axis-self-alignment: center;
                }

                Text {
                    text: root.logging-text;
                    color: root.logging-active ? Theme.text-primary : Theme.text-secondary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }

            logging-touch := TouchArea {
                accessible-role: button;
                accessible-label: root.logging-active
                    ? @tr("StatusBar" => "Recording — open logging menu")
                    : @tr("StatusBar" => "Logging — open logging menu");
                clicked => { root.logging-clicked(); }
            }
        }
    }
}
