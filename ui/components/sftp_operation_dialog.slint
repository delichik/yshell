import { Theme } from "../theme.slint";
import { WinButton } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

// Modal used for the SFTP operations that need form input. The visible fields
// depend on `operation`: upload / download / edit / save-edit / cancel-edit /
// mkdir / rename / chmod. The runtime callbacks are wired by MainWindow.
// 形态：WinUI 3 ContentDialog（§5.10）——宽表单弹窗，右对齐操作区（主操作在右）。

export component SftpOperationDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> operation: "none";
    in-out property <string> path-text: "";
    in-out property <string> local-path-text: "";
    in-out property <string> secondary-text: "";
    in-out property <string> permissions-text: "644";

    callback confirmed();
    callback canceled();

    function shows-path() -> bool {
        return root.operation == "upload" || root.operation == "download" || root.operation == "edit" || root.operation == "rename" || root.operation == "chmod";
    }

    function shows-local-path() -> bool {
        return root.operation == "upload" || root.operation == "download";
    }

    function shows-secondary() -> bool {
        return root.operation == "mkdir" || root.operation == "rename";
    }

    function shows-permissions() -> bool {
        return root.operation == "chmod";
    }

    function title-text() -> string {
        if (root.operation == "upload") { return @tr("Upload File"); }
        if (root.operation == "download") { return @tr("Download File"); }
        if (root.operation == "edit") { return @tr("Edit Remote File"); }
        if (root.operation == "save-edit") { return @tr("Save Remote Edit"); }
        if (root.operation == "cancel-edit") { return @tr("Cancel Remote Edit"); }
        if (root.operation == "mkdir") { return @tr("New Folder"); }
        if (root.operation == "rename") { return @tr("Rename Remote Path"); }
        if (root.operation == "chmod") { return @tr("Change Permissions"); }
        return @tr("SFTP Operation");
    }

    function primary-label() -> string {
        if (root.operation == "upload") { return @tr("Upload"); }
        if (root.operation == "download") { return @tr("Download"); }
        if (root.operation == "edit") { return @tr("Start Remote Edit"); }
        if (root.operation == "save-edit") { return @tr("Save Remote Edit"); }
        if (root.operation == "cancel-edit") { return @tr("Cancel Remote Edit"); }
        if (root.operation == "mkdir") { return @tr("Create Folder"); }
        if (root.operation == "rename") { return @tr("Rename"); }
        if (root.operation == "chmod") { return @tr("Apply Chmod"); }
        return @tr("Run");
    }

    function hint-text() -> string {
        if (root.operation == "upload") { return @tr("Remote target is optional: leave it empty to upload into the current directory using the local file name."); }
        if (root.operation == "download") { return @tr("Downloads the remote file into the local destination path."); }
        if (root.operation == "edit") { return @tr("Downloads a temporary copy and tracks changes until Save Remote Edit or Cancel Remote Edit."); }
        if (root.operation == "save-edit") { return @tr("Uploads the edited local temp copy back to the remote path."); }
        if (root.operation == "cancel-edit") { return @tr("Discards the active remote edit session and removes the local temp file."); }
        if (root.operation == "mkdir") { return @tr("Relative paths resolve from the current remote directory."); }
        if (root.operation == "rename") { return @tr("Relative new paths resolve from the current remote directory."); }
        if (root.operation == "chmod") { return @tr("Applies the octal permission bits to the remote path."); }
        return "";
    }

    function path-label() -> string {
        if (root.operation == "upload") { return @tr("Remote target path (optional)"); }
        if (root.operation == "download") { return @tr("Remote source path"); }
        if (root.operation == "edit") { return @tr("Remote file to edit"); }
        if (root.operation == "rename") { return @tr("Remote path to rename"); }
        return @tr("Remote path");
    }

    function local-path-label() -> string {
        if (root.operation == "download") { return @tr("Local destination path"); }
        return @tr("Local file path");
    }

    function secondary-label() -> string {
        if (root.operation == "mkdir") { return @tr("New folder path"); }
        return @tr("New path");
    }

    function primary-enabled() -> bool {
        if (root.operation == "upload") { return root.local-path-text != ""; }
        if (root.operation == "download") { return root.local-path-text != "" && root.path-text != ""; }
        if (root.operation == "edit") { return root.path-text != ""; }
        if (root.operation == "mkdir") { return root.secondary-text != ""; }
        if (root.operation == "rename") { return root.path-text != "" && root.secondary-text != ""; }
        if (root.operation == "chmod") { return root.path-text != "" && root.permissions-text != ""; }
        return true;
    }

    /// 破坏性操作（删除远端条目、丢弃远程编辑内容）：主按钮用 critical 文案色
    function is-destructive() -> bool {
        return root.operation == "delete" || root.operation == "cancel-edit";
    }

    visible: self.open;
    background: Theme.scrim;

    // Block interaction with the content behind the modal.
    TouchArea { }

    Rectangle {
        x: (parent.width - 560px) / 2;
        y: max((parent.height - self.height) / 2, 40px);
        width: 560px;
        height: body.preferred-height;
        background: Theme.panel-background;
        border-radius: Theme.radius-panel;
        border-width: 1px;
        border-color: Theme.control-stroke;

        body := VerticalLayout {
            padding: Theme.spacing-20;
            spacing: Theme.spacing-12;

            Text {
                text: root.title-text();
                color: Theme.text-primary;
                font-size: Theme.font-subtitle;
                font-weight: Theme.weight-semibold;
            }

            Text {
                text: root.hint-text();
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            // 表单字段：WinTextInput 自带 control-fill 底 + control-stroke 描边 + 聚焦强调条
            // 占位符（/local/path、/remote/path、644）是路径/权限格式示例，按 W4 规则不翻译
            if root.shows-local-path() : VerticalLayout {
                spacing: Theme.spacing-4;
                Text { text: root.local-path-label(); color: Theme.text-secondary; font-size: Theme.font-body; }
                WinTextInput {
                    text <=> root.local-path-text;
                    placeholder-text: "/local/path";
                }
            }

            if root.shows-path() : VerticalLayout {
                spacing: Theme.spacing-4;
                Text { text: root.path-label(); color: Theme.text-secondary; font-size: Theme.font-body; }
                WinTextInput {
                    text <=> root.path-text;
                    placeholder-text: "/remote/path";
                }
            }

            if root.shows-secondary() : VerticalLayout {
                spacing: Theme.spacing-4;
                Text { text: root.secondary-label(); color: Theme.text-secondary; font-size: Theme.font-body; }
                WinTextInput {
                    text <=> root.secondary-text;
                    placeholder-text: "/remote/path";
                }
            }

            if root.shows-permissions() : VerticalLayout {
                spacing: Theme.spacing-4;
                Text { text: @tr("Permissions (octal)"); color: Theme.text-secondary; font-size: Theme.font-body; }
                WinTextInput {
                    text <=> root.permissions-text;
                    placeholder-text: "644";
                }
            }

            // 操作区：右对齐，主操作（Run/Upload/...）在最右
            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;

                WinButton {
                    text: @tr("Cancel");
                    clicked => { root.canceled(); }
                }

                WinButton {
                    text: root.primary-label();
                    accent: !root.is-destructive();
                    critical: root.is-destructive();
                    enabled: root.primary-enabled();
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
