import { Theme } from "../theme.slint";
import { Icon } from "basic/icons.slint";

// 传输队列（§5.13）：方向图标 + 摘要；嵌在右侧工具的 WinCard 内，底透明。
// 卡片标题由外层 WinCardHeader（`Transfers`）提供，这里不再重复标题行。
// 暂停/恢复/重试等操作在 SFTP 面板底部传输抽屉里，本面板只做应用级摘要。
export component TransferQueue inherits Rectangle {
    // E21：默认值置空（投影必覆盖），避免投影更新前闪现英文。
    in property <string> summary_text: "";

    height: 110px;
    background: transparent;

    HorizontalLayout {
        padding: Theme.spacing-8;
        spacing: Theme.spacing-8;

        Rectangle {
            width: Theme.icon-size-small;
            vertical-stretch: 1;
            background: transparent;

            Icon {
                name: "download";
                icon-color: Theme.text-secondary;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            spacing: Theme.spacing-4;
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: root.summary_text;
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            Text {
                text: @tr("Pause, resume, and retry are in the SFTP transfer drawer.");
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
    }
}
