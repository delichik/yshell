import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon } from "basic/icons.slint";
import { WinIconButton } from "basic/controls.slint";
import { ListScrollBar } from "file_pane.slint";
import { SftpTransferRow } from "sftp_panel.slint";

// Dock Transfers panel: same `SftpTransferRow` model and pause/resume/retry/
// cancel/remove actions as `SftpTransferDrawer` (shared queue, not a caption).
export component TransferQueue inherits Rectangle {
    in property <[SftpTransferRow]> rows: [];
    in property <int> total-count: 0;
    in property <int> active-count: 0;
    in property <int> paused-count: 0;
    in property <int> failed-count: 0;
    in property <int> completed-count: 0;

    callback pause(string);
    callback resume(string);
    callback retry(string);
    callback cancel(string);
    callback remove(string);
    callback clear-completed();
    /// Opens/focuses the SFTP transfer drawer (same model) when the user wants
    /// the fuller drawer chrome inside the SFTP panel.
    callback open-sftp-drawer();

    background: transparent;

    // P3：进度条 + 文案列（原 64px 纯文字太弱）。
    private property <length> progress-column-width: 76px;

    // 行内动作按钮的无障碍名 / Tooltip 文案（§5.7：图标化操作必须带提示）。
    private property <string> pause-text: @tr("Pause transfer");
    private property <string> resume-text: @tr("Resume transfer");
    private property <string> retry-text: @tr("Retry transfer");
    private property <string> cancel-text: @tr("Cancel transfer");
    private property <string> remove-text: @tr("Remove transfer");

    pure function action-count(row: SftpTransferRow) -> int {
        return (row.can-pause ? 1 : 0) + (row.can-resume ? 1 : 0) + (row.can-retry ? 1 : 0)
             + (row.can-cancel ? 1 : 0) + (row.can-remove ? 1 : 0);
    }

    pure function action-width(row: SftpTransferRow) -> length {
        // 动作按钮 32×32（§8 命中区 ≥32）+ 相邻 4px 间距（§8）。
        return root.action-count(row) * Theme.control-height
             + Math.max(0, root.action-count(row) - 1) * Theme.spacing-4;
    }

    pure function summary-text() -> string {
        return @tr("{0} transfer(s)", root.total-count)
            + (root.active-count > 0 ? @tr(" · {0} active", root.active-count) : "")
            + (root.paused-count > 0 ? @tr(" · {0} paused", root.paused-count) : "")
            + (root.failed-count > 0 ? @tr(" · {0} failed", root.failed-count) : "")
            + (root.completed-count > 0 ? @tr(" · {0} completed", root.completed-count) : "");
    }

    VerticalLayout {
        // 外层 PanelFrame 已给 12px 内容内边距（与其余面板统一），这里不再叠加。
        padding: 0px;
        spacing: Theme.spacing-4;

        HorizontalLayout {
            height: Theme.control-height-compact;
            spacing: Theme.spacing-4;

            Rectangle {
                width: Theme.icon-size-small;
                vertical-stretch: 1;
                background: transparent;

                Icon {
                    name: "download";
                    icon-color: Theme.text-secondary;
                    icon-size: Theme.icon-size-small;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Text {
                text: root.summary-text();
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.completed-count > 0 : WinIconButton {
                icon: "clear";
                width: Theme.control-height-compact;
                height: Theme.control-height-compact;
                accessible-name: @tr("Clear completed");
                clicked => { root.clear-completed(); }
            }

            WinIconButton {
                icon: "chevron-right";
                width: Theme.control-height-compact;
                height: Theme.control-height-compact;
                accessible-name: @tr("Show SFTP transfer drawer");
                clicked => { root.open-sftp-drawer(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;
            // PANEL-2：不再强制 48px 下限——面板最小高度（120px）下可用列表区
            // 约 40px，48px 会把底边顶出 PanelFrame 的 clip。列表本身可滚动，
            // 空态文案在不足一行时隐藏，避免半行文字。
            min-height: 0px;

            if root.rows.length == 0 : Text {
                visible: parent.height >= Theme.line-caption;
                text: @tr("No transfer tasks yet");
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if root.rows.length > 0 : Rectangle {
                width: parent.width;
                height: parent.height;

                transfer_list := ListView {
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    // PANEL-2：视口按行高整数倍对齐，底部不出现被腰斩的半行；
                    // 空间不足一行时仍保留可滚动视口（而不是 0 高度）。
                    height: min(parent.height,
                        max(Theme.row-height-list,
                            floor(max(0px, parent.height) / Theme.row-height-list)
                                * Theme.row-height-list));

                    for row[index] in root.rows : Rectangle {
                        height: Theme.row-height-list;
                        border-radius: Theme.radius-control;
                        // 失败行用错误色（§5.9）：此前借用 attention-*（警告黄），
                        // 会把"传输失败"渲染成"警告"，与 InfoBar 的 error 档不一致。
                        background: row.is-failed ? Theme.banner-error-background
                            : Math.mod(index, 2) == 0 ? transparent : Theme.card-fill;
                        border-width: row.is-failed ? 1px : 0px;
                        border-color: row.is-failed ? Theme.banner-error-stroke : transparent;

                        Text {
                            x: Theme.spacing-4;
                            y: 0;
                            width: max(0px, parent.width - root.action-width(row)
                                - root.progress-column-width - 2 * Theme.spacing-4);
                            height: parent.height;
                            text: row.file-name-text;
                            color: row.is-failed ? Theme.banner-error-text : Theme.text-primary;
                            font-size: Theme.font-caption;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }

                        // P3：进度条（progress-percent）+ 失败/状态文案。
                        VerticalLayout {
                            x: parent.width - root.action-width(row) - root.progress-column-width - Theme.spacing-4;
                            y: (parent.height - self.preferred-height) / 2;
                            width: root.progress-column-width;
                            spacing: 2px;
                            alignment: center;

                            if !row.is-failed : Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.control-stroke;
                                clip: true;

                                Rectangle {
                                    width: parent.width * max(0, min(100, row.progress-percent)) / 100;
                                    height: parent.height;
                                    background: Theme.accent;
                                    border-radius: 2px;
                                }
                            }

                            Text {
                                text: row.is-failed ? row.status-text : row.progress-text;
                                color: row.is-failed ? Theme.critical : Theme.text-tertiary;
                                font-size: Theme.font-caption;
                                horizontal-alignment: right;
                                wrap: no-wrap;
                                overflow: elide;
                                width: parent.width;
                            }
                        }

                        HorizontalLayout {
                            x: parent.width - root.action-width(row);
                            y: 0;
                            width: root.action-width(row);
                            height: parent.height;
                            spacing: Theme.spacing-4;
                            alignment: end;

                            // 动作按钮统一 32×32（与 SFTP 抽屉内的实现同形，
                            // 原来这里是 24×24：命中区不足 32，且在 32px 行里贴顶）。
                            if row.can-pause : WinIconButton {
                                icon: "pause";
                                accessible-name: root.pause-text;
                                tooltip-text: root.pause-text;
                                cross-axis-self-alignment: center;
                                clicked => { root.pause(row.id); }
                            }
                            if row.can-resume : WinIconButton {
                                icon: "play";
                                accessible-name: root.resume-text;
                                tooltip-text: root.resume-text;
                                cross-axis-self-alignment: center;
                                clicked => { root.resume(row.id); }
                            }
                            if row.can-retry : WinIconButton {
                                icon: "refresh";
                                accessible-name: root.retry-text;
                                tooltip-text: root.retry-text;
                                cross-axis-self-alignment: center;
                                clicked => { root.retry(row.id); }
                            }
                            if row.can-cancel : WinIconButton {
                                icon: "close";
                                accessible-name: root.cancel-text;
                                tooltip-text: root.cancel-text;
                                cross-axis-self-alignment: center;
                                clicked => { root.cancel(row.id); }
                            }
                            if row.can-remove : WinIconButton {
                                icon: "trash";
                                accessible-name: root.remove-text;
                                tooltip-text: root.remove-text;
                                cross-axis-self-alignment: center;
                                clicked => { root.remove(row.id); }
                            }
                        }
                    }
                }

                ListScrollBar {
                    x: parent.width - self.width;
                    y: 0;
                    height: parent.height;
                    content-height: transfer_list.content-height;
                    visible-height: transfer_list.visible-height;
                    content-y <=> transfer_list.content-y;
                    scroll-enabled: transfer_list.enabled;
                }
            }
        }
    }
}
