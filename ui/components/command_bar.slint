// 命令栏（CommandBar，48px）：新建会话、Panels 菜单与查找/设置/更多入口。
//
// N3 Phase 2：原先的 SFTP / Tunnels / Quick Commands 三个开关 + 右栏展开按钮
// 收敛为一个 "Panels" 菜单入口（锚点交给宿主打开 View 菜单，与 View 菜单同一份
// 面板可见性入口）。窄窗（<1120px）仍保留右栏展开/收起 chevron。
//
// 约定：`@tr` 文案搬移后显式带上原组件上下文（`@tr("MainWindow" => ...)`），
// 保证 gettext 的 (msgctxt, msgid) 与拆分前一致。
import { Theme } from "../theme.slint";
import { WinButton, WinIconButton } from "basic/controls.slint";

export component CommandBar inherits Rectangle {
    /// 窄窗口下显示右栏展开/收起按钮（§4.2：<1120px）
    in property <bool> dock-toggle-visible: false;
    /// 右栏当前是否被自动折叠（决定 chevron 方向）。
    in property <bool> right-collapsed: false;
    /// A24：查找入口是否可用（无活动会话时禁用 + tooltip 说明原因）。
    in property <bool> find-enabled: true;
    /// A24：查找入口禁用时的原因说明（默认复用既有 msgid）。
    private property <string> find-disabled-tooltip: @tr("MainWindow" => "Open a session first.");

    callback new-session();
    /// "Panels" 入口：把锚点（窗口绝对坐标）交给宿主打开 View 菜单。
    callback open-panels-menu(length, length);
    /// 窄窗右栏临时展开/收起。
    callback toggle-right-side();
    callback open-find();
    callback open-settings();
    /// "更多"入口：把锚点（窗口绝对坐标）交给宿主打开**溢出菜单**。
    /// A3：溢出菜单是独立模型（不再复用一级菜单的 open-index，因此"帮助"不再被点亮）。
    callback open-more-menu(length, length);

    height: Theme.bar-height-commandbar;
    background: Theme.layer-fill;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;

        WinButton {
            text: @tr("MainWindow" => "New Session");
            icon: "plus";
            accent: true;
            // Slint 1.18 起 *-stretch 默认值是 1：不显式归零的话，
            // 按钮会和尾部 spacer 瓜分剩余宽度被撑开。
            horizontal-stretch: 0;
            clicked => { root.new-session(); }
        }

        // 竖向居中：布局子项默认顶对齐，1px 分隔条会贴着按钮顶边（muse 轮4）；
        // 用可拉伸容器 + 绝对居中的实条固定到行中线。
        Rectangle {
            width: 1px;
            vertical-stretch: 1;
            background: transparent;

            Rectangle {
                width: 1px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                background: Theme.control-stroke;
            }
        }

        // N3：面板可见性/位置统一入口（与 View 菜单同步）。
        WinButton {
            text: @tr("MainWindow" => "Panels");
            icon: "chevron-down";
            horizontal-stretch: 0;
            clicked => {
                root.open-panels-menu(
                    self.absolute-position.x,
                    Theme.bar-height-menubar + Theme.bar-height-commandbar
                );
            }
        }

        // 吸收剩余宽度（唯一可增长项）。A19：纯布局占位，不需要标识符。
        Rectangle { horizontal-stretch: 1; }

        // 右栏自动折叠时的展开/收起入口（§4.2：<1120px）
        if root.dock-toggle-visible : WinIconButton {
            icon: root.right-collapsed ? "chevron-left" : "chevron-right";
            accessible-name: root.right-collapsed
                ? @tr("MainWindow" => "Expand tool panels")
                : @tr("MainWindow" => "Collapse tool panels");
            clicked => { root.toggle-right-side(); }
        }

        // A24：查找入口在有活动会话时才可用（禁用态用 tooltip 说明原因，点击不再
        // 静默置位 `terminal_find_visible`）。Tooltip 必须是"被悬停元素"的子元素，
        // 因此包一层同尺寸容器（WinIconButton 没有 @children 槽）。
        Rectangle {
            width: Theme.control-height;
            height: Theme.control-height;
            background: transparent;

            WinIconButton {
                width: parent.width;
                height: parent.height;
                icon: "search";
                enabled: root.find-enabled;
                accessible-name: root.find-enabled
                    ? @tr("MainWindow" => "Find in terminal")
                    : @tr("MainWindow" => "Open a session first.");
                clicked => { root.open-find(); }
            }

            if !root.find-enabled : Tooltip {
                text: @markdown("\{root.find-disabled-tooltip}");
            }
        }
        WinIconButton {
            icon: "settings";
            accessible-name: @tr("MainWindow" => "Settings");
            clicked => { root.open-settings(); }
        }
        WinIconButton {
            icon: "more";
            accessible-name: @tr("MainWindow" => "More");
            clicked => {
                root.open-more-menu(self.absolute-position.x, Theme.bar-height-menubar + Theme.bar-height-commandbar);
            }
        }
    }
}
