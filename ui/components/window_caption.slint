// Shared frameless-window caption pieces used by MenuBar and ToolWindowChrome.
//
// TitleBarDragTouch matches the main-window native-drag path: threshold +
// press-in-bounds + drag-triggered. After HTCAPTION move, Windows swallows
// mouse-up so Slint would keep the TouchArea grab — clear it before the move
// and only re-enable after the synchronous move returns (mouse is up).

import { Theme } from "../theme.slint";
import { Icon } from "basic/icons.slint";

/// Windows 原生标题栏拖动检测：`native-drag` 为 true 时由宿主关掉 WindowMoveArea。
///
/// 按下后移动超过阈值才上报 `drag-requested`，单击 / 双击仍是普通 TouchArea 行为。
///
/// 抓取清理（拖动后要点两次才能点控件的根因）：
/// 系统 `HTCAPTION` 移动循环会吞掉 mouse-up。若拖动中途就把 `enabled` 开回去，
/// 左键仍按下时 TouchArea 会重新抓住输入，下一次点击被吞掉。
/// 正确做法：发起拖动前 `enabled = false` 清 grab；`drag-requested` 用同步
/// `SendMessage(WM_NCLBUTTONDOWN)` 跑完移动循环后返回（此时键已松开），再恢复
/// `enabled`。残留点击路径仍用下一帧 Timer 恢复。
export component TitleBarDragTouch inherits TouchArea {
    in property <bool> native-drag: false;
    callback clicked-blank();
    callback double-clicked-blank();
    callback drag-requested();

    private property <length> press-x: 0px;
    private property <length> press-y: 0px;
    private property <bool> armed: false;
    private property <bool> drag-triggered: false;
    /// 按下是否落在标题栏自身范围内。
    private property <bool> press-in-bounds: false;
    /// 非拖动路径（抓取残留）清 grab 后，下一帧再打开。
    private property <bool> restore-enabled: false;

    pure function abs-length(value: length) -> length {
        value < 0px ? -value : value;
    }

    function clear-slint-grab-deferred() {
        // TouchArea docs：按下期间关掉 enabled → Cancel + 清 pressed/grab。
        root.enabled = false;
        root.restore-enabled = true;
    }

    pointer-event(event) => {
        if (!root.native-drag) {
            return;
        }
        if (event.button == PointerEventButton.left) {
            if (event.kind == PointerEventKind.down) {
                root.drag-triggered = false;
                root.press-in-bounds = self.mouse-x >= 0px && self.mouse-x <= root.width
                    && self.mouse-y >= 0px && self.mouse-y <= root.height;
                if (!root.press-in-bounds) {
                    // 抓取残留送来的按下（点在标题栏之外）：不当作拖动起点。
                    root.armed = false;
                    root.clear-slint-grab-deferred();
                    return;
                }
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.armed = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.armed = false;
            }
        }
    }

    moved => {
        if (root.native-drag && root.armed
            && (root.abs-length(self.mouse-x - root.press-x) >= 4px
                || root.abs-length(self.mouse-y - root.press-y) >= 4px)) {
            root.armed = false;
            root.drag-triggered = true;
            root.restore-enabled = false;
            // 清 grab；保持 disabled 直到原生移动循环结束（见 drag-requested 同步语义）。
            root.enabled = false;
            root.drag-requested();
            root.enabled = true;
        }
    }

    clicked => {
        if (root.drag-triggered) {
            root.drag-triggered = false;
        } else if (root.press-in-bounds) {
            root.clicked-blank();
        }
        root.press-in-bounds = false;
    }

    double-clicked => {
        if (root.press-in-bounds) {
            root.double-clicked-blank();
        }
        root.press-in-bounds = false;
    }

    Timer {
        interval: 0ms;
        running: root.restore-enabled;
        triggered => {
            root.enabled = true;
            root.restore-enabled = false;
        }
    }
}

/// WinUI 3 标题栏按钮：46×顶栏高、直角、关闭悬停用系统红。
export component CaptionButton inherits Rectangle {
    in property <string> kind: "minimize";
    /// 最大化态：方框换成还原（叠方）。
    in property <bool> window-maximized: false;
    callback clicked();

    private property <bool> is-close: root.kind == "close";
    private property <string> access-label:
        root.kind == "minimize" ? @tr("MenuBar" => "Minimize")
        : root.kind == "close" ? @tr("MenuBar" => "Close")
        : root.window-maximized ? @tr("MenuBar" => "Restore")
        : @tr("MenuBar" => "Maximize");
    private property <color> glyph-color: root.is-close && touch.has-hover
        ? Theme.caption-close-hover-text
        : Theme.text-primary;

    width: 46px;
    height: 100%;
    background: root.is-close
        ? (touch.pressed ? Theme.caption-close-pressed
            : touch.has-hover ? Theme.caption-close-hover : transparent)
        : (touch.pressed ? Theme.subtle-pressed
            : touch.has-hover ? Theme.subtle-hover : transparent);
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.access-label;
    accessible-action-default => { root.clicked(); }

    // 最小化 / 关闭用图标；最大化·还原用几何方框。
    // close 的 SVG 描边比 minus 更内缩，同为 10px 时 X 会显得更小，故关闭用 12px。
    if root.kind == "minimize" : Icon {
        name: "minus";
        icon-color: root.glyph-color;
        icon-size: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.kind == "maximize" && !root.window-maximized : Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: 1px;
        border-color: root.glyph-color;
        background: transparent;
    }
    if root.kind == "maximize" && root.window-maximized : Rectangle {
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: transparent;

        // 后层方框（偏右上）
        Rectangle {
            x: 2px;
            y: 0px;
            width: 8px;
            height: 8px;
            border-width: 1px;
            border-color: root.glyph-color;
            background: transparent;
        }
        // 前层方框（偏左下，盖住后层一角）
        Rectangle {
            x: 0px;
            y: 2px;
            width: 8px;
            height: 8px;
            border-width: 1px;
            border-color: root.glyph-color;
            background: Theme.window-background;
        }
    }
    if root.kind == "close" : Icon {
        name: "close";
        icon-color: root.glyph-color;
        icon-size: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
