// 右栏工具面板（RightDock）：拖拽把手 + 卡片容器（SFTP / Tunnels / Transfers /
// Quick Commands）+ SFTP 右键菜单 Popup。
//
// 拆分自 `ui/main_window.slint`（R1 结构重构）：只搬代码，不改布局/文案/行为。
//   * 根继承 `HorizontalLayout`：把手与右栏容器在拆分前就是外层 HorizontalLayout
//     的两个相邻 cell（间距 0），这里用同形布局承载，几何不变。
//   * 显隐/宽度仍由 main_window 计算（`dock-effective-width`；宽度 0 = 折叠）。
//     面板内层用 `if` 控制是否参与布局（与拆分前一致，避免折叠时把状态栏挤出）。
//   * 需要写宿主弹窗状态的动作（new-folder/rename/…）只上报语义回调，由宿主设置
//     `sftp_dialog_*` 并打开 `SftpEntryDialog`。
//   * Popup 实例放在 `ToolDockPopups` 里，必须在 main_window 的
//     "内容之后、模态弹窗之前"实例化，保持原有绘制层级。
//   * `@tr` 文案搬移后显式带上原组件上下文（`@tr("MainWindow" => ...)`）。
import { Theme } from "../theme.slint";
import { WinCard, WinCardHeader, WinIconButton } from "basic/controls.slint";
import { MenuEntry, MenuPopup } from "menu_popup.slint";
import { LocalRow } from "local_pane.slint";
import { SftpCrumb, SftpPanel, SftpRow, SftpTransferRow } from "sftp_panel.slint";

export component ToolDock inherits HorizontalLayout {
    in property <length> dock-effective-width: 0px;
    in property <bool> sftp-visible: true;
    in property <bool> tunnels-visible: true;
    in property <bool> commands-visible: true;

    // Tunnels 投影
    in property <string> tunnels-summary-text: "";

    /// SFTP 面板/表头的右键菜单锚点（窗口绝对坐标）
    callback sftp-menu-requested(length, length);

    // --- N1：SftpPanel 投影透传（卡片壳只提供弹性高度与标题条）---------------
    in property <[SftpRow]> sftp-rows: [];
    in property <[SftpCrumb]> sftp-crumbs: [];
    in property <int> sftp-selected-index: -1;
    in property <string> sftp-sort-column-text: "name";
    in property <bool> sftp-sort-ascending: true;
    in property <string> sftp-sort-text: "";
    in property <bool> sftp-show-hidden: false;
    in property <int> sftp-item-count: 0;
    in property <int> sftp-dir-count: 0;
    in property <int> sftp-selected-count: 0;
    in property <string> sftp-empty-text: "";
    in property <string> sftp-error-text: "";
    in property <bool> sftp-connected: false;
    in property <bool> sftp-remote-edit-active: false;
    in property <string> sftp-remote-edit-text: "";
    in-out property <string> sftp-path-text: "/";
    in property <[LocalRow]> local-rows: [];
    in property <string> local-path-text: "/";
    in property <bool> local-show-hidden: false;
    in property <string> local-sort-column-text: "name";
    in property <bool> local-sort-ascending: true;
    in property <string> local-sort-text: "Name ↑";
    in property <int> local-item-count: 0;
    in property <int> local-dir-count: 0;
    in property <int> local-selected-count: 0;
    in property <string> local-empty-text: "";
    in property <string> local-error-text: "";
    in property <bool> local-retry-visible: true;
    in property <bool> local-collapsed: false;
    in property <string> local-selected-name-text: "";
    in property <string> local-selection-key: "";
    in property <string> sftp-selection-key: "";
    in property <[SftpTransferRow]> transfer-rows: [];
    in property <bool> transfer-expanded: false;
    in property <int> transfer-total-count: 0;
    in property <int> transfer-active-count: 0;
    in property <int> transfer-paused-count: 0;
    in property <int> transfer-failed-count: 0;
    in property <int> transfer-completed-count: 0;
    in property <int> transfer-retryable-count: 0;

    callback refresh-sftp();
    callback up-sftp();
    callback home-sftp();
    callback open-sftp-path(string);
    callback open-sftp-crumb(int);
    callback sort-sftp(string);
    callback toggle-sftp-hidden();
    callback select-sftp-row(int, bool, bool);
    callback activate-sftp-row(int);
    callback panel-sftp-menu-requested(length, length);
    callback save-sftp-remote-edit();
    callback cancel-sftp-remote-edit();
    callback local-toggle-collapsed();
    callback local-up();
    callback local-home();
    callback local-refresh();
    callback local-open-path(string);
    callback local-sort-by(string);
    callback local-toggle-hidden();
    callback local-select-row(int, bool, bool);
    callback local-activate-row(int);
    callback local-context-menu-requested(int, length, length);
    callback local-retry();
    callback transfer-toggle-expanded();
    callback transfer-pause(string);
    callback transfer-resume(string);
    callback transfer-retry(string);
    callback transfer-cancel(string);
    callback transfer-remove(string);
    callback transfer-clear-completed();
    callback copy-file-selection();
    callback cut-file-selection();
    callback paste-cross-pane();
    pure callback drag-local-transfer(string) -> data-transfer;
    pure callback drag-remote-transfer(string) -> data-transfer;
    callback drop-on-remote-row(int, data-transfer, DragAction);
    callback drop-on-remote-blank(data-transfer, DragAction);
    callback drop-on-local(data-transfer, DragAction);

    // --- 拖拽把手（4px，悬停变色；折叠时不显示）------------------------------
    // 拖拽状态与宽度钳制仍在 main_window：这里只上报指针窗口绝对 x。
    in property <bool> dragging: false;
    callback drag-started(length);
    callback drag-moved(length);
    callback drag-finished();

    // 可见性由宿主传入的宽度推导（与拆分前 dock_visible 的定义一致：width > 0px）。
    if root.dock-effective-width > 0px : Rectangle {
        width: Theme.resize-handle-width;
        background: root.dragging || dock_resize_touch.has-hover ? Theme.accent : transparent;
        animate background { duration: Theme.duration-faster; easing: ease-out; }

        dock_resize_touch := TouchArea {
            mouse-cursor: col-resize;

            pointer-event(event) => {
                if (event.button == PointerEventButton.left) {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-started(self.absolute-position.x + self.mouse-x);
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        root.drag-finished();
                    }
                }
            }
            moved => {
                if (root.dragging) {
                    root.drag-moved(self.absolute-position.x + self.mouse-x);
                }
            }
        }
    }

    // --- RightDock（卡片式工具面板；W5-④ 宽度可拖拽/自动折叠）------------------
    Rectangle {
        width: root.dock-effective-width;
        visible: root.dock-effective-width > 0px;
        background: Theme.window-background;
        // 卡片总高可能超过可用高度（例如 1600×1000 时右栏自动展开）：
        // 裁剪在右栏内，避免卡片画到状态栏上（溢出）。
        clip: true;

        Rectangle {
            x: 0;
            width: 1px;
            height: parent.height;
            background: Theme.layer-stroke;
        }

        // 面板内容只在右栏可见时才参与布局：Slint 的 `visible: false`
        // 不会把元素移出布局，若内容常驻，折叠状态下卡片的最小高度仍会
        // 顶起主区最小高度（窗口变矮时把状态栏挤出可视区）。
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            // N1：SFTP 卡片靠 `vertical-stretch: 1` 吸收剩余高度；`alignment: start`
            // 会把"多余空间"先放到末尾、忽略拉伸项，所以这里不再用 start 对齐。

            // N1：SFTP 卡片高度弹性（取消 420px 固定值）；面板内容由宿主的
            // `@children` 槽注入（main_window 里实例化 SftpPanel），队列抽屉已并入面板。
            if root.dock-effective-width > 0px && root.sftp-visible : Rectangle {
                vertical-stretch: 1;
                min-height: 240px;
                background: Theme.card-fill;
                border-radius: Theme.radius-panel;
                border-width: 1px;
                border-color: Theme.card-stroke;
                clip: true;

                Rectangle {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    height: Theme.control-height;
                    background: transparent;

                    WinCardHeader {
                        width: parent.width;
                        height: parent.height;
                        title: @tr("MainWindow" => "SFTP");
                        icon: "folder";
                        dock_header_spacer := Rectangle { horizontal-stretch: 1; }
                        WinIconButton {
                            icon: "more";
                            accessible-name: @tr("MainWindow" => "SFTP operations");
                            clicked => {
                                root.sftp-menu-requested(
                                    self.absolute-position.x,
                                    self.absolute-position.y + self.height
                                );
                            }
                        }
                    }
                }

                SftpPanel {
                    x: 8px;
                    y: 44px;
                    width: parent.width - 16px;
                    height: parent.height - 52px;

                    rows: root.sftp-rows;
                    crumbs: root.sftp-crumbs;
                    selected-index: root.sftp-selected-index;
                    sort-column: root.sftp-sort-column-text;
                    sort-ascending: root.sftp-sort-ascending;
                    sort-text: root.sftp-sort-text;
                    show-hidden: root.sftp-show-hidden;
                    item-count: root.sftp-item-count;
                    dir-count: root.sftp-dir-count;
                    selected-count: root.sftp-selected-count;
                    empty-text: root.sftp-empty-text;
                    error-text: root.sftp-error-text;
                    connected: root.sftp-connected;
                    remote-edit-active: root.sftp-remote-edit-active;
                    remote-edit-text: root.sftp-remote-edit-text;
                    path-text <=> root.sftp-path-text;
                    local-rows: root.local-rows;
                    local-path-text: root.local-path-text;
                    local-show-hidden: root.local-show-hidden;
                    local-sort-column: root.local-sort-column-text;
                    local-sort-ascending: root.local-sort-ascending;
                    local-sort-text: root.local-sort-text;
                    local-item-count: root.local-item-count;
                    local-dir-count: root.local-dir-count;
                    local-selected-count: root.local-selected-count;
                    local-empty-text: root.local-empty-text;
                    local-error-text: root.local-error-text;
                    local-retry-visible: root.local-retry-visible;
                    local-collapsed: root.local-collapsed;
                    local-title-text: @tr("MainWindow" => "Local");
                    local-selected-name-text: root.local-selected-name-text;
                    local-selection-key: root.local-selection-key;
                    sftp-selection-key: root.sftp-selection-key;
                    transfer-rows: root.transfer-rows;
                    transfer-expanded: root.transfer-expanded;
                    transfer-total-count: root.transfer-total-count;
                    transfer-active-count: root.transfer-active-count;
                    transfer-paused-count: root.transfer-paused-count;
                    transfer-failed-count: root.transfer-failed-count;
                    transfer-completed-count: root.transfer-completed-count;
                    transfer-retryable-count: root.transfer-retryable-count;

                    refresh() => { root.refresh-sftp(); }
                    up() => { root.up-sftp(); }
                    home() => { root.home-sftp(); }
                    open-path(path) => { root.open-sftp-path(path); }
                    open-crumb(index) => { root.open-sftp-crumb(index); }
                    sort-by(column) => { root.sort-sftp(column); }
                    toggle-hidden() => { root.toggle-sftp-hidden(); }
                    select-row(index, ctrl, shift) => { root.select-sftp-row(index, ctrl, shift); }
                    activate-row(index) => { root.activate-sftp-row(index); }
                    context-menu-requested(index, x, y) => { root.sftp-menu-requested(x, y); }
                    panel-menu-requested(x, y) => { root.panel-sftp-menu-requested(x, y); }
                    save-edit() => { root.save-sftp-remote-edit(); }
                    cancel-edit() => { root.cancel-sftp-remote-edit(); }
                    drag-remote-transfer(key) => { return root.drag-remote-transfer(key); }
                    drag-local-transfer(key) => { return root.drag-local-transfer(key); }
                    drop-on-remote-row(index, data, action) => { root.drop-on-remote-row(index, data, action); }
                    drop-on-remote-blank(data, action) => { root.drop-on-remote-blank(data, action); }
                    drop-on-local(data, action) => { root.drop-on-local(data, action); }
                    local-toggle-collapsed() => { root.local-toggle-collapsed(); }
                    local-up() => { root.local-up(); }
                    local-home() => { root.local-home(); }
                    local-refresh() => { root.local-refresh(); }
                    local-open-path(path) => { root.local-open-path(path); }
                    local-sort-by(column) => { root.local-sort-by(column); }
                    local-toggle-hidden() => { root.local-toggle-hidden(); }
                    local-select-row(index, ctrl, shift) => { root.local-select-row(index, ctrl, shift); }
                    local-activate-row(index) => { root.local-activate-row(index); }
                    local-context-menu-requested(index, x, y) => { root.local-context-menu-requested(index, x, y); }
                    local-redirect-requested() => { }
                    local-retry() => { root.local-retry(); }
                    transfer-toggle-expanded() => { root.transfer-toggle-expanded(); }
                    transfer-pause(id) => { root.transfer-pause(id); }
                    transfer-resume(id) => { root.transfer-resume(id); }
                    transfer-retry(id) => { root.transfer-retry(id); }
                    transfer-cancel(id) => { root.transfer-cancel(id); }
                    transfer-remove(id) => { root.transfer-remove(id); }
                    transfer-clear-completed() => { root.transfer-clear-completed(); }
                    copy-selection() => { root.copy-file-selection(); }
                    cut-selection() => { root.cut-file-selection(); }
                    paste-cross-pane() => { root.paste-cross-pane(); }
                }
            }
            if root.dock-effective-width > 0px && root.tunnels-visible : WinCard {
                WinCardHeader {
                    title: @tr("MainWindow" => "Tunnels");
                    icon: "globe";
                }
                Text {
                    text: root.tunnels-summary-text;
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }

            if root.dock-effective-width > 0px && root.commands-visible : WinCard {
                WinCardHeader {
                    title: @tr("MainWindow" => "Quick Commands");
                    icon: "code";
                }
                Text {
                    text: @tr("MainWindow" => "Command presets will appear here.");
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }

            // 常驻空白（首选高度 0，不参与拉伸）：保证右栏布局任何时候都至少有一个
            // cell。空布局的 layout info 是 { min: 0, max: 0 }（见 i-slint-core
            // `box_layout_info` 的 count < 1 分支），而主区 cross 轴取各 cell 的
            // min(max)，随后 `fold.max = fold.max.max(fold.min)` 会把主区最大高度
            // 钉成"各 cell 最小高度里的最大值"——表现就是窗口高度被封顶、
            // 且根内容撑不满窗口（底部死区）。有 cell 在时 max 无界。
            // N1：SFTP 卡片现在是拉伸项，这里显式不拉伸（避免和面板平分剩余高度）。
            dock_layout_spacer := Rectangle { height: 0px; vertical-stretch: 0; }
        }
    }
}

// SFTP 右键菜单 Popup（宿主在窗口层级实例化）。
export component ToolDockPopups inherits Rectangle {
    in property <bool> open: false;
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    in property <[MenuEntry]> entries: [];

    callback selected(int);
    callback dismissed();

    // 作为 Window 直接子项（与拆分前的 MenuPopup 相同）：root 由 Slint 自动铺满
    // 窗口，内层 Popup 显式取父尺寸，保持锚点钳制与全屏 scrim 与拆分前一致。
    background: transparent;

    sftp_context_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.open;
        entries: root.entries;
        anchor-x: root.anchor-x;
        anchor-y: root.anchor-y;
        panel-width: 240px;
        dismissed => { root.dismissed(); }
        selected(index) => { root.selected(index); }
    }
}
