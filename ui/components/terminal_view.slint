import { Theme } from "../theme.slint";
import { WinButton, WinIconButton, WinToggle } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

// 终端滚动条数据通道（§5.17）：Rust 投影写入总行数/视口行数，滚动条把
// 点击/拖拽换算成"距顶部行号"后回调（bootstrap 里绑定到 runtime）。
// 声明在本文件而不是 main_window.slint：终端视图自身就能读写，
// 宿主（main_window.slint）无需再转发一层；如需窗口级属性，可把
// TerminalView 的 scrollback-lines / viewport-rows 覆盖绑定即可。
export global TerminalScrollInfo {
    in-out property <int> scrollback-lines: 0;
    in-out property <int> viewport-rows: 0;
    callback scroll-to-line(int);
}

// 终端表面（§5.17）：8px 圆角 + 1px 静默描边 + 内边距 12。
// 表面内不再有标题条与底栏；滚动/选择反馈改为覆盖在表面右上角的小浮层。
// 聚焦不再切 accent 描边（深色底上蓝框过重）。
export component TerminalView inherits Rectangle {
    // E21：这些属性每次启动都由 Rust 投影覆盖；默认值置空，避免投影到达前闪现英文
    //（muse 轮1 中#35）。因此也不标 @tr。
    in property <string> title: "";
    in property <string> log-output: "";
    in property <[string]> visible-lines: [];
    in property <image> terminal-image;
    /// 终端表面底色：跟随会话的终端配色背景（Rust 侧按活动会话投影）。
    ///
    /// 之前固定用主题的 `terminal-surface`（深色下近乎纯黑）：换成浅色配色方案
    /// 时，位图四周会露出一圈黑边。位图放不下的余量与内边距都用这个颜色。
    in property <color> surface-background: Theme.terminal-surface;
    in property <int> cursor-column: 0;
    in property <int> cursor-row: 0;
    in property <int> scroll-offset: 0;
    // 滚动条数据：默认取全局投影（TerminalScrollInfo），宿主可覆盖绑定。
    in property <int> scrollback-lines: TerminalScrollInfo.scrollback-lines;
    in property <int> viewport-rows: TerminalScrollInfo.viewport-rows;
    in property <bool> selection-active: false;
    in-out property <string> search-query: "";
    in property <string> search-summary: "";
    /// WP2：正则查找开关（与运行时 `terminal_search_regex` 双向）。
    in-out property <bool> search-regex: false;
    // 状态已由窗口状态栏承载，这里只保留属性（不再渲染底栏）
    in property <string> footer-status: "";
    in property <bool> find-visible: false;
    // --- WP1：连接 overlay（connecting / failed / pending-confirmation）------
    in property <bool> connection-overlay-visible: false;
    in property <string> connection-overlay-target: "";
    in property <string> connection-overlay-stage: "";
    in property <string> connection-overlay-error: "";
    in property <bool> connection-overlay-failed: false;
    in property <bool> connection-overlay-pending: false;
    callback connection-retry();
    callback connection-cancel();
    callback connection-copy-error();
    /// E10：宿主告知终端视图当前是否可见（Quick Connect 页 / 无会话时为 false）——
    /// 查找栏的自动聚焦据此避让，不去抢其他页面输入框的焦点。
    in property <bool> view-visible: true;
    /// P1：分屏叶子内嵌时去掉外层 padding、放宽 min-height（标题/描边由 SplitPaneLeaf 承担）。
    in property <bool> embedded: false;
    /// P1：非聚焦分屏叶子只做位图预览 + 点击聚焦，不接手选择/滚动/按键/查找/overlay。
    in property <bool> interactive: true;
    out property <bool> terminal-focused: root.interactive && terminal_focus.has-focus;
    // E16/UI-1：内边距统一走 Theme token；左右 2×，上下为 0（D9）。
    out property <float> terminal-viewport-width-px: terminal_surface.width / 1px - 2 * Theme.terminal-padding-x / 1px;
    out property <float> terminal-viewport-height-px: terminal_surface.height / 1px - 2 * Theme.terminal-padding-y / 1px;

    /// P1：非交互叶子被点击时请求宿主切换焦点（分屏未聚焦 pane）。
    callback focus-requested();
    callback key-pressed(string, bool, bool, bool, bool);
    callback scroll-lines(int);
    callback scroll-to-bottom();
    callback selection-begin(float, float);
    callback selection-update(float, float);
    callback selection-end(float, float);
    callback select-word-at(float, float);
    callback copy-visible();
    callback paste-clipboard();
    callback clear-terminal();
    callback find-text(string);
    callback find-next();
    callback find-prev();
    callback find-regex-changed(bool);
    callback dismiss-find();
    callback context-menu-requested(length, length);

    // --- 滚动条几何（§5.17）：4px 细条、覆盖式，不影响终端内容宽度 -------------
    // 可回翻行数 = 总行数 - 视口行数；只有 >0 时才显示滚动条。
    property <int> scroll-max-offset: Math.max(root.scrollback-lines - root.viewport-rows, 0);
    property <bool> scrollbar-visible: root.scroll-max-offset > 0;
    // 滑块长度比例 = 视口行数 / 总行数。
    property <float> scroll-thumb-ratio: root.scrollback-lines > 0 ? root.viewport-rows * 1.0 / root.scrollback-lines : 1.0;
    // 0 = 贴底（live 视图），1 = 贴顶（最旧一行）。
    property <float> scroll-fraction: root.scroll-max-offset > 0 ? root.scroll-offset * 1.0 / root.scroll-max-offset : 0.0;
    // 轨道 y（相对轨道顶部）→ 距顶部行号：0 = 最旧一行，scroll-max-offset = live 底部。
    // Rust 侧把行号换算成 scroll offset，并把越界值 clamp 到可达范围。
    pure function scroll-line-at-y(y: float, travel-px: float) -> int {
        if (travel-px <= 0 || root.scroll-max-offset <= 0) { return 0; }
        return Math.min(
            root.scroll-max-offset,
            Math.max(0, Math.round(root.scroll-max-offset * (y / travel-px)))
        );
    }

    // 根容器只做布局承载（§5.17 的唯一视觉容器是 terminal_surface）：
    // 这里保持透明、无边框，避免和 terminal_surface 形成两层圆角描边。
    background: transparent;

    VerticalLayout {
        padding: root.embedded ? 0px : Theme.spacing-8;
        spacing: root.embedded ? (root.find-visible ? Theme.spacing-4 : 0px) : Theme.spacing-8;

        terminal_surface := Rectangle {
            background: root.surface-background;
            // 聚焦态不再换成 accent 描边：蓝框在深色终端上刺眼，且和键盘
            // FocusRing 叠出「双重选中」。聚焦只靠光标/输入反馈表达。
            border-color: root.embedded ? transparent : Theme.terminal-border;
            border-width: root.embedded ? 0px : 1px;
            border-radius: root.embedded ? 0px : Theme.radius-panel;
            // 可收缩下限：窗口 880×600 时终端区仍能放下（含查找栏），不把状态栏挤出可视区。
            // 分屏叶子内嵌时放宽，避免把另一片挤没。略低于旧 320px，给顶栏合并后的布局留余量。
            min-height: root.embedded ? 40px : 240px;
            clip: true;

            // 表面内边距（§5.17 → Theme.terminal-padding-x/y）；embedded 时仍保留，与单窗格度量一致。
            // UI-1/D9：上下为 0，终端内容直接贴住 tab 栏与 pane 底边。
            terminal_focus := FocusScope {
                x: Theme.terminal-padding-x;
                y: Theme.terminal-padding-y;
                width: parent.width - 2 * Theme.terminal-padding-x;
                height: parent.height - 2 * Theme.terminal-padding-y;
                enabled: root.interactive;

                key-pressed(event) => {
                    if (!root.interactive) {
                        return reject;
                    }
                    // E10：查找栏可见时 F3/Shift+F3 在匹配间跳转、Esc 关栏；
                    // 其余按键照旧送终端（避免 F3 被编码成远端输入）。
                    if (root.find-visible) {
                        if (event.text == Key.F3) {
                            if (event.modifiers.shift) {
                                root.find-prev();
                            } else {
                                root.find-next();
                            }
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            root.dismiss-find();
                            return accept;
                        }
                    }
                    root.key-pressed(
                        event.text,
                        event.modifiers.control,
                        event.modifiers.alt,
                        event.modifiers.shift,
                        event.modifiers.meta
                    );
                    return accept;
                }

                // 终端位图由 Rust 按**物理像素**渲染（cell 尺寸 = 物理像素）；
                // `image.width/height` 是位图像素数，乘 `1phx` 后以精确设备像素尺寸
                // 显示：1 图像像素 = 1 设备像素，逻辑尺寸自动等于 位图 px / scale。
                // 网格按 floor 取整（只报告完整可见单元格；余数留白，与 xterm 一致）。
                // `image-rendering: pixelated`：禁止默认的 smooth 线性插值——在
                // 非整数 DPI / 亚像素对齐时，smooth 会把整幅终端字糊成发虚。
                terminal_image := Image {
                    source: root.terminal-image;
                    width: root.terminal-image.width * 1phx;
                    height: root.terminal-image.height * 1phx;
                    // 贴顶左：余数空白落在右/下（与 xterm floor 网格一致），避免顶边像空行。
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    image-rendering: pixelated;
                }

                surface_touch := TouchArea {
                    // 终端文本区可做选择：I 形光标（桌面控件规则里仅文本类使用）
                    mouse-cursor: root.interactive ? MouseCursor.text : MouseCursor.default;
                    pointer-event(event) => {
                        if (!root.interactive) {
                            return;
                        }
                        if (event.button == PointerEventButton.left) {
                            if (event.kind == PointerEventKind.down) {
                                terminal_focus.focus();
                                root.selection-begin(self.mouse-x / 1px, self.mouse-y / 1px);
                            } else if (event.kind == PointerEventKind.move) {
                                if (self.pressed) {
                                    root.selection-update(self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            } else if (event.kind == PointerEventKind.up) {
                                root.selection-end(self.mouse-x / 1px, self.mouse-y / 1px);
                            }
                        } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                            root.context-menu-requested(
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y
                            );
                        }
                    }
                    clicked => {
                        if (root.interactive) {
                            terminal_focus.focus();
                        }
                    }
                    double-clicked => {
                        if (root.interactive) {
                            root.select-word-at(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                    scroll-event(event) => {
                        if (root.interactive && event.delta-y != 0) {
                            root.scroll-lines(event.delta-y > 0 ? 3 : -3);
                            return accept;
                        }
                        reject
                    }
                }
            }

            // P1：非交互叶子上的点击落到表面层，交给宿主切换焦点。
            if !root.interactive : TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.focus-requested(); }
            }

            // WP1/P2：连接生命周期 overlay（居中卡片）。不用 `if` 销毁节点，以便 opacity 淡入淡出；
            // pending 确认由模态对话框承载（投影侧已隐藏 overlay）。
            if root.interactive : Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.scrim;
                opacity: root.connection-overlay-visible ? 1.0 : 0.0;
                visible: root.connection-overlay-visible || self.opacity > 0.01;
                animate opacity {
                    duration: Theme.duration-normal;
                    easing: ease-out;
                }

                // 隐藏时不拦截终端指针。
                TouchArea {
                    enabled: root.connection-overlay-visible;
                    mouse-cursor: MouseCursor.default;
                }

                Rectangle {
                    width: min(420px, parent.width - 2 * Theme.spacing-24);
                    height: overlay_body.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: Theme.panel-background;
                    border-radius: Theme.radius-panel;
                    border-width: 1px;
                    border-color: Theme.control-stroke;

                    overlay_body := VerticalLayout {
                        padding: Theme.spacing-20;
                        spacing: Theme.spacing-12;

                        Text {
                            text: root.connection-overlay-target;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            font-weight: Theme.weight-semibold;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.connection-overlay-failed
                                ? @tr("Connection failed")
                                : @tr("Connecting…");
                            color: root.connection-overlay-failed ? Theme.critical : Theme.text-secondary;
                            font-size: Theme.font-caption;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        Text {
                            text: root.connection-overlay-stage;
                            color: Theme.accent;
                            font-size: Theme.font-body;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        if root.connection-overlay-error != "" : Text {
                            text: root.connection-overlay-error;
                            color: Theme.critical;
                            font-size: Theme.font-caption;
                            font-family: Theme.font-mono;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.spacing-8;

                            // P2：仅失败可 Retry；pending 确认走 HostKey/Auth 模态，不在此提供 Retry。
                            if root.connection-overlay-failed : WinButton {
                                text: @tr("Retry");
                                accent: true;
                                clicked => { root.connection-retry(); }
                            }

                            WinButton {
                                text: @tr("Cancel");
                                clicked => { root.connection-cancel(); }
                            }

                            if root.connection-overlay-error != "" : WinButton {
                                text: @tr("Copy error");
                                clicked => { root.connection-copy-error(); }
                            }
                        }
                    }
                }
            }

            // 滚动 / 选择反馈：右上角小浮层（半透明 chrome 底 + 4px 圆角），不占整行
            if root.interactive && (root.scroll-offset > 0 || root.selection-active) : Rectangle {
                x: parent.width - self.width - Theme.terminal-padding-x;
                y: Theme.terminal-padding-y;
                width: feedback_row.preferred-width;
                height: feedback_row.preferred-height;
                background: Theme.terminal-chrome-fill;
                border-radius: Theme.radius-control;
                border-width: 1px;
                border-color: Theme.terminal-border;

                feedback_row := HorizontalLayout {
                    padding-left: Theme.spacing-12;
                    padding-right: Theme.spacing-8;
                    padding-top: Theme.spacing-4;
                    padding-bottom: Theme.spacing-4;
                    spacing: Theme.spacing-8;
                    alignment: center;

                    if root.scroll-offset > 0 : Text {
                        text: @tr("scrolled back {n} line" | "scrolled back {n} lines" % root.scroll-offset);
                        color: Theme.caution;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                        wrap: no-wrap;
                    }

                    if root.selection-active : Text {
                        text: @tr("selection");
                        color: Theme.accent;
                        font-size: Theme.font-caption;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        wrap: no-wrap;
                    }

                    if root.scroll-offset > 0 : WinButton {
                        text: @tr("Bottom");
                        clicked => { root.scroll-to-bottom(); }
                    }
                }
            }

            // --- 滚动条（§5.17）：4px 细条 + 圆角，覆盖在表面右侧内缘，不占内容宽度 ---
            // 仅当存在可回翻行时出现；常态 40% 不透明度，悬停（滑块或轨道）/拖拽中 60%。
            if root.interactive && root.scrollbar-visible : Rectangle {
                x: parent.width - self.width - Theme.spacing-4;
                y: Theme.spacing-4;
                width: Theme.spacing-4;
                height: parent.height - 2 * Theme.spacing-4;
                background: transparent;
                clip: true;

                // 滑块长度 = 视口行数 / 总行数 × 轨道高度，最小 24px 保证可抓取。
                property <float> track-px: self.height / 1px;
                property <float> thumb-px: Math.max(self.track-px * root.scroll-thumb-ratio, 24.0);
                property <float> travel-px: Math.max(self.track-px - self.thumb-px, 0.0);

                scroll_thumb := Rectangle {
                    width: parent.width;
                    height: parent.thumb-px * 1px;
                    // scroll-fraction = 0 时贴底（live），= 1 时贴顶（最旧一行）
                    y: (parent.travel-px * (1.0 - root.scroll-fraction)) * 1px;
                    border-radius: self.width / 2;
                    background: Theme.text-tertiary;
                    opacity: scroll_bar_touch.dragging || scroll_bar_touch.has-hover ? 0.6 : 0.4;
                    animate opacity { duration: Theme.duration-faster; easing: ease-out; }
                }

                // Slint 1.9 的 TouchArea 没有 pressed 回调，pointer-event 也没有返回值
                //（无法 reject），拖拽状态自建：down 抓取滑块 → move 跟随鼠标 → up/cancel 释放。
                scroll_bar_touch := TouchArea {
                    property <bool> dragging: false;
                    // 按下时抓取点在滑块内的偏移：拖拽期间保持不变，滑块不会跳变。
                    property <length> drag-anchor: 0px;
                    property <bool> over-thumb: self.has-hover
                        && self.mouse-y >= scroll_thumb.y
                        && self.mouse-y <= scroll_thumb.y + scroll_thumb.height;

                    // E6：设计语言 §5 禁止 hand 光标——滚动条滑块保持默认箭头
                    //（拖拽把手才用 col/row-resize）。

                    // 条带上的滚轮与终端内容一致（3 行/格）：条带位于表面内边距上，
                    // 若不接手就会成为"滚轮死区"。
                    scroll-event(event) => {
                        if (event.delta-y != 0) {
                            root.scroll-lines(event.delta-y > 0 ? 3 : -3);
                            return accept;
                        }
                        reject
                    }

                    pointer-event(event) => {
                        // 注意：Slint 的 move 事件 button 是 `other`（不是 left），
                        // 所以按 kind 分派、只有 down 才看 button。
                        if (event.kind == PointerEventKind.down) {
                            if (event.button == PointerEventButton.left) {
                                // 点滚动条也把键盘焦点留在终端（与点终端内容一致）。
                                terminal_focus.focus();
                                if (self.over-thumb) {
                                    self.dragging = true;
                                    self.drag-anchor = self.mouse-y - scroll_thumb.y;
                                } else {
                                    // 点击轨道：滑块跳到点击位置对应的行。
                                    TerminalScrollInfo.scroll-to-line(
                                        root.scroll-line-at-y(self.mouse-y / 1px, parent.travel-px)
                                    );
                                }
                            }
                        } else if (event.kind == PointerEventKind.move) {
                            if (self.dragging) {
                                TerminalScrollInfo.scroll-to-line(
                                    root.scroll-line-at-y(
                                        (self.mouse-y - self.drag-anchor) / 1px,
                                        parent.travel-px
                                    )
                                );
                            }
                        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            self.dragging = false;
                        }
                    }
                }
            }
        }

        // --- 查找栏（P1：窄宽时控件可横向滚动，隐藏次要标签，避免挤成 `…`）---
        if root.interactive && root.find-visible : Rectangle {
            // 40px = 32px 控件 + 上下各 4px（M 轮5 实测值）
            height: Theme.control-height + 2 * Theme.spacing-4;
            background: Theme.terminal-chrome-fill;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.terminal-border;
            clip: true;

            // E10：Esc 关栏、F3/Shift+F3 上一个/下一个（输入框聚焦时也能用）。
            // 包住整条是为了让输入框 reject 的按键沿父链冒泡到这里。
            find_scope := FocusScope {
                focus-on-click: false;

                // E10：查找栏打开（条件元素创建）后自动聚焦搜索框。
                // 用 1ms Timer 在本次事件循环末尾执行一次，避免在 `changed find-visible`
                // 里访问尚未实例化的条件元素（搜索框本身就在这个 `if` 里）。
                focus_timer := Timer {
                    interval: 1ms;
                    running: true;
                    triggered => {
                        if (root.view-visible) {
                            search_input.focus-input();
                        }
                        self.running = false;
                    }
                }

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.dismiss-find();
                        return accept;
                    }
                    if (event.text == Key.F3) {
                        if (event.modifiers.shift) {
                            root.find-prev();
                        } else {
                            root.find-next();
                        }
                        return accept;
                    }
                    return reject;
                }

                find_flick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    interactive: true;
                    mouse-drag-pan-enabled: true;
                    content-width: Math.max(find_row.preferred-width, self.width);
                    content-height: self.height;

                    find_row := HorizontalLayout {
                        // 文本左 8；右侧以 32×32 关闭按钮收尾；纵向 4 垂直居中
                        padding-left: Theme.spacing-8;
                        padding-right: Theme.spacing-4;
                        padding-top: Theme.spacing-4;
                        padding-bottom: Theme.spacing-4;
                        spacing: Theme.spacing-4;

                        // P1：宽栏才显示 "Find" 标签；窄栏靠输入框 placeholder 表达语义。
                        if find_scope.width >= 520px : Text {
                            text: @tr("Find");
                            color: Theme.text-secondary;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }

                        // 搜索框：WinTextInput 自带 control-fill 底 + control-stroke 描边 + 聚焦强调条
                        search_input := WinTextInput {
                            horizontal-stretch: 1;
                            // P1：再压一点下限，给按钮留位；过窄时 Flickable 横滚
                            min-width: 72px;
                            text <=> root.search-query;
                            placeholder-text: root.search-regex
                                ? @tr("Regex (Rust syntax)")
                                : @tr("Search visible terminal text");
                            accepted => {
                                root.find-text(self.text);
                                // 提交后回焦终端，避免后续按键继续落在输入框/直接进 shell 的歧义
                                terminal_focus.focus();
                            }
                        }

                        // WP2：正则模式开关；窄栏隐藏文字，走纯图标/勾选态
                        WinToggle {
                            text: find_scope.width >= 420px ? @tr("Regex") : "";
                            accessible-name: @tr("Regex");
                            checked <=> root.search-regex;
                            toggled => {
                                root.find-regex-changed(root.search-regex);
                                if (search_input.text != "") {
                                    root.find-text(search_input.text);
                                }
                            }
                        }

                        // E10：按钮保底宽；窄栏用更短标签
                        WinButton {
                            text: @tr("Find");
                            min-width: 48px;
                            clicked => {
                                root.find-text(search_input.text);
                                terminal_focus.focus();
                            }
                        }
                        WinButton {
                            text: @tr("Prev");
                            min-width: find_scope.width >= 420px ? 56px : 48px;
                            clicked => {
                                root.find-prev();
                                terminal_focus.focus();
                            }
                        }
                        WinButton {
                            text: @tr("Next");
                            min-width: find_scope.width >= 420px ? 56px : 48px;
                            clicked => {
                                root.find-next();
                                terminal_focus.focus();
                            }
                        }

                        // P1：摘要仅在较宽时显示，避免与按钮抢宽
                        if find_scope.width >= 560px : Text {
                            text: root.search-summary;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            min-width: 0px;
                            overflow: elide;
                        }

                        WinIconButton {
                            icon: "close";
                            accessible-name: @tr("Close find bar");
                            clicked => { root.dismiss-find(); }
                        }
                    }
                }
            }
        }
    }

    /// A2/E23：把键盘焦点交还终端（菜单/弹层关闭后的焦点回退；查找栏关闭时也走这里）。
    /// 终端不可见时应由宿主自行判断，不要调用。
    public function focus-terminal() {
        if (root.interactive) {
            terminal_focus.focus();
        }
    }
}
