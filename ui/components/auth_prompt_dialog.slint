// Authentication prompt — sign in with a server-offered method.
//
// Flow: host context → retry error (if any) → method switch (when >1) →
// method fields → footer (Cancel | Connect/Continue). Sensitive values are
// cleared by the host on dismiss; this component only presents and edits them.

import { Theme } from "../theme.slint";
import { WinButton, WinInfoBar, WinToggle, WinScrollIndicator } from "basic/controls.slint";
import { WinTextInput } from "basic/text_input.slint";

export struct AuthKeyOption {
    id: string,
    label: string,
    detail: string,
}

export struct AuthKeyboardPrompt {
    text: string,
    echo: bool,
    answer: string,
}

component AuthKeyListItem inherits Rectangle {
    in property <AuthKeyOption> node;
    in property <bool> selected: false;
    callback clicked();

    height: 48px;
    border-radius: Theme.radius-control;
    background: selected ? Theme.subtle-selected
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    VerticalLayout {
        padding-left: Theme.spacing-12;
        padding-right: Theme.spacing-12;
        padding-top: Theme.spacing-8;
        padding-bottom: Theme.spacing-8;
        spacing: 2px;

        Text {
            text: node.label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: root.selected ? Theme.weight-semibold : 400;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: node.detail;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            font-family: Theme.font-mono;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AuthPromptDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> host-text: "";
    in property <string> problem-text: "";
    in property <bool> has-usable-method: true;

    in-out property <int> selected-method: 0;
    in property <bool> password-visible: true;
    in property <bool> publickey-visible: true;
    in property <bool> keyboard-visible: true;
    in property <bool> submit-enabled: true;

    in-out property <string> password-text: "";

    in property <[AuthKeyOption]> key-options: [];
    in-out property <int> selected-key-index: -1;
    in property <string> selected-key-label: "";
    in-out property <string> passphrase-text: "";
    in-out property <bool> use-agent: false;
    in property <bool> publickey-submit-enabled: false;

    in property <string> challenge-name: "";
    in property <string> challenge-instruction: "";
    in property <[AuthKeyboardPrompt]> challenge-prompts: [];
    in property <int> challenge-round: 0;
    in property <int> challenge-round-total: 0;
    in property <bool> keyboard-final-round: false;
    in property <bool> keyboard-submit-enabled: false;

    callback cancel();
    callback select-method(int);
    callback submit-password();
    callback update-password(string);
    callback select-key(int);
    callback update-passphrase(string);
    callback toggle-use-agent(bool);
    callback browse-key-file();
    callback update-challenge-answer(int, string);
    callback submit-keyboard-round();

    visible: root.open;
    background: transparent;

    private property <bool> show-password:
        root.selected-method == 0 && root.password-visible;
    private property <bool> show-publickey:
        root.selected-method == 1 && root.publickey-visible;
    private property <bool> show-keyboard:
        root.selected-method == 2 && root.keyboard-visible;
    private property <bool> method-chooser-visible:
        (root.password-visible && (root.publickey-visible || root.keyboard-visible))
        || (root.publickey-visible && root.keyboard-visible);

    private property <bool> primary-enabled:
        !root.has-usable-method ? false
        : root.show-password ? root.submit-enabled
        : root.show-publickey ? root.publickey-submit-enabled
        : root.show-keyboard ? root.keyboard-submit-enabled
        : false;

    private property <string> primary-label:
        root.show-keyboard && !root.keyboard-final-round
            ? @tr("Continue")
            : @tr("Connect");

    function submit-primary() {
        if (root.show-keyboard) {
            root.submit-keyboard-round();
        } else {
            root.submit-password();
        }
    }

    dialog_scope := FocusScope {
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.cancel();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            width: root.width;
            height: root.height;
            spacing: Theme.spacing-16;

            // Who are we signing into?
            VerticalLayout {
                spacing: Theme.spacing-4;

                Text {
                    text: @tr("Sign in to {0}", root.host-text);
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-semibold;
                    wrap: no-wrap;
                    overflow: elide;
                }

                if root.method-chooser-visible : Text {
                    text: @tr("Pick a method the server accepts. You can switch and retry without losing what you typed.");
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                }
            }

            if root.problem-text != "" : WinInfoBar {
                severity: "error";
                text: root.problem-text;
            }

            if !root.has-usable-method : WinInfoBar {
                severity: "error";
                text: @tr("The server does not offer any authentication method YShell supports.");
            }

            // Method switch — only when the server offers more than one.
            if root.has-usable-method && root.method-chooser-visible : HorizontalLayout {
                spacing: Theme.spacing-8;

                if root.password-visible : WinButton {
                    text: @tr("Password");
                    accent: root.selected-method == 0;
                    clicked => { root.select-method(0); }
                }

                if root.publickey-visible : WinButton {
                    text: @tr("Public key");
                    accent: root.selected-method == 1;
                    clicked => { root.select-method(1); }
                }

                if root.keyboard-visible : WinButton {
                    text: @tr("Keyboard interactive");
                    accent: root.selected-method == 2;
                    clicked => { root.select-method(2); }
                }
            }

            // --- Password --------------------------------------------------
            if root.show-password : VerticalLayout {
                spacing: Theme.spacing-12;

                VerticalLayout {
                    spacing: Theme.spacing-8;

                    Text {
                        text: @tr("Password");
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                    }

                    WinTextInput {
                        text <=> root.password-text;
                        placeholder-text: @tr("Password");
                        input-type: password;
                        edited(text) => { root.update-password(text); }
                        accepted => { if root.primary-enabled { root.submit-primary(); } }
                    }
                }
            }

            // --- Public key ------------------------------------------------
            if root.show-publickey : VerticalLayout {
                spacing: Theme.spacing-12;

                VerticalLayout {
                    spacing: Theme.spacing-8;

                    Text {
                        text: @tr("Private key");
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                    }

                    Rectangle {
                        height: min(48px * max(root.key-options.length, 1) + 8px, 240px);
                        background: Theme.control-fill;
                        border-radius: Theme.radius-control;
                        border-width: 1px;
                        border-color: Theme.control-stroke;
                        clip: true;

                        key-scroll := Flickable {
                            visible: root.key-options.length > 0;
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            content-width: self.width;
                            content-height: key-list.preferred-height;

                            key-list := VerticalLayout {
                                padding: Theme.spacing-4;
                                spacing: 2px;

                                for option[i] in root.key-options : AuthKeyListItem {
                                    node: option;
                                    selected: i == root.selected-key-index;
                                    clicked => {
                                        root.selected-key-index = i;
                                        root.select-key(i);
                                    }
                                }
                            }
                        }

                        WinScrollIndicator {
                            visible: root.key-options.length > 0;
                            x: parent.width - self.width - Theme.spacing-4;
                            y: Theme.spacing-4;
                            height: parent.height - 2 * Theme.spacing-4;
                            viewport-position: key-scroll.content-y;
                            content-extent: key-scroll.content-height;
                            viewport-extent: key-scroll.height;
                            thumb-min-length: 16px;
                        }

                        if root.key-options.length == 0 : Text {
                            width: parent.width - 2 * Theme.spacing-16;
                            x: Theme.spacing-16;
                            y: max((parent.height - self.preferred-height) / 2, Theme.spacing-12);
                            text: @tr("No managed private key. Import one on the Private Keys page, or browse for a key file.");
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-8;

                        Text {
                            text: root.selected-key-label != ""
                                ? root.selected-key-label
                                : @tr("No key selected");
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: no-wrap;
                            overflow: elide;
                        }

                        WinButton {
                            text: @tr("Browse…");
                            icon: "file";
                            clicked => { root.browse-key-file(); }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Theme.spacing-8;

                    Text {
                        text: @tr("Key passphrase");
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                    }

                    WinTextInput {
                        text <=> root.passphrase-text;
                        placeholder-text: @tr("Optional");
                        input-type: password;
                        edited(text) => { root.update-passphrase(text); }
                        accepted => {
                            if root.primary-enabled { root.submit-primary(); }
                        }
                    }
                }

                WinToggle {
                    text: @tr("Use ssh-agent");
                    checked: root.use-agent;
                    toggled => { root.toggle-use-agent(self.checked); }
                }
            }

            // --- Keyboard-interactive --------------------------------------
            if root.show-keyboard : VerticalLayout {
                spacing: Theme.spacing-12;

                if root.challenge-round-total > 1 : Text {
                    text: @tr("Round {0} of {1}", root.challenge-round, root.challenge-round-total);
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                }

                if root.challenge-name != "" : Text {
                    text: root.challenge-name;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                }

                if root.challenge-instruction != "" : Text {
                    text: root.challenge-instruction;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }

                if root.challenge-prompts.length == 0 : Text {
                    text: @tr("Waiting for the server challenge…");
                    color: Theme.text-tertiary;
                    font-size: Theme.font-body;
                }

                for prompt[i] in root.challenge-prompts : VerticalLayout {
                    spacing: Theme.spacing-8;

                    Text {
                        text: prompt.text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }

                    WinTextInput {
                        text: prompt.answer;
                        input-type: prompt.echo ? InputType.text : InputType.password;
                        accepted => {
                            if root.primary-enabled { root.submit-primary(); }
                        }
                        edited => { root.update-challenge-answer(i, self.text); }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.spacing-12;
                background: transparent;
            }

            Rectangle {
                height: 1px;
                vertical-stretch: 0;
                background: Theme.divider;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;
                vertical-stretch: 0;
                padding-top: Theme.spacing-4;

                WinButton {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }

                WinButton {
                    text: root.primary-label;
                    accent: true;
                    enabled: root.primary-enabled;
                    clicked => { root.submit-primary(); }
                }
            }
        }
    }

    public function focus-dialog() {
        dialog_scope.focus();
    }

    changed open => {
        if (root.open) {
            dialog_scope.focus();
        }
    }
}
