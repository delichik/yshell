// 独立工具窗口客户区壳：自绘标题栏 + 内容槽（无遮罩、无居中卡片）。
//
// 由各 `*Window inherits Window` 填满客户区使用；关闭走 `close-requested`，
// 拖动复用主窗同一套 TitleBarDragTouch / CaptionButton（window_caption.slint）。

import { Theme } from "../theme.slint";
import { TitleBarDragTouch, CaptionButton } from "window_caption.slint";

/// 标题栏 + 内容槽；根尺寸由宿主 Window 的 preferred/min/max 决定。
export component ToolWindowChrome inherits Rectangle {
    in property <string> title-text: "";
    /// 标题右侧摘要（可空：不占位）。
    in property <string> summary-text: "";
    /// Windows：标题栏拖动走 Win32 原生移动循环。
    in property <bool> native-title-drag: false;
    callback close-requested();
    callback title-drag-requested();

    background: Theme.window-background;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        title_bar := Rectangle {
            height: Theme.bar-height-menubar;
            vertical-stretch: 0;
            background: Theme.window-background;

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.divider;
            }

            if !root.native-title-drag : WindowMoveArea {
                width: parent.width - 46px;
                height: parent.height;
            }

            if root.native-title-drag : TitleBarDragTouch {
                width: parent.width - 46px;
                height: parent.height;
                native-drag: true;
                drag-requested => { root.title-drag-requested(); }
            }

            HorizontalLayout {
                padding-left: Theme.spacing-12;
                spacing: Theme.spacing-12;

                Text {
                    text: root.title-text;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    horizontal-stretch: root.summary-text == "" ? 1 : 0;
                    overflow: elide;
                }

                if root.summary-text != "" : Text {
                    text: root.summary-text;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }

                CaptionButton {
                    kind: "close";
                    clicked => { root.close-requested(); }
                }
            }
        }

        content := Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            background: Theme.window-background;
            clip: true;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: Theme.tool-window-padding;
                spacing: Theme.spacing-12;
                @children
            }
        }
    }
}
