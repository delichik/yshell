// Password required as an independent non-resizable tool window.

import { Theme } from "../theme.slint";
import { PasswordPromptDialog } from "../components/password_prompt_dialog.slint";

export component PasswordPromptWindow inherits Window {
    title: @tr("Password required");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-standard;
    min-width: Theme.tool-window-width-standard;
    max-width: Theme.tool-window-width-standard;
    preferred-height: Theme.tool-window-height-standard;
    min-height: Theme.tool-window-height-standard;
    max-height: Theme.tool-window-height-standard;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    in property <string> title-text;
    in property <string> message-text;
    in-out property <string> password-text;
    in property <bool> connect-enabled;

    in-out property <bool> native_title_drag: false;

    callback cancel();
    callback submit();
    callback title_drag_requested();

    dialog := PasswordPromptDialog {
        open: true;
        width: Theme.tool-window-width-standard;
        height: Theme.tool-window-height-standard;
        title-text: root.title-text;
        message-text: root.message-text;
        password-text <=> root.password-text;
        connect-enabled: root.connect-enabled;
        cancel => { root.cancel(); }
        submit => { root.submit(); }
    }

    public function focus-dialog() {
        dialog.focus-dialog();
    }

    init => {
        root.focus-dialog();
    }
}

