// Known Hosts as an independent non-resizable tool window.

import { Theme } from "../theme.slint";
import { KnownHostsPage } from "../pages/known_hosts.slint";

export component KnownHostsWindow inherits Window {
    title: @tr("Known Hosts");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-wide;
    min-width: Theme.tool-window-width-wide;
    max-width: Theme.tool-window-width-wide;
    preferred-height: Theme.tool-window-height-tall;
    min-height: Theme.tool-window-height-tall;
    max-height: Theme.tool-window-height-tall;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    in property <string> inventory-text;
    in property <string> selection-text;
    in property <string> details-text;
    in property <string> detail-host-text;
    in property <string> detail-port-text;
    in property <string> detail-algorithm-text;
    in property <string> detail-fingerprint-text;
    in property <string> detail-path-text;
    in property <string> path-text;
    in-out property <string> clear-confirmation-text;

    in-out property <bool> native_title_drag: false;

    callback dismiss();
    callback select-prev();
    callback select-next();
    callback remove-selected();
    callback update-clear-confirmation(string);
    callback clear-all();
    callback title_drag_requested();

    page := KnownHostsPage {
        open: true;
        width: Theme.tool-window-width-wide;
        height: Theme.tool-window-height-tall;
        inventory-text: root.inventory-text;
        selection-text: root.selection-text;
        details-text: root.details-text;
        detail-host-text: root.detail-host-text;
        detail-port-text: root.detail-port-text;
        detail-algorithm-text: root.detail-algorithm-text;
        detail-fingerprint-text: root.detail-fingerprint-text;
        detail-path-text: root.detail-path-text;
        path-text: root.path-text;
        clear-confirmation-text <=> root.clear-confirmation-text;
        native-title-drag <=> root.native_title_drag;
        title-drag-requested => { root.title_drag_requested(); }
        close => { root.dismiss(); }
        select-prev => { root.select-prev(); }
        select-next => { root.select-next(); }
        remove-selected => { root.remove-selected(); }
        update-clear-confirmation(string) => { root.update-clear-confirmation(string); }
        clear-all => { root.clear-all(); }
    }

    public function focus-dialog() {
        page.focus-dialog();
    }

    init => {
        root.focus-dialog();
    }
}

