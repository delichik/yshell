// Startup master-password unlock as an independent compact tool window
// (560×400). Prototype: docs/prototypes/settings/master-password-unlock.html
//
// Shown on the first access to protected data after start-up. `Unlock` verifies
// the password; a wrong password shows an inline error bar and the window size
// does not change. `Quit` / × / Esc exits YShell without reading any protected
// file. `Forgot password?` goes to the Reset flow (destructive, no token).

import { Theme } from "../theme.slint";
import { WinButton, WinIconButton } from "../components/basic/controls.slint";
import { Icon } from "../components/basic/icons.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";
import { TextFormats } from "../text_formats.slint";

component UnlockActionButton inherits Rectangle {
    in property <string> text: "";
    in property <string> hint: "";
    in property <bool> accent: false;
    in property <bool> critical: false;
    callback clicked();

    height: Theme.control-height;
    width: button.preferred-width;

    button := WinButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        accent: root.accent;
        critical: root.critical;
        clicked => { root.clicked(); }
    }

    if root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

export component MasterPasswordUnlockWindow inherits Window {
    title: @tr("Master Password Required");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-compact;
    min-width: Theme.tool-window-width-compact;
    max-width: Theme.tool-window-width-compact;
    preferred-height: Theme.tool-window-height-compact;
    min-height: Theme.tool-window-height-compact;
    max-height: Theme.tool-window-height-compact;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    /// Inline error id (`wrong-current` / `not-set`); empty = clean.
    in property <string> error-id: "";
    in-out property <string> password-text;

    in-out property <bool> native_title_drag: false;

    callback unlock();
    callback quit();
    callback forgot();
    callback update-password(string);
    callback title_drag_requested();

    private property <length> body-width:
        Theme.tool-window-width-compact - 2 * Theme.tool-window-padding;
    private property <length> body-height:
        Theme.tool-window-height-compact - Theme.bar-height-menubar
        - 2 * Theme.tool-window-padding;

    ToolWindowChrome {
        width: Theme.tool-window-width-compact;
        height: Theme.tool-window-height-compact;
        title-text: @tr("Master Password Required");
        native-title-drag: root.native_title_drag;
        // × = Quit（不读取任何受保护文件）。
        close-requested => { root.quit(); }
        title-drag-requested => { root.title_drag_requested(); }

        VerticalLayout {
            width: root.body-width;
            height: root.body-height;
            spacing: Theme.spacing-12;

            Text {
                text: @tr("Enter your master password.");
                color: Theme.text-primary;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            // 错误条：就地显示，窗体尺寸不变。
            if root.error-id != "" : Rectangle {
                background: Theme.banner-error-background;
                border-radius: Theme.radius-control;
                border-width: 1px;
                border-color: Theme.banner-error-stroke;

                HorizontalLayout {
                    padding: Theme.spacing-8;
                    spacing: Theme.spacing-8;

                    Icon {
                        width: Theme.icon-size-small;
                        height: Theme.icon-size-small;
                        name: "warning";
                        icon-color: Theme.banner-error-text;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: TextFormats.master-password-error(root.error-id);
                        color: Theme.banner-error-text;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                }
            }

            // 单字段子窗：无左侧 label，控件顶满内容区。
            WinTextInput {
                horizontal-stretch: 0;
                input-type: InputType.password;
                placeholder-text: @tr("Master password");
                text <=> root.password-text;
                edited => { root.update-password(self.text); }
                accepted => { root.unlock(); }
            }

            HorizontalLayout {
                alignment: end;
                UnlockActionButton {
                    text: @tr("Forgot password?");
                    hint: @tr("Reset master password");
                    critical: true;
                    clicked => { root.forgot(); }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            Rectangle { height: 1px; background: Theme.divider; }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;

                UnlockActionButton {
                    text: @tr("Quit");
                    hint: @tr("Quit YShell without unlocking");
                    clicked => { root.quit(); }
                }
                UnlockActionButton {
                    text: @tr("Unlock");
                    hint: @tr("Unlock");
                    accent: true;
                    clicked => { root.unlock(); }
                }
            }
        }
    }

    /// 宿主把键盘焦点交给本窗（字段焦点由默认 Tab 链处理）。
    public function focus-dialog() {
    }
}
