// Theme Manager as an independent non-resizable tool window.

import { Theme } from "../theme.slint";
import { ThemeManagerPage, ThemeManagerRow } from "../pages/theme_manager.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";

export component ThemeManagerWindow inherits Window {
    title: @tr("Terminal Styles");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-wide;
    min-width: Theme.tool-window-width-wide;
    max-width: Theme.tool-window-width-wide;
    preferred-height: Theme.tool-window-height-tall;
    min-height: Theme.tool-window-height-tall;
    max-height: Theme.tool-window-height-tall;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    private property <length> body-width:
        Theme.tool-window-width-wide - 2 * Theme.tool-window-padding;
    private property <length> body-height:
        Theme.tool-window-height-tall - Theme.bar-height-menubar - 2 * Theme.tool-window-padding;

    in property <[ThemeManagerRow]> themes;
    in-out property <int> selected-index;
    in property <string> default-name-text;
    in property <bool> selected-is-default;
    in property <int> builtin-count;
    in property <int> user-count;
    in property <image> preview;
    in property <color> preview-background;
    in property <bool> theme-editor-open;
    in property <bool> theme-editor-builtin;
    in property <string> theme-editor-id;
    in-out property <string> theme-editor-name;
    in property <color> theme-editor-foreground;
    in property <color> theme-editor-background;
    in property <color> theme-editor-cursor;
    in property <color> theme-editor-selection;
    in property <[color]> theme-editor-ansi;
    in property <[color]> editor-palette-swatches;
    in property <bool> font-editable;
    in property <[string]> font-options;
    in-out property <int> font-index;
    in-out property <string> font-family-text;
    in-out property <string> font-size-text;
    in-out property <string> backup-font-text;

    in-out property <bool> native_title_drag: false;

    callback dismiss();
    callback select-theme(int);
    callback set-default-theme();
    callback new-style();
    callback clone-theme(string);
    callback edit-theme(string);
    callback request-delete-theme(string);
    callback close-theme-editor();
    callback save-theme-editor();
    callback update-theme-editor-name(string);
    callback update-theme-editor-role(string, string);
    callback update-theme-editor-ansi(int, string);
    callback prepare-context-menu(int);
    callback clone-from-menu();
    callback delete-from-menu();
    callback update-font-family(string);
    callback update-font-size(string);
    callback update-backup-font(string);
    callback browse-font-family-file();
    callback browse-font-fallback-file();
    callback title_drag_requested();

    chrome := ToolWindowChrome {
        width: Theme.tool-window-width-wide;
        height: Theme.tool-window-height-tall;
        title-text: @tr("Terminal Styles");
        // 计数只在页内工具条右侧；标题栏不重复（对齐原型 title = 名称）。
        summary-text: "";
        native-title-drag: root.native_title_drag;
        close-requested => { root.dismiss(); }
        title-drag-requested => { root.title_drag_requested(); }

        page := ThemeManagerPage {
            open: true;
            width: root.body-width;
            height: root.body-height;
            themes: root.themes;
            selected-index <=> root.selected-index;
            default-name-text: root.default-name-text;
            selected-is-default: root.selected-is-default;
            builtin-count: root.builtin-count;
            user-count: root.user-count;
            preview: root.preview;
            preview-background: root.preview-background;
            theme-editor-open: root.theme-editor-open;
            theme-editor-builtin: root.theme-editor-builtin;
            theme-editor-id: root.theme-editor-id;
            theme-editor-name <=> root.theme-editor-name;
            theme-editor-foreground: root.theme-editor-foreground;
            theme-editor-background: root.theme-editor-background;
            theme-editor-cursor: root.theme-editor-cursor;
            theme-editor-selection: root.theme-editor-selection;
            theme-editor-ansi: root.theme-editor-ansi;
            editor-palette-swatches: root.editor-palette-swatches;
            font-editable: root.font-editable;
            font-options: root.font-options;
            font-index <=> root.font-index;
            font-family-text <=> root.font-family-text;
            font-size-text <=> root.font-size-text;
            backup-font-text <=> root.backup-font-text;
            close => { root.dismiss(); }
            select-theme(int) => { root.select-theme(int); }
            set-default-theme => { root.set-default-theme(); }
            new-style => { root.new-style(); }
            clone-theme(string) => { root.clone-theme(string); }
            edit-theme(string) => { root.edit-theme(string); }
            request-delete-theme(string) => { root.request-delete-theme(string); }
            close-theme-editor => { root.close-theme-editor(); }
            save-theme-editor => { root.save-theme-editor(); }
            update-theme-editor-name(string) => { root.update-theme-editor-name(string); }
            update-theme-editor-role(string, string) => { root.update-theme-editor-role(string, string); }
            update-theme-editor-ansi(int, string) => { root.update-theme-editor-ansi(int, string); }
            prepare-context-menu(int) => { root.prepare-context-menu(int); }
            clone-from-menu => { root.clone-from-menu(); }
            delete-from-menu => { root.delete-from-menu(); }
            update-font-family(string) => { root.update-font-family(string); }
            update-font-size(string) => { root.update-font-size(string); }
            update-backup-font(string) => { root.update-backup-font(string); }
            browse-font-family-file => { root.browse-font-family-file(); }
            browse-font-fallback-file => { root.browse-font-fallback-file(); }
        }
    }

    public function focus-dialog() {
        page.focus-dialog();
    }

    init => {
        root.focus-dialog();
    }
}

