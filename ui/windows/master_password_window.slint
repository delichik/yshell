// Master password (Set / Change / Remove / Reset) as an independent compact
// tool window (560×400). Prototype: docs/prototypes/settings/master-password.html
//
// One window, four states selected by `kind`; the footer is always
// `Cancel | primary` and there is **no typing confirmation token**: Reset is a
// plain destructive button (D35 / docs/agents/prototypes.md).

import { Theme } from "../theme.slint";
import { WinButton } from "../components/basic/controls.slint";
import { Icon } from "../components/basic/icons.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";
import { TextFormats } from "../text_formats.slint";

// 页脚按钮 + tooltip（每个可点按钮都要有悬停提示）。
component PasswordActionButton inherits Rectangle {
    in property <string> text: "";
    in property <string> hint: "";
    in property <bool> accent: false;
    in property <bool> critical: false;
    callback clicked();

    height: Theme.control-height;
    width: button.preferred-width;

    button := WinButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        accent: root.accent;
        critical: root.critical;
        clicked => { root.clicked(); }
    }

    if root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

export component MasterPasswordWindow inherits Window {
    title: @tr("Master Password");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-compact;
    min-width: Theme.tool-window-width-compact;
    max-width: Theme.tool-window-width-compact;
    preferred-height: Theme.tool-window-height-compact;
    min-height: Theme.tool-window-height-compact;
    max-height: Theme.tool-window-height-compact;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    /// `set` / `change` / `remove` / `reset`.
    in property <string> kind: "set";
    /// Validation error id (`too-short` / `mismatch` / `current-required` /
    /// `wrong-current`); empty = clean.
    in property <string> error-id: "";
    in-out property <string> current-text;
    in-out property <string> new-text;
    in-out property <string> confirm-text;

    in-out property <bool> native_title_drag: false;

    callback cancel();
    callback submit();
    callback dismissed();
    callback update-current(string);
    callback update-new(string);
    callback update-confirm(string);
    callback title_drag_requested();

    private property <length> body-width:
        Theme.tool-window-width-compact - 2 * Theme.tool-window-padding;
    private property <length> body-height:
        Theme.tool-window-height-compact - Theme.bar-height-menubar
        - 2 * Theme.tool-window-padding;
    private property <bool> current-visible: root.kind == "change" || root.kind == "remove";
    private property <bool> new-visible: root.kind == "set" || root.kind == "change";
    private property <bool> is-reset: root.kind == "reset";

    ToolWindowChrome {
        width: Theme.tool-window-width-compact;
        height: Theme.tool-window-height-compact;
        title-text: TextFormats.master-password-dialog-title(root.kind);
        native-title-drag: root.native_title_drag;
        close-requested => { root.dismissed(); }
        title-drag-requested => { root.title_drag_requested(); }

        VerticalLayout {
            width: root.body-width;
            height: root.body-height;
            spacing: Theme.spacing-12;

            if root.kind == "set" : Text {
                text: @tr("Encrypts sessions and keys.");
                color: Theme.text-primary;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            // 错误条：就地显示，窗体尺寸不变。
            if root.error-id != "" : Rectangle {
                background: Theme.banner-error-background;
                border-radius: Theme.radius-control;
                border-width: 1px;
                border-color: Theme.banner-error-stroke;

                HorizontalLayout {
                    padding: Theme.spacing-8;
                    spacing: Theme.spacing-8;

                    Icon {
                        width: Theme.icon-size-small;
                        height: Theme.icon-size-small;
                        name: "warning";
                        icon-color: Theme.banner-error-text;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: TextFormats.master-password-error(root.error-id);
                        color: Theme.banner-error-text;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                }
            }

            // `alignment` 必须是 stretch（默认）：WinTextInput 的 preferred-width 固定为
            // 0，`alignment: start` 时布局只给子项 preferred 尺寸，输入框会变成 0 宽不可见。
            if root.current-visible : HorizontalLayout {
                spacing: Theme.spacing-12;
                alignment: stretch;
                Text {
                    text: @tr("Current");
                    width: Theme.form-label-width;
                    height: Theme.control-height;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }
                WinTextInput {
                    horizontal-stretch: 1;
                    input-type: InputType.password;
                    text <=> root.current-text;
                    edited => { root.update-current(self.text); }
                }
            }

            if root.new-visible : HorizontalLayout {
                spacing: Theme.spacing-12;
                alignment: stretch;
                Text {
                    text: @tr("New");
                    width: Theme.form-label-width;
                    height: Theme.control-height;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }
                WinTextInput {
                    horizontal-stretch: 1;
                    input-type: InputType.password;
                    text <=> root.new-text;
                    edited => { root.update-new(self.text); }
                }
            }

            if root.new-visible : HorizontalLayout {
                spacing: Theme.spacing-12;
                alignment: stretch;
                Text {
                    text: @tr("Confirm");
                    width: Theme.form-label-width;
                    height: Theme.control-height;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }
                WinTextInput {
                    horizontal-stretch: 1;
                    input-type: InputType.password;
                    text <=> root.confirm-text;
                    edited => { root.update-confirm(self.text); }
                }
            }

            if root.new-visible : Text {
                text: @tr("At least 8 characters.");
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
            }

            if root.kind == "set" : Text {
                text: @tr("No recovery if forgotten.");
                color: Theme.critical;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }

            if root.kind == "remove" : Text {
                text: @tr("Sessions and keys will no longer be encrypted.");
                color: Theme.critical;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }

            if root.is-reset : Text {
                text: @tr("Deletes all protected data. This cannot be undone.");
                color: Theme.critical;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            Rectangle { height: 1px; background: Theme.divider; }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;

                PasswordActionButton {
                    text: @tr("Cancel");
                    hint: @tr("Cancel (returns to Settings or Unlock)");
                    clicked => { root.cancel(); }
                }
                PasswordActionButton {
                    text: TextFormats.master-password-dialog-primary(root.kind);
                    hint: TextFormats.master-password-dialog-primary(root.kind);
                    accent: !root.is-reset;
                    critical: root.is-reset;
                    clicked => { root.submit(); }
                }
            }
        }
    }

    /// 宿主把键盘焦点交给本窗（字段焦点由 Slint 的默认 Tab 链处理）。
    public function focus-dialog() {
    }
}
