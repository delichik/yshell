// Login Script · Keys 步骤子窗（standard 720×580）。
//
// 原型：`docs/prototypes/session-editor/sections/login-step-keys.html`。
// 主列表只读；Keys 正文与 Tokens 速查在本窗编辑。页脚 Delete（编辑态）| Cancel | Save。

import { Theme } from "../theme.slint";
import { WinButton, WinIconButton } from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";
import { EditorTextArea } from "../pages/session_editor.slint";

// 表单行：左侧固定宽度标签 + 右侧控件（与 Session Editor 同形态）。
component FormRow inherits Rectangle {
    in property <string> label: "";

    height: max(Theme.control-height, body.preferred-height);
    background: transparent;

    body := HorizontalLayout {
        spacing: Theme.spacing-12;
        cross-axis-alignment: start;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            width: Theme.form-label-width-narrow;
            height: Theme.control-height;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing-8;
            cross-axis-alignment: center;
            @children
        }
    }
}

export component LoginStepKeysWindow inherits Window {
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-standard;
    min-width: Theme.tool-window-width-standard;
    max-width: Theme.tool-window-width-standard;
    preferred-height: Theme.tool-window-height-standard;
    min-height: Theme.tool-window-height-standard;
    max-height: Theme.tool-window-height-standard;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    title: root.edit-mode ? @tr("Edit Keys") : @tr("Add Keys");

    private property <length> body-width:
        Theme.tool-window-width-standard - 2 * Theme.tool-window-padding;
    private property <length> body-height:
        Theme.tool-window-height-standard - Theme.bar-height-menubar - 2 * Theme.tool-window-padding;

    /// true = 编辑已有步骤（标题 Edit Keys，页脚出现 Delete）。
    in property <bool> edit-mode: false;
    in-out property <string> name-text: "";
    in-out property <string> keys-text: "";
    /// 展开 `{host}` / `{username}` 会话令牌。
    in property <bool> tokens: false;

    in-out property <bool> native_title_drag: false;

    callback dismiss();
    callback update-name(string);
    callback update-keys(string);
    callback set-tokens(bool);
    callback save();
    callback delete-step();
    callback title_drag_requested();

    chrome := ToolWindowChrome {
        width: Theme.tool-window-width-standard;
        height: Theme.tool-window-height-standard;
        title-text: root.edit-mode ? @tr("Edit Keys") : @tr("Add Keys");
        native-title-drag: root.native_title_drag;
        close-requested => { root.dismiss(); }
        title-drag-requested => { root.title_drag_requested(); }

        VerticalLayout {
            width: root.body-width;
            height: root.body-height;
            spacing: Theme.spacing-12;

            FormRow {
                label: @tr("Name");
                WinTextInput {
                    width: 420px;
                    text <=> root.name-text;
                    placeholder-text: @tr("Optional");
                    edited => { root.update-name(self.text); }
                }
            }

            FormRow {
                label: @tr("Keys");

                EditorTextArea {
                    width: 420px;
                    area-height: 232px;
                    monospace: true;
                    text <=> root.keys-text;
                    placeholder-text: "cd /opt/app{Enter}\nsudo -i{Enter}";
                    edited(value) => { root.update-keys(value); }
                }
            }

            // Tokens 速查（只读说明；宽度与表单列一致）。
            FormRow {
                label: @tr("Tokens");

                Rectangle {
                    width: 420px;
                    height: 132px;
                    border-radius: Theme.radius-control;
                    border-width: 1px;
                    border-color: Theme.layer-stroke;
                    background: Theme.subtle-hover;

                    VerticalLayout {
                        padding: Theme.spacing-12;
                        spacing: Theme.spacing-4;

                        Text {
                            text: @tr("Type special keys as {{…}} (case-insensitive); double the braces for a literal brace.");
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                        }

                        Text {
                            text: @tr("{{Enter}} / {{Return}} · {{Tab}} · {{Esc}} · {{Space}} · {{Backspace}} · {{Delete}} · {{Up}} {{Down}} {{Left}} {{Right}} · {{Home}} {{End}} · {{Ctrl+C}} {{Ctrl+D}} {{Ctrl+Z}} · {{Alt+…}} {{Shift+…}} · {{ {{ }} }}");
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            font-family: Theme.font-mono;
                            wrap: word-wrap;
                        }

                        Text {
                            text: @tr("Example: yes{{Enter}} · echo {{{{a}}}}{{Enter}}");
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            font-family: Theme.font-mono;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Rectangle { height: 1px; background: Theme.layer-stroke; }

            HorizontalLayout {
                spacing: Theme.spacing-8;

                // Delete 仅编辑态出现（新建步骤没有可删对象）。
                if root.edit-mode : WinIconButton {
                    icon: "trash";
                    accessible-name: @tr("Delete");
                    tooltip-text: @tr("Delete");
                    clicked => { root.delete-step(); }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                WinButton { text: @tr("Cancel"); subtle: true; clicked => { root.dismiss(); } }
                WinButton {
                    text: @tr("Save");
                    accent: true;
                    enabled: root.keys-text != "";
                    clicked => { root.save(); }
                }
            }
        }
    }

    public function focus-dialog() {
        focus_scope.focus();
    }

    focus_scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.dismiss();
                return accept;
            }
            return reject;
        }
    }

    init => {
        root.focus-dialog();
    }
}
