// Confirm tool window — product ContentDialog layout on ToolWindowChrome.
//
// Hierarchy: chrome title → consequence message → optional typed confirm /
// don't-ask → footer divider → Cancel + Confirm (safe action leftmost of the
// pair; destructive uses critical styling; no Enter-to-confirm by default).

import { Theme } from "../theme.slint";
import { Icon } from "../components/basic/icons.slint";
import { WinButton, WinCheckBox } from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";

export component CompactConfirmWindow inherits Window {
    title: root.title-text;
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-compact;
    min-width: Theme.tool-window-width-compact;
    max-width: Theme.tool-window-width-compact;
    preferred-height: Theme.tool-window-height-compact;
    min-height: Theme.tool-window-height-compact;
    max-height: Theme.tool-window-height-compact;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    in property <string> title-text: @tr("Confirm");
    in property <string> message-text: "";
    in property <string> confirmation-token: "";
    in property <string> confirmation-placeholder: "";
    in-out property <string> confirmation-text: "";
    in property <string> confirm-label: @tr("Confirm");
    in property <string> cancel-label: @tr("Cancel");
    in property <bool> destructive: false;
    in property <bool> show-dont-ask-again: false;
    in-out property <bool> dont-ask-again: false;

    in-out property <bool> native_title_drag: false;

    callback confirmed();
    callback canceled();
    callback title_drag_requested();

    private property <bool> needs-token: root.confirmation-token != "";
    private property <bool> is-dangerous: root.destructive || root.needs-token;

    dialog_scope := FocusScope {
        width: Theme.tool-window-width-compact;
        height: Theme.tool-window-height-compact;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.canceled();
                return accept;
            }
            return reject;
        }

        ToolWindowChrome {
            width: Theme.tool-window-width-compact;
            height: Theme.tool-window-height-compact;
            title-text: root.title-text;
            native-title-drag: root.native_title_drag;
            close-requested => { root.canceled(); }
            title-drag-requested => { root.title_drag_requested(); }

            // --- Body: what will happen ------------------------------------
            HorizontalLayout {
                spacing: Theme.spacing-12;
                alignment: start;

                if root.is-dangerous : Rectangle {
                    width: Theme.icon-size-large;
                    height: Theme.icon-size-large;
                    background: transparent;

                    Icon {
                        name: "warning";
                        icon-color: Theme.critical;
                        icon-size: Theme.icon-size-large;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: root.message-text;
                    color: root.is-dangerous ? Theme.critical : Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: root.is-dangerous ? Theme.weight-semibold : 400;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: top;
                }
            }

            // --- Typed confirmation (host key REPLACE / secret reset style) -
            if root.needs-token : Text {
                text: root.confirmation-placeholder != ""
                    ? root.confirmation-placeholder
                    : @tr("Type {0} to confirm", root.confirmation-token);
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            confirm_input := WinTextInput {
                height: root.needs-token ? Theme.control-height : 0px;
                visible: root.needs-token;
                enabled: root.needs-token;
                text <=> root.confirmation-text;
                placeholder-text: root.confirmation-token;
            }

            // 原型 close-tab-confirm：页脚行内「Don't ask again」是勾选框（非开关）。
            if root.show-dont-ask-again : WinCheckBox {
                text: @tr("Don't ask again");
                accessible-name: @tr("Don't ask again");
                checked <=> root.dont-ask-again;
                horizontal-stretch: 0;
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.spacing-16;
                background: transparent;
            }

            // --- Footer ----------------------------------------------------
            Rectangle {
                height: 1px;
                vertical-stretch: 0;
                background: Theme.divider;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;
                vertical-stretch: 0;
                padding-top: Theme.spacing-4;

                cancel_button := WinButton {
                    text: root.cancel-label;
                    clicked => { root.canceled(); }
                }

                WinButton {
                    text: root.confirm-label;
                    accent: !root.is-dangerous;
                    critical: root.is-dangerous;
                    enabled: !root.needs-token || root.confirmation-text == root.confirmation-token;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }

    public function focus-dialog() {
        // E-064: never default-focus the destructive confirm; typed confirms
        // focus the input; plain confirms keep Esc on the scope (not Enter).
        if (root.needs-token) {
            confirm_input.focus-input();
        } else if (root.is-dangerous) {
            cancel_button.focus-button();
        } else {
            dialog_scope.focus();
        }
    }

    init => {
        root.focus-dialog();
    }
}
