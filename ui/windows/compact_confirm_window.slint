// Confirm tool window — product ContentDialog layout on ToolWindowChrome.
//
// Hierarchy: chrome title → consequence message → optional don't-ask →
// footer divider → Cancel + Confirm (safe action leftmost of the pair;
// destructive uses critical styling; no Enter-to-confirm by default).

import { Theme } from "../theme.slint";
import { TextFormats } from "../text_formats.slint";
import { Icon } from "../components/basic/icons.slint";
import { WinButton, WinCheckBox } from "../components/basic/controls.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";

export component CompactConfirmWindow inherits Window {
    title: root.display-title();
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-compact;
    min-width: Theme.tool-window-width-compact;
    max-width: Theme.tool-window-width-compact;
    preferred-height: Theme.tool-window-height-compact;
    min-height: Theme.tool-window-height-compact;
    max-height: Theme.tool-window-height-compact;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    in property <string> title-text: @tr("Confirm");
    in property <string> message-text: "";
    /// `editor-discard` / `close-tabs` 的标题、正文、确认按钮走 TextFormats；
    /// 其余 kind 继续用 Rust 传入的 title-text / message-text / confirm-label。
    in property <string> kind: "";
    in property <bool> close-tabs-single: false;
    in property <string> close-tabs-name: "";
    in property <int> close-tabs-count: 0;
    in property <int> close-tabs-active-count: 0;
    /// 关标签 / 退出确认的后果清单（项目符号行；空 = 只显示 message）。
    in property <[string]> details: [];
    /// 后果清单下的补充说明（端口转发等；空 = 不显示）。
    in property <string> note-text: "";
    in property <string> confirm-label: @tr("Confirm");
    in property <string> cancel-label: @tr("Cancel");
    in property <bool> destructive: false;
    in property <bool> show-dont-ask-again: false;
    in-out property <bool> dont-ask-again: false;

    in-out property <bool> native_title_drag: false;

    callback confirmed();
    callback canceled();
    callback title_drag_requested();

    pure function display-title() -> string {
        if root.kind == "editor-discard" {
            return TextFormats.editor-discard-confirm-title();
        }
        if root.kind == "close-tabs" {
            return TextFormats.close-tabs-confirm-title(root.close-tabs-single);
        }
        return root.title-text;
    }

    pure function display-message() -> string {
        if root.kind == "editor-discard" {
            return TextFormats.editor-discard-confirm-message();
        }
        if root.kind == "close-tabs" {
            return TextFormats.close-tabs-confirm-message(
                root.close-tabs-single,
                root.close-tabs-name,
                root.close-tabs-count,
                root.close-tabs-active-count,
            );
        }
        return root.message-text;
    }

    pure function display-confirm-label() -> string {
        if root.kind == "editor-discard" {
            return TextFormats.editor-discard-confirm-label();
        }
        if root.kind == "close-tabs" {
            return TextFormats.close-tabs-confirm-label();
        }
        return root.confirm-label;
    }

    private property <bool> is-dangerous: root.destructive;

    dialog_scope := FocusScope {
        width: Theme.tool-window-width-compact;
        height: Theme.tool-window-height-compact;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.canceled();
                return accept;
            }
            return reject;
        }

        ToolWindowChrome {
            width: Theme.tool-window-width-compact;
            height: Theme.tool-window-height-compact;
            title-text: root.display-title();
            native-title-drag: root.native_title_drag;
            close-requested => { root.canceled(); }
            title-drag-requested => { root.title_drag_requested(); }

            // --- Body: what will happen ------------------------------------
            HorizontalLayout {
                spacing: Theme.spacing-12;
                alignment: start;

                if root.is-dangerous : Rectangle {
                    width: Theme.icon-size-large;
                    height: Theme.icon-size-large;
                    background: transparent;

                    Icon {
                        name: "warning";
                        icon-color: Theme.critical;
                        icon-size: Theme.icon-size-large;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: root.display-message();
                    color: root.is-dangerous ? Theme.critical : Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: root.is-dangerous ? Theme.weight-semibold : 400;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: top;
                }
            }

            // --- Consequences list (close tab / quit) -----------------------
            if root.details.length > 0 : VerticalLayout {
                spacing: Theme.spacing-8;
                vertical-stretch: 0;

                for line in root.details : HorizontalLayout {
                    spacing: Theme.spacing-8;
                    alignment: start;
                    cross-axis-alignment: start;

                    Text {
                        text: "•";
                        color: root.is-dangerous ? Theme.critical : Theme.text-secondary;
                        font-size: Theme.font-body;
                        vertical-alignment: top;
                    }

                    Text {
                        text: line;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
            }

            if root.note-text != "" : Text {
                text: root.note-text;
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: Theme.spacing-16;
                background: transparent;
            }

            // --- Footer ----------------------------------------------------
            Rectangle {
                height: 1px;
                vertical-stretch: 0;
                background: Theme.divider;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;
                vertical-stretch: 0;
                padding-top: Theme.spacing-4;

                // 原型 close-tab-confirm：「Don't ask again」是勾选框（非开关），
                // 与 Cancel / 主操作同一行、位于最左。
                if root.show-dont-ask-again : WinCheckBox {
                    text: @tr("Don't ask again");
                    accessible-name: @tr("Don't ask again");
                    checked <=> root.dont-ask-again;
                    horizontal-stretch: 0;
                }

                Rectangle { horizontal-stretch: 1; }

                cancel_button := WinButton {
                    text: root.cancel-label;
                    clicked => { root.canceled(); }
                }

                WinButton {
                    text: root.display-confirm-label();
                    accent: !root.is-dangerous;
                    critical: root.is-dangerous;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }

    public function focus-dialog() {
        // Never default-focus the destructive confirm. Plain confirms keep
        // Esc on the scope (not Enter).
        if (root.is-dangerous) {
            cancel_button.focus-button();
        } else {
            dialog_scope.focus();
        }
    }

    init => {
        root.focus-dialog();
    }
}
