// New Folder as an independent non-resizable tool window.

import { Theme } from "../theme.slint";
import { NewFolderDialog } from "../components/session_sidebar.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";

export component NewFolderWindow inherits Window {
    title: @tr("New Folder");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-compact;
    min-width: Theme.tool-window-width-compact;
    max-width: Theme.tool-window-width-compact;
    preferred-height: Theme.tool-window-height-compact;
    min-height: Theme.tool-window-height-compact;
    max-height: Theme.tool-window-height-compact;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    in property <string> title-text;
    in property <string> message-text;
    in-out property <string> name-text;
    in property <string> placeholder-text;
    in property <string> confirm-label;
    in property <string> cancel-label;

    in-out property <bool> native_title_drag: false;

    callback confirmed(string);
    callback canceled();
    callback title_drag_requested();

    private property <length> body-width:
        Theme.tool-window-width-compact - 2 * Theme.tool-window-padding;
    private property <length> body-height:
        Theme.tool-window-height-compact - Theme.bar-height-menubar - 2 * Theme.tool-window-padding;

    ToolWindowChrome {
        width: Theme.tool-window-width-compact;
        height: Theme.tool-window-height-compact;
        title-text: root.title-text != "" ? root.title-text : @tr("New Folder");
        native-title-drag: root.native_title_drag;
        close-requested => { root.canceled(); }
        title-drag-requested => { root.title_drag_requested(); }

        dialog := NewFolderDialog {
            open: true;
            width: root.body-width;
            height: root.body-height;
            message-text: root.message-text;
            name-text <=> root.name-text;
            placeholder-text: root.placeholder-text;
            confirm-label: root.confirm-label;
            cancel-label: root.cancel-label;
            confirmed(string) => { root.confirmed(string); }
            canceled => { root.canceled(); }
        }
    }

    public function focus-dialog() {
        dialog.focus-dialog();
    }

    init => {
        root.focus-dialog();
    }
}
