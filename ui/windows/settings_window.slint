// Settings as an independent non-resizable tool window.

import { Theme } from "../theme.slint";
import { SettingsDialog } from "../pages/settings.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";

export component SettingsWindow inherits Window {
    title: @tr("Settings");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-wide;
    min-width: Theme.tool-window-width-wide;
    max-width: Theme.tool-window-width-wide;
    preferred-height: Theme.tool-window-height-tall;
    min-height: Theme.tool-window-height-tall;
    max-height: Theme.tool-window-height-tall;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    private property <length> body-width:
        Theme.tool-window-width-wide - 2 * Theme.tool-window-padding;
    private property <length> body-height:
        Theme.tool-window-height-tall - Theme.bar-height-menubar - 2 * Theme.tool-window-padding;

    in property <string> config-dir-text;
    in property <string> secret-store-status-text;
    in-out property <string> scrollback-lines-text;
    in-out property <string> scrollback-max-cells-text;
    in-out property <string> settings-sftp-max-parallel-transfers-text;
    in property <string> terminal-status-text;
    in property <string> language-text;
    in-out property <bool> debug-logging-enabled;
    in-out property <bool> confirm-close-session-enabled;
    in-out property <bool> confirm-quit-app-enabled;
    in-out property <bool> mcp-enabled;
    in-out property <bool> mcp-auto-approve-control-enabled;
    in property <string> mcp-status-text;
    in property <string> mcp-boundaries-text;
    in property <string> mcp-host-config-text;
    in property <string> debug-log-dir-text;
    // 默认分区必须在**窗口**侧也给默认值：`section <=> body.section` 是双向绑定，
    // 窗口侧未初始化的空串会覆盖 `SettingsDialog` 的 `"general"` 默认值，
    // 导致所有 `if root.section == ...` 分支都不命中、内容区整块空白。
    in-out property <string> section: "general";
    in property <string> appearance-color-scheme-name-text;
    in property <bool> appearance-color-scheme-builtin;
    in property <[color]> appearance-palette-swatches;
    in property <[string]> appearance-font-options;
    in-out property <int> appearance-font-index;
    in-out property <string> appearance-font-size-text;
    in-out property <string> appearance-fallback-fonts-text;
    in property <string> appearance-status-text;
    in property <image> appearance-preview;
    in property <color> appearance-preview-background;

    // --- settings-security ---
    in property <int> settings-appearance-mode-index: 0;
    in property <int> settings-appearance-accent-index: 1;
    in property <[color]> settings-appearance-accent-light-swatches: [];
    in property <[color]> settings-appearance-accent-dark-swatches: [];
    in property <[string]> settings-appearance-style-options: [];
    in property <int> settings-appearance-style-index: 0;
    in-out property <int> settings-terminal-middle-click-index: 0;
    in-out property <int> settings-terminal-right-click-index: 0;
    in-out property <int> settings-terminal-multi-line-paste-index: 0;
    in-out property <bool> settings-terminal-auto-copy: false;
    in property <string> settings-terminal-status-kind-text: "";
    in property <string> settings-terminal-status-field-text: "";
    in property <string> settings-terminal-status-value-text: "";
    in property <string> settings-terminal-status-limit-text: "";
    in-out property <bool> settings-sftp-show-hidden: true;
    in-out property <int> settings-sftp-conflict-index: 0;
    in property <[string]> settings-sftp-editor-options: [];
    in-out property <int> settings-sftp-editor-index: 0;
    in property <bool> settings-sftp-editor-custom-visible: false;
    in-out property <string> settings-sftp-editor-path-text: "";
    in property <string> settings-sftp-status-kind-text: "";
    in property <bool> settings-master-password-set: false;
    in property <bool> settings-master-password-locked: false;
    in property <int> settings-security-known-hosts-count: 0;
    in property <int> settings-security-private-keys-count: 0;
    in property <int> settings-security-proxies-count: 0;
    // --- settings-security end

    in-out property <bool> native_title_drag: false;

    callback dismiss();
    callback open-host-keys();
    callback open-private-keys();
    callback open-proxies();
    callback open-theme-manager();
    callback update-scrollback-lines(string);
    callback update-scrollback-max-cells(string);
    callback update-settings-sftp-max-parallel-transfers(string);
    callback save-settings-sftp();
    callback reset-terminal-defaults();
    callback save-terminal-settings();
    callback set-language(string);
    callback set-debug-logging(bool);
    callback set-confirm-close-session(bool);
    callback set-confirm-quit-app(bool);
    callback set-mcp-enabled(bool);
    callback set-mcp-auto-approve-control(bool);
    callback open-debug-log-dir();
    callback select-appearance-font(int);
    callback update-appearance-font-size(string);
    callback bump-appearance-font-size(int);
    callback update-appearance-fallback-fonts(string);
    callback browse-appearance-font-file();
    callback browse-appearance-fallback-font();
    callback clear-appearance-fallbacks();
    callback reset-appearance-defaults();
    callback save-appearance();
    // --- settings-security ---
    callback update-settings-appearance-mode(int);
    callback update-settings-appearance-accent(int);
    callback select-settings-appearance-style(int);
    callback update-settings-terminal-middle-click(int);
    callback update-settings-terminal-right-click(int);
    callback update-settings-terminal-multi-line-paste(int);
    callback update-settings-terminal-auto-copy(bool);
    callback update-settings-sftp-show-hidden(bool);
    callback update-settings-sftp-conflict-action(int);
    callback update-settings-sftp-external-editor(int);
    callback update-settings-sftp-external-editor-path(string);
    callback browse-settings-sftp-external-editor();
    callback open-master-password-dialog(string);
    callback open-config-dir();
    callback save-settings();
    // --- settings-security end
    callback title_drag_requested();

    chrome := ToolWindowChrome {
        width: Theme.tool-window-width-wide;
        height: Theme.tool-window-height-tall;
        title-text: @tr("Settings");
        native-title-drag: root.native_title_drag;
        close-requested => { root.dismiss(); }
        title-drag-requested => { root.title_drag_requested(); }

        body := SettingsDialog {
            open: true;
            width: root.body-width;
            height: root.body-height;
            config-dir-text: root.config-dir-text;
            secret-store-status-text: root.secret-store-status-text;
            scrollback-lines-text <=> root.scrollback-lines-text;
            scrollback-max-cells-text <=> root.scrollback-max-cells-text;
            settings-sftp-max-parallel-transfers-text <=> root.settings-sftp-max-parallel-transfers-text;
            terminal-status-text: root.terminal-status-text;
            language-text: root.language-text;
            debug-logging-enabled <=> root.debug-logging-enabled;
            confirm-close-session-enabled <=> root.confirm-close-session-enabled;
            confirm-quit-app-enabled <=> root.confirm-quit-app-enabled;
            mcp-enabled <=> root.mcp-enabled;
            mcp-auto-approve-control-enabled <=> root.mcp-auto-approve-control-enabled;
            mcp-status-text: root.mcp-status-text;
            mcp-boundaries-text: root.mcp-boundaries-text;
            mcp-host-config-text: root.mcp-host-config-text;
            debug-log-dir-text: root.debug-log-dir-text;
            section <=> root.section;
            appearance-color-scheme-name-text: root.appearance-color-scheme-name-text;
            appearance-color-scheme-builtin: root.appearance-color-scheme-builtin;
            appearance-palette-swatches: root.appearance-palette-swatches;
            appearance-font-options: root.appearance-font-options;
            appearance-font-index <=> root.appearance-font-index;
            appearance-font-size-text <=> root.appearance-font-size-text;
            appearance-fallback-fonts-text <=> root.appearance-fallback-fonts-text;
            appearance-status-text: root.appearance-status-text;
            appearance-preview: root.appearance-preview;
            appearance-preview-background: root.appearance-preview-background;
            // --- settings-security ---
            settings-appearance-mode-index: root.settings-appearance-mode-index;
            settings-appearance-accent-index: root.settings-appearance-accent-index;
            settings-appearance-accent-light-swatches: root.settings-appearance-accent-light-swatches;
            settings-appearance-accent-dark-swatches: root.settings-appearance-accent-dark-swatches;
            settings-appearance-style-options: root.settings-appearance-style-options;
            settings-appearance-style-index: root.settings-appearance-style-index;
            settings-terminal-middle-click-index <=> root.settings-terminal-middle-click-index;
            settings-terminal-right-click-index <=> root.settings-terminal-right-click-index;
            settings-terminal-multi-line-paste-index <=> root.settings-terminal-multi-line-paste-index;
            settings-terminal-auto-copy <=> root.settings-terminal-auto-copy;
            settings-terminal-status-kind-text: root.settings-terminal-status-kind-text;
            settings-terminal-status-field-text: root.settings-terminal-status-field-text;
            settings-terminal-status-value-text: root.settings-terminal-status-value-text;
            settings-terminal-status-limit-text: root.settings-terminal-status-limit-text;
            settings-sftp-show-hidden <=> root.settings-sftp-show-hidden;
            settings-sftp-conflict-index <=> root.settings-sftp-conflict-index;
            settings-sftp-editor-options: root.settings-sftp-editor-options;
            settings-sftp-editor-index <=> root.settings-sftp-editor-index;
            settings-sftp-editor-custom-visible: root.settings-sftp-editor-custom-visible;
            settings-sftp-editor-path-text <=> root.settings-sftp-editor-path-text;
            settings-sftp-status-kind-text: root.settings-sftp-status-kind-text;
            settings-master-password-set: root.settings-master-password-set;
            settings-master-password-locked: root.settings-master-password-locked;
            settings-security-known-hosts-count: root.settings-security-known-hosts-count;
            settings-security-private-keys-count: root.settings-security-private-keys-count;
            settings-security-proxies-count: root.settings-security-proxies-count;
            // --- settings-security end
            close => { root.dismiss(); }
            open-host-keys => { root.open-host-keys(); }
            open-private-keys => { root.open-private-keys(); }
            open-proxies => { root.open-proxies(); }
            open-theme-manager => { root.open-theme-manager(); }
            update-scrollback-lines(string) => { root.update-scrollback-lines(string); }
            update-scrollback-max-cells(string) => { root.update-scrollback-max-cells(string); }
            update-settings-sftp-max-parallel-transfers(string) => { root.update-settings-sftp-max-parallel-transfers(string); }
            save-settings-sftp => { root.save-settings-sftp(); }
            reset-terminal-defaults => { root.reset-terminal-defaults(); }
            save-terminal-settings => { root.save-terminal-settings(); }
            set-language(string) => { root.set-language(string); }
            set-debug-logging(bool) => { root.set-debug-logging(bool); }
            set-confirm-close-session(bool) => { root.set-confirm-close-session(bool); }
            set-confirm-quit-app(bool) => { root.set-confirm-quit-app(bool); }
            set-mcp-enabled(bool) => { root.set-mcp-enabled(bool); }
            set-mcp-auto-approve-control(bool) => { root.set-mcp-auto-approve-control(bool); }
            open-debug-log-dir => { root.open-debug-log-dir(); }
            select-appearance-font(int) => { root.select-appearance-font(int); }
            update-appearance-font-size(string) => { root.update-appearance-font-size(string); }
            bump-appearance-font-size(int) => { root.bump-appearance-font-size(int); }
            update-appearance-fallback-fonts(string) => { root.update-appearance-fallback-fonts(string); }
            browse-appearance-font-file => { root.browse-appearance-font-file(); }
            browse-appearance-fallback-font => { root.browse-appearance-fallback-font(); }
            clear-appearance-fallbacks => { root.clear-appearance-fallbacks(); }
            reset-appearance-defaults => { root.reset-appearance-defaults(); }
            save-appearance => { root.save-appearance(); }
            // --- settings-security ---
            update-settings-appearance-mode(int) => { root.update-settings-appearance-mode(int); }
            update-settings-appearance-accent(int) => { root.update-settings-appearance-accent(int); }
            select-settings-appearance-style(int) => { root.select-settings-appearance-style(int); }
            update-settings-terminal-middle-click(int) => { root.update-settings-terminal-middle-click(int); }
            update-settings-terminal-right-click(int) => { root.update-settings-terminal-right-click(int); }
            update-settings-terminal-multi-line-paste(int) => { root.update-settings-terminal-multi-line-paste(int); }
            update-settings-terminal-auto-copy(bool) => { root.update-settings-terminal-auto-copy(bool); }
            update-settings-sftp-show-hidden(bool) => { root.update-settings-sftp-show-hidden(bool); }
            update-settings-sftp-conflict-action(int) => { root.update-settings-sftp-conflict-action(int); }
            update-settings-sftp-external-editor(int) => { root.update-settings-sftp-external-editor(int); }
            update-settings-sftp-external-editor-path(string) => { root.update-settings-sftp-external-editor-path(string); }
            browse-settings-sftp-external-editor => { root.browse-settings-sftp-external-editor(); }
            open-master-password-dialog(string) => { root.open-master-password-dialog(string); }
            open-config-dir => { root.open-config-dir(); }
            save-settings => { root.save-settings(); }
            // --- settings-security end
        }
    }

    public function focus-dialog() {
        body.focus-dialog();
    }

    init => {
        root.focus-dialog();
    }
}

