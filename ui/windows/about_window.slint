// About as an independent tool window (title bar + content, no scrim).
//
// 原型：`docs/prototypes/about/index.html`（standard 720×580）。
// 结构：产品名 + 一句说明 → Config directory / License 只读详情 → 可折叠的
// open source licenses（默认折叠，展开为固定高度滚动区，窗口尺寸不变）→ Close。
// 只读行使用共享 `DetailRow`，不再在本窗自绘 label/val 网格。

import { Theme } from "../theme.slint";
import { WinButton } from "../components/basic/controls.slint";
import { DetailRow } from "../components/basic/forms.slint";
import { ToolWindowChrome } from "../components/tool_window_chrome.slint";

export component AboutWindow inherits Window {
    title: @tr("About YShell");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: Theme.tool-window-width-standard;
    min-width: Theme.tool-window-width-standard;
    max-width: Theme.tool-window-width-standard;
    preferred-height: Theme.tool-window-height-standard;
    min-height: Theme.tool-window-height-standard;
    max-height: Theme.tool-window-height-standard;
    background: Theme.window-background;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    in property <string> version-text: "";
    in property <string> config-dir-text: "";
    /// 开源许可预览正文（产品侧截断后写入；全文过大，不可直接塞进 Text）。
    in property <string> licenses-text: "";
    /// 预览是否被截断；展开区底部提供「打开全文」。
    in property <bool> licenses-truncated: false;
    /// 预览行数（Rust 计数）；Flickable 用它估高，禁止 preferred-height 量正文。
    in property <int> licenses-preview-lines: 0;
    in-out property <bool> native_title_drag: false;

    /// open source licenses 面板是否展开（默认折叠；展开后窗口尺寸不变）。
    private property <bool> licenses-open: false;

    callback dismiss();
    callback title_drag_requested();
    /// 将完整许可证清单写到临时文件并用系统默认程序打开。
    callback open_full_licenses();

    dialog_scope := FocusScope {
        width: Theme.tool-window-width-standard;
        height: Theme.tool-window-height-standard;

        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.dismiss();
                return accept;
            }
            return reject;
        }

        ToolWindowChrome {
            width: Theme.tool-window-width-standard;
            height: Theme.tool-window-height-standard;
            title-text: @tr("About YShell");
            native-title-drag: root.native_title_drag;
            close-requested => { root.dismiss(); }
            title-drag-requested => { root.title_drag_requested(); }

            VerticalLayout {
                vertical-stretch: 1;
                spacing: Theme.spacing-16;

                // --- A · copy：产品名 + 一句说明 ---------------------------
                VerticalLayout {
                    spacing: Theme.spacing-4;

                    Text {
                        text: @tr("YShell {0}", root.version-text);
                        color: Theme.text-primary;
                        font-size: Theme.font-subtitle;
                        font-weight: Theme.weight-semibold;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    Text {
                        text: @tr("A Slint desktop shell for SSH, SFTP, tunnels and terminal workflows.");
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                }

                // --- B · grid：只读详情（共享 DetailRow） -------------------
                VerticalLayout {
                    spacing: 0px;

                    DetailRow {
                        label: @tr("Config directory");
                        value: root.config-dir-text;
                        mono: true;
                    }

                    DetailRow {
                        label: @tr("License");
                        value: "GPL-3.0-only";
                        last: true;
                    }
                }

                // --- C · open source licenses（默认折叠，展开为滚动区） -----
                VerticalLayout {
                    vertical-stretch: root.licenses-open ? 1 : 0;
                    spacing: Theme.spacing-8;

                    WinButton {
                        text: @tr("Open source licenses");
                        icon: root.licenses-open ? "chevron-down" : "chevron-right";
                        tooltip-text: @tr("Open source licenses");
                        clicked => { root.licenses-open = !root.licenses-open; }
                    }

                    if root.licenses-open : VerticalLayout {
                        vertical-stretch: 1;
                        spacing: Theme.spacing-8;
                        min-height: 0px;

                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 120px;
                            max-height: 220px;
                            background: Theme.control-fill;
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: Theme.control-stroke;
                            clip: true;

                            // 行高由 Rust 预计算；禁止对正文做 preferred-height（即便截断
                            // 后上千行，ComplexText 量高仍会卡死 UI 线程）。
                            Flickable {
                                width: parent.width;
                                height: parent.height;
                                interactive: true;
                                content-width: self.width;
                                content-height: Math.max(
                                    self.height,
                                    root.licenses-preview-lines * Theme.line-caption + 2 * Theme.spacing-8
                                );

                                Text {
                                    x: Theme.spacing-12;
                                    y: Theme.spacing-8;
                                    width: parent.width - 2 * Theme.spacing-12;
                                    height: Math.max(
                                        parent.height - 2 * Theme.spacing-8,
                                        root.licenses-preview-lines * Theme.line-caption
                                    );
                                    text: root.licenses-text == ""
                                        ? @tr("Open source licenses are not bundled in this build.")
                                        : root.licenses-truncated
                                            ? root.licenses-text + "\n\n" + @tr("Preview truncated. Open the full text to review every license.")
                                            : root.licenses-text;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-family: Theme.font-mono;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }

                        WinButton {
                            text: root.licenses-truncated
                                ? @tr("Open full text…")
                                : @tr("Open licenses file…");
                            tooltip-text: @tr("Open the complete open-source license list");
                            clicked => { root.open_full_licenses(); }
                        }
                    }
                }

                // 折叠时由 spacer 吸收剩余高度；展开时滚动区吸收。
                Rectangle {
                    visible: !root.licenses-open;
                    vertical-stretch: 1;
                    min-height: 0px;
                    background: transparent;
                }

                Rectangle {
                    height: 1px;
                    vertical-stretch: 0;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    alignment: end;
                    vertical-stretch: 0;

                    WinButton {
                        text: @tr("Close");
                        tooltip-text: @tr("Close");
                        clicked => { root.dismiss(); }
                    }
                }
            }
        }
    }

    init => {
        dialog_scope.focus();
    }
}
