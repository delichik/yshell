    // `TextFormats.status-message` 模板；Rust 只投影值，句子在 Slint 侧渲染。
    in-out property <string> quick_connect_summary_kind_text: "";
    in-out property <string> quick_connect_summary_param_1_text: "";
    in-out property <string> quick_connect_summary_param_2_text: "";
    /// 最近一次连接成功的目标（非空时显示"保存为会话…"）。
