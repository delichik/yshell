import { Button, LineEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "YShell";
    preferred-width: 1280px;
    preferred-height: 800px;

    in-out property <string> status_text: "Ready";
    in-out property <string> config_dir: "";
    in-out property <string> active_session: "Welcome";
    in-out property <string> session_summary_text: "No runtime sessions yet.";
    in-out property <string> tab_text: "Welcome  idle";
    in-out property <string> terminal_title_text: "YShell terminal";
    in-out property <string> terminal_body_text: "Runtime is ready. Open a Quick Connect target or create a draft session.";
    in-out property <string> transport_backend_text: "fake";
    in-out property <bool> sftp_visible: true;
    in-out property <bool> tunnels_visible: true;
    in-out property <bool> commands_visible: true;

    callback quick_connect(string);
    callback new_session();
    callback save_session();
    callback open_saved_session();
    callback send_demo_input();
    callback disconnect_session();
    callback reconnect_session();
    callback select_fake_backend();
    callback select_real_backend();
    callback toggle_sftp();
    callback toggle_tunnels();
    callback toggle_commands();

    background: #0f1117;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 32px;
            background: #20242d;
            HorizontalLayout {
                padding-left: 12px;
                spacing: 18px;
                Text { text: "File"; color: #f4f7fb; vertical-alignment: center; }
                Text { text: "Edit"; color: #f4f7fb; vertical-alignment: center; }
                Text { text: "View"; color: #f4f7fb; vertical-alignment: center; }
                Text { text: "Session"; color: #f4f7fb; vertical-alignment: center; }
                Text { text: "Help"; color: #f4f7fb; vertical-alignment: center; }
            }
        }

        Rectangle {
            height: 52px;
            background: #2c3340;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;

                quick_input := LineEdit {
                    placeholder-text: "ssh://user@host:22";
                    text: "";
                    accepted => { root.quick_connect(self.text); }
                }
                Button { text: "Connect"; clicked => { root.quick_connect(quick_input.text); } }
                Button { text: "New"; clicked => { root.new_session(); } }
                Button { text: "Save"; clicked => { root.save_session(); } }
                Button { text: "Open Saved"; clicked => { root.open_saved_session(); } }
                Button { text: "Send pwd"; clicked => { root.send_demo_input(); } }
                Button { text: "Disconnect"; clicked => { root.disconnect_session(); } }
                Button { text: "Reconnect"; clicked => { root.reconnect_session(); } }
                Button { text: "Use Fake"; clicked => { root.select_fake_backend(); } }
                Button { text: "Use Real"; clicked => { root.select_real_backend(); } }
                Button { text: "Split"; enabled: false; }
                Button { text: root.sftp_visible ? "Hide SFTP" : "SFTP"; clicked => { root.toggle_sftp(); } }
                Button { text: root.tunnels_visible ? "Hide Tunnels" : "Tunnels"; clicked => { root.toggle_tunnels(); } }
                Button { text: root.commands_visible ? "Hide Commands" : "Commands"; clicked => { root.toggle_commands(); } }
                Button { text: "Log"; enabled: false; }
                Button { text: "Search"; enabled: false; }
            }
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 280px;
                background: #252b36;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "Session Manager"; color: #f4f7fb; font-weight: 700; vertical-alignment: center; }
                        Button { text: "+"; clicked => { root.new_session(); } }
                    }
                    LineEdit { placeholder-text: "Search sessions"; }
                    Text { text: "Favorites"; color: #a8b3c7; }
                    Rectangle {
                        height: 30px;
                        background: #313948;
                        border-radius: 4px;
                        Text { text: root.active_session; color: #f4f7fb; x: 8px; y: 6px; }
                    }
                    Text { text: "Recent"; color: #a8b3c7; }
                    Text { text: "Backend: " + root.transport_backend_text; color: #7dd3fc; }
                    Text { text: root.session_summary_text; color: #cdd6e3; wrap: word-wrap; }
                    Text { text: root.config_dir; color: #69758b; wrap: word-wrap; }
                }
            }

            VerticalLayout {
                Rectangle {
                    height: 36px;
                    background: #1b1f27;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 6px;
                        Button { text: root.tab_text; }
                        Button { text: "+"; clicked => { root.new_session(); } }
                    }
                }
                Rectangle {
                    background: #0f1117;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: root.terminal_title_text; color: #d7e0ef; font-size: 20px; }
                        Text { text: root.terminal_body_text; color: #a8b3c7; wrap: word-wrap; }
                        Text { text: root.status_text; color: #7dd3fc; wrap: word-wrap; }
                    }
                }
            }

            Rectangle {
                width: 340px;
                background: #20242d;
                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;
                    Rectangle {
                        height: root.sftp_visible ? 150px : 0px;
                        background: #252b36;
                        Text { text: "SFTP\nConnect a session to browse remote files."; color: #f4f7fb; x: 10px; y: 10px; }
                    }
                    Rectangle {
                        height: root.tunnels_visible ? 130px : 0px;
                        background: #252b36;
                        Text { text: "Tunnels\nNo active tunnels"; color: #f4f7fb; x: 10px; y: 10px; }
                    }
                    Rectangle {
                        height: root.commands_visible ? 130px : 0px;
                        background: #252b36;
                        Text { text: "Quick Commands\nCommand presets will appear here."; color: #f4f7fb; x: 10px; y: 10px; }
                    }
                }
            }
        }

        Rectangle {
            height: 28px;
            background: #20242d;
            Text { text: root.status_text; color: #cdd6e3; x: 10px; vertical-alignment: center; }
        }
    }
}
