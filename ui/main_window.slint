// 菜单栏项（WinUI 3 MenuBar 形态）：24px 行高、4px 圆角、展开态高亮
component MenuTitle inherits Rectangle {
    in property <string> label: @tr("MenuBar" => "File");
    in property <bool> open: false;
    /// 是否已有任一菜单展开（`root.open_menu_index >= 0`）：展开态下悬停到另一个
    /// 一级菜单要直接切换（标准 MenuBar 行为），未展开时悬停不动作。
    in property <bool> menu-open: false;
    callback activated();
    /// 菜单已展开且指针悬停到本项：由 main_window 切换到本项对应的菜单。
    callback hovered();

    height: Theme.control-height-compact;
    width: title-text.preferred-width + 20px;
    border-radius: Theme.radius-control;
    background: root.open ? Theme.subtle-selected : title-touch.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    title-text := Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-body;
        x: 10px;
        height: parent.height;
        vertical-alignment: center;
    }

    title-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
        // 悬停切换：仅在已有菜单展开时生效；PointerEventKind.move 覆盖指针移入本项的过渡。
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move && root.menu-open) {
                root.hovered();
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "YShell";
    // §4.2 / §12：默认 1440×900，最小 880×600
    // （<1120 自动折叠右栏，<960 左导航变 48px 图标条，因此 880×600 是安全下限）
    //
    // 注意：Slint 会把根内容的 layout info.max 作为窗口的 max_inner_size（见
    // i-slint-core `min_max_size_for_layout_constraints`）。若根内容里存在
    // "只有固定宽度子项"的横向布局（例如菜单栏的 5 个固定宽 MenuTitle），
    // 推导出的 max 会是这些宽度之和（有限值），窗口的 max 就会被钉死在这个
    // 值上（表现为拖大窗口被弹回）。因此菜单栏末尾放了一个弹性空白
    // （menu_bar_spacer），保证根内容的 max 无界，窗口可自由拉伸。
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 880px;
    min-height: 600px;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    in-out property <string> status_text: "Ready";
    in-out property <string> config_dir: "";
    in-out property <string> secret_store_status_text: "Secret store disabled.";
    in-out property <string> secret_reset_confirmation_text: "";
    in-out property <string> editor_folder_text: "Saved Sessions (saved-sessions)";
    in-out property <string> new_folder_name_text: "";
    in-out property <string> editor_name_text: "";
    in-out property <string> editor_host_text: "";
    in-out property <string> editor_port_text: "22";
    in-out property <string> editor_username_text: "";
    in-out property <string> editor_auth_method_text: "agent";
    in-out property <string> editor_host_key_policy_text: "strict";
    in-out property <string> editor_password_text: "";
    in-out property <string> editor_key_path_text: "";
    in-out property <string> editor_passphrase_text: "";
    in-out property <string> editor_target_text: "Creating new saved session";
    in-out property <bool> editor_modal_visible: false;
    in-out property <string> editor_section_text: "general";
    in-out property <string> editor_auth_test_status_text: "Run Auth Test to validate the current editor fields without saving.";
    in-out property <bool> known_hosts_modal_visible: false;
    in-out property <string> known_hosts_inventory_text: "No persisted known hosts yet.";
    in-out property <string> known_hosts_selection_text: "No persisted known hosts are available.";
    in-out property <string> known_hosts_details_text: "";
    in-out property <string> known_hosts_path_text: "";
    in-out property <string> known_hosts_clear_confirmation_text: "";
    in-out property <string> editor_proxy_mode_text: "none";
    in-out property <string> editor_proxy_protocol_text: "socks5";
    in-out property <string> editor_proxy_host_text: "";
    in-out property <string> editor_proxy_port_text: "";
    in-out property <string> editor_proxy_username_text: "";
    in-out property <string> editor_proxy_password_text: "";
    in-out property <bool> editor_proxy_dns_by_proxy: true;
    in-out property <string> editor_proxy_summary_text: "Proxy disabled for this editor session.";
    in-out property <string> editor_tunnel_kind_text: "local";
    in-out property <string> editor_tunnel_bind_host_text: "127.0.0.1";
    in-out property <string> editor_tunnel_bind_port_text: "";
    in-out property <string> editor_tunnel_target_host_text: "";
    in-out property <string> editor_tunnel_target_port_text: "";
    in-out property <string> editor_tunnel_summary_text: "No tunnel forwards configured.";
    in-out property <string> logging_enabled_text: "disabled";
    in-out property <string> logging_format_text: "sanitized";
    in-out property <string> logging_directory_text: "";
    in-out property <string> logging_summary_text: "global=disabled format=sanitized directory=logs";
    in-out property <string> settings_scrollback_lines_text: "10000";
    in-out property <string> settings_scrollback_max_cells_text: "2000000";
    in-out property <string> settings_terminal_status_text: "Save terminal settings to apply the scrollback limits to existing sessions.";
    in-out property <string> active_session: "Welcome";
    in-out property <string> session_summary_text: "No runtime sessions yet.";
    in-out property <string> session_search_text: "";
    in-out property <string> saved_session_selection_text: "No saved session selected";
    in-out property <string> saved_session_inventory_text: "No saved sessions yet.";
    in-out property <string> recent_sessions_text: "No recent runtime sessions yet.";
    in-out property <bool> host_key_prompt_visible: false;
    in-out property <string> host_key_prompt_text: "";
    in-out property <string> host_key_prompt_mode_text: "";
    in-out property <string> host_key_prompt_confirmation_text: "";
    in-out property <string> tab_text: "Welcome  idle";
    in-out property <string> terminal_title_text: "YShell terminal";
    in-out property <string> terminal_body_text: "Runtime is ready. Open a Quick Connect target or create a draft session.";
    in-out property <[string]> terminal_visible_lines: ["Runtime is ready. Open a Quick Connect target or create a draft session."];
    in-out property <image> terminal_image;
    in-out property <int> terminal_cursor_column: 0;
    in-out property <int> terminal_cursor_row: 0;
    in-out property <int> terminal_scroll_offset: 0;
    in-out property <bool> terminal_selection_active: false;
    // W5-A3：终端 Edit 菜单（Copy/清屏等）的状态开关；与上者同源。
    in-out property <bool> terminal_has_selection: false;
    in-out property <string> terminal_search_query_text: "";
    in-out property <string> terminal_search_summary_text: "Find in terminal";
    in-out property <string> sftp_path_text: "/";
    in-out property <string> sftp_listing_text: "Fake backend selected. Switch to native SSH to validate the embedded SSH and SFTP paths.";
    in-out property <string> sftp_local_path_text: "";
    in-out property <string> sftp_remote_target_text: "";
    in-out property <string> sftp_secondary_target_text: "";
    in-out property <string> sftp_permissions_text: "644";
    in-out property <string> sftp_session_status_text: "SFTP session disconnected. Connect a runtime session first.";
    in-out property <string> sftp_remote_edit_text: "No active remote edit session";
    in-out property <[SftpRow]> sftp_rows;
    in-out property <[SftpCrumb]> sftp_crumbs;
    in-out property <int> sftp_selected_index: -1;
    in-out property <string> sftp_sort_text: "Name ↑";
    in-out property <string> sftp_sort_column_text: "name";
    in-out property <bool> sftp_sort_ascending: true;
    in-out property <bool> sftp_show_hidden: false;
    in-out property <string> sftp_item_summary_text: "";
    // W4 收尾：SFTP 汇总行只投影计数，句子/复数由 SftpPanel 用 @tr 组装。
    in-out property <int> sftp_item_count: 0;
    in-out property <int> sftp_dir_count: 0;
    in-out property <string> sftp_empty_text: "";
    in-out property <string> sftp_selected_name_text: "";
    in-out property <string> sftp_selected_path_text: "";
    in-out property <string> sftp_selected_permissions_text: "";
    in-out property <bool> sftp_remote_edit_active: false;
    // W5-A3：SFTP 生命周期就绪（ready）时才允许 SFTP 操作菜单项。
    in-out property <bool> sftp_available: false;
    in-out property <string> transfer_queue_text: "No active transfers";
    in-out property <string> tunnels_summary_text: "Tunnels\nNo active tunnels";
    in-out property <string> transport_backend_text: "fake";
    out property <float> terminal_viewport_width_px: terminal_view.terminal-viewport-width-px;
    out property <float> terminal_viewport_height_px: terminal_view.terminal-viewport-height-px;
    /// W5-A2：终端是否持有键盘焦点（模态弹窗关闭后的焦点恢复据此避让终端）。
    out property <bool> terminal_focused: terminal_view.terminal-focused;
    in-out property <bool> sftp_visible: true;
    in-out property <bool> tunnels_visible: true;
    in-out property <bool> commands_visible: true;
    in-out property <string> app_version_text: "";

    // --- W5：连接密码弹窗（仅本次连接使用；不写密钥库/磁盘）------------------
    // 认证方式为 password / keyboard-interactive 的已保存会话在密钥库里找不到密码时，
    // Rust 挂起连接并置 `password_prompt_visible`；输入后 `submit_password` 用该密码
    // 重试一次。`password_prompt_host_text` 是文案里的 `user@host:port`。
    in-out property <bool> password_prompt_visible: false;
    in-out property <string> password_prompt_title_text: @tr("Password required");
    in-out property <string> password_prompt_host_text: "";
    in-out property <string> password_prompt_message_text:
        root.password_prompt_host_text == ""
            ? @tr("Enter the password to continue.")
            : @tr("Enter the password for {0} to connect.", root.password_prompt_host_text);
    // in-out：弹窗内编辑；宿主（Rust）在弹窗关闭后清空，避免残留上一次的密码。
    in-out property <string> password_prompt_value_text: "";

    // --- W4 i18n：Rust 只投影值；句子模板在下方 display 属性/函数里用 @tr 渲染 ----
    // 旧的 *_text 句子属性保留声明（Rust 绑定兼容），但界面不再读取它们。
    in-out property <string> secret_store_kind_text: "disabled";
    in-out property <string> secret_store_path_text: "";
    in-out property <string> editor_folder_label_text: "";
    in-out property <string> editor_folder_id_text: "";
    in-out property <bool> editor_folder_known: false;
    in-out property <string> editor_target_session_id_text: "";
    in-out property <bool> editor_target_editing: false;
    in-out property <string> editor_auth_test_kind_text: "hint";
    in-out property <string> editor_auth_test_host_text: "";
    in-out property <string> editor_auth_test_backend_text: "";
    in-out property <string> editor_auth_test_startup_text: "";
    in-out property <string> editor_auth_test_error_text: "";
    in-out property <string> editor_proxy_summary_kind_text: "none";
    in-out property <string> editor_proxy_summary_address_text: "";
    in-out property <string> editor_proxy_summary_user_text: "";
    in-out property <string> editor_tunnel_summary_kind_text: "none";
    in-out property <string> editor_tunnel_summary_rows_text: "";
    in-out property <int> editor_tunnel_summary_count: 0;
    in-out property <string> logging_directory_display_text: "logs";
    in-out property <string> settings_terminal_status_kind_text: "hint";
    in-out property <string> settings_terminal_status_field_text: "";
    in-out property <string> settings_terminal_status_value_text: "";
    in-out property <string> settings_terminal_status_limit_text: "";
    in-out property <string> known_hosts_inventory_rows_text: "";
    in-out property <bool> known_hosts_inventory_empty: true;
    in-out property <string> known_hosts_selection_kind_text: "empty";
    in-out property <string> known_hosts_selection_host_text: "";
    in-out property <string> known_hosts_selection_port_text: "";
    in-out property <int> known_hosts_selection_index: 0;
    in-out property <int> known_hosts_selection_total: 0;
    in-out property <string> active_session_kind_text: "welcome";
    in-out property <string> active_session_name_text: "";
    in-out property <string> active_session_state_text: "";
    // --- W5-A3：菜单/按钮状态感知（纯布尔量，由 runtime.rs 投影；见 `AppProjection`）---
    in-out property <bool> has_active_session: false;
    in-out property <bool> active_session_connected: false;
    in-out property <bool> has_saved_selection: false;
    in-out property <int> saved_session_count: 0;
    in-out property <string> session_summary_rows_text: "";
    in-out property <int> session_summary_count: 0;
    in-out property <int> session_summary_hidden_count: 0;
    in-out property <string> saved_session_selection_kind_text: "none";
    in-out property <string> saved_session_selection_name_text: "";
    in-out property <string> saved_session_selection_host_text: "";
    in-out property <string> saved_session_selection_id_text: "";
    in-out property <string> saved_session_inventory_rows_text: "";
    in-out property <string> saved_session_inventory_query_text: "";
    in-out property <bool> saved_session_inventory_empty: true;
    // 会话树：Rust 侧按显示顺序压平的行模型 + 当前选中节点 id（旧文本投影保留但不再渲染）
    in-out property <[SessionTreeRow]> session_tree_rows: [];
    in-out property <string> saved_session_tree_selected_id: "";
    in-out property <string> recent_sessions_rows_text: "";
    in-out property <bool> recent_sessions_empty: true;
    in-out property <string> tab_name_text: "";
    in-out property <string> tab_state_text: "idle";
    in-out property <bool> tab_has_session: false;
    in-out property <string> terminal_title_name_text: "";
    in-out property <bool> terminal_title_has_session: false;
    in-out property <string> terminal_body_kind_text: "ready";
    in-out property <string> terminal_search_kind_text: "prompt";
    in-out property <int> terminal_search_match_count: 0;
    in-out property <int> terminal_search_current_index: 0;
    in-out property <string> sftp_listing_kind_text: "connect-real";
    in-out property <string> sftp_listing_rows_text: "";
    in-out property <string> sftp_listing_session_key_text: "";
    in-out property <string> sftp_listing_path_text: "";
    in-out property <string> sftp_listing_error_text: "";
    in-out property <string> sftp_session_status_kind_text: "disconnected";
    in-out property <string> sftp_session_status_reason_text: "";
    in-out property <string> sftp_session_status_detail_text: "";
    in-out property <string> sftp_session_status_session_key_text: "";
    in-out property <string> sftp_remote_edit_remote_path_text: "";
    in-out property <string> sftp_remote_edit_local_path_text: "";
    in-out property <string> transfer_queue_rows_text: "";
    in-out property <bool> transfer_queue_empty: true;
    in-out property <string> tunnels_summary_kind_text: "no-active";
    in-out property <string> tunnels_summary_rows_text: "";
    // W4 收尾：status_text 的 i18n 覆盖（kind="" 时状态栏回退英文 status_text）。
    in-out property <string> status_kind_text: "";
    in-out property <string> status_param_1_text: "";
    in-out property <string> status_param_2_text: "";

    // --- W4 i18n：显示串（全部经 @tr 模板渲染；译者只翻这里出现的句子）--------
    property <string> secret_store_status_display:
        secret-store-status(root.secret_store_kind_text, root.secret_store_path_text);
    property <string> editor_folder_display:
        root.editor_folder_known
            ? @tr("{0} ({1})", root.editor_folder_label_text, root.editor_folder_id_text)
            : @tr("Unknown folder ({0})", root.editor_folder_id_text);
    property <string> editor_target_display:
        root.editor_target_editing
            ? @tr("Editing {0}", root.editor_target_session_id_text)
            : @tr("Creating new saved session");
    property <string> editor_auth_test_status_display:
        editor-auth-test-status(
            root.editor_auth_test_kind_text,
            root.editor_auth_test_host_text,
            root.editor_auth_test_backend_text,
            root.editor_auth_test_startup_text,
            root.editor_auth_test_error_text
        );
    property <string> editor_proxy_summary_display:
        proxy-summary-text(
            root.editor_proxy_summary_kind_text,
            root.editor_proxy_protocol_text,
            root.editor_proxy_summary_address_text,
            root.editor_proxy_summary_user_text,
            root.editor_proxy_dns_by_proxy
        );
    property <string> editor_tunnel_summary_display:
        root.editor_tunnel_summary_count == 0
            ? @tr("No tunnel forwards configured.")
            : root.editor_tunnel_summary_rows_text;
    property <string> logging_summary_display:
        @tr("global={0} format={1} directory={2}",
            root.logging_enabled_text,
            root.logging_format_text,
            root.logging_directory_display_text);
    property <string> settings_terminal_status_display:
        settings-terminal-status(
            root.settings_terminal_status_kind_text,
            root.settings_terminal_status_field_text,
            root.settings_terminal_status_value_text,
            root.settings_terminal_status_limit_text
        );
    property <string> known_hosts_inventory_display:
        root.known_hosts_inventory_empty
            ? @tr("No persisted known hosts yet.")
            : root.known_hosts_inventory_rows_text;
    property <string> known_hosts_selection_display:
        known-hosts-selection(
            root.known_hosts_selection_kind_text,
            root.known_hosts_selection_host_text,
            root.known_hosts_selection_port_text,
            root.known_hosts_selection_index,
            root.known_hosts_selection_total
        );
    property <string> active_session_display:
        root.active_session_kind_text == "session"
            ? root.active_session_name_text + "  " + root.active_session_state_text
            : (root.active_session_kind_text == "saved-sessions"
                ? @tr("Saved Sessions ({0})", root.saved_session_count)
                : @tr("Welcome"));
    property <string> session_summary_display:
        root.session_summary_count == 0
            ? @tr("No runtime sessions yet.")
            : (root.session_summary_hidden_count > 0
                ? root.session_summary_rows_text + "\n" + @tr("... and {0} more", root.session_summary_hidden_count)
                : root.session_summary_rows_text);
    property <string> saved_session_selection_display:
        saved-session-selection(
            root.saved_session_selection_kind_text,
            root.saved_session_selection_name_text,
            root.saved_session_selection_host_text,
            root.saved_session_selection_id_text
        );
    property <string> saved_session_inventory_display:
        root.saved_session_inventory_empty
            ? (root.saved_session_inventory_query_text == ""
                ? @tr("No saved sessions yet.")
                : @tr("No saved sessions matched `{0}`.", root.saved_session_inventory_query_text))
            : root.saved_session_inventory_rows_text;
    property <string> recent_sessions_display:
        root.recent_sessions_empty
            ? @tr("No recent runtime sessions yet.")
            : root.recent_sessions_rows_text;
    property <string> tab_display:
        (root.tab_has_session ? root.tab_name_text + "  " : @tr("Welcome") + "  ") + root.tab_state_text;
    property <string> terminal_title_display:
        root.terminal_title_has_session
            ? @tr("Terminal: {0}", root.terminal_title_name_text)
            : @tr("YShell terminal");
    property <string> terminal_body_display:
        root.terminal_body_kind_text == "ready"
            ? @tr("Runtime is ready. Open a Quick Connect target or create a draft session.")
            : (root.terminal_body_kind_text == "no-output"
                ? @tr("Terminal runtime is initialized but no output is available yet.")
                : root.terminal_body_text);
    property <string> terminal_search_summary_display:
        terminal-search-summary(
            root.terminal_search_kind_text,
            root.terminal_search_query_text,
            root.terminal_search_match_count,
            root.terminal_search_current_index
        );
    property <string> sftp_listing_display:
        sftp-listing-summary(
            root.sftp_listing_kind_text,
            root.sftp_listing_rows_text,
            root.sftp_listing_session_key_text,
            root.sftp_listing_path_text,
            root.sftp_listing_error_text
        );
    property <string> sftp_empty_display:
        root.sftp_empty_text != "" ? root.sftp_empty_text : root.sftp_listing_display;
    property <string> sftp_session_status_display:
        sftp-session-status(
            root.sftp_session_status_kind_text,
            root.sftp_session_status_reason_text,
            root.sftp_session_status_detail_text,
            root.sftp_session_status_session_key_text
        );
    property <string> sftp_remote_edit_display:
        root.sftp_remote_edit_active
            ? @tr("Remote edit: {0} <-> {1}", root.sftp_remote_edit_remote_path_text, root.sftp_remote_edit_local_path_text)
            : @tr("No active remote edit session");
    property <string> sftp_sort_display:
        sftp-sort-summary(root.sftp_sort_column_text, root.sftp_sort_ascending);
    property <string> transfer_queue_display:
        root.transfer_queue_empty
            ? @tr("No active transfers")
            : root.transfer_queue_rows_text;
    property <string> tunnels_summary_display:
        root.tunnels_summary_kind_text == "none"
            ? @tr("No configured tunnels for the active session.")
            : (root.tunnels_summary_kind_text == "no-active"
                ? @tr("No active tunnels")
                : root.tunnels_summary_rows_text);
    property <string> status_display:
        status-message(
            root.status_kind_text,
            root.status_param_1_text,
            root.status_param_2_text,
            root.status_text
        );

    // Local UI state (iteration 1): panels, menus and dialogs are Slint-local.
    in-out property <bool> session_manager_visible: true;
    in-out property <bool> terminal_find_visible: false;
    in-out property <int> open_menu_index: -1;
    in-out property <length> menu_anchor_x: 0px;
    in-out property <length> menu_anchor_y: 0px;
    in-out property <bool> terminal_context_menu_open: false;
    in-out property <length> terminal_context_menu_x: 0px;
    in-out property <length> terminal_context_menu_y: 0px;
    in-out property <bool> saved_session_context_menu_open: false;
    in-out property <length> saved_session_context_menu_x: 0px;
    in-out property <length> saved_session_context_menu_y: 0px;
    in-out property <bool> sftp_context_menu_open: false;
    in-out property <length> sftp_context_menu_x: 0px;
    in-out property <length> sftp_context_menu_y: 0px;
    in-out property <bool> about_dialog_visible: false;
    in-out property <bool> settings_dialog_visible: false;
    in-out property <bool> delete_session_dialog_visible: false;
    in-out property <string> delete_session_confirmation_text: "";
    in-out property <bool> quit_dialog_visible: false;
    in-out property <bool> sftp_operation_dialog_visible: false;
    in-out property <string> sftp_operation_text: "none";
    in-out property <string> sftp_dialog_kind: "none";
    in-out property <string> sftp_dialog_name_text: "";
    in-out property <string> sftp_dialog_permissions_text: "644";
    in-out property <string> sftp_dialog_local_text: "";

    // --- W5-④ 面板宽度与自适应（§4.2；宽度为内存态，不持久化）----------------
    /// 左导航期望宽度：拖拽结果，钳制在 200–420px（默认沿用 Theme.nav-width）
    in-out property <length> nav_panel_width: Theme.nav-width;
    /// 右工具面板期望宽度：拖拽结果，钳制在 280–560px（默认沿用 Theme.dock-width）
    in-out property <length> dock_panel_width: Theme.dock-width;
    /// 窗口 <1120px 时用户手动展开右栏（覆盖自动折叠；仅内存态）
    in-out property <bool> dock_user_expanded: false;
    /// 窗口 <960px 时用户手动展开左导航（覆盖 48px 图标条；仅内存态）
    in-out property <bool> nav_user_expanded: false;

    // 断点与拖拽边界（布局行为参数，不进 Theme token）
    property <length> breakpoint_full_layout: 1280px;
    property <length> breakpoint_dock_collapse: 1120px;
    property <length> breakpoint_nav_rail: 960px;
    property <length> nav_width_min: 200px;
    property <length> nav_width_max: 420px;
    property <length> dock_width_min: 280px;
    property <length> dock_width_max: 560px;

    /// 线性收缩系数：窗口 ≤1120px 为 0，≥1280px 为 1（§4.2 的 1120–1280 档）
    property <float> layout_squeeze_ratio:
        clamp((root.width - root.breakpoint_dock_collapse) / (root.breakpoint_full_layout - root.breakpoint_dock_collapse), 0.0, 1.0);
    /// 拖拽换算系数：收缩档内指针 1px 对应目标宽度 1/ratio px，保证把手跟手
    property <float> layout_drag_scale:
        (root.width >= root.breakpoint_full_layout || root.width < root.breakpoint_dock_collapse) ? 1.0
        : max(0.0001, root.layout_squeeze_ratio);

    /// 右栏因窗口过窄而自动折叠（§4.2：<1120px）；用户手动展开后不再折叠
    property <bool> dock_auto_collapsed:
        root.width < root.breakpoint_dock_collapse && !root.dock_user_expanded;
    /// 右栏最终宽度（0 = 折叠）；1120–1280px 按可用空间线性收缩
    property <length> dock_effective_width:
        root.dock_auto_collapsed ? 0px
        : (root.width >= root.breakpoint_full_layout) ? root.dock_panel_width
        : (root.width >= root.breakpoint_dock_collapse) ? (root.dock_width_min + (root.dock_panel_width - root.dock_width_min) * root.layout_squeeze_ratio)
        : root.dock_panel_width;
    property <bool> dock_visible: root.dock_effective_width > 0px;
    /// 窄窗口下在命令栏右侧显示右栏展开/收起按钮
    property <bool> dock_toggle_visible: root.width < root.breakpoint_dock_collapse;

    /// 左导航是否折叠为 48px 图标条（§4.2：<960px）
    property <bool> nav_rail_active:
        root.width < root.breakpoint_nav_rail && !root.nav_user_expanded;
    /// 是否显示"收回图标条"按钮（仅 <960px 有意义）
    property <bool> nav_rail_available: root.width < root.breakpoint_nav_rail;
    /// 全宽左导航列是否可见（图标条模式下由图标条取代）
    property <bool> nav_column_visible:
        root.session_manager_visible && !root.nav_rail_active;
    /// 左导航图标条是否可见
    property <bool> nav_rail_visible:
        root.session_manager_visible && root.nav_rail_active;
    /// 左导航最终宽度
    property <length> nav_effective_width:
        root.nav_rail_active ? Theme.nav-rail-width
        : (root.width >= root.breakpoint_full_layout || root.width < root.breakpoint_dock_collapse) ? root.nav_panel_width
        : (root.nav_width_min + (root.nav_panel_width - root.nav_width_min) * root.layout_squeeze_ratio);

    // 拖拽锚点（按下时记录指针绝对位置与起始宽度；用绝对坐标避免把手随宽度移动产生抖动）
    property <bool> nav_resize_dragging: false;
    property <length> nav_drag_anchor_x: 0px;
    property <length> nav_drag_start_width: 0px;
    property <bool> dock_resize_dragging: false;
    property <length> dock_drag_anchor_x: 0px;
    property <length> dock_drag_start_width: 0px;

