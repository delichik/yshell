    /// D12：连接历史是否开启。
    in-out property <bool> quick_connect_history_enabled: true;
    /// "最近连接"行（历史 + 已保存会话最近使用，运行时已去重排序）。
    in-out property <[QuickConnectRow]> quick_connect_rows: [];
    /// "快速链接"行（运行时已按 sort_order 排序）。
    in-out property <[QuickLinkRow]> quick_links_rows: [];
    // 标签右键菜单针对的标签 id（scope 编码 = 前缀 + id）。
    in-out property <string> tab_menu_id: "";
    // §7 启用条件由 Rust 对"右键的标签"计算（disabled 时必须带 tooltip）。
    in-out property <bool> tab_menu_close_others_enabled: false;
    in-out property <bool> tab_menu_close_left_enabled: false;
    in-out property <bool> tab_menu_close_right_enabled: false;
    in-out property <bool> tab_menu_close_all_enabled: false;
    in-out property <bool> tab_menu_close_disconnected_enabled: false;
    // A28（D18）：针对"被右键标签"的重连/断开可用性（Rust `tab_menu_connection_flags`）。
    in-out property <bool> tab_menu_reconnect_enabled: false;
    in-out property <bool> tab_menu_disconnect_enabled: false;
