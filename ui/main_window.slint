    in-out property <string> status_kind_text: "";
    in-out property <string> status_param_1_text: "";
    in-out property <string> status_param_2_text: "";

    // --- W4 i18n：显示串（全部经 @tr 模板渲染；译者只翻这里出现的句子）--------
    // 说明（R1）：显示串的渲染逻辑已集中到 ui/text_formats.slint；这里只保留
    // 仍在使用的透传定义。下面 5 个是 S1/S2 遗留的"当前无渲染方"的属性
    // （ACTIVE/RECENT 区块与旧状态栏已移除），R1 是纯结构重构，保持它们的定义
    // （含 @tr 文案）不变，使 i18n 键集合与拆分前逐字节一致；清理另开任务。
    property <string> active_session_display:
        TextFormats.active-session-display(root.active_session_kind_text, root.active_session_name_text, root.active_session_state_text, root.saved_session_count);
    property <string> session_summary_display:
        TextFormats.session-summary-display(root.session_summary_count, root.session_summary_hidden_count, root.session_summary_rows_text);
    property <string> saved_session_selection_display:
        TextFormats.saved-session-selection(root.saved_session_selection_kind_text, root.saved_session_selection_name_text, root.saved_session_selection_host_text, root.saved_session_selection_id_text);
    property <string> recent_sessions_display:
        TextFormats.recent-sessions-display(root.recent_sessions_empty, root.recent_sessions_rows_text);
    property <string> sftp_listing_display:
        TextFormats.sftp-listing-summary(root.sftp_listing_kind_text, root.sftp_listing_rows_text, root.sftp_listing_session_key_text, root.sftp_listing_path_text, root.sftp_listing_error_text);

    // Local UI state (iteration 1): panels, menus and dialogs are Slint-local.
    // N3：Sessions 面板可见性（= 面板在任一栈中）由 Rust 投影（`[ui.layout]`）。
    in-out property <bool> sessions_visible: true;
