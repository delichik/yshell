    out property <float> terminal_viewport_secondary_height_px: terminal_workspace.terminal-viewport-secondary-height-px;
    /// W5-A2：终端是否持有键盘焦点（模态弹窗关闭后的焦点恢复据此避让终端）。
    out property <bool> terminal_focused: terminal_workspace.terminal-focused;
