    in-out property <string> tunnels_summary_text: "Tunnels\nNo active tunnels";
    out property <float> terminal_viewport_width_px: terminal_workspace.terminal-viewport-width-px;
    out property <float> terminal_viewport_height_px: terminal_workspace.terminal-viewport-height-px;
    /// W5-A2：终端是否持有键盘焦点（模态弹窗关闭后的焦点恢复据此避让终端）。
    out property <bool> terminal_focused: terminal_workspace.terminal-focused;
    in-out property <bool> sftp_visible: true;
    in-out property <bool> tunnels_visible: true;
    in-out property <bool> commands_visible: true;
    in-out property <string> app_version_text: "";

    // --- W5：连接密码弹窗（仅本次连接使用；不写密钥库/磁盘）------------------
    // 认证方式为 password / keyboard-interactive 的已保存会话在密钥库里找不到密码时，
    // Rust 挂起连接并置 `password_prompt_visible`；输入后 `submit_password` 用该密码
    // 重试一次。`password_prompt_host_text` 是文案里的 `user@host:port`。
    in-out property <bool> password_prompt_visible: false;
    in-out property <string> password_prompt_title_text: @tr("Password required");
    in-out property <string> password_prompt_host_text: "";
    in-out property <string> password_prompt_message_text:
        root.password_prompt_host_text == ""
            ? @tr("Enter the password to continue.")
            : @tr("Enter the password for {0} to connect.", root.password_prompt_host_text);
    // in-out：弹窗内编辑；宿主（Rust）在弹窗关闭后清空，避免残留上一次的密码。
    in-out property <string> password_prompt_value_text: "";

