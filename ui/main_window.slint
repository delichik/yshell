            label: @tr("Open Log Folder"), shortcut: "", enabled: root.terminal_logging_open_folder_enabled,
            checked: false, separator: false,
            tooltip: root.terminal_logging_open_folder_enabled ? "" : @tr("No log folder is available yet.")
        }
    ];
    // N0（§7）：标签右键菜单。启用条件来自 Rust（针对右键时的标签）；禁用必须带 tooltip。
    property <[MenuEntry]> tab_context_menu_entries: [
        {
            label: @tr("Close"), shortcut: "", enabled: true, checked: false, separator: false
        },
        {
            label: @tr("Close Others"), shortcut: "",
            enabled: root.tab_menu_close_others_enabled, checked: false, separator: false,
            tooltip: root.tab_menu_close_others_enabled ? "" : @tr("Only one tab is open.")
        },
        {
            label: @tr("Close Tabs to Left"), shortcut: "",
            enabled: root.tab_menu_close_left_enabled, checked: false, separator: false,
            tooltip: root.tab_menu_close_left_enabled ? "" : @tr("There are no tabs to the left.")
        },
        {
            label: @tr("Close Tabs to Right"), shortcut: "",
            enabled: root.tab_menu_close_right_enabled, checked: false, separator: false,
            tooltip: root.tab_menu_close_right_enabled ? "" : @tr("There are no tabs to the right.")
        },
        {
            label: @tr("Close All"), shortcut: "",
            enabled: root.tab_menu_close_all_enabled, checked: false, separator: false,
            tooltip: root.tab_menu_close_all_enabled ? "" : @tr("No tabs are open.")
        },
        {
            label: @tr("Close Disconnected Tabs"), shortcut: "",
            enabled: root.tab_menu_close_disconnected_enabled, checked: false, separator: false,
            tooltip: root.tab_menu_close_disconnected_enabled ? "" : @tr("No disconnected or failed tabs to close.")
        },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        // A28（D18）：标签级 Reconnect/Disconnect 的启用态来自 Rust 对"被右键标签"的
        // 投影（`tab_menu_reconnect_enabled` / `tab_menu_disconnect_enabled`）。
        // 断开的标签才可 Reconnect；已连接的标签才可 Disconnect。
        {
            label: @tr("Reconnect"), shortcut: root.shortcut-reconnect,
            enabled: root.tab_menu_reconnect_enabled, checked: false, separator: false,
            tooltip: root.tab_menu_reconnect_enabled ? "" : @tr("This tab is already connected.")
        },
        {
            label: @tr("Disconnect"), shortcut: "",
            enabled: root.tab_menu_disconnect_enabled, checked: false, separator: false,
            tooltip: root.tab_menu_disconnect_enabled ? "" : @tr("This tab is already disconnected.")
        }
    ];
    property <[MenuEntry]> saved_session_context_menu_entries: [
        // W5-A3：没有选中的已保存会话时，各项操作禁用；A12：禁用必须给出原因。
        // A13：右键目标是文件夹时本套菜单不适用（New Session 也不是在该文件夹下创建）——
        // 按 kind 分流需要 Rust 投影"被右键节点类型"，见 WS-A 报告的跨组请求。
        {
            label: @tr("Session" => "Open"), shortcut: "",
            enabled: root.has_saved_selection, checked: false, separator: false,
            tooltip: root.has_saved_selection ? "" : @tr("Select a saved session first.")
        },
        {
            label: @tr("Edit..."), shortcut: "",
            enabled: root.has_saved_selection, checked: false, separator: false,
            tooltip: root.has_saved_selection ? "" : @tr("Select a saved session first.")
        },
        {
            label: @tr("Update From Active"), shortcut: "",
            enabled: root.has_saved_selection && root.has_active_session, checked: false, separator: false,
            tooltip: root.has_saved_selection
                ? @tr("Open the active session first.")
                : @tr("Select a saved session first.")
        },
        {
            label: @tr("Delete..."), shortcut: "",
            enabled: root.has_saved_selection, checked: false, separator: false,
            tooltip: root.has_saved_selection ? "" : @tr("Select a saved session first.")
        },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("New Session"), shortcut: root.shortcut-new-session, enabled: true, checked: false, separator: false }
    ];
    // A27（D12）：会话树"文件夹行"右键菜单。与 `saved_session_context_menu_entries`
    // 共用 `dispatch_context_menu(which = 0)`，由 `saved_tree_menu_kind_text` 分流。
    // 索引与 dispatch 对齐：0 New Session Here / 1 New Folder… / 2 Rename… /
    // 3 Delete… / 4 Connect All / 5 Edit Folder Defaults…。
    // 无 Rust 动作的项 disabled + tooltip 说明原因（不静默缺失）。
    property <[MenuEntry]> saved_folder_context_menu_entries: [
        {
            label: @tr("New Session Here"), shortcut: "",
            enabled: root.saved_tree_menu_kind_text == "folder", checked: false, separator: false,
            tooltip: root.saved_tree_menu_kind_text == "folder" ? "" : @tr("Right-click a folder first.")
        },
        {
            label: @tr("New Folder..."), shortcut: "", enabled: false, checked: false, separator: false,
            tooltip: @tr("Not available in this version.")
        },
        {
            label: @tr("Rename..."), shortcut: "", enabled: false, checked: false, separator: false,
            tooltip: @tr("Not available in this version.")
        },
        {
            label: @tr("Delete..."), shortcut: "", enabled: false, checked: false, separator: false,
            tooltip: @tr("Not available in this version.")
        },
        {
            label: @tr("Connect All"), shortcut: "", enabled: false, checked: false, separator: false,
            tooltip: @tr("Not available in this version.")
        },
        {
            label: @tr("Edit Folder Defaults…"), shortcut: "",
            enabled: root.saved_tree_menu_kind_text == "folder", checked: false, separator: false,
            tooltip: root.saved_tree_menu_kind_text == "folder" ? "" : @tr("Right-click a folder first.")
        }
    ];
    // S1（§14.1 / context-menu-design §5.3）：会话树空白区菜单。
    // Import/Expand All/Collapse All 本版不实现：disabled + tooltip 说明原因。
    property <[MenuEntry]> saved_session_blank_menu_entries: [
        { label: @tr("New Session"), shortcut: root.shortcut-new-session, enabled: true, checked: false, separator: false },
        { label: @tr("New Folder..."), shortcut: "", enabled: true, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        {
            label: @tr("Import Config..."),
            shortcut: "", enabled: false, checked: false, separator: false,
            tooltip: @tr("Importing configuration files is not available in this build.")
        },
        {
            label: @tr("Expand All"),
            shortcut: "", enabled: false, checked: false, separator: false,
            tooltip: @tr("Expand All is not available in this build.")
        },
        {
            label: @tr("Collapse All"),
            shortcut: "", enabled: false, checked: false, separator: false,
            tooltip: @tr("Collapse All is not available in this build.")
        },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Refresh"), shortcut: "", enabled: true, checked: false, separator: false }
    ];
    // S1：窄窗口 48px 图标条的最小菜单（New Session / 展开会话栏）。
    property <[MenuEntry]> nav_rail_menu_entries: [
        { label: @tr("New Session"), shortcut: root.shortcut-new-session, enabled: true, checked: false, separator: false },
        { label: @tr("Expand navigation"), shortcut: "", enabled: true, checked: false, separator: false }
    ];

    // --- Local helpers -------------------------------------------------------
    /// 关闭当前右键菜单（同一时刻只有一个展开，与拆分前一致）。
    function close_context_menus() {
        root.context_menu_token = "none";
    }

    /// A2：菜单/右键菜单/溢出菜单关闭后把键盘焦点交还（弹层打开时自己拿了焦点）。
    /// 与 L2 弹窗同一优先级：仍有模态弹窗 → 交给最上层弹窗；否则 A33（E23）：
    /// 有活动会话且终端可见时优先还给终端（菜单打开前终端是否聚焦没有可靠信号，
    /// 采用"有活动会话即回终端"的简单策略，取舍见 ws-A.md A33）；否则回到窗口级
    /// 快捷键 FocusScope。
    function restore-focus-after-menu() {
        if (root.any_modal_visible) {
            root.focus-top-dialog();
        } else if (root.has_active_session && !root.quick_connect_visible) {
            terminal_workspace.focus-terminal();
        } else {
            root.focus-global-shortcuts();
        }
    }

    /// A3：关闭命令栏溢出菜单（由 dismissed / 其它入口调用）。
    function close_more_menu() {
        if (root.more_menu_open) {
            root.more_menu_open = false;
            root.restore-focus-after-menu();
        }
    }

    /// A2 / WS-D 接口：关闭当前展开的浮层（菜单栏下拉 / 右键菜单 / 面板 ⋯ /
    /// 溢出菜单）。返回 `true` 表示确实关掉了一层。
    ///
    /// 终端聚焦时按键不会到达窗口级 `shortcut_scope`（终端 FocusScope accept
    /// 全部按键），所以 Rust 的终端按键兜底需要在 Esc 上调用这里：
    /// ```rust
    /// // crates/yshell-app/src/bootstrap.rs（WS-D）：
    /// if text.as_ref() == "\u{1b}" && window.invoke_dismiss_overlays() {
    ///     return;   // Esc 只关浮层，不下发进 PTY
    /// }
    /// ```
    public function dismiss-overlays() -> bool {
        if (root.open_menu_index >= 0) {
            root.open_menu_index = -1;
            root.menu-opened-by-hover = false;
            root.restore-focus-after-menu();
            return true;
        }
        if (root.more_menu_open) {
            root.more_menu_open = false;
            root.restore-focus-after-menu();
            return true;
        }
        if (root.panel_menu_id != "") {
            root.close_panel_menu();
            return true;
        }
        if (root.context_menu_token != "none") {
            root.close_context_menus();
            root.restore-focus-after-menu();
            return true;
        }
        return false;
    }

    /// 打开指定右键菜单：先关掉其它右键菜单与一级菜单，再记录锚点（回调传 x/y）。
    function open_context_menu(token: string, x: length, y: length) {
        root.close_context_menus();
        root.open_menu_index = -1;
        root.menu-opened-by-hover = false;
        root.more_menu_open = false;
        root.context_menu_x = x;
        root.context_menu_y = y;
        root.context_menu_token = token;
    }

    /// 一级菜单点击：已展开则收起；否则切换到本项（并关掉右键菜单/溢出菜单）。
    /// A34：若当前弹层是"悬停切换"打开的，第一次 click 只确认（保持展开、清标志），
    /// 第二次 click 才收起 —— 修复"hover 切过去后紧接着的 click 把弹层立刻关掉"。
    function toggle_menu(index: int, anchor_x: length) {
        if (root.open_menu_index == index) {
            if (root.menu-opened-by-hover) {
                root.menu-opened-by-hover = false;
            } else {
                root.open_menu_index = -1;
                root.restore-focus-after-menu();
            }
        } else {
            root.close_context_menus();
            root.close_more_menu();
            root.menu_anchor_x = anchor_x;
            root.menu_anchor_y = Theme.bar-height-menubar;
            root.open_menu_index = index;
            root.menu-opened-by-hover = false;
        }
    }

    /// 一级菜单悬停切换：已有菜单展开时，指针移到另一个一级菜单直接切到它的菜单
    /// （标准 MenuBar 行为）；没有菜单展开时悬停不动作，保持"点击展开"。
    /// A34：切换成功后置 `menu-opened-by-hover`，让紧随的 click 不误关弹层。
    function hover_menu(index: int, anchor_x: length) {
        if (root.open_menu_index >= 0 && root.open_menu_index != index) {
            root.close_context_menus();
            root.menu_anchor_x = anchor_x;
            root.menu_anchor_y = Theme.bar-height-menubar;
            root.open_menu_index = index;
            root.menu-opened-by-hover = true;
        }
    }

    /// 一级菜单选中：menu 0..4 = File/Edit/Session/View/Help（模型数组见下方）。
    /// 逐条与拆分前各 MenuPopup 的 selected 分支一致。
    function dispatch_menu(menu: int, index: int) {
        if (menu == 0) {
            // File
            if (index == 0) { root.start_new_saved_session_editor(); }
            else if (index == 1) { root.focus-quick-connect(); }
            else if (index == 2) { root.save_session(); }
            else if (index == 4) { root.settings_dialog_visible = true; }
            else if (index == 5) { root.quit_dialog_visible = true; }
        } else if (menu == 1) {
            // Edit
            // A22（B 轮2 高#1）：Edit > Copy 必须复制**选区**（与终端右键菜单同源回调），
            // 此前调的是 `copy_terminal_visible()`（整屏可见内容），静默给错结果。
            if (index == 0) { root.copy_terminal_selection(); }
            else if (index == 1) { root.paste_terminal_clipboard(); }
            else if (index == 2) { root.clear_terminal(); }
            // A24：无活动会话时不置位（避免"状态残留 → 之后打开终端莫名弹出查找栏"）。
            else if (index == 3) {
                if (root.has_active_session) {
                    root.terminal_find_visible = true;
                }
            }
        } else if (menu == 2) {
            // Session
            if (index == 0) { root.disconnect_session(); }
            else if (index == 1) { root.reconnect_session(); }
            else if (index == 3) { root.load_selected_saved_session_into_editor(); }
            else if (index == 4) { root.update_selected_saved_session(); }
            else if (index == 5) {
                root.delete_session_confirmation_text = "";
                root.delete_session_dialog_visible = true;
            }
            else if (index == 7) { root.open_host_keys_manager(); }
            else if (index == 8) { root.open_private_keys_manager(); }
        } else if (menu == 3) {
            // View：面板可见性/位置统一入口（隐藏过的按默认侧恢复）。
            if (index == 0) { root.toggle_panel("sessions"); }
            else if (index == 1) { root.toggle_panel("sftp"); }
            else if (index == 2) { root.toggle_panel("tunnels"); }
            else if (index == 3) { root.toggle_panel("quick_commands"); }
            else if (index == 4) { root.toggle_panel("transfers"); }
        } else if (menu == 4) {
            // Help
            if (index == 0) { root.about_dialog_visible = true; }
        }
        root.open_menu_index = -1;
        root.menu-opened-by-hover = false;
        root.restore-focus-after-menu();
    }

    /// A3：命令栏溢出菜单选中（0 = About / 2 = Settings / 4 = Quit，奇数位是分隔符）。
    function dispatch_overflow_menu(index: int) {
        if (index == 0) { root.about_dialog_visible = true; }
        else if (index == 2) { root.settings_dialog_visible = true; }
        else if (index == 4) { root.quit_dialog_visible = true; }
        root.more_menu_open = false;
        root.restore-focus-after-menu();
    }

    /// A27（D12）：判断被右键节点的 kind（folder / session / none）。
    /// 说明：Slint 1.18 的 `find-index`/闭包仍是实验特性（非实验构建不可用），函数里
    /// 无法按 id 遍历 `session_tree_rows`；这里改用"右键先选中"路径中**同步更新**的
    /// 投影：`saved_session_tree_selected_id`（被选中行的 id，文件夹会话都在内）与
    /// `saved_folder_selected`（该选中行是否为文件夹）。未知 id 选中不变 → "none"。
    function saved_tree_menu_kind_for_id(id: string) -> string {
        if (root.saved_session_tree_selected_id != id) {
            return "none";
        }
        if (root.saved_folder_selected) {
            return "folder";
        }
        return "session";
    }

    /// 右键菜单选中：which 0..2 = 会话树行/空白区/图标条（左栏），4 = 终端，5 = SFTP，6 = 标签。
    /// 逐条与拆分前各 MenuPopup 的 selected 分支一致。
    function dispatch_context_menu(which: int, index: int) {
        if (which == 0) {
            // 会话树行菜单
            if (root.saved_tree_menu_kind_text == "folder") {
                // A27（D12）：文件夹行菜单（索引见 `saved_folder_context_menu_entries`）。
                if (index == 0) {
                    root.start_new_saved_session_editor_in_folder(root.saved_session_tree_selected_id);
                }
                else if (index == 5) { root.edit_folder_defaults(); }
            } else {
                if (index == 0) { root.open_selected_saved_session(); }
                else if (index == 1) { root.load_selected_saved_session_into_editor(); }
                else if (index == 2) { root.update_selected_saved_session(); }
                else if (index == 3) {
                    root.delete_session_confirmation_text = "";
                    root.delete_session_dialog_visible = true;
                }
                else if (index == 5) { root.start_new_saved_session_editor(); }
            }
        } else if (which == 1) {
            // 会话树空白区菜单
            if (index == 0) { root.start_new_saved_session_editor(); }
            else if (index == 1) {
                root.new_root_folder_name_text = "";
                root.new_folder_dialog_visible = true;
            }
            else if (index == 7) { root.refresh_saved_sessions(); }
        } else if (which == 2) {
            // 图标条菜单
            if (index == 0) { root.start_new_saved_session_editor(); }
            else if (index == 1) { root.panel_side_expand("left"); }
        } else if (which == 4) {
            // 终端菜单
            if (index == 0) { root.copy_terminal_selection(); }
            else if (index == 1) { root.paste_terminal_clipboard(); }
            else if (index == 2) { root.terminal_select_all(); }
            else if (index == 3) { root.clear_terminal(); }
            else if (index == 4) { root.terminal_find_visible = true; }
            // N6：日志项（Start/Stop/Open File/Open Folder）。
            else if (index == 6) { root.terminal_logging_start(); }
            else if (index == 7) { root.terminal_logging_stop(); }
            else if (index == 8) { root.terminal_logging_open_file(); }
            else if (index == 9) { root.terminal_logging_open_folder(); }
        } else if (which == 7) {
            // N6：状态栏日志菜单（与终端菜单同一组语义动作）。
            if (index == 0) { root.terminal_logging_start(); }
            else if (index == 1) { root.terminal_logging_stop(); }
            else if (index == 2) { root.terminal_logging_open_file(); }
            else if (index == 3) { root.terminal_logging_open_folder(); }
        } else if (which == 6) {
            // N0 标签菜单：单关 / 批量 scope（others|left|right|all|disconnected）
            if (index == 0) { root.close_tab(root.tab_menu_id); }
            else if (index == 1) { root.close_tabs("others:" + root.tab_menu_id); }
            else if (index == 2) { root.close_tabs("left:" + root.tab_menu_id); }
            else if (index == 3) { root.close_tabs("right:" + root.tab_menu_id); }
            else if (index == 4) { root.close_tabs("all"); }
            else if (index == 5) { root.close_tabs("disconnected"); }
            // A28（D18）：Reconnect/Disconnect（索引见 `tab_context_menu_entries`）。
            else if (index == 7) { root.reconnect_tab(root.tab_menu_id); }
            else if (index == 8) { root.disconnect_tab(root.tab_menu_id); }
        }
        root.close_context_menus();
        root.restore-focus-after-menu();
    }

    /// N3：面板 ⋯ 菜单——记录目标面板与锚点，由窗口层级的 PanelMenuPopup 渲染。
    function open_panel_menu(id: string, x: length, y: length) {
        root.panel_menu_id = id;
        root.panel_menu_x = x;
        root.panel_menu_y = y;
    }

    function close_panel_menu() {
        root.panel_menu_id = "";
        root.restore-focus-after-menu();
    }

    /// 某个面板框的当前投影（菜单禁用项 / 收起文案用）。
    function panel_frame_for(id: string) -> PanelFrameData {
        if (id == "sessions") { return root.layout_sessions_frame; }
        if (id == "sftp") { return root.layout_sftp_frame; }
        if (id == "tunnels") { return root.layout_tunnels_frame; }
        if (id == "quick_commands") { return root.layout_quick_commands_frame; }
        return root.layout_transfers_frame;
    }

    /// 面板菜单动作 → Rust（布局持久化在 Rust：move/hide/collapse 全部落盘）。
    function dispatch_panel_menu(action: PanelMenuAction) {
        if (root.panel_menu_id == "") { return; }
        if (action == PanelMenuAction.MoveLeft) { root.panel_action(root.panel_menu_id, "move-left"); }
        else if (action == PanelMenuAction.MoveRight) { root.panel_action(root.panel_menu_id, "move-right"); }
        else if (action == PanelMenuAction.Collapse) { root.panel_action(root.panel_menu_id, "collapse"); }
        else if (action == PanelMenuAction.Expand) { root.panel_action(root.panel_menu_id, "expand"); }
        else { root.panel_action(root.panel_menu_id, "hide"); }
        root.close_panel_menu();
    }

    /// SFTP 弹窗语义动作：宿主持有 `sftp_dialog_*` 与 SftpEntryDialog 实例。
    function open_sftp_dialog(kind: string) {
        if (kind == "new-folder") {
            root.sftp_dialog_name_text = "";
        } else if (kind == "upload") {
            root.sftp_dialog_local_text = root.sftp_local_path_text;
        } else if (kind == "download") {
            root.sftp_dialog_local_text = root.local_path_text;
        } else if (kind == "copy-to") {
            root.sftp_dialog_local_text = root.sftp_path_text;
        } else if (kind == "rename") {
            root.sftp_dialog_name_text = root.sftp_selected_name_text;
        } else if (kind == "chmod") {
            root.sftp_dialog_permissions_text = root.sftp_selected_permissions_text;
        }
        root.sftp_dialog_kind = kind;
    }

    /// N1：按右键位置选择上下文菜单的目标类型（远端行由投影给出 file/dir/multi）。
    function begin_sftp_context_menu(scope: string, x: length, y: length) {
        if (scope == "remote-blank") {
            root.sftp_menu_target_kind_text = "blank";
        } else if (scope == "local") {
            root.sftp_menu_target_kind_text = root.local_selected_count > 0 ? "local" : "local-blank";
        }
        root.open_context_menu("sftp", x, y);
    }

    /// N3：远端行右键 → 按行投影的 kind 选择菜单（多选优先 multi）。
    function begin_sftp_row_context_menu(index: int, x: length, y: length) {
        if (root.sftp_selected_count > 1) {
            root.sftp_menu_target_kind_text = "multi";
        } else if (index >= 0 && index < root.sftp_rows.length) {
            root.sftp_menu_target_kind_text = root.sftp_rows[index].is-dir ? "dir" : "file";
        } else {
            root.sftp_menu_target_kind_text = "blank";
        }
        root.open_context_menu("sftp", x, y);
    }

    /// L2：把键盘焦点交还给仍然可见的最上层弹窗（嵌套关闭上层后由各关闭路径调用）。
    /// 顺序与下方弹窗实例的声明顺序相反（最后声明 = 绘制/交互最上层）。没有弹窗
    /// 剩余时把焦点还给窗口级快捷键 FocusScope（等价于 bootstrap 的
    /// `restore_shortcut_focus_after_modal`；本地弹窗关闭不产生投影事件，需在此补位）。
    function focus-top-dialog() {
        if (root.logging_dialog_visible) {
            logging_dialog.focus-dialog();
        } else if (root.terminal_appearance_dialog_visible) {
            terminal_appearance_dialog.focus-dialog();
        } else if (root.folder_editor_visible) {
            folder_editor.focus-dialog();
        } else if (root.auth_prompt_visible) {
            auth_prompt_dialog.focus-dialog();
        } else if (root.host_key_prompt_visible) {
            host_key_dialog.focus-dialog();
        } else if (root.private_keys_modal_visible) {
            private_keys_page.focus-dialog();
        } else if (root.host_keys_modal_visible) {
            host_keys_page.focus-dialog();
        } else if (root.known_hosts_modal_visible) {
            known_hosts_page.focus-dialog();
        } else if (root.editor_modal_visible) {
            session_editor.focus-dialog();
        } else if (root.sftp_properties_visible) {
            sftp_properties_dialog.focus-dialog();
        } else if (root.sftp_conflict_visible) {
            sftp_conflict_dialog.focus-dialog();
        } else if (root.sftp_dialog_kind != "none") {
            sftp_dialog.focus-dialog();
        } else if (root.password_prompt_visible) {
            password_dialog.focus-dialog();
        } else if (root.new_folder_dialog_visible) {
            new_folder_dialog.focus-dialog();
        } else if (root.close_tabs_confirm_visible) {
            close_tabs_dialog.focus-dialog();
        } else if (root.quit_dialog_visible) {
            quit_dialog.focus-dialog();
        } else if (root.delete_session_dialog_visible) {
            delete_dialog.focus-dialog();
        } else if (root.settings_dialog_visible) {
            settings_dialog.focus-dialog();
        } else if (root.about_dialog_visible) {
            about_dialog.focus-dialog();
        } else {
            root.focus-global-shortcuts();
        }
    }

    background: Theme.window-background;

    // --- W5-A2：窗口级全局快捷键 FocusScope ---------------------------------
    // 包住主内容：终端/输入框先拿到按键，被它们 reject 的组合沿父链冒泡到这里；
    // 命中的组合 accept 并执行动作，其余 reject（不消费按键，继续走原本的焦点链路）。
    // 终端 FocusScope 会 accept 全部按键（见 ui/components/terminal_view.slint），
    // 所以终端聚焦时由 bootstrap.rs 的终端按键兜底调用同一份 `dispatch-global-shortcut`。
    shortcut_scope := FocusScope {
        key-pressed(event) => {
            // A2：浮层（一级菜单 / 右键菜单 / 面板 ⋯ / 溢出菜单）打开时，Esc 只关浮层。
            // 终端聚焦时按键到不了这里（终端 FocusScope 消费全部按键）——Rust 侧的
            // 终端按键兜底请调用 `dismiss-overlays()`，见其文档注释。
            if (event.text == "\u{001b}" && root.dismiss-overlays()) {
                return accept;
            }
            if (root.dispatch-global-shortcut(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            )) {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // FocusScope 不是布局容器：显式撑满窗口，保持内容区几何与之前一致。
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            // --- MenuBar（32px，低频/全局入口）----------------------------------
            // 行与一级菜单项见 components/menu_bar.slint；点击/悬停只上报
            // index + 锚点 x，展开态与切换逻辑仍在本文件（toggle_menu/hover_menu）。
            MenuBar {
                open-index: root.open_menu_index;
                menu-activated(index, anchor_x) => { root.toggle_menu(index, anchor_x); }
                menu-hovered(index, anchor_x) => { root.hover_menu(index, anchor_x); }
            }

            // --- CommandBar（48px，高频动作）-----------------------------------
            // 结构与动作见 components/command_bar.slint；面板开关的"折叠时顺带展开"
            // 副作用、快捷路径（focus-quick-connect）与"更多"菜单锚点由本文件补齐。
            command_bar := CommandBar {
                dock-toggle-visible: root.layout_dock_toggle_visible;
                right-collapsed: root.layout_dock_collapsed;
                new-session() => { root.start_new_saved_session_editor(); }
                open-panels-menu(x, y) => {
                    // 与 View 菜单同一份面板入口：借用菜单栏的锚点机制。
                    root.open_menu_index = 3;
                    root.menu_anchor_x = x;
                    root.menu_anchor_y = y;
                }
                toggle-right-side() => { root.panel_side_toggle("right"); }
                // A24：无活动会话时命令栏查找按钮禁用（禁用态带 tooltip 说明原因），
                // 点击不再静默置位 `terminal_find_visible`。
                find-enabled: root.has_active_session;
                open-find() => {
                    if (root.has_active_session) {
                        root.terminal_find_visible = true;
                    }
                }
                open-settings() => { root.settings_dialog_visible = true; }
                open-more-menu(x, y) => {
                    // A3：独立溢出菜单（不再复用一级菜单索引，帮助标题不会被点亮）。
                    root.open_menu_index = -1;
                    root.close_context_menus();
                    root.more_menu_x = x;
                    root.more_menu_y = y;
                    root.more_menu_open = true;
                }
            }

            // --- 主机密钥确认：已改为模态弹窗 HostKeyDialog（见文件末尾）------
            // 旧的内嵌 InfoBar 横幅整块移除：属性/回调（host_key_prompt_visible、
            // host_key_prompt_text、host_key_prompt_mode_text、
            // host_key_prompt_confirmation_text、cancel_host_key_prompt、
            // trust_host_key_once、trust_host_key_and_save、
            // replace_host_key_and_connect、update_host_key_replace_confirmation）
            // 全部保留，由 HostKeyDialog 复用。

            // --- N3：面板停靠容器（左右面板栈 + 工作区槽；几何全部来自 Rust）-----
            // 面板框绝对定位、内容常驻；中间 `@children` 槽放 TerminalWorkspace。
            tool_dock := ToolDock {
                vertical-stretch: 1;
                left-effective-width: root.layout_left_effective_width;
                right-effective-width: root.layout_right_effective_width;
                left-width: root.layout_left_width;
                right-width: root.layout_right_width;
                nav-rail-active: root.layout_rail_active;
                layout-drag-scale: root.layout_drag_scale;
                sessions-frame: root.layout_sessions_frame;
                sftp-frame: root.layout_sftp_frame;
                tunnels-frame: root.layout_tunnels_frame;
                quick-commands-frame: root.layout_quick_commands_frame;
                transfers-frame: root.layout_transfers_frame;
                split-handles: root.layout_split_handles;
                drag-indicator-visible: root.layout_drag_indicator_visible;
                drag-indicator-x: root.layout_drag_indicator_x;
                drag-indicator-y: root.layout_drag_indicator_y;
                drag-indicator-width: root.layout_drag_indicator_width;
                area-resized(w, h) => { root.panel_area_resized(w, h); }
                panel-menu-requested(id, x, y) => { root.open_panel_menu(id, x, y); }
                panel-collapse-requested(id) => { root.panel_action(id, "collapse-toggle"); }
                panel-hide-requested(id) => { root.panel_action(id, "hide"); }
                panel-drag-start(id, x, y) => { root.panel_drag_start(id, x, y); }
                panel-drag-move(id, x, y) => { root.panel_drag_move(id, x, y); }
                panel-drag-drop(id, x, y) => { root.panel_drag_drop(id, x, y); }
                panel-drag-cancel() => { root.panel_drag_cancel(); }
                panel-split-preview(side, boundary, y) => { root.panel_split_preview(side, boundary, y); }
                panel-split-commit() => { root.panel_split_commit(); }
                panel-width-preview(side, width) => { root.panel_width_preview(side, width); }
                panel-width-commit() => { root.panel_width_commit(); }
                rail-menu-requested(x, y) => { root.open_context_menu("rail", x, y); }
                rail-expand-requested() => { root.panel_side_expand("left"); }
                // A31（B24/B25）：SessionSidebarContent 头部 `+` / 空白区左键 → 宿主回调。
                session-new-requested() => { root.start_new_saved_session_editor(); }
                session-clear-selection-requested() => { root.clear_saved_session_selection(); }

                // Sessions 面板内容（搜索/树/空白区右键）
                session-search-text <=> root.session_search_text;
                session-tree-rows: root.session_tree_rows;
                session-selected-id: root.saved_session_tree_selected_id;
                session-empty-text: TextFormats.saved-session-inventory-display(root.saved_session_inventory_empty, root.saved_session_inventory_query_text, root.saved_session_inventory_rows_text);
                update-session-search(value) => { root.update_session_search(value); }
                select-session-row(id) => { root.select_saved_session(id); }
                activate-session-row(id) => { root.activate_saved_session_tree_node(id); }
                toggle-session-folder(id) => { root.toggle_saved_folder(id); }
                session-row-context-menu-requested(id, x, y) => {
                    // 右键先选中再弹菜单；这条路径不算"点击"，
                    // 否则会喂给"重复点击 = 激活"兜底。
                    root.select_saved_session_for_menu(id);
                    // A27（D12）：记录被右键节点类型，供文件夹/会话菜单分流。
                    root.saved_tree_menu_kind_text = root.saved_tree_menu_kind_for_id(id);
                    root.open_context_menu("saved-session", x, y);
                }
                session-blank-menu-requested(x, y) => { root.open_context_menu("blank", x, y); }
                tunnels-summary-text: TextFormats.tunnels-summary-display(root.tunnels_summary_kind_text, root.tunnels_summary_rows_text);
                transfer-queue-text: root.transfer_queue_text;

                // --- TerminalWorkspace --------------------------------------------
                // 标签条 + TerminalView 见 components/terminal_workspace.slint；
                // 投影与回调由本文件转发，viewport/焦点 out 属性继续对 Rust 暴露。
                terminal_workspace := TerminalWorkspace {
                    horizontal-stretch: 1;
                    // N2：活动标签是 QC 页时隐藏终端视图，内容区换成页面实例。
                    terminal-visible: !root.quick_connect_visible;
                    tabs: root.tabs;
                    title-text: TextFormats.terminal-title-display(root.terminal_title_has_session, root.terminal_title_name_text);
                    body-text: TextFormats.terminal-body-display(root.terminal_body_kind_text, root.terminal_body_text);
                    visible-lines <=> root.terminal_visible_lines;
                    terminal-image: root.terminal_image;
                    cursor-column: root.terminal_cursor_column;
                    cursor-row: root.terminal_cursor_row;
                    scroll-offset: root.terminal_scroll_offset;
                    selection-active: root.terminal_selection_active;
                    search-query-text <=> root.terminal_search_query_text;
                    search-summary-text: TextFormats.terminal-search-summary(root.terminal_search_kind_text, root.terminal_search_query_text, root.terminal_search_match_count, root.terminal_search_current_index);
                    status-text: root.status_text;
                    find-visible: root.terminal_find_visible;
                    new-session() => { root.new_tab_default(); }
                    // A24：标签条的查找入口同样只在有活动会话时置位（WS-E 会移除这个重复入口）。
                    open-find() => {
                        if (root.has_active_session) {
                            root.terminal_find_visible = true;
                        }
                    }
                    activate-tab(id) => { root.activate_tab(id); }
                    close-tab(id) => { root.close_tab(id); }
                    tab-context-menu-requested(id, x, y) => {
                        root.tab_menu_id = id;
                        root.tab_context_menu_requested(id, x, y);
                        root.open_context_menu("tab", x, y);
                    }
                    context-menu-requested(x, y) => { root.open_context_menu("terminal", x, y); }
                    terminal-key(text, ctrl, alt, shift, meta) => { root.terminal_key(text, ctrl, alt, shift, meta); }
                    terminal-scroll(delta) => { root.terminal_scroll(delta); }
                    terminal-scroll-to-bottom() => { root.terminal_scroll_to_bottom(); }
                    terminal-selection-begin(x, y) => { root.terminal_selection_begin(x, y); }
                    terminal-selection-update(x, y) => { root.terminal_selection_update(x, y); }
                    terminal-selection-end(x, y) => { root.terminal_selection_end(x, y); }
                    terminal-select-word-at(x, y) => { root.terminal_select_word_at(x, y); }
                    copy-visible() => { root.copy_terminal_visible(); }
                    paste-clipboard() => { root.paste_terminal_clipboard(); }
                    clear-terminal() => { root.clear_terminal(); }
                    find-text(query) => { root.find_terminal_text(query); }
                    find-next() => { root.find_terminal_next(); }
                    find-prev() => { root.find_terminal_prev(); }
                    dismiss-find() => { root.terminal_find_visible = false; }

                    // --- N2：Quick Connect 页（非终端标签的内容；始终实例化，用
                    // max-height 折叠——invisible 元素在 Slint 1.18 仍占布局空间）--
                    quick_connect_page := QuickConnectPage {
                        vertical-stretch: 1;
                        max-height: root.quick_connect_visible ? 100000px : 0px;
                        input-text <=> root.quick_connect_input_text;
                        input-error-text: root.quick_connect_error_text;
                        // A36（WS-D D37）：kind 为空时回退到 Rust 的一体化文案（现状兼容）。
                        summary-text: TextFormats.status-message(
                            root.quick_connect_summary_kind_text,
                            root.quick_connect_summary_param_1_text,
                            root.quick_connect_summary_param_2_text,
                            root.quick_connect_summary_text
                        );
                        history-enabled: root.quick_connect_history_enabled;
                        last-target-text: root.quick_connect_last_target_text;
                        recent-rows: root.quick_connect_rows;
                        link-rows: root.quick_links_rows;
                        input-changed(text) => { root.update_quick_connect_input(text); }
                        submit(text) => { root.submit_quick_connect(text); }
                        connect-target(target) => { root.submit_quick_connect(target); }
                        pin-target(target) => { root.quick_connect_pin(target); }
                        copy-target(target) => { root.quick_connect_copy(target); }
                        remove-link(id) => { root.quick_link_remove(id); }
                        save-as-session(target) => { root.quick_connect_save_as_session(target); }
                        clear-history() => { root.quick_connect_clear_history(); }
                    }
                }

                // --- N1：SftpPanel 投影 + 回调透传（ToolDock 提供面板壳与透传）------
                sftp-rows: root.sftp_rows;
                    sftp-crumbs: root.sftp_crumbs;
                    sftp-selected-index: root.sftp_selected_index;
                    sftp-sort-column-text: root.sftp_sort_column_text;
                    sftp-sort-ascending: root.sftp_sort_ascending;
                    sftp-sort-text: TextFormats.sftp-sort-summary(root.sftp_sort_column_text, root.sftp_sort_ascending);
                    sftp-show-hidden: root.sftp_show_hidden;
                    sftp-item-count: root.sftp_item_count;
                    sftp-dir-count: root.sftp_dir_count;
                    sftp-selected-count: root.sftp_selected_count;
                    sftp-empty-text: TextFormats.sftp-empty-display(root.sftp_empty_text, root.sftp_listing_kind_text, root.sftp_listing_rows_text, root.sftp_listing_session_key_text, root.sftp_listing_path_text, root.sftp_listing_error_text);
                    sftp-error-text: root.sftp_listing_error_text;
                    sftp-connected: root.sftp_available;
                    sftp-remote-edit-active: root.sftp_remote_edit_active;
                    sftp-remote-edit-text: TextFormats.sftp-remote-edit-display(root.sftp_remote_edit_active, root.sftp_remote_edit_remote_path_text, root.sftp_remote_edit_local_path_text);
                    sftp-path-text <=> root.sftp_path_text;
                    local-rows: root.local_rows;
                    local-path-text: root.local_path_text;
                    local-show-hidden: root.local_show_hidden;
                    local-sort-column-text: root.local_sort_column_text;
                    local-sort-ascending: root.local_sort_ascending;
                    local-sort-text: TextFormats.sftp-sort-summary(root.local_sort_column_text, root.local_sort_ascending);
                    local-item-count: root.local_item_count;
                    local-dir-count: root.local_dir_count;
                    local-selected-count: root.local_selected_count;
                    local-empty-text: root.local_empty_text;
                    local-error-text: root.local_error_text;
                    local-retry-visible: root.local_retry_visible;
                    local-collapsed: root.local_collapsed;
                    local-selected-name-text: root.local_selected_name_text;
                    local-selection-key: root.local_selection_key_text;
                    sftp-selection-key: root.sftp_selection_key_text;
                    transfer-rows: root.transfer_rows;
                    transfer-expanded: root.transfer_drawer_expanded;
                    transfer-total-count: root.transfer_total_count;
                    transfer-active-count: root.transfer_active_count;
                    transfer-paused-count: root.transfer_paused_count;
                    transfer-failed-count: root.transfer_failed_count;
                    transfer-completed-count: root.transfer_completed_count;
                    transfer-retryable-count: root.transfer_retryable_count;
                    refresh-sftp() => { root.refresh_sftp(); }
                    up-sftp() => { root.open_sftp_parent(); }
                    home-sftp() => { root.open_sftp_path("/"); }
                    open-sftp-path(path) => { root.open_sftp_path(path); }
                    open-sftp-crumb(index) => { root.open_sftp_crumb(index); }
                    sort-sftp(column) => { root.sort_sftp(column); }
                    toggle-sftp-hidden() => { root.toggle_sftp_hidden(); }
                    select-sftp-row(index, ctrl, shift) => { root.select_sftp_row(index, ctrl, shift); }
                    activate-sftp-row(index) => {
                        root.select_sftp_entry(index);
                        root.activate_sftp_entry();
                    }
                    panel-sftp-menu-requested(x, y) => {
                        root.begin_sftp_context_menu("remote-blank", x, y);
                    }
                    sftp-row-menu-requested(index, x, y) => {
                        root.begin_sftp_row_context_menu(index, x, y);
                    }
                    save-sftp-remote-edit() => { root.save_sftp_remote_edit(); }
                    cancel-sftp-remote-edit() => { root.cancel_sftp_remote_edit(); }
                    local-toggle-collapsed() => { root.local_toggle_collapsed(); }
                    local-up() => { root.local_up(); }
                    local-home() => { root.local_home(); }
                    local-refresh() => { root.local_refresh(); }
                    local-open-path(path) => { root.local_open_path(path); }
                    local-sort-by(column) => { root.local_sort_by(column); }
                    local-toggle-hidden() => { root.local_toggle_hidden(); }
                    local-select-row(index, ctrl, shift) => { root.local_select_row(index, ctrl, shift); }
                    local-activate-row(index) => { root.local_activate_row(index); }
                    local-context-menu-requested(index, x, y) => {
                        root.begin_sftp_context_menu("local", x, y);
                    }
                    local-retry() => { root.local_retry(); }
                    transfer-toggle-expanded() => { root.transfer_toggle_expanded(); }
                    transfer-pause(id) => { root.transfer_pause(id); }
                    transfer-resume(id) => { root.transfer_resume(id); }
                    transfer-retry(id) => { root.transfer_retry(id); }
                    transfer-cancel(id) => { root.transfer_cancel(id); }
                    transfer-remove(id) => { root.transfer_remove(id); }
                    transfer-clear-completed() => { root.transfer_clear_completed(); }
                    copy-file-selection() => { root.copy_file_selection(); }
                    cut-file-selection() => { root.cut_file_selection(); }
                    paste-cross-pane() => { root.paste_cross_pane(); }
                    drag-local-transfer(key) => { return root.drag_local_transfer(key); }
                    drag-remote-transfer(key) => { return root.drag_remote_transfer(key); }
                    drop-on-remote-row(index, data, action) => { root.drop_on_remote_row(index, data, action); }
                    drop-on-remote-blank(data, action) => { root.drop_on_remote_blank(data, action); }
                    drop-on-local(data, action) => { root.drop_on_local(data, action); }
            }

            // --- StatusBar（26px）------------------------------------------------
            // 视图见 components/status_bar.slint；文案仍由本文件的 status_display 渲染。
            // N6：右侧日志入口/REC；点击打开与终端右键菜单相同的日志菜单。
            StatusBar {
                message: TextFormats.status-message(root.status_kind_text, root.status_param_1_text, root.status_param_2_text, root.status_text);
                logging-usable: root.has_active_session;
                logging-active: root.logging_active;
                logging-text: TextFormats.logging-status-display(root.logging_active, root.logging_mode_text, root.logging_file_name_text);
                logging-clicked() => {
                    // A23（muse 轮1 中#37）：锚点按弹层实际宽度（logging-menu-width）
                    // 对齐到状态栏右内边距 12px，并夹在窗口内 —— 不再用写死的
                    // `root.width - 250px`（窄窗下会把锚点算到窗口外/贴边）。
                    root.open_context_menu(
                        "logging",
                        max(8px, root.width - root.logging-menu-width - Theme.spacing-12),
                        root.height
                    );
                }
            }
        }
    }

    // --- Menus and context menus (above content, below modal dialogs) --------
    // 5 个一级菜单 + 4 个右键菜单的实例留在窗口层级（内容之后、模态弹窗之前），
    // 与拆分前同样的绘制顺序；菜单模型数组仍在下方，选中动作由 dispatch_* 执行。
    MenuBarPopups {
        open-index: root.open_menu_index;
        anchor-x: root.menu_anchor_x;
        anchor-y: root.menu_anchor_y;
        file-entries: root.file_menu_entries;
        edit-entries: root.edit_menu_entries;
        session-entries: root.session_menu_entries;
        view-entries: root.view_menu_entries;
        help-entries: root.help_menu_entries;
        selected(menu, index) => { root.dispatch_menu(menu, index); }
        dismissed() => {
            root.open_menu_index = -1;
            root.menu-opened-by-hover = false;
            root.restore-focus-after-menu();
        }
    }

    // A3：命令栏 "更多(⋯)" 的溢出菜单（独立于一级菜单；绘制层级与其它 Popup 一致）。
    more_menu_popup := MenuPopup {
        open: root.more_menu_open;
        anchor-x: root.more_menu_x;
        anchor-y: root.more_menu_y;
        panel-width: 210px;
        // 与一级菜单一致：遮罩不盖菜单栏，点一级菜单可直接切换。
        scrim-top: Theme.bar-height-menubar;
        entries: root.overflow_menu_entries;
        selected(index) => { root.dispatch_overflow_menu(index); }
        dismissed() => { root.close_more_menu(); }
    }

    SessionSidebarPopups {
        row-menu-open: root.context_menu_token == "saved-session";
        blank-menu-open: root.context_menu_token == "blank";
        rail-menu-open: root.context_menu_token == "rail";
        anchor-x: root.context_menu_x;
        anchor-y: root.context_menu_y;
        // A27（D12）：按被右键节点类型选择文件夹/会话两套菜单模型（索引与 dispatch 对齐）。
        row-entries: root.saved_tree_menu_kind_text == "folder"
            ? root.saved_folder_context_menu_entries
            : root.saved_session_context_menu_entries;
        blank-entries: root.saved_session_blank_menu_entries;
        rail-entries: root.nav_rail_menu_entries;
        selected(which, index) => { root.dispatch_context_menu(which, index); }
        dismissed() => {
            root.close_context_menus();
            root.restore-focus-after-menu();
        }
    }

    TerminalWorkspacePopups {
        open: root.context_menu_token == "terminal";
        anchor-x: root.context_menu_x;
        anchor-y: root.context_menu_y;
        entries: root.terminal_context_menu_entries;
        selected(index) => { root.dispatch_context_menu(4, index); }
        dismissed() => {
            root.close_context_menus();
            root.restore-focus-after-menu();
        }
    }

    TabBarPopups {
        open: root.context_menu_token == "tab";
        anchor-x: root.context_menu_x;
        anchor-y: root.context_menu_y;
        entries: root.tab_context_menu_entries;
        selected(index) => { root.dispatch_context_menu(6, index); }
        dismissed() => {
            root.close_context_menus();
            root.restore-focus-after-menu();
        }
    }

    // N1：SFTP 行/空白/本地四套上下文菜单（file/dir/multi/blank/local）。
    sftp_context_menu := SftpContextMenu {
        open: root.context_menu_token == "sftp";
        anchor-x: root.context_menu_x;
        anchor-y: root.context_menu_y;
        target-kind: root.sftp_menu_target_kind_text;
        connected: root.sftp_available;
        has-selection: root.sftp_menu_target_kind_text == "local"
            ? root.local_selected_count > 0
            : root.sftp_selected_count > 0;
        clipboard-has-remote: root.clipboard_side_text == "remote";
        clipboard-has-local: root.clipboard_side_text == "local";
        show-hidden: root.sftp_menu_target_kind_text == "local"
            ? root.local_show_hidden
            : root.sftp_show_hidden;
        remote-edit-active: root.sftp_remote_edit_active;
        selected(action) => { root.sftp_menu_action(action); }
        dismissed() => {
            root.close_context_menus();
            root.restore-focus-after-menu();
        }
    }

    // N6：状态栏日志入口的菜单（与终端右键菜单同一组日志动作；索引 0..3）。
    logging_menu_popup := MenuPopup {
        open: root.context_menu_token == "logging";
        anchor-x: root.context_menu_x;
        anchor-y: root.context_menu_y;
        // A23：与 host 的锚点计算共用同一个宽度来源。
        panel-width: root.logging-menu-width;
        entries: root.logging_menu_entries;
        selected(index) => { root.dispatch_context_menu(7, index); }
        dismissed() => {
            root.close_context_menus();
            root.restore-focus-after-menu();
        }
    }

    // N3：面板 ⋯ 菜单（Move to Left/Right、Collapse/Expand、Hide）。
    // 与其它 Popup 一样实例在内容之后、模态弹窗之前。
    panel_menu_popup := PanelMenuPopup {
        open: root.panel_menu_id != "";
        anchor-x: root.panel_menu_x;
        anchor-y: root.panel_menu_y;
        placement: root.panel_menu_id == "" ? PanelPlacement.Hidden
            : root.panel_frame_for(root.panel_menu_id).placement == "left" ? PanelPlacement.Left
            : root.panel_frame_for(root.panel_menu_id).placement == "right" ? PanelPlacement.Right
            : PanelPlacement.Hidden;
        collapsed: root.panel_frame_for(root.panel_menu_id).collapsed;
        selected(action) => { root.dispatch_panel_menu(action); }
        dismissed() => { root.close_panel_menu(); }
    }


    // --- Modal dialogs -------------------------------------------------------
    // L2：每个弹窗内部自带根 FocusScope（打开时聚焦；Esc/遮罩点击 = 该弹窗的
    // Cancel/Close 路径）。各关闭路径在宿主侧调用 `focus-top-dialog()`：嵌套时把
    // 焦点交还给仍然可见的最上层弹窗（Esc 只关最上层），否则还给快捷键 FocusScope。
    about_dialog := AboutDialog {
        open: root.about_dialog_visible;
        version-text: root.app_version_text;
        config-dir-text: root.config_dir;
        close() => {
            root.about_dialog_visible = false;
            root.focus-top-dialog();
        }
    }

    settings_dialog := SettingsDialog {
        open: root.settings_dialog_visible;
        config-dir-text: root.config_dir;
        secret-store-status-text: TextFormats.secret-store-status(root.secret_store_kind_text, root.secret_store_path_text);
        secret-reset-confirmation-text: root.secret_reset_confirmation_text;
        scrollback-lines-text <=> root.settings_scrollback_lines_text;
        scrollback-max-cells-text <=> root.settings_scrollback_max_cells_text;
        terminal-status-text: TextFormats.settings-terminal-status(root.settings_terminal_status_kind_text, root.settings_terminal_status_field_text, root.settings_terminal_status_value_text, root.settings_terminal_status_limit_text);
        close() => {
            root.settings_dialog_visible = false;
            root.focus-top-dialog();
        }
        open-known-hosts() => {
            // L2：Settings 不先关闭自己 —— Known Hosts 以嵌套层打开（Esc 只关最上层），
            // 关闭 Known Hosts 后焦点/界面回到 Settings（见 KnownHostsPage.close）。
            root.open_known_hosts_manager();
        }
        update-secret-reset-confirmation(value) => { root.update_secret_reset_confirmation(value); }
        reset-secrets() => { root.reset_secrets(); }
        update-scrollback-lines(value) => { root.update_settings_scrollback_lines(value); }
        update-scrollback-max-cells(value) => { root.update_settings_scrollback_max_cells(value); }
        reset-terminal-defaults() => { root.reset_settings_terminal_defaults(); }
        save-terminal-settings() => { root.save_settings_terminal(); }
        open-terminal-appearance() => { root.open_terminal_appearance(); }
    }

    // N5：Settings → Terminal Appearance（嵌套在 Settings 之上的独立弹窗；
    // 入口按钮在 Settings 的 Terminal 区，保持 Settings 本体几何不变）。
    terminal_appearance_dialog := TerminalAppearanceDialog {
        open: root.terminal_appearance_dialog_visible;
        color-scheme-text: root.settings_appearance_color_scheme_text;
        schemes: root.settings_appearance_schemes;
        palette-swatches: root.settings_appearance_palette_swatches;
        foreground-text <=> root.settings_appearance_foreground_text;
        background-text <=> root.settings_appearance_background_text;
        cursor-text <=> root.settings_appearance_cursor_text;
        selection-text <=> root.settings_appearance_selection_text;
        font-family-text <=> root.settings_appearance_font_family_text;
        font-size-text <=> root.settings_appearance_font_size_text;
        fallback-fonts-text <=> root.settings_appearance_fallback_fonts_text;
        status-text: root.settings_appearance_status_text;
        preview: root.settings_appearance_preview;
        select-scheme(id) => { root.select_settings_scheme(id); }
        update-color(field, value) => { root.update_settings_appearance_color(field, value); }
        update-font-family(value) => { root.update_settings_appearance_font_family(value); }
        update-font-size(value) => { root.update_settings_appearance_font_size(value); }
        update-fallback-fonts(value) => { root.update_settings_appearance_fallback_fonts(value); }
        browse-font-file() => { root.browse_settings_appearance_font_file(); }
        browse-fallback-font() => { root.browse_settings_appearance_fallback_font(); }
        clear-fallbacks() => { root.clear_settings_appearance_fallbacks(); }
        reset-defaults() => { root.reset_settings_appearance_defaults(); }
        save() => { root.save_settings_appearance(); }
        close() => {
            root.close_terminal_appearance();
            root.focus-top-dialog();
        }
    }

    // N5：Folder Editor（会话树文件夹右键 → Edit Folder Defaults…）。
    folder_editor := FolderEditor {
        open: root.folder_editor_visible;
        folder-name: root.folder_editor_name_text;
        folder-path: root.folder_editor_path_text;
        status-text: root.folder_editor_status_text;
        appearance-fields: root.folder_editor_appearance_fields;
        terminal-fields: root.folder_editor_terminal_fields;
        logging-fields: root.folder_editor_logging_fields;
        close() => {
            root.close_folder_editor();
            root.focus-top-dialog();
        }
        save() => { root.save_folder_editor(); }
        reset-all() => { root.reset_all_folder_editor(); }
        field-set-inherit(key) => { root.folder_editor_field_action(key, "inherit"); }
        field-set-explicit(key) => { root.folder_editor_field_action(key, "explicit"); }
        field-reset(key) => { root.folder_editor_field_action(key, "reset"); }
        field-edited(key, value) => { root.update_folder_editor_field(key, value); }
        field-toggled(key) => { root.toggle_folder_editor_logging(); }
        field-selected(key, index) => {
            if (key == "appearance.color_scheme") { root.folder_editor_select_scheme(index); }
            else if (key == "logging.format") { root.folder_editor_select_log_format(index); }
        }
    }

    delete_dialog := ConfirmDialog {
        open: root.delete_session_dialog_visible;
        // A29（C24）：破坏性确认 → 主按钮用 critical 语义（WS-C 已落地 `destructive`）。
        destructive: true;
        title-text: @tr("Delete Saved Session");
        message-text: @tr("This permanently removes the selected saved session from disk. Type DELETE to confirm.");
        confirmation-token: "DELETE";
        confirmation-placeholder: @tr("Type DELETE");
        confirmation-text <=> root.delete_session_confirmation_text;
        confirm-label: @tr("Delete");
        confirmed() => {
            root.delete_selected_saved_session();
            root.delete_session_dialog_visible = false;
            root.delete_session_confirmation_text = "";
            root.focus-top-dialog();
        }
        canceled() => {
            root.delete_session_dialog_visible = false;
            root.delete_session_confirmation_text = "";
            root.focus-top-dialog();
        }
    }

    quit_dialog := ConfirmDialog {
        open: root.quit_dialog_visible;
        // A29（C24）：破坏性确认（断开所有运行时会话）。
        destructive: true;
        title-text: @tr("Quit YShell");
        message-text: @tr("Quit YShell now? Active runtime sessions will be disconnected.");
        confirm-label: @tr("Quit");
        confirmed() => { root.quit_app(); }
        canceled() => {
            root.quit_dialog_visible = false;
            root.focus-top-dialog();
        }
    }

    // N0：关闭标签确认（单关显示会话名；批量显示数量/活动连接数）。
    // 危险确认复用 ConfirmDialog 的安全语义：无默认键盘确认，Enter 不触发关闭；
    // 取消即 `cancel_close_tabs()`（默认焦点安全按钮，见 E-057）。
    close_tabs_dialog := ConfirmDialog {
        open: root.close_tabs_confirm_visible;
        // A29（C24）：破坏性确认（关闭标签会断开活动连接）。
        destructive: true;
        title-text: TextFormats.close-tabs-confirm-title(root.close_tabs_confirm_single);
        message-text: TextFormats.close-tabs-confirm-message(
            root.close_tabs_confirm_single,
            root.close_tabs_confirm_name_text,
            root.close_tabs_confirm_count,
            root.close_tabs_confirm_active_count
        );
        confirm-label: @tr("Close");
        confirmed() => {
            root.confirm_close_tabs();
            root.focus-top-dialog();
        }
        canceled() => {
            root.cancel_close_tabs();
            root.focus-top-dialog();
        }
    }

    // S1：会话树空白区菜单的 `New Folder…`（在根目录创建，名称一次性传给运行时）。
    new_folder_dialog := NewFolderDialog {
        open: root.new_folder_dialog_visible;
        name-text <=> root.new_root_folder_name_text;
        confirmed(name) => {
            root.create_root_saved_folder(name);
            root.new_folder_dialog_visible = false;
            root.new_root_folder_name_text = "";
            root.focus-top-dialog();
        }
        canceled() => {
            root.new_folder_dialog_visible = false;
            root.new_root_folder_name_text = "";
            root.focus-top-dialog();
        }
    }

    // W5：连接密码弹窗。密码只用于这一次连接尝试（不写密钥库/磁盘）；
    // 空密码由 `connect-enabled` 在 UI 层禁用主按钮，Rust 侧再校验兜底。
    password_dialog := PasswordPromptDialog {
        open: root.password_prompt_visible;
        title-text: root.password_prompt_title_text;
        message-text: root.password_prompt_message_text;
        password-text <=> root.password_prompt_value_text;
        connect-enabled: root.password_prompt_value_text != "";
        cancel() => {
            root.cancel_password_prompt();
            root.focus-top-dialog();
        }
        submit() => { root.submit_password(root.password_prompt_value_text); }
    }

    sftp_dialog := SftpEntryDialog {
        open: root.sftp_dialog_kind != "none";
        kind: root.sftp_dialog_kind;
        selected-name-text: root.sftp_selected_name_text;
        selected-path-text: root.sftp_selected_path_text;
        selected-count: root.sftp_selected_count;
        name-text <=> root.sftp_dialog_name_text;
        permissions-text <=> root.sftp_dialog_permissions_text;
        local-path-text <=> root.sftp_dialog_local_text;
        create-folder(name) => {
            root.create_sftp_folder(name);
            root.sftp_dialog_kind = "none";
            root.focus-top-dialog();
        }
        rename-selected(name) => {
            root.rename_sftp_selected(name);
            root.sftp_dialog_kind = "none";
            root.focus-top-dialog();
        }
        delete-selected() => {
            root.delete_sftp_selection();
            root.sftp_dialog_kind = "none";
            root.focus-top-dialog();
        }
        chmod-selected(permissions) => {
            root.chmod_sftp_selection(permissions);
            root.sftp_dialog_kind = "none";
            root.focus-top-dialog();
        }
        upload-selected(path) => {
            root.upload_local_path_to_remote(path);
            root.sftp_dialog_kind = "none";
            root.focus-top-dialog();
        }
        download-selected(path) => {
            root.download_sftp_selection_to(path);
            root.sftp_dialog_kind = "none";
            root.focus-top-dialog();
        }
        copy-to-selected(path) => {
            root.copy_sftp_selection_to(path);
            root.sftp_dialog_kind = "none";
            root.focus-top-dialog();
        }
        canceled() => {
            root.sftp_dialog_kind = "none";
            root.focus-top-dialog();
        }
    }

    // N1：Ask 策略冲突（Overwrite/Rename/Skip 选择后重跑）。
    sftp_conflict_dialog := SftpConflictDialog {
        open: root.sftp_conflict_visible;
        source-text: root.sftp_conflict_source_text;
        destination-text: root.sftp_conflict_destination_text;
        conflict-count: root.sftp_conflict_count;
        conflict-paths-text: root.sftp_conflict_paths_text;
        resolve(policy) => { root.sftp_conflict_resolve(policy); }
        canceled() => {
            root.sftp_conflict_cancel();
            root.focus-top-dialog();
        }
    }

    // N1：条目属性（Permissions/Modified 窄宽隐藏后的查看入口）。
    sftp_properties_dialog := SftpPropertiesDialog {
        open: root.sftp_properties_visible;
        name-text: root.sftp_properties_name_text;
        path-text: root.sftp_properties_path_text;
        kind-text: root.sftp_properties_kind_text;
        size-text: root.sftp_properties_size_text;
        modified-text: root.sftp_properties_modified_text;
        permissions-text: root.sftp_properties_permissions_text;
        copy-path() => { root.sftp_properties_copy_path(); }
        canceled() => {
            root.sftp_properties_close();
            root.focus-top-dialog();
        }
    }

    session_editor := SessionEditor {
        open: root.editor_modal_visible;
        section: root.editor_section_text;
        target-text: TextFormats.editor-target-display(root.editor_target_editing, root.editor_target_session_id_text);
        folder-text: TextFormats.editor-folder-display(root.editor_folder_known, root.editor_folder_label_text, root.editor_folder_id_text);
        new-folder-name <=> root.new_folder_name_text;
        name-text <=> root.editor_name_text;
        host-text <=> root.editor_host_text;
        port-text <=> root.editor_port_text;
        username-text <=> root.editor_username_text;
        auth-method-text: root.editor_auth_method_text;
        host-key-policy-text: root.editor_host_key_policy_text;
        password-text <=> root.editor_password_text;
        key-path-text <=> root.editor_key_path_text;
        passphrase-text <=> root.editor_passphrase_text;
        auth-test-status-text: TextFormats.editor-auth-test-status(root.editor_auth_test_kind_text, root.editor_auth_test_host_text, root.editor_auth_test_backend_text, root.editor_auth_test_startup_text, root.editor_auth_test_error_text);
        proxy-mode-text: root.editor_proxy_mode_text;
        proxy-protocol-text: root.editor_proxy_protocol_text;
        proxy-host-text <=> root.editor_proxy_host_text;
        proxy-port-text <=> root.editor_proxy_port_text;
        proxy-username-text <=> root.editor_proxy_username_text;
        proxy-password-text <=> root.editor_proxy_password_text;
        proxy-dns-by-proxy: root.editor_proxy_dns_by_proxy;
        proxy-summary-text: TextFormats.proxy-summary-text(root.editor_proxy_summary_kind_text, root.editor_proxy_protocol_text, root.editor_proxy_summary_address_text, root.editor_proxy_summary_user_text, root.editor_proxy_dns_by_proxy);
        tunnel-kind-text: root.editor_tunnel_kind_text;
        tunnel-bind-host-text <=> root.editor_tunnel_bind_host_text;
        tunnel-bind-port-text <=> root.editor_tunnel_bind_port_text;
        tunnel-target-host-text <=> root.editor_tunnel_target_host_text;
        tunnel-target-port-text <=> root.editor_tunnel_target_port_text;
        tunnel-summary-text: TextFormats.editor-tunnel-summary-display(root.editor_tunnel_summary_count, root.editor_tunnel_summary_rows_text);
        logging-enabled-text: root.logging_enabled_text;
        logging-format-text: root.logging_format_text;
        logging-directory-text <=> root.logging_directory_text;
        logging-summary-text: TextFormats.logging-summary-display(root.logging_enabled_text, root.logging_format_text, root.logging_directory_display_text);
        secret-store-status-text: TextFormats.secret-store-status(root.secret_store_kind_text, root.secret_store_path_text);
        secret-reset-confirmation-text <=> root.secret_reset_confirmation_text;
        config-dir-text: root.config_dir;
        close() => {
            root.close_session_editor_modal();
            root.focus-top-dialog();
        }
        select-general() => { root.select_session_editor_general(); }
        select-authentication() => { root.select_session_editor_authentication(); }
        select-terminal() => { root.select_session_editor_terminal(); }
        editor-appearance-fields: root.editor_appearance_fields;
        editor-terminal-fields: root.editor_terminal_fields;
        editor-theme-field-action(key, action) => { root.editor_theme_field_action(key, action); }
        update-editor-theme-field(key, value) => { root.update_editor_theme_field(key, value); }
        editor-select-scheme(index) => { root.editor_select_scheme(index); }
        reset-all-editor-theme() => { root.reset_all_editor_theme(); }
        select-sftp() => { root.select_session_editor_sftp(); }
        select-tunnels() => { root.select_session_editor_tunnels(); }
        select-proxy() => { root.select_session_editor_proxy(); }
        select-logging() => { root.select_session_editor_logging(); }
        select-advanced() => { root.select_session_editor_advanced(); }
        select-appearance() => { root.select_session_editor_appearance(); }
        select-folder-prev() => { root.select_previous_editor_folder(); }
        select-folder-next() => { root.select_next_editor_folder(); }
        update-new-folder-name(value) => { root.update_new_folder_name(value); }
        create-folder() => { root.create_folder_under_editor_target(); }
        update-name(value) => { root.update_editor_name(value); }
        update-host(value) => { root.update_editor_host(value); }
        update-port(value) => { root.update_editor_port(value); }
        update-username(value) => { root.update_editor_username(value); }
        set-auth-method-agent() => { root.set_editor_auth_method_agent(); }
        set-auth-method-password() => { root.set_editor_auth_method_password(); }
        set-auth-method-keyboard-interactive() => { root.set_editor_auth_method_keyboard_interactive(); }
        set-auth-method-private-key() => { root.set_editor_auth_method_private_key(); }
        set-host-key-policy-strict() => { root.set_editor_host_key_policy_strict(); }
        set-host-key-policy-trust-on-first-use() => { root.set_editor_host_key_policy_trust_on_first_use(); }
        set-host-key-policy-accept-any-for-testing() => { root.set_editor_host_key_policy_accept_any_for_testing(); }
        update-password(value) => { root.update_editor_password(value); }
        update-key-path(value) => { root.update_editor_key_path(value); }
        update-passphrase(value) => { root.update_editor_passphrase(value); }
        test-auth() => { root.test_editor_auth(); }
        set-proxy-mode-none() => { root.set_editor_proxy_mode_none(); }
        set-proxy-mode-custom() => { root.set_editor_proxy_mode_custom(); }
        set-proxy-protocol-socks4() => { root.set_editor_proxy_protocol_socks4(); }
        set-proxy-protocol-socks4a() => { root.set_editor_proxy_protocol_socks4a(); }
        set-proxy-protocol-socks5() => { root.set_editor_proxy_protocol_socks5(); }
        set-proxy-protocol-http-connect() => { root.set_editor_proxy_protocol_http_connect(); }
        update-proxy-host(value) => { root.update_editor_proxy_host(value); }
        update-proxy-port(value) => { root.update_editor_proxy_port(value); }
        update-proxy-username(value) => { root.update_editor_proxy_username(value); }
        update-proxy-password(value) => { root.update_editor_proxy_password(value); }
        toggle-proxy-dns-by-proxy() => { root.toggle_editor_proxy_dns_by_proxy(); }
        set-tunnel-kind-local() => { root.set_editor_tunnel_kind_local(); }
        set-tunnel-kind-remote() => { root.set_editor_tunnel_kind_remote(); }
        set-tunnel-kind-dynamic() => { root.set_editor_tunnel_kind_dynamic(); }
        update-tunnel-bind-host(value) => { root.update_editor_tunnel_bind_host(value); }
        update-tunnel-bind-port(value) => { root.update_editor_tunnel_bind_port(value); }
        update-tunnel-target-host(value) => { root.update_editor_tunnel_target_host(value); }
        update-tunnel-target-port(value) => { root.update_editor_tunnel_target_port(value); }
        add-tunnel() => { root.add_editor_tunnel_forward(); }
        clear-tunnels() => { root.clear_editor_tunnels(); }
        toggle-logging-enabled() => { root.toggle_global_logging_enabled(); }
        set-logging-format-raw() => { root.set_global_logging_format_raw(); }
        set-logging-format-sanitized() => { root.set_global_logging_format_sanitized(); }
        update-logging-directory(value) => { root.update_global_logging_directory(value); }
        save-logging-settings() => { root.save_global_logging_settings(); }
        reset-secrets() => { root.reset_secrets(); }
        update-secret-reset-confirmation(value) => { root.update_secret_reset_confirmation(value); }
        save() => { root.save_editor_to_saved_session(); }
        save-connect() => { root.save_editor_and_connect(); }
    }

    known_hosts_page := KnownHostsPage {
        open: root.known_hosts_modal_visible;
        inventory-text: TextFormats.known-hosts-inventory-display(root.known_hosts_inventory_empty, root.known_hosts_inventory_rows_text);
        selection-text: TextFormats.known-hosts-selection(root.known_hosts_selection_kind_text, root.known_hosts_selection_host_text, root.known_hosts_selection_port_text, root.known_hosts_selection_index, root.known_hosts_selection_total);
        details-text: root.known_hosts_details_text;
        path-text: root.known_hosts_path_text;
        // A30（D17）：详情拆分字段透传给页面（WS-C 在页面内用 @tr 标签渲染）。
        detail-host-text: root.known_hosts_detail_host_text;
        detail-port-text: root.known_hosts_detail_port_text;
        detail-algorithm-text: root.known_hosts_detail_algorithm_text;
        detail-fingerprint-text: root.known_hosts_detail_fingerprint_text;
        detail-path-text: root.known_hosts_detail_path_text;
        clear-confirmation-text <=> root.known_hosts_clear_confirmation_text;
        close() => {
            root.close_known_hosts_manager();
            root.focus-top-dialog();
        }
        select-prev() => { root.select_previous_known_host(); }
        select-next() => { root.select_next_known_host(); }
        remove-selected() => { root.remove_selected_known_host(); }
        update-clear-confirmation(value) => { root.update_known_hosts_clear_confirmation(value); }
        clear-all() => { root.clear_all_known_hosts(); }
    }

    // N4：私钥管理页（Session > Private Keys…）。
    private_keys_page := PrivateKeysPage {
        open: root.private_keys_modal_visible;
        keys: root.private_keys_rows;
        selected-index <=> root.private_keys_selected_index;
        list-summary-text: root.private_keys_summary_text;
        details-text: root.private_keys_details_text;
        public-key-text: root.private_keys_public_key_text;
        test-result-text: root.private_keys_test_result_text;
        status-text: root.private_keys_status_text;
        remove-confirm-visible <=> root.private_keys_remove_confirm_visible;
        deploy-confirm-visible <=> root.private_keys_deploy_confirm_visible;
        deploy-command-text: root.private_keys_deploy_command_text;
        deploy-summary-text: root.private_keys_deploy_summary_text;
        remove-warning-text: root.private_keys_remove_warning_text;
        import-label-text <=> root.private_keys_import_label_text;
        import-path-text <=> root.private_keys_import_path_text;
        import-passphrase-text <=> root.private_keys_import_passphrase_text;
        remember-import-passphrase <=> root.private_keys_remember_import_passphrase;
        import-enabled: root.private_keys_import_enabled;
        passphrase-text <=> root.private_keys_passphrase_text;
        passphrase-stored: root.private_keys_passphrase_stored;
        passphrase-manage-enabled: root.private_keys_passphrase_manage_enabled;
        close() => {
            root.close_private_keys_manager();
            root.focus-top-dialog();
        }
        select-key(index) => { root.select_private_key(index); }
        import-key() => { root.import_private_key(); }
        browse-import-file() => { root.browse_private_key_file(); }
        update-import-label(value) => { root.update_private_key_import_label(value); }
        update-import-path(value) => { root.update_private_key_import_path(value); }
        update-import-passphrase(value) => { root.update_private_key_import_passphrase(value); }
        toggle-remember-import-passphrase(checked) => {
            root.toggle_private_key_remember_import_passphrase(checked);
        }
        test-key() => { root.test_private_key(); }
        copy-public-key() => { root.copy_private_key_public(); }
        export-public-key() => { root.export_private_key_public(); }
        request-remove() => { root.request_private_key_remove(); }
        confirm-remove() => { root.confirm_private_key_remove(); }
        cancel-remove() => { root.cancel_private_key_remove(); }
        request-deploy() => { root.request_private_key_deploy(); }
        confirm-deploy() => { root.confirm_private_key_deploy(); }
        cancel-deploy() => { root.cancel_private_key_deploy(); }
        update-passphrase(value) => { root.update_private_key_passphrase(value); }
        save-passphrase() => { root.save_private_key_passphrase(); }
        forget-passphrase() => { root.forget_private_key_passphrase(); }
        rename-key(label) => { root.rename_private_key(label); }
    }

    // N4：主机密钥页（Session > Host Keys…；按 host:port 分组 + SHA256 指纹）。
    host_keys_page := HostKeysPage {
        open: root.host_keys_modal_visible;
        groups: root.host_keys_groups;
        selected-group <=> root.host_keys_selected_group;
        selected-entry <=> root.host_keys_selected_entry;
        path-text: root.host_keys_path_text;
        details-text: root.host_keys_details_text;
        // A30（D20）：详情拆分字段透传给页面（与 KnownHostsPage 同款，无 port 字段）。
        detail-host-text: root.host_keys_detail_host_text;
        detail-algorithm-text: root.host_keys_detail_algorithm_text;
        detail-fingerprint-text: root.host_keys_detail_fingerprint_text;
        detail-path-text: root.host_keys_detail_path_text;
        status-text: root.host_keys_status_text;
        import-visible <=> root.host_keys_import_visible;
        import-text <=> root.host_keys_import_text;
        clear-confirmation-text <=> root.host_keys_clear_confirmation_text;
        close() => {
            root.close_host_keys_manager();
            root.focus-top-dialog();
        }
        select-group(index) => { root.select_host_key(index, 0); }
        select-entry(group-index, entry-index) => { root.select_host_key(group-index, entry-index); }
        request-remove() => { root.remove_selected_host_key(); }
        toggle-import() => { root.toggle_host_keys_import(); }
        update-import-text(value) => { root.update_host_keys_import_text(value); }
        import-keys() => { root.import_host_keys(); }
        export-keys() => { root.export_host_keys(); }
        update-clear-confirmation(value) => { root.update_host_keys_clear_confirmation(value); }
        clear-all() => { root.clear_all_host_keys(); }
    }

    // N4：认证弹窗（服务端 AuthMethods/AuthProblemKind 驱动；host key 仍在认证之前）。
    auth_prompt_dialog := AuthPromptDialog {
        open: root.auth_prompt_visible;
        host-text: root.auth_prompt_host_text;
        problem-text: root.auth_prompt_problem_text;
        has-usable-method: root.auth_prompt_has_usable_method;
        selected-method <=> root.auth_prompt_selected_method;
        password-visible: root.auth_prompt_password_visible;
        publickey-visible: root.auth_prompt_publickey_visible;
        keyboard-visible: root.auth_prompt_keyboard_visible;
        submit-enabled: root.auth_prompt_submit_enabled;
        password-text <=> root.auth_prompt_password_text;
        remember-password <=> root.auth_prompt_remember_password;
        key-options: root.auth_prompt_key_options;
        selected-key-index <=> root.auth_prompt_selected_key_index;
        selected-key-label: root.auth_prompt_selected_key_label;
        passphrase-text <=> root.auth_prompt_passphrase_text;
        use-agent <=> root.auth_prompt_use_agent;
        publickey-submit-enabled: root.auth_prompt_publickey_submit_enabled;
        challenge-name: root.auth_prompt_challenge_name;
        challenge-instruction: root.auth_prompt_challenge_instruction;
        challenge-prompts: root.auth_prompt_challenge_prompts;
        challenge-round: root.auth_prompt_challenge_round;
        challenge-round-total: root.auth_prompt_challenge_round_total;
        keyboard-final-round: root.auth_prompt_keyboard_final_round;
        keyboard-submit-enabled: root.auth_prompt_keyboard_submit_enabled;
        cancel() => {
            root.cancel_auth_prompt();
            root.focus-top-dialog();
        }
        select-method(index) => { root.select_auth_prompt_method(index); }
        submit-password() => { root.submit_auth_prompt(); }
        toggle-remember-password(checked) => { root.toggle_auth_prompt_remember_password(checked); }
        select-key(index) => { root.select_auth_prompt_key(index); }
        update-passphrase(value) => { root.update_auth_prompt_passphrase(value); }
        // A31（C31）：密码逐键回传宿主投影，避免未提交的输入与投影脱节。
        update-password(value) => { root.update_auth_prompt_password(value); }
        toggle-use-agent(checked) => { root.toggle_auth_prompt_use_agent(checked); }
        browse-key-file() => { root.browse_auth_prompt_key_file(); }
        update-challenge-answer(index, value) => {
            root.update_auth_prompt_keyboard_answer(index, value);
        }
        submit-keyboard-round() => { root.submit_auth_prompt_keyboard_round(); }
    }

    // 主机密钥确认：与其它模态弹窗同一层，放在最后以保证绘制在最上层
    // （安全确认不应被其它模态遮挡）。属性/回调沿用 main_window 的
    // host_key_prompt_* API，Rust 侧无需改动；`open` 与其它弹窗命名一致。
    host_key_dialog := HostKeyDialog {
        open: root.host_key_prompt_visible;
        prompt-text: root.host_key_prompt_text;
        mode-text: root.host_key_prompt_mode_text;
        // A35：拆分字段透传（Rust 投影 → WS-C 的 HostKeyDialog）。
        target-text: root.host_key_prompt_target_text;
        known-hosts-path-text: root.host_key_prompt_known_hosts_path_text;
        algorithm-text: root.host_key_prompt_algorithm_text;
        fingerprint-text: root.host_key_prompt_fingerprint_text;
        expected-algorithm-text: root.host_key_prompt_expected_algorithm_text;
        expected-fingerprint-text: root.host_key_prompt_expected_fingerprint_text;
        confirmation-text <=> root.host_key_prompt_confirmation_text;
        cancel() => {
            root.cancel_host_key_prompt();
            root.focus-top-dialog();
        }
        trust-once() => {
            root.trust_host_key_once();
            root.focus-top-dialog();
        }
        trust-and-save() => {
            root.trust_host_key_and_save();
            root.focus-top-dialog();
        }
        replace-key() => {
            root.replace_host_key_and_connect();
            root.focus-top-dialog();
        }
        confirmation-edited(value) => { root.update_host_key_replace_confirmation(value); }
        dismissed() => {
            root.cancel_host_key_prompt();
            root.focus-top-dialog();
        }
    }

    // N6：终端日志弹窗（开启表单 / 停止提示）。最后声明 = 交互最上层。
    logging_dialog := LoggingDialog {
        open: root.logging_dialog_visible;
        session-name-text: root.logging_dialog_session_text;
        logging-active: root.logging_active;
        active-path-text: root.logging_path_text;
        directory-text <=> root.logging_dialog_directory_text;
        file-name-text <=> root.logging_dialog_file_name_text;
        file-name-error-text: root.logging_dialog_file_name_error_text;
        file-exists: root.logging_dialog_file_exists;
        path-error-text: root.logging_dialog_path_error_text;
        raw-format <=> root.logging_dialog_raw_format;
        sanitized-format <=> root.logging_dialog_sanitized_format;
        timestamps <=> root.logging_dialog_timestamps;
        include-input <=> root.logging_dialog_include_input;
        input-confirmed <=> root.logging_dialog_input_confirmed;
        overwrite-confirmed <=> root.logging_dialog_overwrite_confirmed;

        browse-requested() => { root.logging_dialog_browse(); }
        directory-changed(text) => { root.logging_dialog_directory_changed(text); }
        file-name-changed(text) => { root.logging_dialog_file_name_changed(text); }
        options-changed(raw, timestamps, include_input, input_confirmed, overwrite_confirmed) => {
            root.logging_dialog_options_changed(raw, timestamps, include_input, input_confirmed, overwrite_confirmed);
        }
        start-requested() => { root.logging_dialog_start(); }
        stop-requested() => { root.logging_dialog_stop(); }
        open-file-requested() => { root.terminal_logging_open_file(); }
        open-folder-requested() => { root.terminal_logging_open_folder(); }
        cancel() => {
            root.logging_dialog_cancel();
            root.focus-top-dialog();
        }
    }
}
