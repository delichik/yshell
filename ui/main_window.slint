    in-out property <string> password_prompt_message_text:
        root.password_prompt_host_text == ""
            ? @tr("Enter the password to continue.")
            : @tr("Enter the password for {0} to connect.", root.password_prompt_host_text);
    // in-out：弹窗内编辑；宿主（Rust）在弹窗关闭后清空，避免残留上一次的密码。
    in-out property <string> password_prompt_value_text: "";

