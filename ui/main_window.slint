    in-out property <string> terminal_search_query_text: "";
    in-out property <string> terminal_search_summary_text: "Find in terminal";
    in-out property <string> sftp_path_text: "/";
    in-out property <string> sftp_listing_text: "Fake backend selected. Switch to native SSH to validate the embedded SSH and SFTP paths.";
    in-out property <string> sftp_local_path_text: "";
    in-out property <string> sftp_remote_target_text: "";
    in-out property <string> sftp_secondary_target_text: "";
    in-out property <string> sftp_permissions_text: "644";
    in-out property <string> sftp_session_status_text: "SFTP session disconnected. Connect a runtime session first.";
    in-out property <string> sftp_remote_edit_text: "No active remote edit session";
    in-out property <[SftpRow]> sftp_rows;
    in-out property <[SftpCrumb]> sftp_crumbs;
    in-out property <int> sftp_selected_index: -1;
    in-out property <string> sftp_sort_text: "Name ↑";
