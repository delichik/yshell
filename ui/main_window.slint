    in-out property <bool> sftp_sort_ascending: true;
    in-out property <bool> sftp_show_hidden: false;
    in-out property <string> sftp_item_summary_text: "";
    // W4 收尾：SFTP 汇总行只投影计数，句子/复数由 SftpPanel 用 @tr 组装。
    in-out property <int> sftp_item_count: 0;
    in-out property <int> sftp_dir_count: 0;
    in-out property <string> sftp_empty_text: "";
    in-out property <string> sftp_selected_name_text: "";
    in-out property <string> sftp_selected_path_text: "";
    in-out property <string> sftp_selected_permissions_text: "";
    in-out property <bool> sftp_remote_edit_active: false;
    // --- N1 Phase 2：本地栏 / 队列抽屉 / 冲突 / 属性 / 剪贴板 -----------------
    in-out property <[LocalRow]> local_rows;
    in-out property <string> local_path_text: "/";
    in-out property <string> local_sort_column_text: "name";
    in-out property <bool> local_sort_ascending: true;
    in-out property <bool> local_show_hidden: false;
    in-out property <int> local_item_count: 0;
    in-out property <int> local_dir_count: 0;
    in-out property <string> local_empty_text: "";
    in-out property <string> local_error_text: "";
    in-out property <bool> local_retry_visible: true;
    in-out property <int> local_selected_count: 0;
    in-out property <bool> local_collapsed: false;
    in-out property <string> local_selected_name_text: "";
    in-out property <string> local_selection_key_text: "";
    in-out property <string> sftp_selection_key_text: "";
    in-out property <[SftpTransferRow]> transfer_rows;
    in-out property <bool> transfer_drawer_expanded: false;
    in-out property <int> transfer_total_count: 0;
    in-out property <int> transfer_active_count: 0;
    in-out property <int> transfer_paused_count: 0;
    in-out property <int> transfer_failed_count: 0;
    in-out property <int> transfer_completed_count: 0;
    in-out property <int> transfer_retryable_count: 0;
    in-out property <bool> sftp_conflict_visible: false;
    in-out property <string> sftp_conflict_source_text: "";
