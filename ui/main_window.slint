import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
// 导出 std-widgets 的色板，供 Rust 在"显式浅色/深色"时同步覆盖（W3 替换 std-widgets 后可移除）
export { Palette } from "std-widgets.slint";
// 终端滚动条数据通道（terminal_view.slint 声明）：Rust 投影写总行数/视口行数、收 scroll-to-line。
// 与 Theme/Palette 一样必须在此再导出，生成的 Rust API 才能访问该 global。
export { TerminalScrollInfo } from "components/terminal_view.slint";
import { MenuEntry } from "components/menu_popup.slint";
import { MenuPopup } from "components/menu_popup.slint";
import { MenuBar, MenuBarPopups } from "components/menu_bar.slint";
import { NewFolderDialog, SessionSidebarPopups } from "components/session_sidebar.slint";
import { TerminalWorkspace, TerminalWorkspacePopups, TabBarPopups, WorkspaceTab } from "components/terminal_workspace.slint";
import { WorkspacePaneLeaf, WorkspaceSplitter } from "components/workspace_pane_model.slint";
import { PanelFrameData, SplitHandleData, ToolDock, TunnelRow } from "components/tool_dock.slint";
import { PanelMenuAction, PanelMenuPopup, PanelPlacement } from "components/panel_frame.slint";
import { StatusBar } from "components/status_bar.slint";
import { SftpConflictDialog, SftpContextMenu, SftpEntryDialog, SftpPanel, SftpPropertiesDialog, SftpTransferRow } from "components/sftp_panel.slint";
import { FileCrumb, FileRow } from "components/file_pane.slint";
import { SessionTreeRow } from "components/session_tree.slint";
import { TextFormats } from "text_formats.slint";
import { ConfirmDialog } from "components/confirm_dialog.slint";
import { PasswordPromptDialog } from "components/password_prompt_dialog.slint";
import { HostKeyDialog } from "components/host_key_dialog.slint";
import { AboutDialog } from "pages/about.slint";
import { SettingsDialog } from "pages/settings.slint";
import { SessionEditor } from "pages/session_editor.slint";
import { KnownHostsPage } from "pages/known_hosts.slint";
import { QuickConnectRow, QuickLinkRow } from "pages/quick_connect.slint";
import { PrivateKeysPage, PrivateKeyRow } from "pages/private_keys.slint";
import { ProxiesPage, ProxyRow, ProxyProfileOption } from "pages/proxies.slint";
import { ThemeManagerPage, ThemeManagerRow } from "pages/theme_manager.slint";
import { HostKeysPage, HostKeyGroup, HostKeyEntry } from "pages/host_keys.slint";
import { AuthPromptDialog, AuthKeyOption, AuthKeyboardPrompt } from "components/auth_prompt_dialog.slint";
import { LoggingDialog } from "components/logging_dialog.slint";
import { FolderEditor, TriStateField } from "pages/folder_editor.slint";

// 一级菜单（MenuTitle/MenuBar 行）已搬到 components/menu_bar.slint；
// NewFolderDialog 已搬到 components/session_sidebar.slint（弹窗实例仍在下方）。

export component MainWindow inherits Window {
    title: "YShell";
    // 阶段 B：自绘标题栏（无系统装饰）。拖动/窗口按钮见 components/menu_bar.slint；
    // 无框时可拖边缩放（winit）。关闭走 close() → on_close_requested（既有确认）。
    // resize-border-width：边沿命中带；过窄时难抓，8px 与常见无框窗一致。
    // WIN-1：Slint/winit 的缩放命中只判断"无框 + 可缩放"，不排除最大化；最大化时
    // 必须把命中带设成 0，否则四边/四角仍会切成 resize 光标并抢走按压事件。
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 8px;
    // WIN-2/WIN-3：Windows 下标题栏拖动改走 Win32 原生移动循环（绕开 winit
    // `drag_window()` 的 dragging 守卫，见 win_chrome::start_native_window_move）。
    // 由 Rust 在窗口创建时按 cfg!(windows) 写入；非 Windows 保持 false，
    // menu_bar.slint 继续使用 WindowMoveArea。
    in-out property <bool> native_title_drag: false;
    callback title_drag_requested();
    // §4.2 / §12：默认 1440×900，最小 880×600
    // （<1120 自动折叠右栏，<960 左导航变 48px 图标条，因此 880×600 是安全下限）
    //
    // 注意：Slint 会把根内容的 layout info.max 作为窗口的 max_inner_size（见
    // i-slint-core `min_max_size_for_layout_constraints`）。若根内容里存在
    // "只有固定宽度子项"的横向布局（例如菜单栏的 5 个固定宽 MenuTitle），
    // 推导出的 max 会是这些宽度之和（有限值），窗口的 max 就会被钉死在这个
    // 值上（表现为拖大窗口被弹回）。因此菜单栏末尾放了一个弹性空白
    // （menu_bar.slint 的菜单栏弹性占位），保证根内容的 max 无界，窗口可自由拉伸。
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 880px;
    min-height: 600px;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-ui;

    // A32（D14）：默认空（Rust 投影在启动时写入；避免闪现英文 "Ready"）。
    in-out property <string> status_text: "";
    in-out property <string> config_dir: "";
    in-out property <string> secret_store_status_text: "Secret store disabled.";
    in-out property <string> secret_reset_confirmation_text: "";
    in-out property <string> editor_folder_text: "Saved Sessions (saved-sessions)";
    in-out property <string> new_folder_name_text: "";
    in-out property <string> editor_name_text: "";
    in-out property <string> editor_host_text: "";
    in-out property <string> editor_port_text: "22";
    in-out property <string> editor_username_text: "";
    in-out property <string> editor_auth_method_text: "agent";
    in-out property <string> editor_password_text: "";
    // SSH-1：Key 认证从托管密钥清单选择（label + 算法/指纹），旧 path 只读标记 legacy。
    in-out property <[AuthKeyOption]> editor_key_options: [];
    in-out property <int> editor_selected_key_index: -1;
    in-out property <bool> editor_selected_key_missing: false;
    in-out property <string> editor_legacy_key_path_text: "";
    in-out property <bool> editor_legacy_key_has_passphrase: false;
    in-out property <bool> editor_has_stored_password: false;
    in-out property <string> editor_target_text: "Creating new saved session";
    in-out property <bool> editor_modal_visible: false;
    in-out property <bool> editor_discard_dialog_visible: false;
    in-out property <bool> editor_is_dirty: false;
    in-out property <string> editor_section_text: "general";
    in-out property <string> editor_auth_test_status_text: "Run Auth Test to validate the current editor fields without saving.";
    in-out property <bool> known_hosts_modal_visible: false;
    in-out property <string> known_hosts_inventory_text: "No persisted known hosts yet.";
    in-out property <string> known_hosts_selection_text: "No persisted known hosts are available.";
    in-out property <string> known_hosts_details_text: "";
    in-out property <string> known_hosts_path_text: "";
    in-out property <string> known_hosts_clear_confirmation_text: "";
    // A30（D17）：主机详情字段拆分（Rust 投影；页面用 @tr 标签渲染，替代英文拼接串）。
    in-out property <string> known_hosts_detail_host_text: "";
    in-out property <string> known_hosts_detail_port_text: "";
    in-out property <string> known_hosts_detail_algorithm_text: "";
    in-out property <string> known_hosts_detail_fingerprint_text: "";
    in-out property <string> known_hosts_detail_path_text: "";
    // --- N4：私钥管理页 -----------------------------------------------------
    in-out property <bool> private_keys_modal_visible: false;
    in-out property <[PrivateKeyRow]> private_keys_rows: [];
    in-out property <int> private_keys_selected_index: -1;
    in-out property <string> private_keys_summary_text: "";
    in-out property <string> private_keys_details_text: "";
    in-out property <string> private_keys_public_key_text: "";
    in-out property <string> private_keys_test_result_text: "";
    in-out property <string> private_keys_status_text: "";
    /// I18N-1：私钥页内联状态的 kind/参数；页面用 `TextFormats.status-message` 渲染，
    /// `private_keys_status_text` 保留为英文回退。
    in-out property <string> private_keys_status_kind_text: "";
    in-out property <string> private_keys_status_param_1_text: "";
    in-out property <string> private_keys_status_param_2_text: "";
    in-out property <bool> private_keys_remove_confirm_visible: false;
    in-out property <bool> private_keys_deploy_confirm_visible: false;
    in-out property <string> private_keys_deploy_command_text: "";
    in-out property <string> private_keys_deploy_summary_text: "";
    in-out property <string> private_keys_remove_warning_text: "";
    in-out property <string> private_keys_import_label_text: "";
    in-out property <string> private_keys_import_path_text: "";
    in-out property <string> private_keys_import_passphrase_text: "";
    in-out property <bool> private_keys_remember_import_passphrase: false;
    in-out property <bool> private_keys_import_enabled: false;
    in-out property <string> private_keys_passphrase_text: "";
    in-out property <bool> private_keys_passphrase_stored: false;
    in-out property <bool> private_keys_passphrase_manage_enabled: false;
    // --- NET-1：代理管理器页 -------------------------------------------------
    in-out property <bool> proxies_modal_visible: false;
    in-out property <[ProxyRow]> proxies_rows: [];
    in-out property <int> proxies_selected_index: -1;
    in-out property <string> proxies_summary_text: "";
    in-out property <string> proxies_status_text: "";
    /// I18N-1：代理页内联状态的 kind/参数（英文 `proxies_status_text` 为回退）。
    in-out property <string> proxies_status_kind_text: "";
    in-out property <string> proxies_status_param_1_text: "";
    in-out property <string> proxies_status_param_2_text: "";
    in-out property <string> proxies_test_result_text: "";
    in-out property <bool> proxies_remove_confirm_visible: false;
    in-out property <bool> proxies_remove_blocked: false;
    in-out property <string> proxies_referencing_text: "";
    in-out property <bool> proxies_editor_is_new: true;
    in-out property <string> proxies_editor_id_text: "";
    in-out property <string> proxies_editor_name_text: "";
    in-out property <int> proxies_editor_protocol_index: 2;
    in-out property <string> proxies_editor_host_text: "";
    in-out property <string> proxies_editor_port_text: "";
    in-out property <string> proxies_editor_username_text: "";
    in-out property <string> proxies_editor_password_text: "";
    in-out property <bool> proxies_editor_dns_by_proxy: true;
    in-out property <bool> proxies_editor_password_stored: false;
    in-out property <bool> proxies_editor_save_enabled: false;
    in-out property <bool> proxies_test_in_flight: false;
    // --- N4：主机密钥页 -----------------------------------------------------
    in-out property <bool> host_keys_modal_visible: false;
    in-out property <[HostKeyGroup]> host_keys_groups: [];
    in-out property <int> host_keys_selected_group: -1;
    in-out property <int> host_keys_selected_entry: -1;
    in-out property <string> host_keys_details_text: "";
    in-out property <string> host_keys_path_text: "";
    in-out property <string> host_keys_status_text: "";
    /// I18N-1：主机密钥页内联状态的 kind/参数（英文 `host_keys_status_text` 为回退）。
    in-out property <string> host_keys_status_kind_text: "";
    in-out property <string> host_keys_status_param_1_text: "";
    in-out property <string> host_keys_status_param_2_text: "";
    in-out property <bool> host_keys_import_visible: false;
    in-out property <string> host_keys_import_text: "";
    in-out property <int> host_keys_key_count: 0;
    // Host Keys 破坏性确认（ConfirmDialog；无 CLEAR 令牌）。
    in-out property <bool> host_keys_clear_dialog_visible: false;
    in-out property <bool> host_keys_remove_dialog_visible: false;
    // A30（D20）：主机密钥详情字段拆分（Rust 投影；页面用 @tr 标签渲染）。
    in-out property <string> host_keys_detail_host_text: "";
    in-out property <string> host_keys_detail_algorithm_text: "";
    in-out property <string> host_keys_detail_fingerprint_text: "";
    in-out property <string> host_keys_detail_path_text: "";
    // --- N4：认证弹窗（服务端能力驱动）--------------------------------------
    in-out property <bool> auth_prompt_visible: false;
    in-out property <string> auth_prompt_host_text: "";
    in-out property <string> auth_prompt_problem_text: "";
    in-out property <bool> auth_prompt_has_usable_method: true;
    in-out property <int> auth_prompt_selected_method: 0;
    in-out property <bool> auth_prompt_password_visible: true;
    in-out property <bool> auth_prompt_publickey_visible: true;
    in-out property <bool> auth_prompt_keyboard_visible: true;
    in-out property <bool> auth_prompt_submit_enabled: false;
    in-out property <string> auth_prompt_password_text: "";
    in-out property <bool> auth_prompt_remember_password: false;
    in-out property <[AuthKeyOption]> auth_prompt_key_options: [];
    in-out property <int> auth_prompt_selected_key_index: -1;
    in-out property <string> auth_prompt_selected_key_label: "";
    in-out property <string> auth_prompt_passphrase_text: "";
    in-out property <bool> auth_prompt_use_agent: false;
    in-out property <bool> auth_prompt_publickey_submit_enabled: false;
    in-out property <string> auth_prompt_challenge_name: "";
    in-out property <string> auth_prompt_challenge_instruction: "";
    in-out property <[AuthKeyboardPrompt]> auth_prompt_challenge_prompts: [];
    in-out property <int> auth_prompt_challenge_round: 0;
    in-out property <int> auth_prompt_challenge_round_total: 0;
    in-out property <bool> auth_prompt_keyboard_final_round: false;
    in-out property <bool> auth_prompt_keyboard_submit_enabled: false;
    in-out property <string> editor_proxy_mode_text: "none";
    // NET-1：托管代理下拉 + legacy 只读摘要。
    in-out property <[ProxyProfileOption]> editor_proxy_options: [];
    in-out property <int> editor_selected_proxy_index: -1;
    in-out property <string> editor_proxy_selected_detail_text: "";
    in-out property <string> editor_proxy_legacy_text: "";
    in-out property <bool> editor_proxy_selected_missing: false;
    in-out property <string> editor_tunnel_kind_text: "local";
    in-out property <string> editor_tunnel_bind_host_text: "127.0.0.1";
    in-out property <string> editor_tunnel_bind_port_text: "";
    in-out property <string> editor_tunnel_target_host_text: "";
    in-out property <string> editor_tunnel_target_port_text: "";
    in-out property <string> editor_tunnel_summary_text: "No tunnel forwards configured.";
    in-out property <string> logging_enabled_text: "disabled";
    in-out property <string> logging_format_text: "sanitized";
    in-out property <string> logging_directory_text: "";
    in-out property <string> logging_summary_text: "global=disabled format=sanitized directory=logs";
    in-out property <string> settings_scrollback_lines_text: "10000";
    in-out property <string> settings_language_text: "system";
    in-out property <bool> settings_debug_logging_enabled: false;
    in-out property <string> settings_debug_log_dir_text: "";
    in-out property <string> settings_scrollback_max_cells_text: "2000000";
    /// 设置页「SFTP」分区：最大并行传输数。
    in-out property <string> settings_sftp_max_parallel_transfers_text: "4";
    in-out property <string> settings_terminal_status_text: "Save terminal settings to apply the scrollback limits to existing sessions.";
    in-out property <string> active_session: "Welcome";
    in-out property <string> session_summary_text: "No runtime sessions yet.";
    in-out property <string> session_search_text: "";
    in-out property <string> saved_session_selection_text: "No saved session selected";
    in-out property <string> saved_session_inventory_text: "No saved sessions yet.";
    in-out property <string> recent_sessions_text: "No recent runtime sessions yet.";
    in-out property <bool> host_key_prompt_visible: false;
    in-out property <string> host_key_prompt_text: "";
    in-out property <string> host_key_prompt_mode_text: "";
    // A35：主机密钥弹窗的拆分字段（WS-D 投影 → WS-C 的 HostKeyDialog 渲染）。
    // 全部 `in-out`（与既有 host_key_prompt_* 一致），Rust 未投影时保持空串，
    // 弹窗回退到上面的一体化 `host_key_prompt_text`。
    in-out property <string> host_key_prompt_target_text: "";
    in-out property <string> host_key_prompt_known_hosts_path_text: "";
    in-out property <string> host_key_prompt_algorithm_text: "";
    in-out property <string> host_key_prompt_fingerprint_text: "";
    in-out property <string> host_key_prompt_expected_algorithm_text: "";
    in-out property <string> host_key_prompt_expected_fingerprint_text: "";
    in-out property <string> tab_text: "Welcome  idle";
    in-out property <string> terminal_title_text: "YShell terminal";
    in-out property <string> terminal_body_text: "Runtime is ready. Open a Quick Connect target or create a local terminal tab with +.";
    in-out property <[string]> terminal_visible_lines: ["Runtime is ready. Open a Quick Connect target or create a local terminal tab with +."];
    in-out property <image> terminal_image;
    /// WP4：非聚焦 pane 终端位图。
    in-out property <image> terminal_image_secondary;
    in-out property <int> terminal_cursor_column: 0;
    in-out property <int> terminal_cursor_row: 0;
    in-out property <int> terminal_viewport_columns: 0;
    in-out property <int> terminal_viewport_rows: 0;
    in-out property <int> terminal_scroll_offset: 0;
    in-out property <bool> terminal_selection_active: false;
    // W5-A3：终端 Edit 菜单（Copy/清屏等）的状态开关；与上者同源。
    in-out property <bool> terminal_has_selection: false;
    // WP2：Clear Scrollback / Select·Copy Screen 启用条件。
    in-out property <bool> terminal_has_scrollback: false;
    in-out property <bool> terminal_has_screen_content: false;
    in-out property <string> terminal_search_query_text: "";
    in-out property <bool> terminal_search_regex: false;
    in-out property <string> terminal_search_error_text: "";
    in-out property <string> terminal_search_summary_text: "Find in terminal";
    // WP2：Clear Scrollback 简单确认（无 Type-token）。
    in-out property <bool> clear_scrollback_dialog_visible: false;
    in-out property <string> sftp_path_text: "/";
    /// `new` / `terminal` / `sftp` — active workspace tab mode.
    in-out property <string> active_tab_mode_text: "new";
    /// Per-SFTP-tab local/remote split ratio (default 1:1).
    in-out property <float> sftp_column_ratio: 0.5;
    in-out property <string> sftp_listing_text: "Connect a session and refresh SFTP to browse remote files.";
    in-out property <string> sftp_local_path_text: "";
    in-out property <string> sftp_remote_target_text: "";
    in-out property <string> sftp_secondary_target_text: "";
