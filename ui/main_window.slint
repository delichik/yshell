    // --- W5-A2：全局快捷键 ---------------------------------------------------
    // 组合键字符串只在这里定义一次：菜单项的 `MenuEntry.shortcut` 显示文本与按键处理
    // （`dispatch-global-shortcut`）引用同一份常量。快捷键显示文本按惯例不翻译。
    property <string> shortcut-new-session: "Ctrl+N";
    property <string> shortcut-quick-connect: "Ctrl+O";
    property <string> shortcut-save-session: "Ctrl+S";
    property <string> shortcut-find: "Ctrl+F";
    property <string> shortcut-clear-terminal: "Ctrl+K";
    property <string> shortcut-toggle-sidebar: "Ctrl+B";
    property <string> shortcut-quit: "Ctrl+Q";
    property <string> shortcut-reconnect: "F5";
    property <string> shortcut-settings: "Ctrl+,";
    // 终端里已实现的复制/粘贴组合键（由 bootstrap.rs 的终端按键处理分发）。
    property <string> shortcut-copy: "Ctrl+Shift+C";
    property <string> shortcut-paste: "Ctrl+V";

    // F5 在 Slint 里是特殊键码（见 i-slint-common `key_codes.rs`）。
    // T0（Slint 1.18.1）核对：`KeyEvent` 仍然只有 text/modifiers/repeat
    //（i-slint-common `builtin_structs.rs`），没有 `key` 字段，因此特殊键继续按
    // `event.text` 的私有区键码比较。
    property <string> key-code-f5: "\u{F708}";

    // 模态弹窗打开时全局快捷键让位给弹窗（弹窗内输入框自行处理按键）。
    property <bool> global-shortcuts-blocked:
        root.editor_modal_visible
        || root.settings_dialog_visible
        || root.about_dialog_visible
        || root.known_hosts_modal_visible
        || root.password_prompt_visible
        || root.host_key_prompt_visible
        || root.quit_dialog_visible
        || root.delete_session_dialog_visible
        || root.sftp_dialog_kind != "none"
        || root.private_keys_modal_visible
        || root.host_keys_modal_visible
        || root.auth_prompt_visible
        // N5 的两个嵌套弹窗（WS-A 补齐让位条件；与 `focus-top-dialog` 一致）
        || root.terminal_appearance_dialog_visible
        || root.folder_editor_visible;

    /// L2：是否有任一模态弹窗可见（焦点恢复/让位用；比 `global-shortcuts-blocked`
    /// 更完整，含 NewFolderDialog 与关闭标签确认）。
    property <bool> any_modal_visible:
        root.editor_modal_visible
        || root.settings_dialog_visible
        || root.about_dialog_visible
        || root.known_hosts_modal_visible
        || root.password_prompt_visible
        || root.host_key_prompt_visible
        || root.quit_dialog_visible
        || root.delete_session_dialog_visible
        || root.new_folder_dialog_visible
        || root.close_tabs_confirm_visible
        || root.sftp_dialog_kind != "none"
        || root.private_keys_modal_visible
        || root.host_keys_modal_visible
        || root.auth_prompt_visible
        // N5：终端外观 / Folder Editor（焦点恢复与 Esc 让位都要看到它们）
        || root.terminal_appearance_dialog_visible
        || root.folder_editor_visible;

    /// W5-A2 / N2：Ctrl+O、Ctrl+L 与 File > Quick Connect —— 打开/激活 QC 页并聚焦输入框。
    public function focus-quick-connect() {
        root.open_quick_connect();
        quick_connect_page.focus-quick-connect();
    }

    // N2：切到 QC 标签（点击标签/Ctrl+O/启动落点）时自动聚焦输入框。
    changed quick_connect_visible => {
        if (root.quick_connect_visible) {
            quick_connect_page.focus-quick-connect();
        }
    }

    // A24：活动会话消失（关闭/切到 QC 标签等）时清掉查找栏状态，
    // 避免它残留并在下一个会话里"莫名弹出"。
    changed has_active_session => {
        if (!root.has_active_session) {
            root.terminal_find_visible = false;
        }
    }

    /// W5-A2：把键盘焦点交给窗口级快捷键 FocusScope。
    /// 启动时由 bootstrap.rs 调用；模态弹窗关闭后再次调用（见 `restore_shortcut_focus_after_modal`）。
    ///
    /// L2：弹窗打开期间不抢焦点 —— 弹窗自己持有焦点（Esc/输入依赖它），并且
    /// "弹窗 A 关闭 → 弹窗 B 打开"发生在同一次投影里时，bootstrap 的恢复路径
    /// 不能把焦点从刚打开的新弹窗抢回快捷键层（宿主用 `focus-top-dialog` 补位）。
    public function focus-global-shortcuts() {
        if (!root.any_modal_visible) {
            shortcut_scope.focus();
        }
    }

    /// W5-A2：CapsLock / Shift 都会把 `event.text` 变成大写，因此每个字母都按
    /// 小写/大写两种写法匹配（Slint 1.18 已有 `to-lowercase()`，此处保持既有实现）。
    function shortcut-key(text: string, lower: string, upper: string) -> bool {
        return text == lower || text == upper;
    }

    /// W5-A2：窗口级快捷键的唯一映射表。
    ///
    /// 返回 `true` 表示组合键已被消费（窗口根 FocusScope 据此 accept，bootstrap.rs 的
    /// 终端按键兜底不再把该键编码成终端输入）；返回 `false` 时按键继续走原本的焦点链路。
    /// 命中的组合即使对应动作当前不可用（例如无活动会话时的 Ctrl+S / F5），也返回
    /// `true`：否则 ^S/^Q 一类控制码会落进 shell，留下 XOFF 之类的终端流控状态。
    /// 注意：终端聚焦时 `Ctrl+L`（shell 清屏）也会命中快速连接，取舍见任务说明。
    public function dispatch-global-shortcut(text: string, ctrl: bool, shift: bool, alt: bool, meta: bool) -> bool {
        if (alt || meta || root.global-shortcuts-blocked) {
            return false;
        }
        if (!ctrl) {
            // F5：重连（与 Session > Reconnect 同一回调与状态门限）
            if (!shift && text == root.key-code-f5) {
                if (root.has_active_session && !root.active_session_connected) {
                    root.reconnect_session();
                }
                return true;
            }
            return false;
        }
        if (shift) {
            // Ctrl+Shift+K：清屏（Ctrl+Shift+C / Ctrl+Shift+V 留给终端复制、粘贴，不拦截）
            if (shortcut-key(text, "k", "K")) {
                if (root.has_active_session) {
                    root.clear_terminal();
                }
                return true;
            }
            return false;
        }
        // Ctrl+N：新建会话（与 File > New Session 同一回调：打开 Session Editor）
        if (shortcut-key(text, "n", "N")) {
            root.start_new_saved_session_editor();
            return true;
        }
        // Ctrl+O / Ctrl+L：聚焦快速连接
        if (shortcut-key(text, "o", "O") || shortcut-key(text, "l", "L")) {
            root.focus-quick-connect();
            return true;
        }
        // Ctrl+S：保存活动会话（与 File > Save Active Session 同一状态门限；
        // 组合键始终消费掉，避免 ^S/^Q 一类的控制码下发给 shell）
        if (shortcut-key(text, "s", "S")) {
            if (root.has_active_session) {
                root.save_session();
            }
            return true;
        }
        // Ctrl+F：终端查找（A24：无活动会话时不置位，避免状态残留到下一个会话）
        if (shortcut-key(text, "f", "F")) {
            if (root.has_active_session) {
                root.terminal_find_visible = true;
            }
            return true;
        }
        // Ctrl+K：清屏（与 Edit > Clear Terminal 同一状态门限）
        if (shortcut-key(text, "k", "K")) {
            if (root.has_active_session) {
                root.clear_terminal();
            }
            return true;
        }
        // Ctrl+B：切换左栏（Sessions 面板显示/隐藏；与 View > Session Manager 同一路径）
        if (shortcut-key(text, "b", "B")) {
            root.toggle_panel("sessions");
            return true;
        }
        // Ctrl+Q：退出（走现有确认弹窗）
        if (shortcut-key(text, "q", "Q")) {
            root.quit_dialog_visible = true;
            return true;
        }
        // Ctrl+,：设置
        if (text == ",") {
            root.settings_dialog_visible = true;
            return true;
        }
        return false;
    }

    // --- Menu models ---------------------------------------------------------
    property <[MenuEntry]> file_menu_entries: [
        { label: @tr("New Session"), shortcut: root.shortcut-new-session, enabled: true, checked: false, separator: false },
        { label: @tr("Quick Connect"), shortcut: root.shortcut-quick-connect, enabled: true, checked: false, separator: false },
        // W5-A3：没有活动会话时无处保存。
        {
            label: @tr("Save Active Session"), shortcut: root.shortcut-save-session,
            enabled: root.has_active_session, checked: false, separator: false,
            // A12：禁用项必须有 tooltip 说明原因（契约 §18）。
            tooltip: root.has_active_session ? "" : @tr("Open a session before saving it.")
        },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Settings..."), shortcut: root.shortcut-settings, enabled: true, checked: false, separator: false },
        { label: @tr("Quit"), shortcut: root.shortcut-quit, enabled: true, checked: false, separator: false }
    ];
    property <[MenuEntry]> edit_menu_entries: [
        // W5-A3：无选区 / 无活动会话时禁用。
        {
            label: @tr("Copy"), shortcut: root.shortcut-copy,
            enabled: root.terminal_has_selection, checked: false, separator: false,
            tooltip: root.terminal_has_selection ? "" : @tr("Select text in the terminal first.")
        },
        { label: @tr("Paste"), shortcut: root.shortcut-paste, enabled: true, checked: false, separator: false },
        {
            label: @tr("Clear Terminal"), shortcut: root.shortcut-clear-terminal,
            enabled: root.has_active_session, checked: false, separator: false,
            tooltip: root.has_active_session ? "" : @tr("Open a session first.")
        },
        // A24：无活动会话时查找不可用（此前 enabled: true 会静默置位查找栏状态）。
        {
            label: @tr("Find..."), shortcut: root.shortcut-find,
            enabled: root.has_active_session, checked: false, separator: false,
            tooltip: root.has_active_session ? "" : @tr("Open a session first.")
        }
    ];
    property <[MenuEntry]> session_menu_entries: [
        // W5-A3：已连接才能断开；有活动会话（且未连接）才能重连。
        {
            label: @tr("Disconnect"), shortcut: "",
            enabled: root.active_session_connected, checked: false, separator: false,
            tooltip: root.active_session_connected ? "" : @tr("The active session is not connected.")
        },
        {
            label: @tr("Reconnect"), shortcut: root.shortcut-reconnect,
            enabled: root.has_active_session && !root.active_session_connected, checked: false, separator: false,
            tooltip: root.has_active_session
                ? @tr("The active session is already connected.")
                : @tr("Open a session first.")
        },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        // W5-A3：Edit / Delete 需要选中的已保存会话；Update 还需要活动会话作为来源。
        {
            label: @tr("Edit Selected Session..."), shortcut: "",
            enabled: root.has_saved_selection, checked: false, separator: false,
            tooltip: root.has_saved_selection ? "" : @tr("Select a saved session first.")
        },
        {
            label: @tr("Update Selected From Active"), shortcut: "",
            enabled: root.has_saved_selection && root.has_active_session, checked: false, separator: false,
            tooltip: root.has_saved_selection
                ? @tr("Open the active session first.")
                : @tr("Select a saved session first.")
        },
        {
            label: @tr("Delete Selected Session..."), shortcut: "",
            enabled: root.has_saved_selection, checked: false, separator: false,
            tooltip: root.has_saved_selection ? "" : @tr("Select a saved session first.")
        },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        // N4：两个同级、独立入口（私钥页 / 主机密钥页）。
        { label: @tr("Host Keys..."), shortcut: "", enabled: true, checked: false, separator: false },
        { label: @tr("Private Keys..."), shortcut: "", enabled: true, checked: false, separator: false }
    ];
    property <[MenuEntry]> view_menu_entries: [
        { label: @tr("Session Manager"), shortcut: root.shortcut-toggle-sidebar, enabled: true, checked: root.sessions_visible, separator: false },
        { label: @tr("SFTP Panel"), shortcut: "", enabled: true, checked: root.sftp_visible, separator: false },
        { label: @tr("Tunnels"), shortcut: "", enabled: true, checked: root.tunnels_visible, separator: false },
        { label: @tr("Quick Commands"), shortcut: "", enabled: true, checked: root.commands_visible, separator: false },
        { label: @tr("Transfers"), shortcut: "", enabled: true, checked: root.transfers_visible, separator: false }
    ];
    property <[MenuEntry]> help_menu_entries: [
        { label: @tr("About YShell"), shortcut: "", enabled: true, checked: false, separator: false }
    ];
    // --- A3：命令栏 "更多(⋯)" 的独立溢出菜单 ---------------------------------
    // B 轮2 #39 / 轮3 #12：此前 `open-more-menu` 直接设 `open_menu_index = 4`，
    // 点"更多"打开的是帮助菜单、并把菜单栏的"帮助"点亮。这里改为独立模型 +
    // 独立 popup（`more_menu_*`），与一级菜单完全解耦。
    // 内容按 §5.7："次级操作溢出进 ⋯"（不重复命令栏已有按钮的动作）。
    property <[MenuEntry]> overflow_menu_entries: [
        { label: @tr("About YShell"), shortcut: "", enabled: true, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Settings..."), shortcut: root.shortcut-settings, enabled: true, checked: false, separator: false },
        { label: "", shortcut: "", enabled: false, checked: false, separator: true },
        { label: @tr("Quit"), shortcut: root.shortcut-quit, enabled: true, checked: false, separator: false }
    ];
    property <[MenuEntry]> terminal_context_menu_entries: [
        // W5-A3：无选区时 Copy 禁用（其余项需要活动会话）。
        {
            label: @tr("Copy"), shortcut: root.shortcut-copy,
            enabled: root.terminal_has_selection, checked: false, separator: false,
            tooltip: root.terminal_has_selection ? "" : @tr("Select text in the terminal first.")
        },
        { label: @tr("Paste"), shortcut: root.shortcut-paste, enabled: true, checked: false, separator: false },
        {
            label: @tr("Select All"), shortcut: "",
