        if kind == "proxies-duplicate-failed" {
            return @tr("MainWindow" => "Duplicate failed: {0}", param_1);
        }
        if kind == "proxies-editor-discarded" {
            return @tr("MainWindow" => "Discarded proxy editor changes.");
        }
        if kind == "proxies-save-failed" {
            return @tr("MainWindow" => "Cannot save proxy profile: {0}", param_1);
        }
        if kind == "proxies-remove-requires-selection" {
            return @tr("MainWindow" => "Select a proxy profile to delete.");
        }
        if kind == "proxies-delete-failed" {
            return @tr("MainWindow" => "Delete failed: {0}", param_1);
        }
        if kind == "proxies-clear-from-sessions-failed" {
            return @tr("MainWindow" => "Cannot update saved sessions: {0}", param_1);
        }
        if kind == "proxies-test-in-progress" {
            return @tr("MainWindow" => "A proxy test is already running.");
        }
        if kind == "proxies-test-requires-selection" {
            return @tr("MainWindow" => "Select a proxy profile to test.");
        }
        if kind == "proxies-test-config-failed" {
            return @tr("MainWindow" => "Test failed before connecting: {0}", param_1);
        }
        if kind == "proxies-test-worker-unavailable" {
            return @tr("MainWindow" => "Test is unavailable: the proxy-test worker was not started.");
        }
        if kind == "proxies-test-spawn-failed" {
            return @tr("MainWindow" => "Test could not start its worker thread: {0}", param_1);
        }
        if kind == "proxies-testing" {
            return @tr("MainWindow" => "Testing {0} at {1}…", param_1, param_2);
        }
        if kind == "proxies-test-passed" {
            return @tr("MainWindow" => "Test passed: {0} answered from {1}.", param_1, param_2);
        }
        if kind == "proxies-test-failed" {
            return @tr("MainWindow" => "Test failed: {0}", param_1);
        }
        // --- I18N-1：Folder Editor 内联状态 --------------------------------------
        if kind == "folder-defaults-editing" {
            return @tr("MainWindow" => "Editing defaults for `{0}`. Changes apply to terminals opened afterwards.", param_1);
        }
        if kind == "folder-defaults-reset" {
            return @tr("MainWindow" => "Cleared every override for this folder; Save persists the reset.");
        }
        if kind == "folder-defaults-unknown-scheme" {
            return @tr("MainWindow" => "Unknown color scheme id `{0}`.", param_1);
        }
        if kind == "folder-defaults-not-number" {
            return @tr("MainWindow" => "{0} must be a whole number.", theme-field-name(param_1));
        }
        if kind == "folder-defaults-out-of-range" {
            return @tr("MainWindow" => "{0} must be between {1}.", theme-field-name(param_1), param_2);
        }
        if kind == "folder-defaults-invalid-field" {
            return @tr("MainWindow" => "{0}: {1}", theme-field-name(param_1), param_2);
        }
        if kind == "folder-defaults-logging-toggle-invalid" {
            return @tr("MainWindow" => "Session logging: `{0}` is not `on` or `off`.", param_1);
        }
        if kind == "folder-defaults-logging-format-invalid" {
            return @tr("MainWindow" => "Format: format must be `raw` or `sanitized`.");
        }
        if kind == "folder-defaults-saved-detail" {
            return @tr("MainWindow" => "Saved folder defaults for `{0}`. New terminals use them; open terminals keep their theme.", param_1);
        }
        // --- I18N-1：宿主（bootstrap）直写状态 -----------------------------------
        if kind == "appearance-font-picker-unavailable" {
            return @tr("MainWindow" => "No display server was found; type the font file path instead.");
        }
        if kind == "appearance-fallback-font-picker-unavailable" {
            return @tr("MainWindow" => "No display server was found; type the fallback font file path instead.");
        }
        if kind == "sftp-copied-paths" {
            return @tr("MainWindow" => "Copied {n} path." | "Copied {n} paths." % round(param_1.to-float()), round(param_1.to-float()));
        }
        if kind == "local-copied-paths" {
            return @tr("MainWindow" => "Copied local path(s).");
        }
        if kind == "sftp-copied-path" {
            return @tr("MainWindow" => "Copied `{0}`.", param_1);
        }
        if kind == "sftp-unknown-menu-action" {
            return @tr("MainWindow" => "Unknown SFTP menu action `{0}`.", param_1);
        }
        return fallback;
    }

    /// 状态栏模板入口：Rust 只传稳定 kind/参数；未覆盖的 kind 回退英文 status_text。
    public pure function status-message(kind: string, param_1: string, param_2: string, fallback: string) -> string {
        return status-message-core(kind, param_1, param_2, status-message-tabs(kind, param_1, param_2, status-message-sftp(kind, param_1, param_2, status-message-transfer(kind, param_1, param_2, status-message-terminal(kind, param_1, param_2, status-message-sessions(kind, param_1, param_2, status-message-managers(kind, param_1, param_2, fallback)))))));
    }

    // --- N0：标签关闭确认弹窗文案 -------------------------------------------
    public pure function close-tabs-confirm-title(single: bool) -> string {
        return single
            ? @tr("MainWindow" => "Close Session")
            : @tr("MainWindow" => "Close Tabs");
    }

    public pure function close-tabs-confirm-message(single: bool, name: string, count: int, active_count: int) -> string {
        if (single) {
            return @tr("MainWindow" => "Close `{0}`? Its active connection will be disconnected.", name);
        }
        return @tr("MainWindow" => "Close {n} tab" | "Close {n} tabs" % count, count)
            + "  "
            + (@tr("MainWindow" => "{n} of them has an active connection and will be disconnected." | "{n} of them have active connections and will be disconnected." % active_count, active_count));
    }

    // --- N5：三态字段的来源提示 -----------------------------------------------
    /// `kind` 由 Rust 投影：builtin / global / folder / local-folder /
    /// local-session / scheme。`param` 是文件夹名或方案名（其余为空）。
    public pure function theme-source-display(kind: string, param: string) -> string {
        if kind == "builtin" {
            return @tr("MainWindow" => "Built-in default");
        }
        if kind == "global" {
            return @tr("MainWindow" => "From global settings");
        }
        if kind == "folder" {
            return @tr("MainWindow" => "From folder: {0}", param);
        }
        if kind == "scheme" {
            return @tr("MainWindow" => "From color scheme: {0}", param);
        }
        if kind == "local-folder" {
            return @tr("MainWindow" => "Set in this folder");
        }
        if kind == "local-session" {
            return @tr("MainWindow" => "Set for this session");
        }
        return "";
    }

    /// N5：三态字段的标签（按稳定 key 渲染，Folder/Session Editor 复用）。
    public pure function theme-field-label(key: string) -> string {
        if key == "appearance.color_scheme" { return @tr("MainWindow" => "Color scheme"); }
        if key == "appearance.foreground" { return @tr("MainWindow" => "Foreground"); }
        if key == "appearance.background" { return @tr("MainWindow" => "Background"); }
        if key == "appearance.cursor" { return @tr("MainWindow" => "Cursor"); }
        if key == "appearance.selection" { return @tr("MainWindow" => "Selection"); }
        if key == "appearance.font_family" { return @tr("MainWindow" => "Font family"); }
        if key == "appearance.font_size" { return @tr("MainWindow" => "Font size"); }
        if key == "appearance.backup_font" { return @tr("MainWindow" => "Fallback font"); }
        if key == "terminal.scrollback_lines" { return @tr("MainWindow" => "Scrollback lines"); }
        if key == "terminal.scrollback_max_cells" { return @tr("MainWindow" => "Scrollback memory cap"); }
        if key == "logging.enabled" { return @tr("MainWindow" => "Session logging"); }
        if key == "logging.format" { return @tr("MainWindow" => "Format"); }
        if key == "logging.directory" { return @tr("MainWindow" => "Directory"); }
        return "";
    }

    /// I18N-1：状态行里的字段名（未知 key 回退原始 key，避免丢技术细节）。
    public pure function theme-field-name(key: string) -> string {
        return theme-field-label(key) == "" ? key : theme-field-label(key);
    }

    /// N5：三态字段下方的说明（按稳定 key 渲染）。
    public pure function theme-field-hint(key: string) -> string {
        if key == "appearance.color_scheme" { return @tr("MainWindow" => "Built-in palette"); }
        if key == "appearance.foreground"
            || key == "appearance.background"
            || key == "appearance.cursor"
            || key == "appearance.selection" {
            return @tr("MainWindow" => "Hex color");
        }
        if key == "appearance.font_family" { return @tr("MainWindow" => "Bundled DejaVu or an imported file"); }
        if key == "appearance.font_size" { return @tr("MainWindow" => "Logical pixels"); }
        if key == "appearance.backup_font" { return @tr("MainWindow" => "One font file tried before the bundled CJK face"); }
        if key == "terminal.scrollback_lines" { return @tr("MainWindow" => "Per session"); }
        if key == "terminal.scrollback_max_cells" { return @tr("MainWindow" => "Cells kept per session"); }
        if key == "logging.enabled" { return @tr("MainWindow" => "Write sessions to disk"); }
        if key == "logging.format" { return @tr("MainWindow" => "Raw keeps escape sequences"); }
        if key == "logging.directory" { return @tr("MainWindow" => "Log output directory"); }
        return "";
    }
}
