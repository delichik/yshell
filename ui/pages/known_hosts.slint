import { Theme } from "../theme.slint";
import { Icon } from "../components/basic/icons.slint";
import { WinButton, WinCard, WinCardHeader, WinIconButton, WinScrollIndicator } from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";

// 详情行（等宽 caption；与详情块原有整段文本同一形态）。
// 注意：同一文件内的局部组件必须先声明后使用。
component DetailLine inherits Text {
    in property <string> hint: "";
    text: root.hint;
    color: Theme.text-secondary;
    font-size: Theme.font-caption;
    font-family: Theme.font-mono;
    wrap: word-wrap;
}

// 已知主机管理器：ContentDialog 形态（§5.10）：标题行 → 双栏（清单 / 详情）→ 危险区。
export component KnownHostsPage inherits Rectangle {
    in property <bool> open: false;
    in property <string> inventory-text: "";
    in property <string> selection-text: "";
    in property <string> details-text: "";
    /// WS-D/WS-A 拆分的详情字段（标签在页面内本地化）。全部为空时回退到 `details-text`。
    in property <string> detail-host-text: "";
    in property <string> detail-port-text: "";
    in property <string> detail-algorithm-text: "";
    in property <string> detail-fingerprint-text: "";
    in property <string> detail-path-text: "";
    in property <string> path-text: "";
    in-out property <string> clear-confirmation-text: "";

    callback close();
    callback select-prev();
    callback select-next();
    callback remove-selected();
    callback update-clear-confirmation(string);
    callback clear-all();

    // 详情区：拆分字段可用时逐行渲染（标签本地化）；否则回退整段 `details-text`。
    private property <bool> detail-entry-visible: root.detail-host-text != "";
    private property <bool> detail-split-visible:
        root.detail-entry-visible || root.detail-path-text != "";

    visible: self.open;
    // B 轮3 #32：本弹窗**只**从 Settings 内部打开（`open_known_hosts_manager()` 唯一调用点
    // 在 settings 的「打开已知主机管理器」按钮），此时 Settings 自己的 scrim 已经压暗全窗；
    // 再叠一层会让遮罩明显更深（实测 45→9，其它弹窗 45→21）。这里不再画第二层遮罩，
    // 视觉与其它单层弹窗一致；点击"面板外"仍由 dialog_scope 的全窗 TouchArea 关闭本弹窗。
    // （若将来新增独立入口，需要恢复 `background: Theme.scrim;`。）
    background: transparent;

    // L2（对话框 Esc / 遮罩点击关闭）：根 FocusScope 包住整个弹窗；打开时聚焦，
    // Esc 沿焦点链冒泡到这里 → 与关闭按钮完全相同的 `root.close()` 路径；其余按键 reject。
    dialog_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            // Esc 键码按 `event.text` 比较（与 session_tree 判 Enter 的做法一致）。
            if (event.text == "\u{001b}") {
                root.close();
                return accept;
            }
            return reject;
        }

        // 遮罩：点击 = 关闭（与关闭按钮同一路径）。
        TouchArea {
            clicked => { root.close(); }
        }

        Rectangle {
            x: (parent.width - 760px) / 2;
            y: 52px;
            width: 760px;
            height: parent.height - 104px;
            background: Theme.panel-background;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.control-stroke;
            clip: true;

            // 吞掉面板空白处的点击，避免穿透到遮罩触发取消。
            TouchArea { }

            VerticalLayout {
                padding: Theme.spacing-20;
                spacing: Theme.spacing-12;

                // 标题行：右侧统一关闭按钮
                HorizontalLayout {
                    spacing: Theme.spacing-12;

                    Text {
                        text: @tr("Known Hosts");
                        color: Theme.text-primary;
                        font-size: Theme.font-subtitle;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.selection-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    WinIconButton {
                        icon: "close";
                        accessible-name: @tr("Close");
                        clicked => { root.close(); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    spacing: Theme.spacing-16;

                    // --- 左：持久化条目 -------------------------------------------
                    WinCard {
                        width: 320px;

                        WinCardHeader {
                            title: @tr("Persisted Entries");
                            icon: "globe";
                        }

                        // 清单表面：Rust 侧给出预格式化文本，行首 ">" 标记当前选中项。
                        // 原先是"裁剪的 Text"，条目多时下半部分不可达（E22）→ 改为可滚动 + 指示条。
                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;
                            background: Theme.panel-background;
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: Theme.divider;

                            inventory-scroll := Flickable {
                                width: parent.width;
                                height: parent.height;
                                interactive: true;
                                content-width: self.width;
                                content-height: inventory-text.preferred-height + 2 * Theme.spacing-8;

                                inventory-text := Text {
                                    x: 10px;
                                    y: Theme.spacing-8;
                                    width: inventory-scroll.width - 20px;
                                    text: root.inventory-text;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-family: Theme.font-mono;
                                    wrap: no-wrap;
                                }
                            }

                            // 滚动指示：E22 可复用组件（`content-y` ≤ 0，组件内部取负）
                            WinScrollIndicator {
                                x: parent.width - self.width - Theme.spacing-4;
                                y: Theme.spacing-4;
                                height: parent.height - 2 * Theme.spacing-4;
                                viewport-position: inventory-scroll.content-y;
                                content-extent: inventory-scroll.content-height;
                                viewport-extent: inventory-scroll.height;
                                thumb-min-length: 24px;
                            }
                        }

                        // 操作区：右对齐
                        HorizontalLayout {
                            spacing: Theme.spacing-8;
                            alignment: end;
                            vertical-stretch: 0;

                            WinButton {
                                text: @tr("Prev");
                                clicked => { root.select-prev(); }
                            }

                            WinButton {
                                text: @tr("Next");
                                clicked => { root.select-next(); }
                            }

                            WinButton {
                                text: @tr("Remove Selected");
                                icon: "trash";
                                critical: true;
                                clicked => { root.remove-selected(); }
                            }
                        }
                    }

                    // --- 右：详情 + 危险区 -----------------------------------------
                    VerticalLayout {
                        spacing: Theme.spacing-12;

                        WinCard {
                            vertical-stretch: 1;

                            WinCardHeader {
                                title: @tr("Host Key Details");
                                icon: "shield";
                            }

                            Text {
                                text: @tr("Path: {0}", root.path-text);
                                color: Theme.text-tertiary;
                                font-size: Theme.font-caption;
                                wrap: word-wrap;
                            }

                            // 详情表面：等宽 caption，指纹对齐显示（可滚动 + 指示条，E22）
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                background: Theme.panel-background;
                                border-radius: Theme.radius-control;
                                border-width: 1px;
                                border-color: Theme.divider;

                                details-scroll := Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    interactive: true;
                                    content-width: self.width;
                                    content-height: detail-body.preferred-height + 2 * Theme.spacing-8;

                                    detail-body := VerticalLayout {
                                        x: 10px;
                                        y: Theme.spacing-8;
                                        width: details-scroll.width - 20px;
                                        spacing: Theme.spacing-4;

                                        // 已选条目：四条字段行（标签本地化；空值行也保留，与原整段文本行数一致）
                                        if root.detail-entry-visible : VerticalLayout {
                                            spacing: Theme.spacing-4;

                                            DetailLine { hint: @tr("Host: {0}", root.detail-host-text); }
                                            DetailLine { hint: @tr("Port: {0}", root.detail-port-text); }
                                            DetailLine { hint: @tr("Algorithm: {0}", root.detail-algorithm-text); }
                                            DetailLine { hint: @tr("Fingerprint: {0}", root.detail-fingerprint-text); }
                                        }

                                        if root.detail-path-text != "" : DetailLine {
                                            hint: @tr("Known hosts path: {0}", root.detail-path-text);
                                        }

                                        // 未选中条目（仅路径）时的说明，替代原整段文本里的英文句
                                        if root.detail-path-text != "" && !root.detail-entry-visible : DetailLine {
                                            hint: @tr("Temporary trust entries are not persisted here.");
                                        }

                                        // 兼容回退：宿主尚未提供拆分字段时，继续显示原来的整段文本
                                        if !root.detail-split-visible && root.details-text != "" : DetailLine {
                                            hint: root.details-text;
                                        }
                                    }
                                }

                                WinScrollIndicator {
                                    x: parent.width - self.width - Theme.spacing-4;
                                    y: Theme.spacing-4;
                                    height: parent.height - 2 * Theme.spacing-4;
                                    viewport-position: details-scroll.content-y;
                                    content-extent: details-scroll.content-height;
                                    viewport-extent: details-scroll.height;
                                    thumb-min-length: 24px;
                                }
                            }
                        }

                        // 危险区：WinCard + critical 文案色
                        WinCard {
                            vertical-stretch: 0;

                            HorizontalLayout {
                                spacing: Theme.spacing-8;

                                Rectangle {
                                    width: Theme.icon-size-small;
                                    vertical-stretch: 1;
                                    background: transparent;

                                    Icon {
                                        name: "warning";
                                        icon-color: Theme.critical;
                                        icon-size: Theme.icon-size-small;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                Text {
                                    text: @tr("Danger Zone");
                                    color: Theme.critical;
                                    font-size: Theme.font-body-large;
                                    font-weight: Theme.weight-semibold;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            Text {
                                // CLEAR 是机器比对令牌：译文必须保留英文原词
                                text: @tr("Type CLEAR to remove every persisted known host entry from disk.");
                                color: Theme.critical;
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                            }

                            // 确认输入：WinTextInput 自带 control-fill 底 + control-stroke 描边 + 聚焦强调条（§5.2）。
                            // placeholder 中的 CLEAR 是机器比对令牌，译文必须保留英文原词。
                            WinTextInput {
                                text <=> root.clear-confirmation-text;
                                placeholder-text: @tr("Type CLEAR");
                                edited => { root.update-clear-confirmation(self.text); }
                            }

                            HorizontalLayout {
                                alignment: end;

                                WinButton {
                                    text: @tr("Clear All Known Hosts");
                                    critical: true;
                                    clicked => { root.clear-all(); }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }

                // 操作区：右对齐
                HorizontalLayout {
                    alignment: end;

                    WinButton {
                        text: @tr("Close");
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        dialog_scope.focus();
    }

    // 打开时聚焦弹窗（Esc 需要焦点在弹窗内）。
    changed open => {
        if (root.open) {
            dialog_scope.focus();
        }
    }
}
