// NET-1 / 波2-C：代理管理器页（与 Known Hosts / Private Keys 同一清单型管理器规范）。
//
// 与宿主（Rust / DialogWindowManager）的约定：
//   * `open` 由宿主投影驱动；`close`（Esc / 标题栏关闭）走同一条路径。
//   * `proxies` 是按名称排序的极简行模型（名称 + protocol·host:port）。
//   * 工具条只放 `+`（New）；行级 Duplicate / Test / Delete 全部走右键菜单。
//   * 右栏是编辑表单（Password 只写不回显）；页脚 Cancel | Save（均关闭；Save 先持久化）。
//   * 破坏性操作走 `request-remove-proxy`：被已保存会话引用时宿主阻止删除并在
//     本页说明（D8），同时提供"设为无代理"的显式动作。
//
// 规范：docs/agents/prototypes.md（清单型管理器）、docs/prototypes/proxies/。

import { Theme } from "../theme.slint";
import { TextFormats } from "../text_formats.slint";
import {
    WinButton, WinComboBox, WinIconButton, WinScrollIndicator, WinSwitch,
} from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { FormHint, FormRow } from "../components/basic/forms.slint";
import { MenuPopup, MenuEntry } from "../components/menu_popup.slint";
import { ManagerDialogShell } from "../components/manager_dialog_shell.slint";

/// 代理清单行（Rust `ProxyRowData` 的 Slint 镜像）。
export struct ProxyRow {
    id: string,
    name: string,
    /// 预格式化的协议名（SOCKS5 / HTTP CONNECT …）。
    protocol: string,
    /// 预格式化的 `host:port`。
    address: string,
    username: string,
    password-stored: bool,
    /// 预格式化的引用会话名（"Prod, Staging" / ""）。
    used-by: string,
    selected: bool,
}

/// 会话编辑器代理下拉选项（Rust `ProxyProfileOptionData` 的 Slint 镜像）。
export struct ProxyProfileOption {
    id: string,
    label: string,
    detail: string,
}

/// 单条代理清单行：名称 + protocol · host:port（两行，极简）。
component ProxyListItem inherits Rectangle {
    in property <ProxyRow> node;
    in property <bool> selected: false;
    callback clicked();
    callback context-menu-requested(length, length);

    height: Theme.control-height * 2;
    border-radius: Theme.radius-control;
    background: selected ? Theme.subtle-selected
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    VerticalLayout {
        padding-left: Theme.spacing-8;
        padding-right: Theme.spacing-8;
        padding-top: Theme.spacing-4;
        padding-bottom: Theme.spacing-4;
        spacing: 2px;
        alignment: center;

        Text {
            text: node.name;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: node.selected ? Theme.weight-semibold : 400;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: node.protocol + " · " + node.address;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            font-family: Theme.font-mono;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context-menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }
}

/// 表单行由共享 `forms.slint` 提供（FormRow / FormHint）。

export component ProxiesPage inherits Rectangle {
    in property <bool> open: false;
    in property <[ProxyRow]> proxies: [];
    in property <string> list-summary-text: "";
    in property <string> empty-text: @tr("No managed proxies yet. Create one to use it in a session.");
    in property <string> status-text: "";
    /// I18N-1：状态行模板（Rust 只投影 kind/参数；`status-text` 为英文回退）。
    in property <string> status-kind-text: "";
    in property <string> status-param-1-text: "";
    in property <string> status-param-2-text: "";
    in property <string> test-result-text: "";
    in property <bool> test-in-flight: false;

    in-out property <int> selected-index: -1;

    // D8：被引用代理的删除阻止说明 + 显式"设为无代理"动作。
    in property <bool> remove-blocked: false;
    in property <string> referencing-text: "";

    // 编辑表单（密码只写：空 = 保留已保存口令）
    in property <bool> editor-is-new: true;
    in property <string> editor-id-text: "";
    in-out property <string> editor-name-text: "";
    in-out property <string> editor-host-text: "";
    in-out property <string> editor-port-text: "";
    in-out property <string> editor-username-text: "";
    in-out property <string> editor-password-text: "";
    in property <bool> editor-password-stored: false;
    in property <bool> editor-dns-by-proxy: true;
    in-out property <int> editor-protocol-index: 2;
    in property <bool> editor-save-enabled: false;

    callback close();
    callback select-proxy(int);
    callback start-new-proxy();
    callback begin-edit-proxy();
    callback duplicate-proxy();
    callback request-remove-proxy();
    callback clear-proxy-references();
    callback dismiss-proxy-warning();
    callback test-proxy();
    callback save-proxy-editor();
    callback cancel-proxy-editor();
    callback update-proxy-name(string);
    callback update-proxy-host(string);
    callback update-proxy-port(string);
    callback update-proxy-username(string);
    callback update-proxy-password(string);
    callback select-proxy-protocol(int);
    callback toggle-proxy-dns();
    // 行右键动作（工具条不再放文字按钮）。
    callback prepare-context-menu(int);
    callback duplicate-from-menu();
    callback test-from-menu();
    callback remove-from-menu();

    private property <bool> has-selection:
        root.selected-index >= 0 && root.selected-index < root.proxies.length;
    private property <[string]> protocol-options: [
        "SOCKS4", "SOCKS4a", "SOCKS5", "HTTP CONNECT"
    ];
    private property <bool> save-enabled:
        root.editor-save-enabled
        || (root.editor-name-text != ""
            && root.editor-host-text != ""
            && root.editor-port-text != "");
    private property <string> status-display: TextFormats.status-message(
        root.status-kind-text,
        root.status-param-1-text,
        root.status-param-2-text,
        root.status-text
    );

    // 行右键菜单状态。
    private property <bool> row-menu-open: false;
    private property <length> row-menu-x: 0px;
    private property <length> row-menu-y: 0px;
    private property <[MenuEntry]> row-menu-entries: [
        {
            label: @tr("Duplicate"),
            shortcut: "",
            enabled: root.has-selection,
            checked: false,
            separator: false,
        },
        {
            label: @tr("Test"),
            shortcut: "",
            enabled: root.has-selection && !root.test-in-flight,
            checked: false,
            separator: false,
        },
        {
            label: "",
            shortcut: "",
            enabled: false,
            checked: false,
            separator: true,
        },
        {
            label: @tr("Delete"),
            shortcut: "",
            enabled: root.has-selection,
            checked: false,
            separator: false,
        },
    ];

    public function open-row-menu(index: int, x: length, y: length) {
        root.selected-index = index;
        root.row-menu-x = x - root.absolute-position.x;
        root.row-menu-y = y - root.absolute-position.y;
        root.row-menu-open = true;
    }

    // 退场淡出期间壳仍可见：根跟着壳的 opacity，避免透明全屏挡住下层。
    visible: root.open;
    background: transparent;

    shell := ManagerDialogShell {
        width: root.width;
        height: root.height;
        open: root.open;
        close => { root.close(); }

        HorizontalLayout {
            spacing: Theme.spacing-16;
            vertical-stretch: 1;

            // --- 左：工具条只放 `+` + 极简清单 + 右键动作 ----------------------
            Rectangle {
                width: Theme.manager-list-width;
                clip: true;
                background: transparent;

                left-scroll := Flickable {
                    width: parent.width;
                    height: parent.height;
                    interactive: true;
                    content-width: self.width;
                    content-height: left-column.preferred-height;

                    left-column := VerticalLayout {
                        spacing: Theme.spacing-8;

                        HorizontalLayout {
                            spacing: Theme.spacing-8;
                            cross-axis-alignment: center;

                            WinIconButton {
                                icon: "plus";
                                accessible-name: @tr("New");
                                tooltip-text: @tr("New proxy");
                                clicked => { root.start-new-proxy(); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.list-summary-text;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            height: max(180px, min(root.proxies.length * 64px + 8px, 520px));
                            clip: true;
                            background: Theme.control-fill;
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: Theme.control-stroke;

                            proxies-list := Flickable {
                                visible: root.proxies.length > 0;
                                width: parent.width;
                                height: parent.height;
                                interactive: true;
                                content-width: self.width;
                                content-height: rows.preferred-height;

                                rows := VerticalLayout {
                                    padding: Theme.spacing-4;
                                    spacing: 2px;

                                    for row[i] in root.proxies : ProxyListItem {
                                        node: row;
                                        selected: i == root.selected-index;
                                        clicked => {
                                            root.selected-index = i;
                                            root.select-proxy(i);
                                        }
                                        context-menu-requested(x, y) => {
                                            root.selected-index = i;
                                            root.prepare-context-menu(i);
                                            root.open-row-menu(i, x, y);
                                        }
                                    }
                                }
                            }

                            WinScrollIndicator {
                                visible: root.proxies.length > 0;
                                x: parent.width - self.width - Theme.spacing-4;
                                y: Theme.spacing-4;
                                height: parent.height - 2 * Theme.spacing-4;
                                viewport-position: proxies-list.content-y;
                                content-extent: proxies-list.content-height;
                                viewport-extent: proxies-list.height;
                                thumb-min-length: 24px;
                            }

                            empty := VerticalLayout {
                                visible: root.proxies.length == 0;
                                y: max((parent.height - self.preferred-height) / 2, Theme.spacing-12);
                                width: parent.width;
                                padding-left: Theme.spacing-16;
                                padding-right: Theme.spacing-16;
                                spacing: Theme.spacing-12;
                                alignment: center;

                                Text {
                                    width: min(parent.width - 2 * Theme.spacing-16, 250px);
                                    text: root.empty-text;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-caption;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: center;

                                    WinButton {
                                        text: @tr("New");
                                        icon: "plus";
                                        accent: true;
                                        clicked => { root.start-new-proxy(); }
                                    }
                                }
                            }
                        }

                        // D8：删除被阻止时说明引用方并提供显式迁移动作。
                        if root.remove-blocked : Rectangle {
                            background: Theme.banner-warning-background;
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: Theme.banner-warning-stroke;

                            VerticalLayout {
                                padding: Theme.spacing-12;
                                spacing: Theme.spacing-8;

                                Text {
                                    text: @tr("Cannot delete this proxy: it is used by saved sessions.");
                                    color: Theme.banner-warning-text;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-semibold;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: root.referencing-text;
                                    color: Theme.banner-warning-text;
                                    font-size: Theme.font-caption;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Theme.spacing-8;
                                    alignment: start;

                                    WinButton {
                                        text: @tr("Set Sessions to No Proxy");
                                        icon: "clear";
                                        clicked => { root.clear-proxy-references(); }
                                    }

                                    WinButton {
                                        text: @tr("Dismiss");
                                        subtle: true;
                                        clicked => { root.dismiss-proxy-warning(); }
                                    }
                                }
                            }
                        }
                    }

                    WinScrollIndicator {
                        x: parent.width - self.width - Theme.spacing-4;
                        y: Theme.spacing-4;
                        height: parent.height - 2 * Theme.spacing-4;
                        viewport-position: left-scroll.content-y;
                        content-extent: left-scroll.content-height;
                        viewport-extent: left-scroll.height;
                        thumb-min-length: 24px;
                    }
                }
            }

            // --- 右：编辑表单（页脚只有 Cancel | Save）------------------------
            Rectangle {
                clip: true;
                background: transparent;

                VerticalLayout {
                    spacing: Theme.spacing-8;

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        background: transparent;

                        scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            content-width: self.width;
                            content-height: sections.preferred-height;

                            sections := VerticalLayout {
                                spacing: Theme.form-row-gap;

                                FormRow {
                                    label: @tr("Name");

                                    WinTextInput {
                                        width: Theme.form-field-width;
                                        text <=> root.editor-name-text;
                                        placeholder-text: @tr("Proxy name");
                                        edited => { root.update-proxy-name(self.text); }
                                    }
                                }

                                FormRow {
                                    label: @tr("Protocol");

                                    WinComboBox {
                                        width: Theme.form-field-width;
                                        model: root.protocol-options;
                                        current-index <=> root.editor-protocol-index;
                                        selected(index) => {
                                            root.select-proxy-protocol(index);
                                        }
                                    }
                                }

                                FormRow {
                                    label: @tr("Host");

                                    WinTextInput {
                                        width: Theme.form-field-width;
                                        text <=> root.editor-host-text;
                                        placeholder-text: @tr("Proxy host");
                                        edited => { root.update-proxy-host(self.text); }
                                    }
                                }

                                FormRow {
                                    label: @tr("Port");

                                    WinTextInput {
                                        width: Theme.form-port-width;
                                        text <=> root.editor-port-text;
                                        placeholder-text: "1080";
                                        edited => { root.update-proxy-port(self.text); }
                                    }
                                }

                                FormRow {
                                    label: @tr("Username");

                                    WinTextInput {
                                        width: Theme.form-field-width;
                                        text <=> root.editor-username-text;
                                        placeholder-text: @tr("Proxy username (optional)");
                                        edited => { root.update-proxy-username(self.text); }
                                    }
                                }

                                FormRow {
                                    label: @tr("Password");

                                    WinTextInput {
                                        width: Theme.form-field-width;
                                        text <=> root.editor-password-text;
                                        input-type: password;
                                        placeholder-text: root.editor-password-stored
                                            ? @tr("Leave blank to keep the saved password")
                                            : @tr("Proxy password (optional)");
                                        edited => { root.update-proxy-password(self.text); }
                                    }
                                }

                                FormRow {
                                    label: @tr("DNS via proxy");

                                    // 原型 proxies/index.html：form-switch + On/Off 文案。
                                    WinSwitch {
                                        text: root.editor-dns-by-proxy ? @tr("On") : @tr("Off");
                                        accessible-name: @tr("DNS via proxy");
                                        checked: root.editor-dns-by-proxy;
                                        toggled => { root.toggle-proxy-dns(); }
                                    }
                                }

                                // Test 放到表单末行（原型）；行右键同样可用。
                                FormRow {
                                    label: "";

                                    WinButton {
                                        text: @tr("Test");
                                        icon: "check";
                                        enabled: !root.test-in-flight;
                                        clicked => { root.test-proxy(); }
                                    }
                                }

                                if !root.editor-is-new && root.editor-id-text != "" : FormHint {
                                    text: @tr("Profile id: {0}", root.editor-id-text);
                                }

                                if root.test-result-text != "" : Rectangle {
                                    vertical-stretch: 0;
                                    background: Theme.control-fill;
                                    border-radius: Theme.radius-control;
                                    border-width: 1px;
                                    border-color: Theme.control-stroke;

                                    Text {
                                        x: Theme.spacing-8;
                                        y: Theme.spacing-8;
                                        width: parent.width - 2 * Theme.spacing-8;
                                        text: root.test-result-text;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-caption;
                                        font-family: Theme.font-mono;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        WinScrollIndicator {
                            x: parent.width - self.width - Theme.spacing-4;
                            y: Theme.spacing-4;
                            height: parent.height - 2 * Theme.spacing-4;
                            viewport-position: scroll.content-y;
                            content-extent: scroll.content-height;
                            viewport-extent: scroll.height;
                            thumb-min-length: 24px;
                        }
                    }
                }
            }
        }

        // 一窗一条提交/关闭栏：状态 | Cancel | Save（Cancel/×/Esc 同弃稿关闭；Save = 保存并关闭）。
        // 状态放页脚左侧，避免右栏「Test ↔ 状态」之间被 stretch 撑出大片空洞（对齐原型 spacer + footer）。
        Rectangle {
            height: 1px;
            background: Theme.divider;
            vertical-stretch: 0;
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.spacing-8;
            cross-axis-alignment: center;

            Text {
                horizontal-stretch: 1;
                height: Theme.control-height;
                text: root.status-display;
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }

            WinButton {
                text: @tr("Cancel");
                clicked => { root.cancel-proxy-editor(); }
            }

            WinButton {
                text: @tr("Save");
                icon: "check";
                accent: true;
                enabled: root.save-enabled;
                clicked => { root.save-proxy-editor(); }
            }
        }
    }

    // 行右键菜单（页面内浮层）。
    proxy_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.row-menu-open;
        entries: root.row-menu-entries;
        anchor-x: root.row-menu-x;
        anchor-y: root.row-menu-y;
        panel-width: 200px;
        selected(index) => {
            root.row-menu-open = false;
            if index == 0 {
                root.duplicate-from-menu();
            } else if index == 1 {
                root.test-from-menu();
            } else if index == 3 {
                root.remove-from-menu();
            }
        }
        dismissed => { root.row-menu-open = false; }
    }

    /// 宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        shell.focus-dialog();
    }

    changed open => {
        if (root.open) {
            shell.focus-dialog();
        } else {
            root.row-menu-open = false;
        }
    }
}
