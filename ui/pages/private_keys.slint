// 私钥管理页（N4 设计 §1）：托管私钥清单（名称/算法/指纹/口令状态/被哪些会话
// 使用）+ 导入 + 删除（被引用告警）+ "测试" + 派生公钥（查看/复制/导出/部署）。
//
// 与宿主（Rust / main_window）的约定：
//   * `open` 由宿主投影驱动；`close`（Esc / 遮罩点击 / Close 按钮）走同一条路径。
//   * `keys` 是按显示顺序排好的行模型；`selected-index` 是宿主与页面共享的选择。
//   * 文本输入属性由页面编辑、经 `update-*` 回调写回宿主，宿主决定何时清空。
//   * 破坏性操作（删除 / 部署）走 `request-*`；二次确认由宿主 `ConfirmDialog` 承接
//     （`confirm-*` / `cancel-*` 仍可由宿主直接调用运行时，不在本页展示）。
//   * "部署公钥"在 Phase 2 由宿主持有远端会话执行（命令文本由宿主投影到确认框）。
//
// 规范：docs/product/ui-winui3-design-language.md §5.10（ContentDialog 形态）。

import { Theme } from "../theme.slint";
import { TextFormats } from "../text_formats.slint";
import { WinButton, WinCard, WinCardHeader, WinToggle, WinScrollIndicator } from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { ManagerDialogShell } from "../components/manager_dialog_shell.slint";

/// 托管私钥清单行（Rust `PrivateKeyEntryInfo` 的 Slint 镜像）。
export struct PrivateKeyRow {
    id: string,
    label: string,
    algorithm: string,
    fingerprint: string,
    passphrase-stored: bool,
    material-present: bool,
    /// 预格式化的引用会话名（"Prod, Staging" / "no saved session"）
    used-by: string,
    selected: bool,
}

/// 清单行：名称 + 算法/指纹 + 使用方/口令状态（三行 56px）。
component PrivateKeyListItem inherits Rectangle {
    in property <PrivateKeyRow> node;
    in property <bool> selected: false;
    callback clicked();

    height: 56px;
    border-radius: Theme.radius-control;
    background: selected ? Theme.subtle-selected
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    private property <string> passphrase-status:
        node.passphrase-stored ? @tr("passphrase saved") : @tr("passphrase not saved");
    private property <string> material-status:
        node.material-present ? "" : (" · " + @tr("material missing"));

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;

        Text {
            text: node.label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: node.selected ? Theme.weight-semibold : 400;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: node.algorithm + " · " + node.fingerprint;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            font-family: Theme.font-mono;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: root.passphrase-status + " · " + node.used-by + root.material-status;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component PrivateKeysPage inherits Rectangle {
    in property <bool> open: false;
    in property <[PrivateKeyRow]> keys: [];
    in property <string> list-summary-text: "";
    in property <string> empty-text: @tr("No managed private keys yet. Import an OpenSSH private key to get started.");
    in property <string> details-text: "";
    in property <string> public-key-text: "";
    in property <string> test-result-text: "";
    in property <string> status-text: "";
    /// I18N-1：状态行模板（Rust 只投影 kind/参数；`status-text` 为英文回退）。
    in property <string> status-kind-text: "";
    in property <string> status-param-1-text: "";
    in property <string> status-param-2-text: "";
    in property <bool> busy: false;

    in-out property <int> selected-index: -1;
    in property <string> remove-warning-text: "";

    // 导入表单
    in-out property <string> import-label-text: "";
    in-out property <string> import-path-text: "";
    in-out property <string> import-passphrase-text: "";
    in-out property <bool> remember-import-passphrase: false;
    in property <bool> import-enabled: false;
    // 口令管理（选中密钥）
    in-out property <string> passphrase-text: "";
    in property <bool> passphrase-stored: false;
    in property <bool> passphrase-manage-enabled: false;

    callback close();
    callback select-key(int);
    callback import-key();
    callback browse-import-file();
    callback update-import-label(string);
    callback update-import-path(string);
    callback update-import-passphrase(string);
    callback toggle-remember-import-passphrase(bool);
    callback test-key();
    callback copy-public-key();
    callback export-public-key();
    callback request-remove();
    callback request-deploy();
    callback update-passphrase(string);
    callback save-passphrase();
    callback forget-passphrase();
    callback rename-key(string);

    // 退场淡出期间壳仍可见：根跟着壳的 opacity，避免透明全屏挡住下层。
    visible: root.open;
    background: transparent;

    private property <string> selected-label:
        root.selected-index >= 0 && root.selected-index < root.keys.length
            ? root.keys[root.selected-index].label
            : "";
    private property <bool> has-selection: root.selected-index >= 0;
    private property <string> status-display: TextFormats.status-message(
        root.status-kind-text,
        root.status-param-1-text,
        root.status-param-2-text,
        root.status-text
    );

    shell := ManagerDialogShell {
        width: root.width;
        height: root.height;
        open: root.open;
        close => { root.close(); }

                HorizontalLayout {
                    spacing: Theme.spacing-16;
                    vertical-stretch: 1;

                    // --- 左：清单 + 导入（内容超出时整列滚动）---------------------
                    Rectangle {
                        width: Theme.manager-list-width;
                        clip: true;
                        background: transparent;

                        left-scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            content-width: self.width;
                            content-height: left-column.preferred-height;

                            left-column := VerticalLayout {
                                spacing: Theme.spacing-12;

                                WinCard {
                                    vertical-stretch: 0;

                                    WinCardHeader {
                                        title: @tr("Managed Keys");
                                        icon: "shield";
                                    }

                                    Rectangle {
                                        height: max(140px, min(root.keys.length * 56px + 4px, 224px));
                                        clip: true;
                                        background: Theme.panel-background;
                                        border-radius: Theme.radius-control;
                                        border-width: 1px;
                                        border-color: Theme.divider;

                                        keys-list := Flickable {
                                            visible: root.keys.length > 0;
                                            width: parent.width;
                                            height: parent.height;
                                            interactive: true;
                                            content-width: self.width;
                                            content-height: rows.preferred-height;

                                            rows := VerticalLayout {
                                                padding: 2px;
                                                spacing: 2px;

                                                for row[i] in root.keys : PrivateKeyListItem {
                                                    node: row;
                                                    selected: i == root.selected-index;
                                                    clicked => {
                                                        root.selected-index = i;
                                                        root.select-key(i);
                                                    }
                                                }
                                            }
                                        }

                                        // 滚动指示：E22 可复用组件（`content-y` ≤ 0，组件内部取负）
                                        WinScrollIndicator {
                                            visible: root.keys.length > 0;
                                            x: parent.width - self.width - Theme.spacing-4;
                                            y: Theme.spacing-4;
                                            height: parent.height - 2 * Theme.spacing-4;
                                            viewport-position: keys-list.content-y;
                                            content-extent: keys-list.content-height;
                                            viewport-extent: keys-list.height;
                                            thumb-min-length: 24px;
                                        }

                                        // 空态：居中说明 + Import 主 CTA（Browse/rfd 主路径）
                                        empty-state := VerticalLayout {
                                            visible: root.keys.length == 0;
                                            y: max((parent.height - self.preferred-height) / 2, Theme.spacing-12);
                                            width: parent.width;
                                            padding-left: Theme.spacing-16;
                                            padding-right: Theme.spacing-16;
                                            spacing: Theme.spacing-12;
                                            alignment: center;

                                            Text {
                                                width: min(parent.width - 2 * Theme.spacing-16, 280px);
                                                text: root.empty-text;
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                alignment: center;

                                                WinButton {
                                                    text: @tr("Import");
                                                    icon: "upload";
                                                    accent: true;
                                                    enabled: !root.busy;
                                                    clicked => { root.browse-import-file(); }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.spacing-8;
                                        vertical-stretch: 0;

                                        WinButton {
                                            text: @tr("Test");
                                            icon: "check";
                                            enabled: root.has-selection && !root.busy;
                                            clicked => { root.test-key(); }
                                        }

                                        WinButton {
                                            text: @tr("Import");
                                            icon: "upload";
                                            accent: root.keys.length == 0;
                                            enabled: !root.busy;
                                            clicked => { root.browse-import-file(); }
                                        }
                                    }
                                }

                                WinCard {
                                    vertical-stretch: 0;

                                    WinCardHeader {
                                        title: @tr("Import Private Key");
                                        icon: "upload";
                                    }

                                    Text {
                                        text: @tr("Stored in the secret store; only metadata is written to config.toml.");
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-caption;
                                        wrap: word-wrap;
                                    }

                                    WinTextInput {
                                        text <=> root.import-label-text;
                                        placeholder-text: @tr("Label (optional)");
                                        edited => { root.update-import-label(self.text); }
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.spacing-8;

                                        WinTextInput {
                                            text <=> root.import-path-text;
                                            placeholder-text: @tr("Path to key file");
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-caption;
                                            horizontal-stretch: 1;
                                            edited => { root.update-import-path(self.text); }
                                        }

                                        WinButton {
                                            text: @tr("Browse…");
                                            icon: "file";
                                            clicked => { root.browse-import-file(); }
                                        }
                                    }

                                    WinTextInput {
                                        text <=> root.import-passphrase-text;
                                        placeholder-text: @tr("Passphrase (optional)");
                                        input-type: password;
                                        edited => { root.update-import-passphrase(self.text); }
                                    }

                                    WinToggle {
                                        text: @tr("Remember passphrase");
                                        checked: root.remember-import-passphrase;
                                        toggled => { root.toggle-remember-import-passphrase(self.checked); }
                                    }

                                    HorizontalLayout {
                                        alignment: end;

                                        WinButton {
                                            text: @tr("Import");
                                            icon: "plus";
                                            accent: true;
                                            enabled: root.import-enabled && !root.busy;
                                            clicked => { root.import-key(); }
                                        }
                                    }
                                }
                            }

                            // 滚动指示（左列整体；面板高度不足时才出现）
                            WinScrollIndicator {
                                x: parent.width - self.width - Theme.spacing-4;
                                y: Theme.spacing-4;
                                height: parent.height - 2 * Theme.spacing-4;
                                viewport-position: left-scroll.content-y;
                                content-extent: left-scroll.content-height;
                                viewport-extent: left-scroll.height;
                                thumb-min-length: 24px;
                            }
                        }
                    }

                    // --- 右：详情 / 口令 / 操作 ------------------------------------
                    Rectangle {
                        clip: true;
                        background: transparent;

                        scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            content-width: self.width;
                            content-height: sections.preferred-height;

                            sections := VerticalLayout {
                                spacing: Theme.spacing-12;

                                // 详情 + 派生公钥
                                WinCard {
                                    WinCardHeader {
                                        title: @tr("Key Details");
                                        icon: "shield";
                                    }

                                    Rectangle {
                                        height: max(150px, min(280px, details-block.preferred-height + 20px));
                                        clip: true;
                                        background: Theme.panel-background;
                                        border-radius: Theme.radius-control;
                                        border-width: 1px;
                                        border-color: Theme.divider;

                                        details-scroll := Flickable {
                                            width: parent.width;
                                            height: parent.height;
                                            interactive: true;
                                            content-width: self.width;
                                            content-height: details-block.preferred-height + 20px;

                                            details-block := Text {
                                                x: 10px;
                                                y: 10px;
                                                width: parent.width - 20px;
                                                text: root.details-text;
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-caption;
                                                font-family: Theme.font-mono;
                                                wrap: word-wrap;
                                            }
                                        }

                                        WinScrollIndicator {
                                            x: parent.width - self.width - Theme.spacing-4;
                                            y: Theme.spacing-4;
                                            height: parent.height - 2 * Theme.spacing-4;
                                            viewport-position: details-scroll.content-y;
                                            content-extent: details-scroll.content-height;
                                            viewport-extent: details-scroll.height;
                                            thumb-min-length: 24px;
                                        }
                                    }

                                    if root.status-display != "" : Text {
                                        text: root.status-display;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-caption;
                                        wrap: word-wrap;
                                    }

                                    if root.test-result-text != "" : Text {
                                        text: root.test-result-text;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-caption;
                                        font-family: Theme.font-mono;
                                        wrap: word-wrap;
                                    }

                                    // 派生公钥（可复制/导出；等宽显示）
                                    if root.public-key-text != "" : Rectangle {
                                        height: max(56px, min(160px, pubkey-block.preferred-height + 20px));
                                        clip: true;
                                        background: Theme.panel-background;
                                        border-radius: Theme.radius-control;
                                        border-width: 1px;
                                        border-color: Theme.divider;

                                        pubkey-scroll := Flickable {
                                            width: parent.width;
                                            height: parent.height;
                                            interactive: true;
                                            content-width: self.width;
                                            content-height: pubkey-block.preferred-height + 20px;

                                            pubkey-block := Text {
                                                x: 10px;
                                                y: 10px;
                                                width: parent.width - 20px;
                                                text: root.public-key-text;
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-caption;
                                                font-family: Theme.font-mono;
                                                wrap: word-wrap;
                                            }
                                        }

                                        WinScrollIndicator {
                                            x: parent.width - self.width - Theme.spacing-4;
                                            y: Theme.spacing-4;
                                            height: parent.height - 2 * Theme.spacing-4;
                                            viewport-position: pubkey-scroll.content-y;
                                            content-extent: pubkey-scroll.content-height;
                                            viewport-extent: pubkey-scroll.height;
                                            thumb-min-length: 24px;
                                        }
                                    }

                                    // 重命名
                                    HorizontalLayout {
                                        spacing: Theme.spacing-8;

                                        rename-input := WinTextInput {
                                            text: root.selected-label;
                                            placeholder-text: @tr("Label");
                                            horizontal-stretch: 1;
                                            enabled: root.has-selection && !root.busy;
                                            accepted => { root.rename-key(self.text); }
                                        }

                                        WinButton {
                                            text: @tr("Rename");
                                            enabled: root.has-selection && !root.busy;
                                            clicked => { root.rename-key(rename-input.text); }
                                        }
                                    }

                                    // 公钥操作：Copy / Export / Deploy
                                    HorizontalLayout {
                                        spacing: Theme.spacing-8;

                                        WinButton {
                                            text: @tr("Copy");
                                            icon: "copy";
                                            enabled: root.public-key-text != "";
                                            clicked => { root.copy-public-key(); }
                                        }

                                        WinButton {
                                            text: @tr("Export");
                                            icon: "download";
                                            enabled: root.public-key-text != "";
                                            clicked => { root.export-public-key(); }
                                        }

                                        WinButton {
                                            text: @tr("Deploy");
                                            icon: "upload";
                                            enabled: root.public-key-text != "" && !root.busy;
                                            clicked => { root.request-deploy(); }
                                        }
                                    }

                                    // 移除：普通确认由宿主 ConfirmDialog 承接（非 Danger Zone）
                                    if root.has-selection : Text {
                                        text: root.remove-warning-text;
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-caption;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: Theme.spacing-8;

                                        WinButton {
                                            text: @tr("Remove");
                                            icon: "trash";
                                            critical: true;
                                            enabled: root.has-selection && !root.busy;
                                            clicked => { root.request-remove(); }
                                        }
                                    }
                                }

                                // 口令管理
                                WinCard {
                                    WinCardHeader {
                                        title: @tr("Passphrase");
                                        icon: "shield";
                                    }

                                    Text {
                                        text: root.passphrase-stored
                                            ? @tr("A passphrase is saved for this key.")
                                            : @tr("No passphrase is saved for this key.");
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-caption;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.spacing-8;

                                        WinTextInput {
                                            text <=> root.passphrase-text;
                                            placeholder-text: @tr("Passphrase");
                                            input-type: password;
                                            enabled: root.passphrase-manage-enabled;
                                            horizontal-stretch: 1;
                                            accepted => { root.save-passphrase(); }
                                        }

                                        WinButton {
                                            text: @tr("Remember");
                                            icon: "check";
                                            enabled: root.passphrase-manage-enabled && root.passphrase-text != "" && !root.busy;
                                            clicked => { root.save-passphrase(); }
                                        }

                                        WinButton {
                                            text: @tr("Forget");
                                            icon: "clear";
                                            enabled: root.passphrase-manage-enabled && root.passphrase-stored && !root.busy;
                                            clicked => { root.forget-passphrase(); }
                                        }
                                    }
                                }
                            }
                        }

                        // 滚动指示（右列详情/口令）
                        WinScrollIndicator {
                            x: parent.width - self.width - Theme.spacing-4;
                            y: Theme.spacing-4;
                            height: parent.height - 2 * Theme.spacing-4;
                            viewport-position: scroll.content-y;
                            content-extent: scroll.content-height;
                            viewport-extent: scroll.height;
                            thumb-min-length: 24px;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                    vertical-stretch: 0;
                }

                HorizontalLayout {
                    alignment: end;
                    vertical-stretch: 0;

                    WinButton {
                        text: @tr("Close");
                        clicked => { root.close(); }
                    }
                }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        shell.focus-dialog();
    }

    changed open => {
        if (root.open) {
            shell.focus-dialog();
        }
    }
}
