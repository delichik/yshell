// 私钥管理页（Private Keys 管理器，N4/D18）：极简左清单 + 右栏详情。
//
// 与宿主（Rust / DialogWindowManager）的约定：
//   * `open` 由宿主投影驱动；`close`（Esc / 标题栏关闭 / Close）走同一条路径。
//   * `keys` 是按显示顺序排好的行模型；`selected-index` 是宿主与页面共享的选择。
//   * 全局动作在工具条（Generate / Import 图标钮，正文只进 title）；行级动作
//     （Test / Export public key / Deploy / Remove）走右键菜单。
//   * Generate / Import / Export / Deploy 都是独立子窗（`ui/windows/private_key_*`），
//     本页只发 `open-*` 回调；右栏保留详情、公钥 Copy、口令与重命名。
//   * 破坏性操作走 `request-remove`；二次确认由宿主 ConfirmDialog 承接。
//
// 规范：docs/agents/prototypes.md（清单型管理器）、docs/prototypes/private-keys/。

import { Theme } from "../theme.slint";
import { TextFormats } from "../text_formats.slint";
import { WinButton, WinIconButton, WinScrollIndicator } from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { DetailRow, FormHint, FormRow } from "../components/basic/forms.slint";
import { MenuPopup, MenuEntry } from "../components/menu_popup.slint";
import { ManagerDialogShell } from "../components/manager_dialog_shell.slint";

/// 托管私钥清单行（Rust `PrivateKeyRowData` 的 Slint 镜像）。
export struct PrivateKeyRow {
    id: string,
    label: string,
    algorithm: string,
    fingerprint: string,
    passphrase-stored: bool,
    material-present: bool,
    /// 预格式化的引用会话名（"Prod, Staging" / "no saved session"）
    used-by: string,
    selected: bool,
}

/// 清单行：名称 + 算法/指纹（两行，极简）；引用/口令状态只在右栏详情。
component PrivateKeyListItem inherits Rectangle {
    in property <PrivateKeyRow> node;
    in property <bool> selected: false;
    callback clicked();
    callback context-menu-requested(length, length);

    height: Theme.control-height * 2;
    border-radius: Theme.radius-control;
    background: selected ? Theme.subtle-selected
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    VerticalLayout {
        padding-left: Theme.spacing-8;
        padding-right: Theme.spacing-8;
        padding-top: Theme.spacing-4;
        padding-bottom: Theme.spacing-4;
        spacing: 2px;
        alignment: center;

        Text {
            text: node.label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: node.selected ? Theme.weight-semibold : 400;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: node.algorithm + " · " + node.fingerprint;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            font-family: Theme.font-mono;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context-menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }
}

/// 表单/详情行由共享 `forms.slint` 提供（FormRow / DetailRow / FormHint）。

export component PrivateKeysPage inherits Rectangle {
    in property <bool> open: false;
    in property <[PrivateKeyRow]> keys: [];
    in property <string> list-summary-text: "";
    in property <string> empty-text: @tr("No managed private keys yet. Generate a key or import an OpenSSH private key.");
    in property <string> details-text: "";
    in property <string> public-key-text: "";
    in property <string> test-result-text: "";
    in property <string> status-text: "";
    /// I18N-1：状态行模板（Rust 只投影 kind/参数；`status-text` 为英文回退）。
    in property <string> status-kind-text: "";
    in property <string> status-param-1-text: "";
    in property <string> status-param-2-text: "";
    in property <bool> busy: false;

    in-out property <int> selected-index: -1;
    in property <string> remove-warning-text: "";

    // 兼容既有宿主投影（导入子窗的可见性/文本）；页面不再内联导入。
    in-out property <string> import-label-text: "";
    in-out property <string> import-path-text: "";
    in-out property <string> import-passphrase-text: "";
    in-out property <bool> remember-import-passphrase: false;
    in property <bool> import-enabled: false;
    // 口令管理（选中密钥）
    in-out property <string> passphrase-text: "";
    in property <bool> passphrase-stored: false;
    in property <bool> passphrase-manage-enabled: false;

    callback close();
    callback select-key(int);
    callback import-key();
    callback browse-import-file();
    callback update-import-label(string);
    callback update-import-path(string);
    callback update-import-passphrase(string);
    callback toggle-remember-import-passphrase(bool);
    callback test-key();
    callback copy-public-key();
    callback export-public-key();
    callback request-remove();
    callback request-deploy();
    callback update-passphrase(string);
    callback save-passphrase();
    callback forget-passphrase();
    callback rename-key(string);
    // 子窗入口 + 行右键动作（窗口由宿主 DialogWindowManager 管理）。
    callback open-generate-dialog();
    callback open-import-dialog();
    callback prepare-context-menu(int);
    callback test-from-menu();
    callback export-from-menu();
    callback deploy-from-menu();
    callback remove-from-menu();

    // 退场淡出期间壳仍可见：根跟着壳的 opacity，避免透明全屏挡住下层。
    visible: root.open;
    background: transparent;

    private property <bool> has-selection:
        root.selected-index >= 0 && root.selected-index < root.keys.length;
    private property <string> selected-label:
        root.has-selection ? root.keys[root.selected-index].label : "";
    private property <string> selected-algorithm:
        root.has-selection ? root.keys[root.selected-index].algorithm : "";
    private property <string> selected-fingerprint:
        root.has-selection ? root.keys[root.selected-index].fingerprint : "";
    private property <string> selected-used-by:
        root.has-selection ? root.keys[root.selected-index].used-by : "";
    private property <string> status-display: TextFormats.status-message(
        root.status-kind-text,
        root.status-param-1-text,
        root.status-param-2-text,
        root.status-text
    );

    // 行右键菜单状态。
    private property <bool> row-menu-open: false;
    private property <length> row-menu-x: 0px;
    private property <length> row-menu-y: 0px;
    private property <[MenuEntry]> row-menu-entries: [
        {
            label: @tr("Test"),
            shortcut: "",
            enabled: root.has-selection && !root.busy,
            checked: false,
            separator: false,
        },
        {
            label: @tr("Export public key"),
            shortcut: "",
            enabled: root.has-selection,
            checked: false,
            separator: false,
        },
        {
            label: @tr("Deploy"),
            shortcut: "",
            enabled: root.has-selection && !root.busy,
            checked: false,
            separator: false,
        },
        {
            label: "",
            shortcut: "",
            enabled: false,
            checked: false,
            separator: true,
        },
        {
            label: @tr("Remove"),
            shortcut: "",
            enabled: root.has-selection && !root.busy,
            checked: false,
            separator: false,
        },
    ];

    public function open-row-menu(index: int, x: length, y: length) {
        root.selected-index = index;
        root.row-menu-x = x - root.absolute-position.x;
        root.row-menu-y = y - root.absolute-position.y;
        root.row-menu-open = true;
    }

    shell := ManagerDialogShell {
        width: root.width;
        height: root.height;
        open: root.open;
        close => { root.close(); }

        HorizontalLayout {
            spacing: Theme.spacing-16;
            vertical-stretch: 1;

            // --- 左：清单（工具条图标钮 + 极简行 + 右键动作）-------------------
            Rectangle {
                width: Theme.manager-list-width;
                clip: true;
                background: transparent;

                left-column := VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: Theme.spacing-8;

                    HorizontalLayout {
                        spacing: Theme.spacing-8;
                        vertical-stretch: 0;
                        cross-axis-alignment: center;

                        WinIconButton {
                            icon: "plus";
                            accessible-name: @tr("Generate");
                            tooltip-text: @tr("Generate private key");
                            enabled: !root.busy;
                            clicked => { root.open-generate-dialog(); }
                        }

                        WinIconButton {
                            icon: "upload";
                            accessible-name: @tr("Import");
                            tooltip-text: @tr("Import private key");
                            enabled: !root.busy;
                            clicked => { root.open-import-dialog(); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // 对齐原型工具条右侧短计数（`3 keys`）；长英文摘要留给状态栏/详情。
                        Text {
                            text: @tr("{0} key(s)", root.keys.length);
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        background: Theme.control-fill;
                        border-radius: Theme.radius-control;
                        border-width: 1px;
                        border-color: Theme.control-stroke;

                        keys-list := Flickable {
                            visible: root.keys.length > 0;
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            content-width: self.width;
                            content-height: rows.preferred-height;

                            rows := VerticalLayout {
                                padding: Theme.spacing-4;
                                spacing: 2px;

                                for row[i] in root.keys : PrivateKeyListItem {
                                    node: row;
                                    selected: i == root.selected-index;
                                    clicked => {
                                        root.selected-index = i;
                                        root.select-key(i);
                                    }
                                    context-menu-requested(x, y) => {
                                        root.selected-index = i;
                                        root.prepare-context-menu(i);
                                        root.open-row-menu(i, x, y);
                                    }
                                }
                            }
                        }

                        WinScrollIndicator {
                            visible: root.keys.length > 0;
                            x: parent.width - self.width - Theme.spacing-4;
                            y: Theme.spacing-4;
                            height: parent.height - 2 * Theme.spacing-4;
                            viewport-position: keys-list.content-y;
                            content-extent: keys-list.content-height;
                            viewport-extent: keys-list.height;
                            thumb-min-length: 24px;
                        }

                        empty-state := VerticalLayout {
                            visible: root.keys.length == 0;
                            y: max((parent.height - self.preferred-height) / 2, Theme.spacing-12);
                            width: parent.width;
                            padding-left: Theme.spacing-16;
                            padding-right: Theme.spacing-16;
                            spacing: Theme.spacing-12;
                            alignment: center;

                            Text {
                                width: min(parent.width - 2 * Theme.spacing-16, 280px);
                                text: root.empty-text;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-caption;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: Theme.spacing-8;

                                WinButton {
                                    text: @tr("Generate");
                                    icon: "plus";
                                    accent: true;
                                    enabled: !root.busy;
                                    clicked => { root.open-generate-dialog(); }
                                }

                                WinButton {
                                    text: @tr("Import");
                                    icon: "upload";
                                    enabled: !root.busy;
                                    clicked => { root.open-import-dialog(); }
                                }
                            }
                        }
                    }
                }
            }

            // --- 右：只读详情 + 公钥 Copy + 口令 -------------------------------
            Rectangle {
                clip: true;
                background: transparent;

                scroll := Flickable {
                    width: parent.width;
                    height: parent.height;
                    interactive: true;
                    content-width: self.width;
                    content-height: sections.preferred-height;

                    sections := VerticalLayout {
                        spacing: Theme.form-row-gap;

                        if root.keys.length == 0 : Text {
                            text: @tr("No key selected. Generate or import a key first.");
                            color: Theme.text-tertiary;
                            font-size: Theme.font-body;
                            wrap: word-wrap;
                        }

                        if root.keys.length > 0 : VerticalLayout {
                            spacing: Theme.form-row-gap;

                            DetailRow {
                                label: @tr("Algorithm");
                                value: root.selected-algorithm;
                            }

                            DetailRow {
                                label: @tr("Fingerprint");
                                value: root.selected-fingerprint;
                                mono: true;
                            }

                            DetailRow {
                                label: @tr("Used by");
                                value: root.selected-used-by;
                                last: true;
                            }

                            if root.status-display != "" : FormHint {
                                text: root.status-display;
                            }

                            if root.test-result-text != "" : FormHint {
                                text: root.test-result-text;
                            }

                            // 派生公钥（等宽块 + Copy 图标钮）。
                            if root.public-key-text != "" : FormRow {
                                label: @tr("Public key");

                                Rectangle {
                                    width: Theme.form-field-width;
                                    height: max(128px, min(160px, pubkey-block.preferred-height + 20px));
                                    clip: true;
                                    background: Theme.control-fill;
                                    border-radius: Theme.radius-control;
                                    border-width: 1px;
                                    border-color: Theme.control-stroke;

                                    pubkey-scroll := Flickable {
                                        width: parent.width;
                                        height: parent.height;
                                        interactive: true;
                                        content-width: self.width;
                                        content-height: pubkey-block.preferred-height + 20px;

                                        pubkey-block := Text {
                                            x: Theme.spacing-8;
                                            y: Theme.spacing-8;
                                            width: parent.width - 2 * Theme.spacing-8;
                                            text: root.public-key-text;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-caption;
                                            font-family: Theme.font-mono;
                                            wrap: word-wrap;
                                        }
                                    }

                                    WinScrollIndicator {
                                        x: parent.width - self.width - Theme.spacing-4;
                                        y: Theme.spacing-4;
                                        height: parent.height - 2 * Theme.spacing-4;
                                        viewport-position: pubkey-scroll.content-y;
                                        content-extent: pubkey-scroll.content-height;
                                        viewport-extent: pubkey-scroll.height;
                                        thumb-min-length: 24px;
                                    }
                                }

                                WinIconButton {
                                    icon: "copy";
                                    accessible-name: @tr("Copy public key");
                                    tooltip-text: @tr("Copy public key");
                                    clicked => { root.copy-public-key(); }
                                }
                            }

                            // 重命名（标签就地编辑；保存由宿主落盘）。
                            FormRow {
                                label: @tr("Label");

                                rename-input := WinTextInput {
                                    width: Theme.form-field-width;
                                    text: root.selected-label;
                                    placeholder-text: @tr("Label");
                                    enabled: root.has-selection && !root.busy;
                                    accepted => { root.rename-key(self.text); }
                                }

                                WinButton {
                                    text: @tr("Rename");
                                    enabled: root.has-selection && !root.busy;
                                    clicked => { root.rename-key(rename-input.text); }
                                }
                            }
                        }

                        // 口令管理（选中的托管密钥）
                        if root.has-selection : VerticalLayout {
                            spacing: Theme.form-row-gap;

                            FormHint {
                                text: root.passphrase-stored
                                    ? @tr("A passphrase is saved for this key.")
                                    : @tr("No passphrase is saved for this key.");
                            }

                            FormRow {
                                label: @tr("Passphrase");

                                WinTextInput {
                                    width: Theme.form-field-width;
                                    text <=> root.passphrase-text;
                                    placeholder-text: @tr("New or replace");
                                    input-type: password;
                                    enabled: root.passphrase-manage-enabled;
                                    edited => { root.update-passphrase(self.text); }
                                    accepted => { root.save-passphrase(); }
                                }

                                WinIconButton {
                                    icon: "check";
                                    accessible-name: @tr("Remember passphrase");
                                    tooltip-text: @tr("Remember passphrase");
                                    enabled: root.passphrase-manage-enabled
                                        && root.passphrase-text != "" && !root.busy;
                                    clicked => { root.save-passphrase(); }
                                }

                                WinIconButton {
                                    icon: "clear";
                                    accessible-name: @tr("Forget passphrase");
                                    tooltip-text: @tr("Forget passphrase");
                                    enabled: root.passphrase-manage-enabled
                                        && root.passphrase-stored && !root.busy;
                                    clicked => { root.forget-passphrase(); }
                                }
                            }

                            if root.remove-warning-text != "" : FormHint {
                                text: root.remove-warning-text;
                            }
                        }
                    }
                }

                WinScrollIndicator {
                    x: parent.width - self.width - Theme.spacing-4;
                    y: Theme.spacing-4;
                    height: parent.height - 2 * Theme.spacing-4;
                    viewport-position: scroll.content-y;
                    content-extent: scroll.content-height;
                    viewport-extent: scroll.height;
                    thumb-min-length: 24px;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
            vertical-stretch: 0;
        }

        HorizontalLayout {
            alignment: end;
            vertical-stretch: 0;

            WinButton {
                text: @tr("Close");
                clicked => { root.close(); }
            }
        }
    }

    // 行右键菜单（页面内浮层）。
    key_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.row-menu-open;
        entries: root.row-menu-entries;
        anchor-x: root.row-menu-x;
        anchor-y: root.row-menu-y;
        panel-width: 220px;
        selected(index) => {
            root.row-menu-open = false;
            if index == 0 {
                root.test-from-menu();
            } else if index == 1 {
                root.export-from-menu();
            } else if index == 2 {
                root.deploy-from-menu();
            } else if index == 4 {
                root.remove-from-menu();
            }
        }
        dismissed => { root.row-menu-open = false; }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        shell.focus-dialog();
    }

    changed open => {
        if (root.open) {
            shell.focus-dialog();
        } else {
            root.row-menu-open = false;
        }
    }
}
