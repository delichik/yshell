// TERM-1 / 波2-C：终端样式管理器（Terminal Styles）。
//
// 布局（对齐 docs/prototypes/terminal-styles/）：
//   * 工具条只放 `+`（新建自定义样式）+ 计数；行级 Clone/Delete 走右键菜单。
//   * 左清单极简：名称 + Built-in / Custom（色块与详情只在右栏）。
//   * 右栏：live preview → Font（family / size / fallback + Add Font File）→
//     Colors / ANSI（`ThemeEditor`，内置样式只读）。
//
// 语义（文档化）：
//   * 行点击只把主题选中用于预览；内置样式不可编辑/删除（Clone 可用）。
//   * 显式点「Set as Default」才写入 `terminal.color_scheme` 并保存配置。
//   * Font 字段沿用全局终端外观草稿（主字体 / 字号 / 备用字体文件）；Add Font File
//     在宿主侧走 rfd，失败时回退到路径输入。
//
// 规范：docs/agents/prototypes.md（清单型管理器）、docs/prototypes/terminal-styles/。

import { Theme } from "../theme.slint";
import { WinButton, WinIconButton, WinComboBox, WinScrollIndicator } from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { FormHint, FormRow } from "../components/basic/forms.slint";
import { ThemeEditor } from "../components/theme_editor.slint";
import { TerminalPreview } from "../components/terminal_preview.slint";
import { MenuPopup, MenuEntry } from "../components/menu_popup.slint";
import { ManagerDialogShell } from "../components/manager_dialog_shell.slint";

/// 主题列表行（Rust `ThemeManagerRowData` 的 Slint 镜像）。
export struct ThemeManagerRow {
    id: string,
    name: string,
    /// 角色色 + ANSI 色块的短色带（Rust 侧从调色板生成）。
    swatches: [color],
    /// 内置主题不可编辑/删除（Clone 仍可用）。
    builtin: bool,
    /// 当前预览选中项。
    selected: bool,
    /// 当前全局默认主题（`terminal.color_scheme` 的有效值）。
    current: bool,
}

/// 小徽章（Default / Built-in / Custom）。
component ThemeBadge inherits Rectangle {
    in property <string> label: "";
    in property <bool> emphasized: false;

    height: 18px;
    width: text.preferred-width + 12px;
    border-radius: 9px;
    background: root.emphasized ? Theme.accent-soft : Theme.subtle-selected;

    text := Text {
        x: (parent.width - self.width) / 2;
        height: parent.height;
        text: root.label;
        color: root.emphasized ? Theme.accent : Theme.text-secondary;
        font-size: Theme.font-caption;
        vertical-alignment: center;
        wrap: no-wrap;
    }
}

/// 单条主题行：名称 + Built-in / Custom（极简；动作走右键菜单）。
component ThemeListRow inherits Rectangle {
    in property <ThemeManagerRow> node;
    in property <bool> selected: false;
    callback activate();
    callback context-menu-requested(length, length);

    height: Theme.control-height * 2;
    border-radius: Theme.radius-control;
    background: root.selected ? Theme.subtle-selected
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    // 选中标记：左侧 3px 强调色细条。
    if root.selected : Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 2px;
        background: Theme.accent;
    }

    VerticalLayout {
        padding-left: Theme.spacing-12;
        padding-right: Theme.spacing-8;
        padding-top: Theme.spacing-4;
        padding-bottom: Theme.spacing-4;
        spacing: 2px;
        alignment: center;

        HorizontalLayout {
            spacing: Theme.spacing-8;
            cross-axis-alignment: center;

            Text {
                horizontal-stretch: 1;
                text: root.node.name;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                font-weight: root.selected ? Theme.weight-semibold : 400;
                wrap: no-wrap;
                overflow: elide;
            }

            if root.node.current : ThemeBadge {
                label: @tr("Default");
                emphasized: true;
            }
        }

        Text {
            text: root.node.builtin ? @tr("Built-in") : @tr("Custom");
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.activate(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context-menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }
}

/// 字体表单行由共享 `forms.slint` 提供（FormRow / FormHint）。

export component ThemeManagerPage inherits Rectangle {
    in property <bool> open: false;
    in property <[ThemeManagerRow]> themes: [];
    in-out property <int> selected-index: -1;
    in property <string> default-name-text: "";
    in property <bool> selected-is-default: false;
    in property <int> builtin-count: 0;
    in property <int> user-count: 0;
    /// Rust 投影的 live preview 位图（仅在页面打开时生成）。
    in property <image> preview;
    /// 预览表面底色（跟随预览配色；见 `terminal_preview.slint`）。
    in property <color> preview-background: Theme.terminal-surface;

    // 编辑器状态（与 Settings 旧内联编辑器共用同一份宿主草稿）。
    in property <bool> theme-editor-open: false;
    in property <bool> theme-editor-builtin: false;
    in property <string> theme-editor-id: "";
    in-out property <string> theme-editor-name: "";
    in property <color> theme-editor-foreground: Theme.text-primary;
    in property <color> theme-editor-background: Theme.terminal-background;
    in property <color> theme-editor-cursor: Theme.text-primary;
    in property <color> theme-editor-selection: Theme.selection-fill;
    in property <[color]> theme-editor-ansi: [];
    in property <[color]> editor-palette-swatches: [];

    // Font（全局终端外观；Built-in 只读）。
    in property <bool> font-editable: false;
    in property <[string]> font-options: [];
    in-out property <int> font-index: 0;
    in-out property <string> font-family-text: "";
    in-out property <string> font-size-text: "";
    in-out property <string> backup-font-text: "";

    callback close();
    /// 行点击：参数为列表索引（宿主按索引解析主题 id）。
    callback select-theme(int);
    callback set-default-theme();
    /// 工具条 `+`：以当前选中的样式为模板新建自定义样式。
    callback new-style();
    callback clone-theme(string);
    callback edit-theme(string);
    callback request-delete-theme(string);
    callback close-theme-editor();
    callback save-theme-editor();
    callback update-theme-editor-name(string);
    callback update-theme-editor-role(string, string);
    callback update-theme-editor-ansi(int, string);
    // 行右键菜单 + Font 字段。
    callback prepare-context-menu(int);
    callback clone-from-menu();
    callback delete-from-menu();
    callback update-font-family(string);
    callback update-font-size(string);
    callback update-backup-font(string);
    callback browse-font-family-file();
    callback browse-font-fallback-file();

    private property <bool> has-selection:
        root.selected-index >= 0 && root.selected-index < root.themes.length;
    private property <bool> selected-builtin:
        root.selected-index >= 0 && root.selected-index < root.themes.length
        && root.themes[root.selected-index].builtin;
    private property <bool> fonts-enabled: root.font-editable && !root.selected-builtin;

    // 行右键菜单状态。
    private property <bool> row-menu-open: false;
    private property <length> row-menu-x: 0px;
    private property <length> row-menu-y: 0px;
    private property <[MenuEntry]> row-menu-entries: [
        {
            label: @tr("Clone"),
            shortcut: "",
            enabled: root.has-selection,
            checked: false,
            separator: false,
        },
        {
            label: @tr("Edit"),
            shortcut: "",
            enabled: root.has-selection && !root.selected-builtin,
            checked: false,
            separator: false,
        },
        {
            label: "",
            shortcut: "",
            enabled: false,
            checked: false,
            separator: true,
        },
        {
            label: @tr("Delete"),
            shortcut: "",
            enabled: root.has-selection && !root.selected-builtin,
            checked: false,
            separator: false,
        },
    ];

    public function open-row-menu(index: int, x: length, y: length) {
        root.selected-index = index;
        root.row-menu-x = x - root.absolute-position.x;
        root.row-menu-y = y - root.absolute-position.y;
        root.row-menu-open = true;
    }

    visible: root.open;
    background: transparent;

    shell := ManagerDialogShell {
        width: root.width;
        height: root.height;
        open: root.open;
        close => { root.close(); }

        // --- 工具条：仅 +（New style）+ 计数 ------------------------------
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.spacing-8;
            cross-axis-alignment: center;

            WinIconButton {
                icon: "plus";
                accessible-name: @tr("New style");
                tooltip-text: @tr("New style");
                enabled: !root.theme-editor-open;
                clicked => {
                    root.new-style();
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: @tr("Built-in {0} · Custom {1}", root.builtin-count, root.user-count);
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                vertical-alignment: center;
                wrap: no-wrap;
            }
        }

        // --- 内容：左清单 / 右预览 + 编辑器 -------------------------------
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.spacing-16;

            // 左清单（极简行；Clone/Delete 走右键）。
            Rectangle {
                width: Theme.manager-list-width;
                clip: true;
                background: Theme.control-fill;
                border-radius: Theme.radius-control;
                border-width: 1px;
                border-color: Theme.control-stroke;

                list := Flickable {
                    visible: root.themes.length > 0;
                    width: parent.width;
                    height: parent.height;
                    interactive: true;
                    content-width: self.width;
                    content-height: rows.preferred-height;

                    rows := VerticalLayout {
                        padding: Theme.spacing-4;
                        spacing: 2px;

                        for row[i] in root.themes : ThemeListRow {
                            node: row;
                            selected: row.selected || i == root.selected-index;
                            activate => {
                                root.selected-index = i;
                                root.select-theme(i);
                                // 内置样式以只读编辑器打开（Clone 才能改）。
                                root.edit-theme(row.id);
                            }
                            context-menu-requested(x, y) => {
                                root.selected-index = i;
                                root.prepare-context-menu(i);
                                root.open-row-menu(i, x, y);
                            }
                        }
                    }
                }

                WinScrollIndicator {
                    visible: root.themes.length > 0;
                    x: parent.width - self.width - Theme.spacing-4;
                    y: Theme.spacing-4;
                    height: parent.height - 2 * Theme.spacing-4;
                    viewport-position: list.content-y;
                    content-extent: list.content-height;
                    viewport-extent: list.height;
                    thumb-min-length: 24px;
                }

                Text {
                    visible: root.themes.length == 0;
                    width: parent.width - 2 * Theme.spacing-16;
                    x: Theme.spacing-16;
                    y: (parent.height - self.height) / 2;
                    text: @tr("No themes available.");
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // 右栏：预览固定置顶；Font 与 Colors/ANSI 在滚动区。
            Rectangle {
                clip: true;
                background: transparent;

                VerticalLayout {
                    spacing: Theme.spacing-8;

                    // 预览固定（120px 契约，见 TerminalPreview）。
                    TerminalPreview {
                        vertical-stretch: 0;
                        frame: root.preview;
                        surface-background: root.preview-background;
                        surface-height: 120px;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        background: Theme.card-fill;
                        border-radius: Theme.radius-control;
                        border-width: 1px;
                        border-color: Theme.divider;

                        editor-scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            content-width: self.width;
                            content-height: editor-body.preferred-height;

                            editor-body := VerticalLayout {
                                spacing: Theme.form-row-gap;
                                padding: Theme.spacing-12;

                                // --- Font（family / size / fallback）-----------
                                FormRow {
                                    label: @tr("Font family");

                                    HorizontalLayout {
                                        width: Theme.form-field-width;
                                        spacing: Theme.spacing-8;

                                        WinComboBox {
                                            horizontal-stretch: 1;
                                            model: root.font-options;
                                            current-index: root.font-index;
                                            enabled: root.fonts-enabled;
                                            selected(index) => {
                                                if index >= 0 && index < root.font-options.length {
                                                    root.font-family-text = root.font-options[index];
                                                    root.update-font-family(root.font-options[index]);
                                                }
                                            }
                                        }

                                        WinIconButton {
                                            icon: "plus";
                                            accessible-name: @tr("Add Font File");
                                            tooltip-text: @tr("Add Font File");
                                            enabled: root.fonts-enabled;
                                            clicked => { root.browse-font-family-file(); }
                                        }
                                    }
                                }

                                FormRow {
                                    label: @tr("Font size");

                                    WinTextInput {
                                        width: Theme.form-port-width;
                                        text <=> root.font-size-text;
                                        placeholder-text: "14";
                                        enabled: root.fonts-enabled;
                                        edited => { root.update-font-size(self.text); }
                                    }
                                }

                                FormHint {
                                    text: @tr("6–72");
                                }

                                FormRow {
                                    label: @tr("Fallback");

                                    HorizontalLayout {
                                        width: Theme.form-field-width;
                                        spacing: Theme.spacing-8;

                                        WinTextInput {
                                            horizontal-stretch: 1;
                                            text <=> root.backup-font-text;
                                            placeholder-text: @tr("Font file (optional)");
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-caption;
                                            enabled: root.fonts-enabled;
                                            edited => { root.update-backup-font(self.text); }
                                        }

                                        WinIconButton {
                                            icon: "plus";
                                            accessible-name: @tr("Add Font File");
                                            tooltip-text: @tr("Add Font File");
                                            enabled: root.fonts-enabled;
                                            clicked => { root.browse-font-fallback-file(); }
                                        }
                                    }
                                }

                                if root.selected-builtin : FormHint {
                                    text: @tr("Built-in styles are read-only. Clone this style to make a custom copy.");
                                    indent: false;
                                }

                                // --- Colors / ANSI（既有 ThemeEditor）-----------
                                if root.theme-editor-open : ThemeEditor {
                                    width: parent.width - 2 * Theme.spacing-12;
                                    builtin: root.theme-editor-builtin;
                                    theme-id: root.theme-editor-id;
                                    theme-name <=> root.theme-editor-name;
                                    foreground: root.theme-editor-foreground;
                                    background: root.theme-editor-background;
                                    cursor: root.theme-editor-cursor;
                                    selection: root.theme-editor-selection;
                                    ansi: root.theme-editor-ansi;
                                    palette-swatches: root.editor-palette-swatches;
                                    close() => { root.close-theme-editor(); }
                                    save() => { root.save-theme-editor(); }
                                    clone-theme() => { root.clone-theme(root.theme-editor-id); }
                                    update-name(value) => { root.update-theme-editor-name(value); }
                                    update-role(role, hex) => { root.update-theme-editor-role(role, hex); }
                                    update-ansi(index, hex) => { root.update-theme-editor-ansi(index, hex); }
                                }

                                if !root.theme-editor-open && !root.selected-builtin : FormHint {
                                    text: @tr("Select a custom style to edit its colors, or right-click a built-in style to clone it.");
                                    indent: false;
                                }
                            }
                        }

                        WinScrollIndicator {
                            x: parent.width - self.width - Theme.spacing-4;
                            y: Theme.spacing-4;
                            height: parent.height - 2 * Theme.spacing-4;
                            viewport-position: editor-scroll.content-y;
                            content-extent: editor-scroll.content-height;
                            viewport-extent: editor-scroll.height;
                            thumb-min-length: 24px;
                        }
                    }
                }
            }
        }

        // --- 底部：当前默认 + Set as Default ------------------------------
        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.divider;
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.spacing-12;
            cross-axis-alignment: center;

            Text {
                horizontal-stretch: 1;
                text: @tr("Current default: {0}", root.default-name-text);
                color: Theme.text-primary;
                font-size: Theme.font-body;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }

            WinButton {
                text: @tr("Set as Default");
                enabled: root.has-selection && !root.selected-is-default && !root.theme-editor-open;
                clicked => { root.set-default-theme(); }
            }

            WinButton {
                text: @tr("Close");
                clicked => { root.close(); }
            }
        }
    }

    // 行右键菜单（页面内浮层）。
    theme_menu := MenuPopup {
        width: parent.width;
        height: parent.height;
        open: root.row-menu-open;
        entries: root.row-menu-entries;
        anchor-x: root.row-menu-x;
        anchor-y: root.row-menu-y;
        panel-width: 200px;
        selected(index) => {
            root.row-menu-open = false;
            if index == 0 {
                root.clone-from-menu();
            } else if index == 1 {
                if root.has-selection {
                    root.edit-theme(root.themes[root.selected-index].id);
                }
            } else if index == 3 {
                root.delete-from-menu();
            }
        }
        dismissed => { root.row-menu-open = false; }
    }

    /// 宿主在关闭上层弹窗后把键盘焦点交还给本页（嵌套场景）。
    public function focus-dialog() {
        shell.focus-dialog();
    }

    changed open => {
        if (root.open) {
            shell.focus-dialog();
        } else {
            root.row-menu-open = false;
        }
    }
}
