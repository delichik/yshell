// 主机密钥页（N4 设计 §1，与私钥页同级、独立入口）：升级 known_hosts 展示——
// 按 `host:port` 分组、SHA256 指纹、导出/导入、清空确认。
//
// 与宿主（Rust / main_window）的约定：
//   * `open` 由宿主投影驱动；`cancel`（Esc / 遮罩点击 / Close）走同一条路径。
//   * `groups` 是按 `host:port` 分组后的行模型（每组一个 host 行 + 若干公钥行）。
//   * 导入优先文件浏览；粘贴为次级高级路径。清空 / 删除由宿主 ConfirmDialog 确认。
//
// 规范：docs/product/ui-winui3-design-language.md §5.10（ContentDialog 形态）。

import { Theme } from "../theme.slint";
import { TextFormats } from "../text_formats.slint";
import { Icon } from "../components/basic/icons.slint";
import { WinButton, WinCard, WinCardHeader, WinScrollIndicator } from "../components/basic/controls.slint";
import { ManagerDialogShell } from "../components/manager_dialog_shell.slint";

/// 一条已保存的主机密钥（SHA256 指纹 + 公钥行）。
export struct HostKeyEntry {
    algorithm: string,
    fingerprint: string,
    key-line: string,
}

/// 按 `host:port` 分组的主机密钥。
export struct HostKeyGroup {
    host: string,
    port: int,
    /// 该主机保存的所有密钥（通常一条；多算法时多条）
    entries: [HostKeyEntry],
}

/// 单条主机密钥行：算法 + SHA256 指纹（缩进在组头之下）。
component HostKeyListItem inherits Rectangle {
    in property <HostKeyEntry> node;
    in property <bool> selected: false;
    callback clicked();

    height: Theme.row-height-list + Theme.spacing-8;
    border-radius: Theme.radius-control;
    background: selected ? Theme.subtle-selected
        : touch.pressed ? Theme.subtle-pressed
        : touch.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: Theme.duration-faster; easing: ease-out; }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 1px;

        Text {
            text: node.algorithm;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: node.fingerprint;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            font-family: Theme.font-mono;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 详情行（等宽 caption；与详情块原有整段文本同一形态）。
// 注意：同一文件内的局部组件必须先声明后使用。
component DetailLine inherits Text {
    in property <string> hint: "";
    text: root.hint;
    color: Theme.text-secondary;
    font-size: Theme.font-caption;
    font-family: Theme.font-mono;
    wrap: word-wrap;
}

export component HostKeysPage inherits Rectangle {
    in property <bool> open: false;
    in property <[HostKeyGroup]> groups: [];
    /// 全部密钥条数（跨 host:port 合计；由宿主投影，避免只显示选中组）。
    in property <int> key-count: 0;
    in property <string> path-text: "";
    in property <string> details-text: "";
    /// WS-D/WS-A 拆分的详情字段（标签在页面内本地化）。全部为空时回退到 `details-text`。
    in property <string> detail-host-text: "";
    in property <string> detail-algorithm-text: "";
    in property <string> detail-fingerprint-text: "";
    in property <string> detail-path-text: "";
    in property <string> status-text: "";
    /// I18N-1：状态行模板（Rust 只投影 kind/参数；`status-text` 为英文回退）。
    in property <string> status-kind-text: "";
    in property <string> status-param-1-text: "";
    in property <string> status-param-2-text: "";
    in property <string> empty-text: @tr("No host keys have been saved yet. They are recorded when you trust a host.");

    in-out property <int> selected-group: -1;
    in-out property <int> selected-entry: -1;
    in-out property <bool> import-visible: false;
    in-out property <string> import-text: "";

    callback close();
    callback select-group(int);
    callback select-entry(int, int);
    callback request-remove();
    callback browse-import-file();
    callback toggle-import();
    callback update-import-text(string);
    callback import-keys();
    callback export-keys();
    callback request-clear-all();

    // 退场淡出期间壳仍可见：根跟着壳的 opacity，避免透明全屏挡住下层。
    visible: root.open;
    background: transparent;

    private property <int> group-count: root.groups.length;

    // 详情区：拆分字段可用时逐行渲染（标签本地化）；否则回退整段 `details-text`。
    private property <bool> detail-split-visible:
        root.detail-host-text != "" || root.detail-algorithm-text != ""
        || root.detail-fingerprint-text != "" || root.detail-path-text != "";
    private property <string> status-display: TextFormats.status-message(
        root.status-kind-text,
        root.status-param-1-text,
        root.status-param-2-text,
        root.status-text
    );

    shell := ManagerDialogShell {
        width: root.width;
        height: root.height;
        open: root.open;
        close => { root.close(); }

                // 空态：居中提示 + 主 Import CTA
                if root.groups.length == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: Theme.spacing-16;

                    Text {
                        text: root.empty-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-body;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        // 固定上限，避免 parent.width → layoutinfo 回环。
                        width: 420px;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.spacing-8;

                        WinButton {
                            text: @tr("Import");
                            icon: "upload";
                            accent: true;
                            clicked => { root.browse-import-file(); }
                        }

                        WinButton {
                            text: @tr("Paste text…");
                            clicked => { root.toggle-import(); }
                        }
                    }

                    if root.import-visible : VerticalLayout {
                        spacing: Theme.spacing-8;
                        width: min(parent.width - 2 * Theme.spacing-24, 640px);

                        Text {
                            text: @tr("One entry per line: `host:port` followed by an OpenSSH public key or a SHA256 fingerprint.");
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            min-height: 96px;
                            clip: true;
                            background: Theme.panel-background;
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: Theme.divider;

                            TextInput {
                                x: 10px;
                                y: 10px;
                                width: parent.width - 20px;
                                height: parent.height - 20px;
                                text <=> root.import-text;
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                font-family: Theme.font-mono;
                                single-line: false;
                                wrap: word-wrap;
                                edited => { root.update-import-text(self.text); }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: Theme.spacing-8;

                            WinButton {
                                text: @tr("Cancel");
                                clicked => { root.toggle-import(); }
                            }

                            WinButton {
                                text: @tr("Import");
                                accent: true;
                                enabled: root.import-text != "";
                                clicked => { root.import-keys(); }
                            }
                        }
                    }
                }

                // 非空：工具栏 + 列表 / 详情
                if root.groups.length > 0 : VerticalLayout {
                    spacing: Theme.spacing-12;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        spacing: Theme.spacing-8;
                        vertical-stretch: 0;

                        WinButton {
                            text: @tr("Import");
                            icon: "upload";
                            clicked => { root.browse-import-file(); }
                        }

                        WinButton {
                            text: @tr("Export");
                            icon: "download";
                            clicked => { root.export-keys(); }
                        }

                        WinButton {
                            text: @tr("Clear All");
                            icon: "trash";
                            critical: true;
                            clicked => { root.request-clear-all(); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        WinButton {
                            text: @tr("Paste text…");
                            clicked => { root.toggle-import(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.spacing-16;
                        vertical-stretch: 1;

                        // --- 左：按 host:port 分组的清单 ------------------------------
                        WinCard {
                            width: Theme.manager-list-width;

                            WinCardHeader {
                                title: @tr("Trusted Hosts");
                                icon: "globe";
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                background: Theme.panel-background;
                                border-radius: Theme.radius-control;
                                border-width: 1px;
                                border-color: Theme.divider;

                                groups-list := Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    interactive: true;
                                    content-width: self.width;
                                    content-height: group-rows.preferred-height;

                                    group-rows := VerticalLayout {
                                        padding: 2px;

                                        for group[group-index] in root.groups : VerticalLayout {
                                            spacing: 2px;

                                            // host:port 组头
                                            Rectangle {
                                                height: Theme.row-height-list;
                                                background: transparent;

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: Theme.spacing-8;

                                                    // 图标包一层可拉伸容器再居中：
                                                    // 裸 Icon 是写死 16px 的固定尺寸子项，
                                                    // 默认 stretch 会把它贴行顶（比文字高 8px）。
                                                    Rectangle {
                                                        width: Theme.icon-size-small;
                                                        vertical-stretch: 1;
                                                        background: transparent;

                                                        Icon {
                                                            name: "globe";
                                                            icon-color: Theme.text-secondary;
                                                            icon-size: Theme.icon-size-small;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                    }

                                                    Text {
                                                        text: group.host + ":" + group.port;
                                                        color: Theme.text-primary;
                                                        font-size: Theme.font-body;
                                                        font-weight: Theme.weight-semibold;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        wrap: no-wrap;
                                                        overflow: elide;
                                                    }
                                                }
                                            }

                                            for entry[entry-index] in group.entries : HostKeyListItem {
                                                node: entry;
                                                selected: group-index == root.selected-group && entry-index == root.selected-entry;
                                                clicked => {
                                                    root.selected-group = group-index;
                                                    root.selected-entry = entry-index;
                                                    root.select-entry(group-index, entry-index);
                                                }
                                            }
                                        }
                                    }
                                }

                                WinScrollIndicator {
                                    x: parent.width - self.width - Theme.spacing-4;
                                    y: Theme.spacing-4;
                                    height: parent.height - 2 * Theme.spacing-4;
                                    viewport-position: groups-list.content-y;
                                    content-extent: groups-list.content-height;
                                    viewport-extent: groups-list.height;
                                    thumb-min-length: 24px;
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-8;
                                vertical-stretch: 0;

                                WinButton {
                                    text: @tr("Remove");
                                    icon: "trash";
                                    critical: true;
                                    enabled: root.selected-group >= 0;
                                    clicked => { root.request-remove(); }
                                }
                            }
                        }

                        // --- 右：详情 / 粘贴导入 ---------------------------------
                        Rectangle {
                            clip: true;
                            background: transparent;

                            scroll := Flickable {
                                width: parent.width;
                                height: parent.height;
                                interactive: true;
                                content-width: self.width;
                                content-height: sections.preferred-height;

                                sections := VerticalLayout {
                                    spacing: Theme.spacing-12;

                                    WinCard {
                                        WinCardHeader {
                                            title: @tr("Host Key Details");
                                            icon: "shield";
                                        }

                                        Text {
                                            text: @tr("Path: {0}", root.path-text);
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-caption;
                                            wrap: word-wrap;
                                        }

                                        Rectangle {
                                            height: max(120px, min(280px, detail-body.preferred-height + 2 * Theme.spacing-8));
                                            clip: true;
                                            background: Theme.panel-background;
                                            border-radius: Theme.radius-control;
                                            border-width: 1px;
                                            border-color: Theme.divider;

                                            detail-scroll := Flickable {
                                                width: parent.width;
                                                height: parent.height;
                                                interactive: true;
                                                content-width: self.width;
                                                content-height: detail-body.preferred-height + 2 * Theme.spacing-8;

                                                detail-body := VerticalLayout {
                                                    x: 10px;
                                                    y: Theme.spacing-8;
                                                    width: parent.width - 20px;
                                                    spacing: Theme.spacing-4;

                                                    if root.detail-host-text != "" : DetailLine {
                                                        hint: @tr("Host: {0}", root.detail-host-text);
                                                    }

                                                    if root.detail-algorithm-text != "" : DetailLine {
                                                        hint: @tr("Algorithm: {0}", root.detail-algorithm-text);
                                                    }

                                                    if root.detail-fingerprint-text != "" : DetailLine {
                                                        hint: @tr("Fingerprint: {0}", root.detail-fingerprint-text);
                                                    }

                                                    if root.detail-path-text != "" : DetailLine {
                                                        hint: @tr("Host keys path: {0}", root.detail-path-text);
                                                    }

                                                    if root.detail-path-text != "" && root.detail-host-text == "" : DetailLine {
                                                        hint: @tr("Temporary trust entries are not persisted here.");
                                                    }

                                                    if !root.detail-split-visible && root.details-text != "" : DetailLine {
                                                        hint: root.details-text;
                                                    }
                                                }
                                            }

                                            WinScrollIndicator {
                                                x: parent.width - self.width - Theme.spacing-4;
                                                y: Theme.spacing-4;
                                                height: parent.height - 2 * Theme.spacing-4;
                                                viewport-position: detail-scroll.content-y;
                                                content-extent: detail-scroll.content-height;
                                                viewport-extent: detail-scroll.height;
                                                thumb-min-length: 24px;
                                            }
                                        }

                                        if root.status-display != "" : Text {
                                            text: root.status-display;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-caption;
                                            wrap: word-wrap;
                                        }
                                    }

                                    if root.import-visible : WinCard {
                                        WinCardHeader {
                                            title: @tr("Paste Host Keys");
                                            icon: "upload";
                                        }

                                        Text {
                                            text: @tr("One entry per line: `host:port` followed by an OpenSSH public key or a SHA256 fingerprint.");
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-caption;
                                            wrap: word-wrap;
                                        }

                                        Rectangle {
                                            min-height: 96px;
                                            clip: true;
                                            background: Theme.panel-background;
                                            border-radius: Theme.radius-control;
                                            border-width: 1px;
                                            border-color: Theme.divider;

                                            TextInput {
                                                x: 10px;
                                                y: 10px;
                                                width: parent.width - 20px;
                                                height: parent.height - 20px;
                                                text <=> root.import-text;
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-caption;
                                                font-family: Theme.font-mono;
                                                single-line: false;
                                                wrap: word-wrap;
                                                edited => { root.update-import-text(self.text); }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: Theme.spacing-8;

                                            WinButton {
                                                text: @tr("Cancel");
                                                clicked => { root.toggle-import(); }
                                            }

                                            WinButton {
                                                text: @tr("Import");
                                                accent: true;
                                                enabled: root.import-text != "";
                                                clicked => { root.import-keys(); }
                                            }
                                        }
                                    }
                                }
                            }

                            WinScrollIndicator {
                                x: parent.width - self.width - Theme.spacing-4;
                                y: Theme.spacing-4;
                                height: parent.height - 2 * Theme.spacing-4;
                                viewport-position: scroll.content-y;
                                content-extent: scroll.content-height;
                                viewport-extent: scroll.height;
                                thumb-min-length: 24px;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                    vertical-stretch: 0;
                }

                HorizontalLayout {
                    alignment: end;
                    vertical-stretch: 0;

                    WinButton {
                        text: @tr("Close");
                        clicked => { root.close(); }
                    }
                }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        shell.focus-dialog();
    }

    changed open => {
        if (root.open) {
            shell.focus-dialog();
        }
    }
}
