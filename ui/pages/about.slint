import { Theme } from "../theme.slint";
import { WinButton, WinCard, WinIconButton } from "../components/basic/controls.slint";

// About 对话框：ContentDialog 形态（§5.10）：标题 → 正文 → 操作区（右对齐）。
export component AboutDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> version-text: "";
    in property <string> config-dir-text: "";

    callback close();

    visible: self.open;
    background: Theme.scrim;

    // L2（对话框 Esc / 遮罩点击关闭）：根 FocusScope 包住整个弹窗；打开时聚焦，
    // Esc 沿焦点链冒泡到这里 → 与关闭按钮完全相同的 `root.close()` 路径；其余按键 reject。
    dialog_scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            // Esc 键码按 `event.text` 比较（与 session_tree 判 Enter 的做法一致）。
            if (event.text == "\u{001b}") {
                root.close();
                return accept;
            }
            return reject;
        }

        // 遮罩：点击 = 关闭（与关闭按钮同一路径）。
        TouchArea {
            clicked => { root.close(); }
        }

        Rectangle {
            x: (parent.width - 480px) / 2;
            y: max((parent.height - self.height) / 2, Theme.spacing-24);
            width: 480px;
            height: min(body.preferred-height, parent.height - 2 * Theme.spacing-24);
            background: Theme.panel-background;
            border-radius: Theme.radius-panel;
            border-width: 1px;
            border-color: Theme.control-stroke;

            // 吞掉面板空白处的点击，避免穿透到遮罩触发取消。
            TouchArea { }

            body := VerticalLayout {
                padding: Theme.spacing-20;
                spacing: Theme.spacing-12;

                // 标题行：右侧统一关闭按钮
                HorizontalLayout {
                    spacing: Theme.spacing-8;

                    Text {
                        text: @tr("About YShell");
                        color: Theme.text-primary;
                        font-size: Theme.font-subtitle;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    WinIconButton {
                        icon: "close";
                        accessible-name: @tr("Close");
                        clicked => { root.close(); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }

                Text {
                    text: @tr("YShell {0}", root.version-text);
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Text {
                    text: @tr("A Slint desktop shell for SSH, SFTP, tunnels and terminal workflows.");
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }

                // 元信息：标签列按内容宽度收紧，值列紧随其后并左对齐
                WinCard {
                    GridLayout {
                        spacing: Theme.spacing-16;

                        Text {
                            row: 0;
                            col: 0;
                            text: @tr("Config directory");
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            vertical-alignment: top;
                        }

                        Text {
                            row: 0;
                            col: 1;
                            text: root.config-dir-text;
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            vertical-alignment: top;
                            wrap: word-wrap;
                        }

                        Text {
                            row: 1;
                            col: 0;
                            text: @tr("License");
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            vertical-alignment: top;
                        }

                        Text {
                            row: 1;
                            col: 1;
                            text: "MIT OR Apache-2.0";
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            vertical-alignment: top;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }

                // 操作区：右对齐；关闭是常规动作，不用强调色
                HorizontalLayout {
                    alignment: end;

                    WinButton {
                        text: @tr("Close");
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        dialog_scope.focus();
    }

    // 打开时聚焦弹窗（Esc 需要焦点在弹窗内）。
    changed open => {
        if (root.open) {
            dialog_scope.focus();
        }
    }
}
