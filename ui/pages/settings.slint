import { Theme } from "../theme.slint";
import { WinButton, WinComboBox, WinIconButton, WinNavItem, WinScrollIndicator, WinSwitch } from "../components/basic/controls.slint";
import { FormGroupLabel, FormHint, FormRow } from "../components/basic/forms.slint";
import { Icon } from "../components/basic/icons.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { TerminalPreview } from "../components/terminal_preview.slint";
import { ManagerDialogShell } from "../components/manager_dialog_shell.slint";
import { TextFormats } from "../text_formats.slint";

// 分区导航项：WinNavItem + 可选的禁用说明 tooltip。
// （基础控件 WinNavItem 不属本文件；Tooltip 必须声明在其直接父元素下，故包一层薄壳。）
component SettingsNavItem inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "settings";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    /// 非空且禁用时，hover 显示「本版本未提供」一类说明（契约 §18：disabled 必须有 tooltip）
    in property <string> hint: "";
    callback clicked();

    height: Theme.row-height-nav;
    background: transparent;

    WinNavItem {
        width: parent.width;
        height: parent.height;
        text: root.text;
        icon: root.icon;
        selected: root.selected;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if !root.enabled && root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// 表单行/分组标题/hint 使用共享 `forms.slint`（与 Session Editor 同一实现，
// 度量按原型 form.css：label 120 右对齐 / 13px、gap 12、行间距 10）。

// 文字按钮 + tooltip（规范：每个可点按钮都要有悬停提示）。
component SettingsActionButton inherits Rectangle {
    in property <string> text: "";
    in property <string> hint: "";
    in property <bool> accent: false;
    in property <bool> critical: false;
    callback clicked();

    height: Theme.control-height;
    width: button.preferred-width;

    button := WinButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        accent: root.accent;
        critical: root.critical;
        clicked => { root.clicked(); }
    }

    if root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// Mode 分段控件的一项（System / Light / Dark；也可做单项禁用占位）。
component SettingsMethodButton inherits Rectangle {
    in property <string> text: "";
    in property <string> hint: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.control-height;
    width: max(96px, method.preferred-width);

    method := WinButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        accent: root.selected;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// 强调色色板：Follow system + 6 预设；选中项加粗描边（原型 `aria-pressed` 态）。
// Follow system 用半白半黑渐变（原型 `.accent-system`），与 Blue 实色区分。
component AccentSwatch inherits Rectangle {
    in property <color> swatch: transparent;
    in property <string> hint: "";
    in property <bool> selected: false;
    /// Index 0 = Follow system：半白半黑，不吃 `swatch` 实色。
    in property <bool> follow-system: false;
    callback clicked();

    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.text-primary : Theme.control-stroke;
    background: root.follow-system
        ? @linear-gradient(90deg, #ffffff 0%, #ffffff 50%, #202020 50%, #202020 100%)
        : root.swatch;
    clip: true;

    TouchArea {
        clicked => { root.clicked(); }
    }

    if root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// Security → Managers 的整行可点清单行：图标 + 名称 + 计数 + chevron。
// 行级动作走整行跳转，不在行下堆按钮。
component SettingsManagerRow inherits Rectangle {
    in property <string> icon: "file";
    in property <string> name: "";
    in property <int> count: 0;
    in property <string> hint: "";
    callback clicked();

    height: Theme.control-height * 2;
    background: touch.has-hover ? Theme.subtle-hover : transparent;

    HorizontalLayout {
        padding-left: Theme.spacing-12;
        padding-right: Theme.spacing-12;
        spacing: Theme.spacing-12;
        // 必须是 stretch：行内名称用 `horizontal-stretch: 1` 撑开，计数与 chevron
        // 才会被推到行尾（原型 `.set-row .name { flex: 1 }`）；`alignment: start`
        // 时布局只按 preferred 尺寸摆子项，右侧计数/chevron 会挤在名称后面。
        alignment: stretch;

        Rectangle {
            width: Theme.control-height;
            height: Theme.control-height;
            vertical-stretch: 0;
            cross-axis-self-alignment: center;
            background: Theme.control-fill;
            border-radius: Theme.radius-control;
            border-width: 1px;
            border-color: Theme.control-stroke;

            Icon {
                name: root.icon;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.name;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: "\{root.count}";
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }

        Rectangle {
            width: Theme.icon-size-small;
            height: Theme.icon-size-small;
            cross-axis-self-alignment: center;
            background: transparent;

            Icon {
                name: "chevron-right";
                icon-size: Theme.icon-size-small;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    if root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// Settings dialog：左导航多分区（General / Appearance / Terminal / Security /
// MCP / Advanced / SFTP）；Shortcuts 本版本禁用。
//
// WinUI 3 形态：标题 → 左导航 + 右滚动表单 → 固定 Cancel | Save 操作区。
// + `Cancel` / `×` / `Esc` = 弃稿关闭；`Save` = 校验全部分区并保存后关闭。
// + 分区内容区不复述分区大标题（docs/agents/prototypes.md）。

export component SettingsDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> config-dir-text: "";
    in property <string> secret-store-status-text: "";
    in-out property <string> scrollback-lines-text: "";
    in-out property <string> scrollback-max-cells-text: "";
    /// 设置页「SFTP」分区的最大并行传输数（已退出 Settings，保留属性兼容旧接线）。
    in-out property <string> settings-sftp-max-parallel-transfers-text: "4";
    in property <string> terminal-status-text: "";
    /// UI language preference: `system` / `zh-CN` / `en-US`.
    in property <string> language-text: "system";
    /// Process debug logging preference (writes under the config directory).
    in-out property <bool> debug-logging-enabled: false;
    /// Confirm before closing a session that still has an active connection.
    in-out property <bool> confirm-close-session-enabled: true;
    /// Confirm before quitting YShell.
    in-out property <bool> confirm-quit-app-enabled: true;
    /// MCP master switch (hosts the local endpoint for AI clients).
    in-out property <bool> mcp-enabled: false;
    /// MCP TCP port text (`1–65535`).
    in-out property <string> mcp-port-text: "18765";
    /// Listen == LAN (`0.0.0.0`); false = Local (`127.0.0.1`).
    in-out property <bool> mcp-listen-lan: false;
    /// API key (required for LAN).
    in-out property <string> mcp-api-key-text: "";
    /// Allow AI to view user-created connections.
    in-out property <bool> mcp-view-user-connections: false;
    /// Allow AI to control user-created connections (implies view).
    in-out property <bool> mcp-control-user-connections: false;
    /// Auto-approve MCP AI control requests (skip the consent dialog).
    in-out property <bool> mcp-auto-approve-control-enabled: false;
    /// MCP listener / control status kind id (rendered by
    /// `TextFormats.settings-mcp-status`; see `runtime/mcp.rs::mcp_status_kind`).
    in property <string> mcp-status-kind-text: "";
    /// Optional detail for the MCP status kind (listening port / failure reason).
    in property <string> mcp-status-detail-text: "";
    /// Absolute path of the debug log directory.
    in property <string> debug-log-dir-text: "";
    /// Active left-nav section id.
    in-out property <string> section: "general";

    // --- settings-security ---
    // D36 App theme：Mode 分段 + Accent 色板（即时预览；Save 持久化，Cancel 回滚）。
    in property <int> settings-appearance-mode-index: 0;
    in property <int> settings-appearance-accent-index: 1;
    in property <[color]> settings-appearance-accent-light-swatches: [];
    in property <[color]> settings-appearance-accent-dark-swatches: [];
    /// Terminal style 下拉（全局 color-scheme profile）。
    in property <[string]> settings-appearance-style-options: [];
    in property <int> settings-appearance-style-index: 0;
    // D37 Terminal 交互四项草稿。
    in-out property <int> settings-terminal-middle-click-index: 0;
    in-out property <int> settings-terminal-right-click-index: 0;
    in-out property <int> settings-terminal-multi-line-paste-index: 0;
    in-out property <bool> settings-terminal-auto-copy: false;
    in property <string> settings-terminal-status-kind-text: "";
    in property <string> settings-terminal-status-field-text: "";
    in property <string> settings-terminal-status-value-text: "";
    in property <string> settings-terminal-status-limit-text: "";
    // D33 SFTP 默认值。
    in-out property <bool> settings-sftp-show-hidden: true;
    in-out property <int> settings-sftp-conflict-index: 0;
    in property <[string]> settings-sftp-editor-options: [];
    in-out property <int> settings-sftp-editor-index: 0;
    in property <bool> settings-sftp-editor-custom-visible: false;
    in-out property <string> settings-sftp-editor-path-text: "";
    in property <string> settings-sftp-status-kind-text: "";
    // D35 Security 卡片 + Managers 行计数。
    in property <bool> settings-master-password-set: false;
    in property <bool> settings-master-password-locked: false;
    in property <int> settings-security-known-hosts-count: 0;
    in property <int> settings-security-private-keys-count: 0;
    in property <int> settings-security-proxies-count: 0;
    // --- settings-security end

    // N5：Terminal style 预览（颜色方案即时预览；字体 / 配色编辑在 Terminal Styles）。
    in property <string> appearance-color-scheme-name-text: "";
    in property <bool> appearance-color-scheme-builtin: false;
    in property <[color]> appearance-palette-swatches: [];
    in property <[string]> appearance-font-options: [];
    in-out property <int> appearance-font-index: 0;
    in-out property <string> appearance-font-size-text: "";
    in-out property <string> appearance-fallback-fonts-text: "";
    in property <string> appearance-status-text: "";
    in property <image> appearance-preview;
    /// 预览表面底色（跟随预览配色；见 `terminal_preview.slint`）。
    in property <color> appearance-preview-background: Theme.terminal-surface;

    callback close();
    callback open-host-keys();
    callback open-private-keys();
    callback open-proxies();
    callback open-theme-manager();
    callback update-scrollback-lines(string);
    callback update-scrollback-max-cells(string);
    callback update-settings-sftp-max-parallel-transfers(string);
    callback save-settings-sftp();
    callback reset-terminal-defaults();
    callback save-terminal-settings();
    callback set-language(string);
    callback set-debug-logging(bool);
    callback set-confirm-close-session(bool);
    callback set-confirm-quit-app(bool);
    /// General → Motion：持久化到 `[ui] reduce_motion`（应用配置只来自配置文件）。
    callback set-reduce-motion(bool);
    callback set-mcp-enabled(bool);
    callback update-mcp-port(string);
    callback set-mcp-listen-lan(bool);
    callback update-mcp-api-key(string);
    callback generate-mcp-api-key();
    callback copy-mcp-api-key();
    callback set-mcp-view-user-connections(bool);
    callback set-mcp-control-user-connections(bool);
    callback set-mcp-auto-approve-control(bool);
    callback open-debug-log-dir();
    // Appearance（字体；主题编辑已迁移到 Theme Manager）
    callback select-appearance-font(int);
    callback update-appearance-font-size(string);
    callback bump-appearance-font-size(int);
    callback update-appearance-fallback-fonts(string);
    callback browse-appearance-font-file();
    callback browse-appearance-fallback-font();
    callback clear-appearance-fallbacks();
    callback reset-appearance-defaults();
    callback save-appearance();
    // --- settings-security ---
    // D36 / D37 / D33 草稿更新。
    callback update-settings-appearance-mode(int);
    callback update-settings-appearance-accent(int);
    callback select-settings-appearance-style(int);
    callback update-settings-terminal-middle-click(int);
    callback update-settings-terminal-right-click(int);
    callback update-settings-terminal-multi-line-paste(int);
    callback update-settings-terminal-auto-copy(bool);
    callback update-settings-sftp-show-hidden(bool);
    callback update-settings-sftp-conflict-action(int);
    callback update-settings-sftp-external-editor(int);
    callback update-settings-sftp-external-editor-path(string);
    callback browse-settings-sftp-external-editor();
    // D35 主密码子窗入口（kind: set / change / remove / reset）。
    callback open-master-password-dialog(string);
    // Advanced：打开配置目录（日志目录用既有 open-debug-log-dir）。
    callback open-config-dir();
    // 整窗 Save = 校验全部分区 + 持久化 + 关闭。
    callback save-settings();
    // --- settings-security end

    visible: root.open;
    background: transparent;

    shell := ManagerDialogShell {
        width: root.width;
        height: root.height;
        open: root.open;
        close => { root.close(); }

        // 主体：左侧分区导航 + 右侧表单
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Theme.spacing-12;

            // 分区导航（NavigationView 形态）
            Rectangle {
                width: Theme.nav-width;
                vertical-stretch: 1;
                background: Theme.layer-fill;
                border-radius: Theme.radius-panel;
                border-width: 1px;
                border-color: Theme.layer-stroke;

                VerticalLayout {
                    padding: Theme.spacing-8;
                    spacing: 2px;
                    alignment: start;

                    SettingsNavItem {
                        text: @tr("General");
                        icon: "settings";
                        selected: root.section == "general";
                        clicked => { root.section = "general"; }
                    }
                    SettingsNavItem {
                        text: @tr("Appearance");
                        icon: "eye";
                        selected: root.section == "appearance";
                        clicked => { root.section = "appearance"; }
                    }
                    SettingsNavItem {
                        text: @tr("Terminal");
                        icon: "terminal";
                        selected: root.section == "terminal";
                        clicked => { root.section = "terminal"; }
                    }
                    SettingsNavItem {
                        text: @tr("Security");
                        icon: "shield";
                        selected: root.section == "security";
                        clicked => { root.section = "security"; }
                    }
                    SettingsNavItem {
                        text: @tr("MCP");
                        icon: "link";
                        selected: root.section == "mcp";
                        clicked => { root.section = "mcp"; }
                    }
                    SettingsNavItem {
                        text: @tr("Advanced");
                        icon: "code";
                        selected: root.section == "advanced";
                        clicked => { root.section = "advanced"; }
                    }
                    SettingsNavItem {
                        text: @tr("SFTP");
                        icon: "folder";
                        selected: root.section == "sftp";
                        clicked => { root.section = "sftp"; }
                    }
                    SettingsNavItem {
                        text: @tr("Shortcuts");
                        icon: "edit";
                        enabled: false;
                        hint: @tr("Not available in this version.");
                    }
                }
            }

            // 表单卡片（内容区滚动）
            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                background: Theme.card-fill;
                border-radius: Theme.radius-panel;
                border-width: 1px;
                border-color: Theme.card-stroke;

                VerticalLayout {
                    padding: Theme.spacing-20;
                    spacing: Theme.spacing-16;

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        background: transparent;

                        scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            interactive: true;
                            content-width: self.width;
                            content-height: sections.preferred-height;

                            sections := VerticalLayout {
                                alignment: start;
                                spacing: Theme.spacing-12;

                                // --- General -------------------------------------
                                if root.section == "general" : VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.form-row-gap;

                                    FormRow {
                                        label: @tr("Language");
                                        WinComboBox {
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            model: [@tr("System default"), @tr("English"), @tr("中文")];
                                            current-index: root.language-text == "zh-CN" ? 2
                                                : root.language-text == "en-US" ? 1 : 0;
                                            selected(index) => {
                                                root.set-language(
                                                    index == 1 ? "en-US"
                                                    : index == 2 ? "zh-CN" : "system"
                                                );
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Applies immediately.");
                                    }

                                    FormRow {
                                        label: @tr("Confirm close");
                                        WinSwitch {
                                            text: root.confirm-close-session-enabled ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("Confirm close");
                                            checked <=> root.confirm-close-session-enabled;
                                            toggled => {
                                                root.set-confirm-close-session(root.confirm-close-session-enabled);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Ask before closing an active session.");
                                    }

                                    FormRow {
                                        label: @tr("Confirm quit");
                                        WinSwitch {
                                            text: root.confirm-quit-app-enabled ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("Confirm quit");
                                            checked <=> root.confirm-quit-app-enabled;
                                            toggled => {
                                                root.set-confirm-quit-app(root.confirm-quit-app-enabled);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Ask before quitting YShell.");
                                    }

                                    FormRow {
                                        label: @tr("Reduce motion");
                                        WinSwitch {
                                            text: Theme.reduce-motion ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("Reduce motion");
                                            checked: Theme.reduce-motion;
                                            toggled => {
                                                // 即时应用 + 落盘（`[ui] reduce_motion`）。
                                                Theme.reduce-motion = self.checked;
                                                root.set-reduce-motion(self.checked);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Turns off transitions.");
                                    }
                                }

                                // --- Appearance（D36：App theme + Terminal style）--
                                if root.section == "appearance" : VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.form-row-gap;

                                    FormGroupLabel {
                                        text: @tr("App theme");
                                        first: true;
                                    }

                                    FormRow {
                                        label: @tr("Mode");
                                        HorizontalLayout {
                                            spacing: Theme.spacing-8;
                                            alignment: start;
                                            SettingsMethodButton {
                                                text: @tr("System");
                                                hint: @tr("Follow system");
                                                selected: root.settings-appearance-mode-index == 0;
                                                clicked => { root.update-settings-appearance-mode(0); }
                                            }
                                            SettingsMethodButton {
                                                text: @tr("Light");
                                                hint: @tr("Light");
                                                selected: root.settings-appearance-mode-index == 1;
                                                clicked => { root.update-settings-appearance-mode(1); }
                                            }
                                            SettingsMethodButton {
                                                text: @tr("Dark");
                                                hint: @tr("Dark");
                                                selected: root.settings-appearance-mode-index == 2;
                                                clicked => { root.update-settings-appearance-mode(2); }
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Applies to the whole app.");
                                    }

                                    FormRow {
                                        label: @tr("Accent");
                                        HorizontalLayout {
                                            spacing: Theme.spacing-8;
                                            alignment: start;
                                            for swatch[index] in Theme.dark
                                                ? root.settings-appearance-accent-dark-swatches
                                                : root.settings-appearance-accent-light-swatches : AccentSwatch {
                                                swatch: swatch;
                                                follow-system: index == 0;
                                                selected: root.settings-appearance-accent-index == index;
                                                hint: TextFormats.appearance-accent-label(index);
                                                clicked => { root.update-settings-appearance-accent(index); }
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Used for buttons, focus, and selection.");
                                    }

                                    FormGroupLabel {
                                        text: @tr("Terminal style");
                                    }

                                    FormRow {
                                        label: @tr("Style");
                                        // 与 session-editor / 原型 `.ctl-with-btn` 一致：下拉固定宽 +
                                        // manage（settings）图标钮；不用 eye，避免与 ComboBox 箭头粘成一块易误点。
                                        // 显式宽度也避开 WinComboBox preferred-width=0 在 start 对齐下塌成零宽。
                                        WinComboBox {
                                            width: Theme.form-field-width - Theme.control-height - Theme.spacing-8;
                                            model: root.settings-appearance-style-options;
                                            current-index: root.settings-appearance-style-index;
                                            selected(index) => {
                                                root.select-settings-appearance-style(index);
                                            }
                                        }
                                        WinIconButton {
                                            icon: "settings";
                                            tooltip-text: @tr("Manage terminal styles");
                                            accessible-name: @tr("Manage terminal styles");
                                            clicked => { root.open-theme-manager(); }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Default for new terminals; fonts and colors are edited in Terminal Styles.");
                                    }

                                    // 颜色方案即时预览（字体 / 配色在管理器里编辑）。
                                    // 特殊块：无 label、占满整行（与 Session Editor 预览一致）。
                                    TerminalPreview {
                                        frame: root.appearance-preview;
                                        surface-background: root.appearance-preview-background;
                                        surface-height: Theme.terminal-preview-height;
                                    }
                                }

                                // --- Terminal（D37）-----------------------------
                                if root.section == "terminal" : VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.form-row-gap;

                                    FormGroupLabel {
                                        text: @tr("Scrollback");
                                        first: true;
                                    }

                                    FormRow {
                                        label: @tr("Scrollback lines");
                                        WinTextInput {
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            text <=> root.scrollback-lines-text;
                                            placeholder-text: "10000";
                                            edited => { root.update-scrollback-lines(self.text); }
                                        }
                                    }
                                    FormRow {
                                        label: @tr("Max cells");
                                        WinTextInput {
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            text <=> root.scrollback-max-cells-text;
                                            placeholder-text: "2000000";
                                            edited => { root.update-scrollback-max-cells(self.text); }
                                        }
                                    }
                                    FormHint {
                                        text: TextFormats.settings-terminal-status(
                                            root.settings-terminal-status-kind-text,
                                            root.settings-terminal-status-field-text,
                                            root.settings-terminal-status-value-text,
                                            root.settings-terminal-status-limit-text,
                                        );
                                        hint-color: (root.settings-terminal-status-kind-text == "hint"
                                            || root.settings-terminal-status-kind-text == "saved")
                                            ? Theme.text-tertiary : Theme.critical;
                                    }

                                    FormRow {
                                        label: "";
                                        SettingsActionButton {
                                            text: @tr("Reset defaults");
                                            hint: @tr("Reset defaults");
                                            clicked => { root.reset-terminal-defaults(); }
                                        }
                                    }

                                    FormGroupLabel {
                                        text: @tr("Mouse & paste");
                                    }

                                    FormRow {
                                        label: @tr("Middle click");
                                        WinComboBox {
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            model: [@tr("Paste"), @tr("Do nothing")];
                                            current-index: root.settings-terminal-middle-click-index;
                                            selected(index) => {
                                                root.update-settings-terminal-middle-click(index);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Paste from the clipboard or ignore the click.");
                                    }

                                    FormRow {
                                        label: @tr("Right click");
                                        WinComboBox {
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            model: [@tr("Context menu"), @tr("Paste"), @tr("Do nothing")];
                                            current-index: root.settings-terminal-right-click-index;
                                            selected(index) => {
                                                root.update-settings-terminal-right-click(index);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Open the terminal menu, paste, or ignore the click.");
                                    }

                                    FormRow {
                                        label: @tr("Multi-line paste");
                                        WinComboBox {
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            model: [@tr("Ask"), @tr("Paste"), @tr("Block")];
                                            current-index: root.settings-terminal-multi-line-paste-index;
                                            selected(index) => {
                                                root.update-settings-terminal-multi-line-paste(index);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Ask before sending text with more than one line.");
                                    }

                                    FormRow {
                                        label: @tr("Auto copy");
                                        WinSwitch {
                                            text: root.settings-terminal-auto-copy ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("Auto copy");
                                            checked <=> root.settings-terminal-auto-copy;
                                            toggled => {
                                                root.update-settings-terminal-auto-copy(root.settings-terminal-auto-copy);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Copy selected terminal text to the clipboard automatically.");
                                    }
                                }

                                // --- Security（D35）----------------------------
                                if root.section == "security" : VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.form-row-gap;

                                    // Master password 卡片：图标 + 标题 + 状态 pill + 说明 + 动作区。
                                    Rectangle {
                                        background: Theme.card-fill;
                                        border-radius: Theme.radius-panel;
                                        border-width: 1px;
                                        border-color: Theme.card-stroke;

                                        VerticalLayout {
                                            padding: Theme.spacing-16;
                                            spacing: Theme.spacing-12;

                                            HorizontalLayout {
                                                spacing: Theme.spacing-12;
                                                cross-axis-alignment: center;

                                                Rectangle {
                                                    width: Theme.control-height;
                                                    height: Theme.control-height;
                                                    background: Theme.control-fill;
                                                    border-radius: Theme.radius-control;
                                                    border-width: 1px;
                                                    border-color: Theme.control-stroke;

                                                    Icon {
                                                        name: "shield";
                                                        icon-size: Theme.icon-size-small;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }

                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: @tr("Master password");
                                                    color: Theme.text-primary;
                                                    font-size: Theme.font-body-large;
                                                    font-weight: Theme.weight-semibold;
                                                    vertical-alignment: center;
                                                }

                                                Rectangle {
                                                    background: root.settings-master-password-set
                                                        ? Theme.accent-soft : Theme.control-fill;
                                                    border-radius: Theme.radius-panel;
                                                    border-width: 1px;
                                                    border-color: Theme.control-stroke;

                                                    HorizontalLayout {
                                                        padding-left: Theme.spacing-8;
                                                        padding-right: Theme.spacing-8;
                                                        Text {
                                                            text: TextFormats.master-password-status(root.settings-master-password-set);
                                                            color: Theme.text-primary;
                                                            font-size: Theme.font-caption;
                                                            font-weight: Theme.weight-semibold;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: root.settings-master-password-set
                                                    ? @tr("Sessions and keys are encrypted.")
                                                    : @tr("Sessions and keys are not encrypted.");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-8;
                                                // stretch：密码已设置时用可 stretch 的占位把
                                                // Forgot password? 推到行尾（原型 `.grow`）。
                                                alignment: stretch;

                                                if !root.settings-master-password-set : SettingsActionButton {
                                                    text: @tr("Set");
                                                    hint: @tr("Set master password");
                                                    accent: true;
                                                    clicked => { root.open-master-password-dialog("set"); }
                                                }
                                                if root.settings-master-password-set : SettingsActionButton {
                                                    text: @tr("Change");
                                                    hint: @tr("Change master password");
                                                    clicked => { root.open-master-password-dialog("change"); }
                                                }
                                                if root.settings-master-password-set : SettingsActionButton {
                                                    text: @tr("Remove");
                                                    hint: @tr("Remove master password");
                                                    clicked => { root.open-master-password-dialog("remove"); }
                                                }
                                                if root.settings-master-password-set : Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 1px;
                                                    background: transparent;
                                                }
                                                if root.settings-master-password-set : SettingsActionButton {
                                                    text: @tr("Forgot password?");
                                                    hint: @tr("Reset master password");
                                                    critical: true;
                                                    clicked => { root.open-master-password-dialog("reset"); }
                                                }
                                            }

                                            if !root.settings-master-password-set : Text {
                                                text: @tr("Set a password to encrypt saved sessions and keys.");
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }
                                            if root.settings-master-password-set : Text {
                                                text: @tr("Remove decrypts files; Reset deletes them.");
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    FormGroupLabel {
                                        text: @tr("Managers");
                                    }

                                    // 整行可点清单：图标 + 名称 + 计数 + chevron（不写摘要）。
                                    Rectangle {
                                        background: Theme.card-fill;
                                        border-radius: Theme.radius-panel;
                                        border-width: 1px;
                                        border-color: Theme.card-stroke;

                                        VerticalLayout {
                                            alignment: start;

                                            SettingsManagerRow {
                                                icon: "check";
                                                name: @tr("Known Hosts");
                                                count: root.settings-security-known-hosts-count;
                                                hint: @tr("Open Known Hosts");
                                                clicked => { root.open-host-keys(); }
                                            }
                                            Rectangle { height: 1px; background: Theme.divider; }
                                            SettingsManagerRow {
                                                icon: "file";
                                                name: @tr("Private Keys");
                                                count: root.settings-security-private-keys-count;
                                                hint: @tr("Open Private Keys");
                                                clicked => { root.open-private-keys(); }
                                            }
                                            Rectangle { height: 1px; background: Theme.divider; }
                                            SettingsManagerRow {
                                                icon: "globe";
                                                name: @tr("Proxies");
                                                count: root.settings-security-proxies-count;
                                                hint: @tr("Open Proxies");
                                                clicked => { root.open-proxies(); }
                                            }
                                        }
                                    }
                                }

                                // --- SFTP（D33）--------------------------------
                                if root.section == "sftp" : VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.form-row-gap;

                                    FormRow {
                                        label: @tr("Show hidden");
                                        WinSwitch {
                                            text: root.settings-sftp-show-hidden ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("Show hidden");
                                            checked <=> root.settings-sftp-show-hidden;
                                            toggled => {
                                                root.update-settings-sftp-show-hidden(root.settings-sftp-show-hidden);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("New SFTP tabs start with hidden files shown.");
                                    }

                                    FormRow {
                                        label: @tr("Conflict");
                                        WinComboBox {
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            model: [@tr("Ask"), @tr("Replace"), @tr("Skip"), @tr("Stop")];
                                            current-index: root.settings-sftp-conflict-index;
                                            selected(index) => {
                                                root.update-settings-sftp-conflict-action(index);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Ask opens a dialog; the others apply automatically.");
                                    }

                                    FormRow {
                                        label: @tr("External editor");
                                        WinComboBox {
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            // Rust 投影稳定 id（`system-default` / `custom` / 编辑器名），
                                            // 显示文案用 @tr 映射（`TextFormats.settings-sftp-editor-label`）。
                                            model: root.settings-sftp-editor-options;
                                            has-label-map: true;
                                            label-for(id) => {
                                                return TextFormats.settings-sftp-editor-label(id);
                                            }
                                            current-index: root.settings-sftp-editor-index;
                                            selected(index) => {
                                                root.update-settings-sftp-external-editor(index);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Used to open remote files for editing.");
                                    }

                                    if root.settings-sftp-editor-custom-visible : FormRow {
                                        label: "";
                                        WinTextInput {
                                            max-width: 388px;
                                            horizontal-stretch: 1;
                                            text <=> root.settings-sftp-editor-path-text;
                                            placeholder-text: @tr("Path to editor executable");
                                            edited => {
                                                root.update-settings-sftp-external-editor-path(self.text);
                                            }
                                        }
                                        WinIconButton {
                                            icon: "folder";
                                            tooltip-text: @tr("Browse");
                                            accessible-name: @tr("Browse");
                                            clicked => { root.browse-settings-sftp-external-editor(); }
                                        }
                                    }

                                    FormHint {
                                        text: TextFormats.settings-sftp-status(
                                            root.settings-sftp-status-kind-text,
                                            "",
                                        );
                                        hint-color: root.settings-sftp-status-kind-text == "custom-editor-path-required"
                                            ? Theme.critical : Theme.text-tertiary;
                                    }
                                }

                                // --- MCP（D34：Enable / Port / Listen / API key /
                                // View user / Control user / Auto-approve）----------------
                                if root.section == "mcp" : VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.form-row-gap;

                                    FormRow {
                                        label: @tr("Enable");
                                        WinSwitch {
                                            text: root.mcp-enabled ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("Enable");
                                            checked <=> root.mcp-enabled;
                                            toggled => { root.set-mcp-enabled(root.mcp-enabled); }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Off by default; other MCP controls are disabled.");
                                    }

                                    FormRow {
                                        label: @tr("Port");
                                        WinTextInput {
                                            width: Theme.form-port-width;
                                            enabled: root.mcp-enabled;
                                            text <=> root.mcp-port-text;
                                            accepted => { root.update-mcp-port(root.mcp-port-text); }
                                            edited => { root.update-mcp-port(root.mcp-port-text); }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("1–65535.");
                                    }

                                    FormRow {
                                        label: @tr("Listen");
                                        HorizontalLayout {
                                            spacing: Theme.spacing-8;
                                            SettingsMethodButton {
                                                text: @tr("Local");
                                                hint: @tr("Local = 127.0.0.1");
                                                selected: !root.mcp-listen-lan;
                                                enabled: root.mcp-enabled;
                                                clicked => { root.set-mcp-listen-lan(false); }
                                            }
                                            SettingsMethodButton {
                                                text: @tr("LAN");
                                                hint: @tr("LAN = 0.0.0.0; API key required");
                                                selected: root.mcp-listen-lan;
                                                enabled: root.mcp-enabled;
                                                clicked => { root.set-mcp-listen-lan(true); }
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Local = 127.0.0.1; LAN = 0.0.0.0.");
                                    }

                                    FormRow {
                                        label: @tr("API key");
                                        HorizontalLayout {
                                            spacing: Theme.spacing-8;
                                            max-width: Theme.form-field-width;
                                            horizontal-stretch: 1;
                                            WinTextInput {
                                                horizontal-stretch: 1;
                                                enabled: root.mcp-enabled;
                                                input-type: password;
                                                text <=> root.mcp-api-key-text;
                                                placeholder-text: @tr("Required for LAN");
                                                edited => { root.update-mcp-api-key(root.mcp-api-key-text); }
                                                accepted => { root.update-mcp-api-key(root.mcp-api-key-text); }
                                            }
                                            WinIconButton {
                                                icon: "refresh";
                                                enabled: root.mcp-enabled;
                                                accessible-name: @tr("Generate");
                                                tooltip-text: @tr("Generate");
                                                clicked => { root.generate-mcp-api-key(); }
                                            }
                                            WinIconButton {
                                                icon: "copy";
                                                enabled: root.mcp-enabled && root.mcp-api-key-text != "";
                                                accessible-name: @tr("Copy");
                                                tooltip-text: @tr("Copy");
                                                clicked => { root.copy-mcp-api-key(); }
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Required for LAN.");
                                    }

                                    FormRow {
                                        label: @tr("View user");
                                        WinSwitch {
                                            text: root.mcp-view-user-connections ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("View user");
                                            enabled: root.mcp-enabled;
                                            checked <=> root.mcp-view-user-connections;
                                            toggled => {
                                                root.set-mcp-view-user-connections(root.mcp-view-user-connections);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("AI can see user-created connections.");
                                    }

                                    FormRow {
                                        label: @tr("Control user");
                                        WinSwitch {
                                            text: root.mcp-control-user-connections ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("Control user");
                                            enabled: root.mcp-enabled;
                                            checked <=> root.mcp-control-user-connections;
                                            toggled => {
                                                root.set-mcp-control-user-connections(root.mcp-control-user-connections);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("AI can operate user-created connections.");
                                    }

                                    FormRow {
                                        label: @tr("Auto-approve");
                                        WinSwitch {
                                            text: root.mcp-auto-approve-control-enabled ? @tr("On") : @tr("Off");
                                            accessible-name: @tr("Auto-approve");
                                            checked <=> root.mcp-auto-approve-control-enabled;
                                            enabled: root.mcp-enabled;
                                            toggled => {
                                                root.set-mcp-auto-approve-control(root.mcp-auto-approve-control-enabled);
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Skip the control consent dialog.");
                                    }

                                    FormHint {
                                        text: TextFormats.settings-mcp-status(
                                            root.mcp-status-kind-text,
                                            root.mcp-status-detail-text,
                                        );
                                        hint-color: root.mcp-status-kind-text == "failed"
                                            ? Theme.critical : Theme.text-tertiary;
                                    }

                                    FormHint {
                                        text: @tr("Add this stdio server in your AI host; do not run it yourself.");
                                    }
                                    HorizontalLayout {
                                        spacing: 0px;
                                        alignment: start;

                                        Rectangle {
                                            width: Theme.form-label-width + Theme.spacing-12;
                                            height: 1px;
                                            background: transparent;
                                        }
                                        Text {
                                            text: "command = \"yshell\", args = [\"--mcp\"]";
                                            color: Theme.text-primary;
                                            font-size: Theme.font-caption;
                                            font-family: Theme.font-mono;
                                            wrap: no-wrap;
                                            overflow: elide;
                                        }
                                    }
                                }

                                // --- Advanced ----------------------------------
                                if root.section == "advanced" : VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.form-row-gap;

                                    FormRow {
                                        label: @tr("Debug logging");
                                        HorizontalLayout {
                                            spacing: Theme.spacing-8;
                                            alignment: start;
                                            WinSwitch {
                                                text: root.debug-logging-enabled ? @tr("On") : @tr("Off");
                                                accessible-name: @tr("Debug logging");
                                                checked <=> root.debug-logging-enabled;
                                                toggled => {
                                                    root.set-debug-logging(root.debug-logging-enabled);
                                                }
                                            }
                                            WinIconButton {
                                                icon: "folder";
                                                tooltip-text: @tr("Open debug log folder");
                                                accessible-name: @tr("Open debug log folder");
                                                clicked => { root.open-debug-log-dir(); }
                                            }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Writes logs under the config directory.");
                                    }

                                    FormRow {
                                        label: @tr("Config directory");
                                        WinTextInput {
                                            max-width: 388px;
                                            horizontal-stretch: 1;
                                            read-only: true;
                                            text: root.config-dir-text;
                                        }
                                        WinIconButton {
                                            icon: "folder";
                                            tooltip-text: @tr("Open config directory");
                                            accessible-name: @tr("Open config directory");
                                            clicked => { root.open-config-dir(); }
                                        }
                                    }
                                    FormHint {
                                        text: @tr("Read-only path to sessions, keys, and logs.");
                                    }
                                }
                            }
                        }

                        // 滚动指示：E22 可复用组件（内部按 `-content-y` 计算进度）。
                        WinScrollIndicator {
                            x: scroll.width - self.width - Theme.spacing-4;
                            y: Theme.spacing-4;
                            height: parent.height - 2 * Theme.spacing-4;
                            viewport-position: scroll.content-y;
                            content-extent: scroll.content-height;
                            viewport-extent: scroll.height;
                            thumb-min-length: 24px;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.layer-stroke;
        }

        // 操作区（固定）：Cancel | Save（Save = 保存并关闭；分区内不放 Save）。
        HorizontalLayout {
            alignment: end;
            spacing: Theme.spacing-8;

            SettingsActionButton {
                text: @tr("Cancel");
                hint: @tr("Discard changes and close");
                clicked => { root.close(); }
            }
            SettingsActionButton {
                text: @tr("Save");
                hint: @tr("Save all sections and close");
                accent: true;
                clicked => { root.save-settings(); }
            }
        }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        shell.focus-dialog();
    }

    changed open => {
        if (root.open) {
            shell.focus-dialog();
        }
    }
}
