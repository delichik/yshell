import { Theme } from "../theme.slint";
import { WinButton, WinComboBox, WinIconButton, WinNavItem, WinScrollIndicator, WinToggle } from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { TerminalPreview } from "../components/terminal_preview.slint";
import { ManagerDialogShell } from "../components/manager_dialog_shell.slint";

// 分区导航项：WinNavItem + 可选的禁用说明 tooltip。
// （基础控件 WinNavItem 不属本文件；Tooltip 必须声明在其直接父元素下，故包一层薄壳。）
component SettingsNavItem inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "settings";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    /// 非空且禁用时，hover 显示"本版本未提供"一类说明（契约 §18：disabled 必须有 tooltip）
    in property <string> hint: "";
    callback clicked();

    height: Theme.row-height-nav;
    background: transparent;

    WinNavItem {
        width: parent.width;
        height: parent.height;
        text: root.text;
        icon: root.icon;
        selected: root.selected;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if !root.enabled && root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// Appearance 表单的标签 + 控件行（右对齐标签列，消除自由文本时代的错位）。
// 标签列 128px：比 Theme.form-label-width 略宽，容纳 Foreground / Fallback font。
component AppearanceFieldRow inherits HorizontalLayout {
    in property <string> label: "";
    spacing: Theme.spacing-12;
    alignment: stretch;
    // 交叉轴（垂直）居中：28px 色块与控件、右对齐标签在同一水平线；
    // 固定尺寸子项不再贴顶（默认 stretch 会把它们放在 padding.begin）。
    cross-axis-alignment: center;

    Text {
        text: root.label;
        width: Theme.form-label-width-medium;
        horizontal-alignment: right;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }

    @children
}

// Settings dialog：左导航多分区（General / Appearance / Terminal / Security /
// Advanced）；SFTP / Shortcuts 本版本禁用。Host Keys / Private Keys 以独立页打开。
//
// WinUI 3 形态：标题 → 左导航 + 右滚动表单 → 固定关闭操作区。
// 面板高度固定（与 Session Editor 同理），切换分区时导航不跳动。

export component SettingsDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> config-dir-text: "";
    in property <string> secret-store-status-text: "";
    in-out property <string> scrollback-lines-text: "";
    in-out property <string> scrollback-max-cells-text: "";
    /// 设置页「SFTP」分区的最大并行传输数。
    in-out property <string> settings-sftp-max-parallel-transfers-text: "4";
    in property <string> terminal-status-text: "";
    /// UI language preference: `system` / `zh-CN` / `en-US`.
    in property <string> language-text: "system";
    /// Process debug logging preference (writes under the config directory).
    in-out property <bool> debug-logging-enabled: false;
    /// Confirm before closing a session that still has an active connection.
    in-out property <bool> confirm-close-session-enabled: true;
    /// Confirm before quitting YShell.
    in-out property <bool> confirm-quit-app-enabled: true;
    /// Absolute path of the debug log directory.
    in property <string> debug-log-dir-text: "";
    /// Active left-nav section id.
    in-out property <string> section: "general";

    // N5：Appearance 分区（字体 + 当前主题摘要；主题管理在独立 Theme Manager）。
    in property <string> appearance-color-scheme-name-text: "";
    in property <bool> appearance-color-scheme-builtin: false;
    in property <[color]> appearance-palette-swatches: [];
    in property <[string]> appearance-font-options: [];
    in-out property <int> appearance-font-index: 0;
    in-out property <string> appearance-font-size-text: "";
    in-out property <string> appearance-fallback-fonts-text: "";
    in property <string> appearance-status-text: "";
    in property <image> appearance-preview;
    /// 预览表面底色（跟随预览配色；见 `terminal_preview.slint`）。
    in property <color> appearance-preview-background: Theme.terminal-surface;

    callback close();
    callback open-host-keys();
    callback open-private-keys();
    callback open-proxies();
    callback open-theme-manager();
    callback update-scrollback-lines(string);
    callback update-scrollback-max-cells(string);
    callback update-settings-sftp-max-parallel-transfers(string);
    callback save-settings-sftp();
    callback reset-terminal-defaults();
    callback save-terminal-settings();
    callback set-language(string);
    callback set-debug-logging(bool);
    callback set-confirm-close-session(bool);
    callback set-confirm-quit-app(bool);
    callback open-debug-log-dir();
    // Appearance（字体；主题编辑已迁移到 Theme Manager）
    callback select-appearance-font(int);
    callback update-appearance-font-size(string);
    callback bump-appearance-font-size(int);
    callback update-appearance-fallback-fonts(string);
    callback browse-appearance-font-file();
    callback browse-appearance-fallback-font();
    callback clear-appearance-fallbacks();
    callback reset-appearance-defaults();
    callback save-appearance();

    visible: root.open || shell.opacity > 0.01;
    background: transparent;

    shell := ManagerDialogShell {
        width: 100%;
        height: 100%;
        open: root.open;
        title-text: @tr("Settings");
        summary-text: "";
        close => { root.close(); }

        // 主体：左侧分区导航 + 右侧表单
        HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.spacing-12;

                    // 分区导航（NavigationView 形态）
                    Rectangle {
                        width: Theme.nav-width;
                        vertical-stretch: 1;
                        background: Theme.layer-fill;
                        border-radius: Theme.radius-panel;
                        border-width: 1px;
                        border-color: Theme.layer-stroke;

                        VerticalLayout {
                            padding: Theme.spacing-8;
                            spacing: 2px;
                            alignment: start;

                            SettingsNavItem {
                                text: @tr("General");
                                icon: "settings";
                                selected: root.section == "general";
                                clicked => { root.section = "general"; }
                            }
                            SettingsNavItem {
                                text: @tr("Appearance");
                                icon: "eye";
                                selected: root.section == "appearance";
                                clicked => { root.section = "appearance"; }
                            }
                            SettingsNavItem {
                                text: @tr("Terminal");
                                icon: "terminal";
                                selected: root.section == "terminal";
                                clicked => { root.section = "terminal"; }
                            }
                            SettingsNavItem {
                                text: @tr("Security");
                                icon: "shield";
                                selected: root.section == "security";
                                clicked => { root.section = "security"; }
                            }
                            SettingsNavItem {
                                text: @tr("Advanced");
                                icon: "code";
                                selected: root.section == "advanced";
                                clicked => { root.section = "advanced"; }
                            }
                            SettingsNavItem {
                                text: @tr("SFTP");
                                icon: "folder";
                                selected: root.section == "sftp";
                                clicked => { root.section = "sftp"; }
                            }
                            SettingsNavItem {
                                text: @tr("Shortcuts");
                                icon: "edit";
                                enabled: false;
                                hint: @tr("Not available in this version.");
                            }
                        }
                    }

                    // 表单卡片（内容区滚动）
                    Rectangle {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        background: Theme.card-fill;
                        border-radius: Theme.radius-panel;
                        border-width: 1px;
                        border-color: Theme.card-stroke;

                        VerticalLayout {
                            padding: Theme.spacing-16;
                            spacing: Theme.spacing-12;

                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                background: transparent;

                                scroll := Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    interactive: true;
                                    content-width: self.width;
                                    content-height: sections.preferred-height;

                                    sections := VerticalLayout {
                                        alignment: start;
                                        spacing: Theme.spacing-12;

                                        // --- General ------------------------------------------
                                        if root.section == "general" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            Text {
                                                text: @tr("Language");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body-large;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Text {
                                                text: @tr("Default follows the operating system. Changes apply immediately.");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-8;
                                                cross-axis-alignment: center;

                                                WinButton {
                                                    text: @tr("System");
                                                    accent: root.language-text == "system";
                                                    clicked => { root.set-language("system"); }
                                                }
                                                WinButton {
                                                    text: @tr("Chinese (Simplified)");
                                                    accent: root.language-text == "zh-CN";
                                                    clicked => { root.set-language("zh-CN"); }
                                                }
                                                WinButton {
                                                    text: @tr("English");
                                                    accent: root.language-text == "en-US";
                                                    clicked => { root.set-language("en-US"); }
                                                }
                                            }

                                            Rectangle {
                                                height: 1px;
                                                background: Theme.divider;
                                            }

                                            Text {
                                                text: @tr("Confirmations");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body-large;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Text {
                                                text: @tr("Turn off a confirmation to close or quit without asking. You can turn it back on here at any time.");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            WinToggle {
                                                text: @tr("Confirm before closing a session");
                                                checked <=> root.confirm-close-session-enabled;
                                                toggled => {
                                                    root.set-confirm-close-session(root.confirm-close-session-enabled);
                                                }
                                                horizontal-stretch: 0;
                                            }

                                            WinToggle {
                                                text: @tr("Confirm before quitting YShell");
                                                checked <=> root.confirm-quit-app-enabled;
                                                toggled => {
                                                    root.set-confirm-quit-app(root.confirm-quit-app-enabled);
                                                }
                                                horizontal-stretch: 0;
                                            }

                                            Rectangle {
                                                height: 1px;
                                                background: Theme.divider;
                                            }

                                            // §6.4：统一动画开关。Theme.reduce-motion
                                            // 为 true 时所有 Theme.duration-* 归零，
                                            // 界面只剩状态色即时切换（§6.1.5 / §6.2 motion.instant）。
                                            // 方向：勾上"减少动画"= 关掉动效（绑 reduce-motion，
                                            // 不要直接绑 animations-enabled，那会把语义写反）。
                                            Text {
                                                text: @tr("Motion");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body-large;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Text {
                                                text: @tr("Reduce motion turns off transitions. State colors still change instantly.");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            WinToggle {
                                                text: @tr("Reduce motion");
                                                checked <=> Theme.reduce-motion;
                                                horizontal-stretch: 0;
                                            }
                                        }

                                        // --- Appearance（内联；原嵌套弹窗主体迁入此分区）------
                                        if root.section == "appearance" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            Text {
                                                text: @tr("Appearance");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body-large;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Text {
                                                text: @tr("Global defaults for terminals opened after saving. Open terminals keep their theme.");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: @tr("Current theme");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Rectangle {
                                                background: Theme.card-fill;
                                                border-radius: Theme.radius-control;
                                                border-width: 1px;
                                                border-color: Theme.card-stroke;

                                                HorizontalLayout {
                                                    padding: Theme.spacing-12;
                                                    spacing: Theme.spacing-12;
                                                    cross-axis-alignment: center;

                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        spacing: Theme.spacing-4;

                                                        HorizontalLayout {
                                                            spacing: Theme.spacing-8;
                                                            cross-axis-alignment: center;

                                                            Text {
                                                                horizontal-stretch: 1;
                                                                text: root.appearance-color-scheme-name-text;
                                                                color: Theme.text-primary;
                                                                font-size: Theme.font-body;
                                                                font-weight: Theme.weight-semibold;
                                                                wrap: no-wrap;
                                                                overflow: elide;
                                                            }

                                                            Text {
                                                                text: root.appearance-color-scheme-builtin
                                                                    ? @tr("Built-in theme")
                                                                    : @tr("Custom theme");
                                                                color: Theme.text-tertiary;
                                                                font-size: Theme.font-caption;
                                                                wrap: no-wrap;
                                                            }
                                                        }

                                                        HorizontalLayout {
                                                            spacing: 3px;
                                                            cross-axis-alignment: center;

                                                            for swatch in root.appearance-palette-swatches : Rectangle {
                                                                width: 14px;
                                                                height: 14px;
                                                                border-radius: 3px;
                                                                border-width: 1px;
                                                                border-color: Theme.control-stroke;
                                                                background: swatch;
                                                            }
                                                        }
                                                    }

                                                    WinButton {
                                                        text: @tr("Manage themes…");
                                                        icon: "eye";
                                                        clicked => { root.open-theme-manager(); }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: @tr("Clone, edit and delete color themes in the Theme Manager. Font settings apply to every theme.");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            Rectangle { height: 1px; background: Theme.divider; }

                                            Text {
                                                text: @tr("Font");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            AppearanceFieldRow {
                                                label: @tr("Font family");
                                                WinComboBox {
                                                    horizontal-stretch: 1;
                                                    model: root.appearance-font-options;
                                                    current-index <=> root.appearance-font-index;
                                                    placeholder-text: @tr("DejaVu Sans Mono");
                                                    selected(index) => { root.select-appearance-font(index); }
                                                }
                                                WinButton {
                                                    text: @tr("Add Font File…");
                                                    clicked => { root.browse-appearance-font-file(); }
                                                }
                                            }

                                            AppearanceFieldRow {
                                                label: @tr("Font size");
                                                HorizontalLayout {
                                                    spacing: Theme.spacing-4;
                                                    WinIconButton {
                                                        icon: "chevron-left";
                                                        accessible-name: @tr("Decrease font size");
                                                        clicked => { root.bump-appearance-font-size(-1); }
                                                    }
                                                    Text {
                                                        text: root.appearance-font-size-text;
                                                        color: Theme.text-primary;
                                                        font-size: Theme.font-body;
                                                        vertical-alignment: center;
                                                        horizontal-alignment: center;
                                                        width: 40px;
                                                    }
                                                    WinIconButton {
                                                        icon: "chevron-right";
                                                        accessible-name: @tr("Increase font size");
                                                        clicked => { root.bump-appearance-font-size(1); }
                                                    }
                                                    Text {
                                                        text: @tr("Logical pixels (6-72)");
                                                        color: Theme.text-tertiary;
                                                        font-size: Theme.font-caption;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                }
                                            }

                                            AppearanceFieldRow {
                                                label: @tr("Fallback font");
                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.appearance-fallback-fonts-text;
                                                    placeholder-text: @tr("Font file path");
                                                    edited => { root.update-appearance-fallback-fonts(self.text); }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-8;
                                                padding-left: Theme.form-label-width-medium + Theme.spacing-12;
                                                alignment: start;

                                                WinButton {
                                                    text: @tr("Select File…");
                                                    clicked => { root.browse-appearance-fallback-font(); }
                                                }
                                                WinButton {
                                                    text: @tr("Clear");
                                                    clicked => { root.clear-appearance-fallbacks(); }
                                                }
                                            }

                                            Rectangle { height: 1px; background: Theme.divider; }

                                            Text {
                                                text: @tr("Live preview");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            // TERM-2：live preview 与真实终端共用
                                            // `TerminalPreview` 的像素契约（Rust 按物理
                                            // 像素光栅化，1phx 1:1 显示、pixelated、绝不
                                            // 缩放）。尺寸契约：卡内容宽 434px − 2px 边框
                                            // − 2×6px 终端内边距 = 420px；高 200px − 2px
                                            // 边框 = 198px，对应 Rust 侧
                                            // `SETTINGS_PREVIEW_AREA_PX`（放不下时 Rust
                                            // 减少渲染行列）。
                                            TerminalPreview {
                                                frame: root.appearance-preview;
                                                surface-background: root.appearance-preview-background;
                                            }

                                            Text {
                                                text: root.appearance-status-text;
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-8;
                                                alignment: end;

                                                WinButton {
                                                    text: @tr("Reset Defaults");
                                                    clicked => { root.reset-appearance-defaults(); }
                                                }
                                                WinButton {
                                                    text: @tr("Save");
                                                    accent: true;
                                                    clicked => { root.save-appearance(); }
                                                }
                                            }
                                        }

                                        // --- Terminal -----------------------------------------
                                        if root.section == "terminal" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            Text {
                                                text: @tr("Terminal");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body-large;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-12;

                                                // 标签列：右对齐。左对齐 + 固定宽会在标签与输入框之间留下空洞。
                                                // 列宽用 Theme.form-label-width-wide（宽标签档），不再写死 220px。
                                                Text {
                                                    text: @tr("Scrollback lines");
                                                    width: Theme.form-label-width-wide;
                                                    horizontal-alignment: right;
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-body;
                                                    vertical-alignment: center;
                                                }

                                                // 输入框：WinTextInput 自带 control-fill 底 + control-stroke 描边 + 聚焦强调条（§5.2）
                                                scrollback-lines-input := WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.scrollback-lines-text;
                                                    placeholder-text: "10000";
                                                    edited => { root.update-scrollback-lines(self.text); }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-12;

                                                Text {
                                                    text: @tr("Scrollback memory cap (cells)");
                                                    width: Theme.form-label-width-wide;
                                                    horizontal-alignment: right;
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-body;
                                                    vertical-alignment: center;
                                                }

                                                scrollback-cells-input := WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.scrollback-max-cells-text;
                                                    placeholder-text: "2000000";
                                                    edited => { root.update-scrollback-max-cells(self.text); }
                                                }
                                            }

                                            Text {
                                                text: @tr("Scrollback is stored compressed (about 3 MB per session at the defaults). Both the line count and the total cell count are enforced.");
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: @tr("Allowed range: 100-1000000 lines, 100000-100000000 cells.");
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-8;
                                                alignment: end;

                                                WinButton {
                                                    text: @tr("Reset Defaults");
                                                    clicked => { root.reset-terminal-defaults(); }
                                                }

                                                WinButton {
                                                    text: @tr("Save Terminal Settings");
                                                    accent: true;
                                                    clicked => { root.save-terminal-settings(); }
                                                }
                                            }

                                            Text {
                                                text: root.terminal-status-text;
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }
                                        }

                                        // --- SFTP --------------------------------------------
                                        if root.section == "sftp" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            Text {
                                                text: @tr("SFTP");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body-large;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Text {
                                                text: @tr("How many uploads and downloads may run at the same time. A higher value is faster on fast links but uses more bandwidth.");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            AppearanceFieldRow {
                                                label: @tr("Max parallel transfers");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.settings-sftp-max-parallel-transfers-text;
                                                    placeholder-text: "4";
                                                    font-family: Theme.font-mono;
                                                    edited(text) => { root.update-settings-sftp-max-parallel-transfers(text); }
                                                }
                                            }

                                            Text {
                                                text: @tr("Allowed range: 1-16 transfers.");
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-8;
                                                alignment: end;

                                                WinButton {
                                                    text: @tr("Save SFTP Settings");
                                                    accent: true;
                                                    clicked => { root.save-settings-sftp(); }
                                                }
                                            }
                                        }

                                        // --- Security -----------------------------------------
                                        if root.section == "security" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            Text {
                                                text: @tr("Security");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body-large;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Text {
                                                text: root.secret-store-status-text;
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: @tr("Config directory: {0}", root.config-dir-text);
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            // 三个长入口纵向堆叠，避免 760 里横挤截断。
                                            VerticalLayout {
                                                spacing: Theme.spacing-8;
                                                alignment: start;

                                                WinButton {
                                                    text: @tr("Open Host Keys…");
                                                    clicked => { root.open-host-keys(); }
                                                }

                                                WinButton {
                                                    text: @tr("Open Private Keys…");
                                                    clicked => { root.open-private-keys(); }
                                                }

                                                WinButton {
                                                    text: @tr("Open Proxy Manager…");
                                                    clicked => { root.open-proxies(); }
                                                }
                                            }
                                        }

                                        // --- Advanced -----------------------------------------
                                        if root.section == "advanced" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            Text {
                                                text: @tr("Advanced");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body-large;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Text {
                                                text: @tr("Config directory");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                            }

                                            Text {
                                                text: root.config-dir-text;
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body;
                                                font-family: Theme.font-mono;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: @tr("Application data, sessions, and related files live under this directory.");
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            Rectangle { height: 1px; background: Theme.divider; }

                                            Text {
                                                text: @tr("Debug logging");
                                                color: Theme.text-primary;
                                                font-size: Theme.font-body;
                                                font-weight: Theme.weight-semibold;
                                            }

                                            Text {
                                                text: @tr("When enabled, diagnostic logs are written under the config directory. The console window stays hidden.");
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-body;
                                                wrap: word-wrap;
                                            }

                                            WinToggle {
                                                text: @tr("Record debug logs");
                                                checked <=> root.debug-logging-enabled;
                                                toggled => {
                                                    root.set-debug-logging(root.debug-logging-enabled);
                                                }
                                            }

                                            Text {
                                                text: root.debug-log-dir-text;
                                                color: Theme.text-primary;
                                                font-size: Theme.font-caption;
                                                font-family: Theme.font-mono;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.spacing-8;
                                                alignment: start;

                                                WinButton {
                                                    text: @tr("Open Log Folder");
                                                    clicked => { root.open-debug-log-dir(); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // 滚动指示：E22 可复用组件（内部按 `-content-y` 计算进度）。
                                WinScrollIndicator {
                                    x: scroll.width - self.width - Theme.spacing-4;
                                    y: Theme.spacing-4;
                                    height: parent.height - 2 * Theme.spacing-4;
                                    viewport-position: scroll.content-y;
                                    content-extent: scroll.content-height;
                                    viewport-extent: scroll.height;
                                    thumb-min-length: 24px;
                                }
                            }
                        }
                    }
                }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        // 操作区（固定）：右对齐
        HorizontalLayout {
            alignment: end;

            WinButton {
                text: @tr("Close");
                clicked => { root.close(); }
            }
        }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        shell.focus-dialog();
    }

    changed open => {
        if (root.open) {
            shell.focus-dialog();
        }
    }
}
