import { Theme } from "../theme.slint";
import { WinButton, WinIconButton, WinNavItem } from "../components/basic/controls.slint";
import { WinTextInput } from "../components/basic/text_input.slint";

// 表单行：左侧固定宽度标签 + 右侧控件（子元素放进右侧横向布局）
component FormRow inherits Rectangle {
    in property <string> label: "";
    in property <length> label-width: 116px;

    height: Theme.control-height;
    background: transparent;

    HorizontalLayout {
        spacing: Theme.spacing-12;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            width: root.label-width;
            height: root.height;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            HorizontalLayout {
                spacing: Theme.spacing-8;
                @children
            }
        }
    }
}

// 小节标题
component SectionTitle inherits Text {
    in property <string> heading: "";
    text: root.heading;
    color: Theme.text-primary;
    font-size: Theme.font-body-large;
    font-weight: Theme.weight-semibold;
}

// 分组小标题
component GroupTitle inherits Text {
    in property <string> heading: "";
    text: root.heading;
    color: Theme.text-secondary;
    font-size: Theme.font-body;
    font-weight: Theme.weight-semibold;
}

// 字段说明 / 路径 / 状态：低对比小字
component HintText inherits Text {
    in property <string> hint: "";
    text: root.hint;
    color: Theme.text-tertiary;
    font-size: Theme.font-caption;
    wrap: word-wrap;
}

export component SessionEditor inherits Rectangle {
    in property <bool> open: false;
    in property <string> section: "general";
    in property <string> target-text: "";
    in property <string> folder-text: "";
    in-out property <string> new-folder-name: "";
    in-out property <string> name-text: "";
    in-out property <string> host-text: "";
    in-out property <string> port-text: "22";
    in-out property <string> username-text: "";
    in property <string> auth-method-text: "agent";
    in property <string> host-key-policy-text: "strict";
    in-out property <string> password-text: "";
    in-out property <string> key-path-text: "";
    in-out property <string> passphrase-text: "";
    in property <string> auth-test-status-text: "";
    in property <string> proxy-mode-text: "none";
    in property <string> proxy-protocol-text: "socks5";
    in-out property <string> proxy-host-text: "";
    in-out property <string> proxy-port-text: "";
    in-out property <string> proxy-username-text: "";
    in-out property <string> proxy-password-text: "";
    in property <bool> proxy-dns-by-proxy: true;
    in property <string> proxy-summary-text: "";
    in property <string> tunnel-kind-text: "local";
    in-out property <string> tunnel-bind-host-text: "127.0.0.1";
    in-out property <string> tunnel-bind-port-text: "";
    in-out property <string> tunnel-target-host-text: "";
    in-out property <string> tunnel-target-port-text: "";
    in property <string> tunnel-summary-text: "";
    in property <string> logging-enabled-text: "disabled";
    in property <string> logging-format-text: "sanitized";
    in-out property <string> logging-directory-text: "";
    in property <string> logging-summary-text: "";
    in property <string> secret-store-status-text: "";
    in-out property <string> secret-reset-confirmation-text: "";
    in property <string> config-dir-text: "";

    callback close();
    callback select-general();
    callback select-authentication();
    callback select-terminal();
    callback select-sftp();
    callback select-tunnels();
    callback select-proxy();
    callback select-logging();
    callback select-advanced();
    callback select-appearance();
    callback select-folder-prev();
    callback select-folder-next();
    callback update-new-folder-name(string);
    callback create-folder();
    callback update-name(string);
    callback update-host(string);
    callback update-port(string);
    callback update-username(string);
    callback set-auth-method-agent();
    callback set-auth-method-password();
    callback set-auth-method-keyboard-interactive();
    callback set-auth-method-private-key();
    callback set-host-key-policy-strict();
    callback set-host-key-policy-trust-on-first-use();
    callback set-host-key-policy-accept-any-for-testing();
    callback update-password(string);
    callback update-key-path(string);
    callback update-passphrase(string);
    callback test-auth();
    callback set-proxy-mode-none();
    callback set-proxy-mode-custom();
    callback set-proxy-protocol-socks4();
    callback set-proxy-protocol-socks4a();
    callback set-proxy-protocol-socks5();
    callback set-proxy-protocol-http-connect();
    callback update-proxy-host(string);
    callback update-proxy-port(string);
    callback update-proxy-username(string);
    callback update-proxy-password(string);
    callback toggle-proxy-dns-by-proxy();
    callback set-tunnel-kind-local();
    callback set-tunnel-kind-remote();
    callback set-tunnel-kind-dynamic();
    callback update-tunnel-bind-host(string);
    callback update-tunnel-bind-port(string);
    callback update-tunnel-target-host(string);
    callback update-tunnel-target-port(string);
    callback add-tunnel();
    callback clear-tunnels();
    callback toggle-logging-enabled();
    callback set-logging-format-raw();
    callback set-logging-format-sanitized();
    callback update-logging-directory(string);
    callback save-logging-settings();
    callback reset-secrets();
    callback update-secret-reset-confirmation(string);
    callback save();
    callback save-connect();

    visible: self.open;
    background: Theme.scrim;

    // 拦截底层交互（模态）
    TouchArea { width: parent.width; height: parent.height; }

    panel := Rectangle {
        x: (parent.width - 760px) / 2;
        y: max((parent.height - self.height) / 2, 40px);
        width: 760px;
        // 高度随内容收缩，上限保持原视觉高度（屏幕 85% 以内）
        height: min(parent.height - 80px, panel-body.preferred-height);
        background: Theme.panel-background;
        border-radius: Theme.radius-panel;
        border-width: 1px;
        border-color: Theme.control-stroke;

        panel-body := VerticalLayout {
            padding: Theme.spacing-20;
            spacing: Theme.spacing-12;

            // --- 标题行 ---------------------------------------------------
            HorizontalLayout {
                spacing: Theme.spacing-12;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    alignment: start;

                    Text {
                        text: @tr("Session Editor");
                        color: Theme.text-primary;
                        font-size: Theme.font-subtitle;
                        font-weight: Theme.weight-semibold;
                    }

                    Text {
                        text: root.target-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-caption;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }

                WinIconButton {
                    icon: "close";
                    accessible-name: @tr("Close");
                    clicked => { root.close(); }
                }
            }

            Rectangle { height: 1px; background: Theme.layer-stroke; }

            // --- 主体：左侧分区导航 + 右侧表单 -----------------------------
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: Theme.spacing-12;

                // 分区导航（NavigationView 形态：40px 行高 + 选中强调条）
                Rectangle {
                    width: 180px;
                    vertical-stretch: 1;
                    background: Theme.layer-fill;
                    border-radius: Theme.radius-panel;
                    border-width: 1px;
                    border-color: Theme.layer-stroke;

                    VerticalLayout {
                        padding: Theme.spacing-8;
                        spacing: 2px;
                        alignment: start;

                        WinNavItem { text: @tr("General"); icon: "settings"; selected: root.section == "general"; clicked => { root.select-general(); } }
                        WinNavItem { text: @tr("Authentication"); icon: "shield"; selected: root.section == "authentication"; clicked => { root.select-authentication(); } }
                        WinNavItem { text: @tr("Terminal"); icon: "terminal"; selected: root.section == "terminal"; clicked => { root.select-terminal(); } }
                        WinNavItem { text: @tr("SFTP"); icon: "folder"; selected: root.section == "sftp"; clicked => { root.select-sftp(); } }
                        WinNavItem { text: @tr("Tunnels"); icon: "connect"; selected: root.section == "tunnels"; clicked => { root.select-tunnels(); } }
                        WinNavItem { text: @tr("Proxy"); icon: "globe"; selected: root.section == "proxy"; clicked => { root.select-proxy(); } }
                        WinNavItem { text: @tr("Logging"); icon: "file"; selected: root.section == "logging"; clicked => { root.select-logging(); } }
                        WinNavItem { text: @tr("Advanced"); icon: "code"; selected: root.section == "advanced"; clicked => { root.select-advanced(); } }
                        WinNavItem { text: @tr("Appearance"); icon: "eye"; selected: root.section == "appearance"; clicked => { root.select-appearance(); } }
                    }
                }

                // 表单卡片
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.card-fill;
                    border-radius: Theme.radius-panel;
                    border-width: 1px;
                    border-color: Theme.card-stroke;

                    VerticalLayout {
                        padding: Theme.spacing-16;
                        spacing: Theme.spacing-12;
                        alignment: start;

                        if root.section == "general" : VerticalLayout {
                            alignment: start;
                            spacing: Theme.spacing-12;

                            SectionTitle { heading: @tr("General"); }

                            FormRow {
                                label: @tr("Folder");

                                Text {
                                    text: root.folder-text;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    horizontal-stretch: 1;
                                    height: Theme.control-height;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.spacing-8;

                                WinButton { text: @tr("Folder Prev"); clicked => { root.select-folder-prev(); } }
                                WinButton { text: @tr("Folder Next"); clicked => { root.select-folder-next(); } }
                            }

                            FormRow {
                                label: @tr("New folder");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.new-folder-name;
                                    placeholder-text: @tr("New folder name");
                                    edited => { root.update-new-folder-name(self.text); }
                                }

                                WinButton { text: @tr("New Folder"); icon: "plus"; clicked => { root.create-folder(); } }
                            }

                            FormRow {
                                label: @tr("Session name");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.name-text;
                                    placeholder-text: @tr("Session name");
                                    edited => { root.update-name(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Host");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.host-text;
                                    placeholder-text: @tr("Host");
                                    edited => { root.update-host(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Port");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.port-text;
                                    placeholder-text: "22";
                                    edited => { root.update-port(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Username");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.username-text;
                                    placeholder-text: @tr("Username");
                                    edited => { root.update-username(self.text); }
                                }
                            }
                        }
                        if root.section == "authentication" : VerticalLayout {
                            alignment: start;
                            spacing: Theme.spacing-12;

                            SectionTitle { heading: @tr("Authentication"); }

                            FormRow {
                                label: @tr("Method");

                                WinButton { text: @tr("Agent"); icon: root.auth-method-text == "agent" ? "check" : ""; clicked => { root.set-auth-method-agent(); } }
                                WinButton { text: @tr("Password"); icon: root.auth-method-text == "password" ? "check" : ""; clicked => { root.set-auth-method-password(); } }
                                WinButton { text: @tr("KbdInt"); icon: root.auth-method-text == "keyboard_interactive" ? "check" : ""; clicked => { root.set-auth-method-keyboard-interactive(); } }
                                WinButton { text: @tr("Key"); icon: root.auth-method-text == "private_key" ? "check" : ""; clicked => { root.set-auth-method-private-key(); } }
                            }

                            HintText { hint: @tr("Method: {0}", root.auth-method-text); }

                            FormRow {
                                label: @tr("Host key");

                                WinButton { text: @tr("Strict"); icon: root.host-key-policy-text == "strict" ? "check" : ""; clicked => { root.set-host-key-policy-strict(); } }
                                WinButton { text: @tr("TOFU"); icon: root.host-key-policy-text == "trust-on-first-use" ? "check" : ""; clicked => { root.set-host-key-policy-trust-on-first-use(); } }
                                WinButton { text: @tr("Accept Any"); icon: root.host-key-policy-text == "accept-any-for-testing" ? "check" : ""; clicked => { root.set-host-key-policy-accept-any-for-testing(); } }
                            }

                            HintText { hint: @tr("Host Key: {0}", root.host-key-policy-text); }

                            FormRow {
                                label: @tr("Password");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.password-text;
                                    placeholder-text: @tr("Password / keyboard-interactive secret");
                                    edited => { root.update-password(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Private key");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.key-path-text;
                                    placeholder-text: @tr("Private key path");
                                    edited => { root.update-key-path(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Passphrase");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.passphrase-text;
                                    placeholder-text: @tr("Private key passphrase");
                                    edited => { root.update-passphrase(self.text); }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.spacing-8;

                                WinButton { text: @tr("Test Connection"); icon: "refresh"; clicked => { root.test-auth(); } }
                            }

                            HintText { hint: root.auth-test-status-text; }
                        }
                        if root.section == "proxy" : VerticalLayout {
                            alignment: start;
                            spacing: Theme.spacing-12;

                            SectionTitle { heading: @tr("Proxy"); }

                            FormRow {
                                label: @tr("Mode");

                                WinButton { text: @tr("No Proxy"); icon: root.proxy-mode-text == "none" ? "check" : ""; clicked => { root.set-proxy-mode-none(); } }
                                WinButton { text: @tr("Custom"); icon: root.proxy-mode-text == "custom" ? "check" : ""; clicked => { root.set-proxy-mode-custom(); } }
                            }

                            HintText { hint: @tr("Mode: {0}", root.proxy-mode-text); }

                            FormRow {
                                label: @tr("Protocol");

                                WinButton { text: @tr("SOCKS4"); icon: root.proxy-protocol-text == "socks4" ? "check" : ""; clicked => { root.set-proxy-protocol-socks4(); } }
                                WinButton { text: @tr("SOCKS4a"); icon: root.proxy-protocol-text == "socks4a" ? "check" : ""; clicked => { root.set-proxy-protocol-socks4a(); } }
                                WinButton { text: @tr("SOCKS5"); icon: root.proxy-protocol-text == "socks5" ? "check" : ""; clicked => { root.set-proxy-protocol-socks5(); } }
                                WinButton { text: @tr("HTTP"); icon: root.proxy-protocol-text == "http-connect" ? "check" : ""; clicked => { root.set-proxy-protocol-http-connect(); } }
                            }

                            HintText { hint: @tr("Protocol: {0}", root.proxy-protocol-text); }

                            FormRow {
                                label: @tr("Proxy host");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.proxy-host-text;
                                    placeholder-text: @tr("Proxy host");
                                    edited => { root.update-proxy-host(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Proxy port");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.proxy-port-text;
                                    placeholder-text: @tr("Proxy port");
                                    edited => { root.update-proxy-port(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Username");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.proxy-username-text;
                                    placeholder-text: @tr("Proxy username");
                                    edited => { root.update-proxy-username(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Password");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.proxy-password-text;
                                    placeholder-text: @tr("Proxy password");
                                    edited => { root.update-proxy-password(self.text); }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.spacing-8;

                                WinButton {
                                    text: root.proxy-dns-by-proxy ? @tr("DNS via Proxy: On") : @tr("DNS via Proxy: Off");
                                    icon: root.proxy-dns-by-proxy ? "check" : "";
                                    clicked => { root.toggle-proxy-dns-by-proxy(); }
                                }
                            }

                            HintText { hint: root.proxy-summary-text; }
                        }
                        if root.section == "tunnels" : VerticalLayout {
                            alignment: start;
                            spacing: Theme.spacing-12;

                            SectionTitle { heading: @tr("Tunnels"); }

                            FormRow {
                                label: @tr("Kind");

                                WinButton { text: @tr("Local"); icon: root.tunnel-kind-text == "local" ? "check" : ""; clicked => { root.set-tunnel-kind-local(); } }
                                WinButton { text: @tr("Remote"); icon: root.tunnel-kind-text == "remote" ? "check" : ""; clicked => { root.set-tunnel-kind-remote(); } }
                                WinButton { text: @tr("Dynamic"); icon: root.tunnel-kind-text == "dynamic" ? "check" : ""; clicked => { root.set-tunnel-kind-dynamic(); } }
                            }

                            HintText { hint: @tr("Draft Kind: {0}", root.tunnel-kind-text); }

                            FormRow {
                                label: @tr("Listen host");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.tunnel-bind-host-text;
                                    placeholder-text: "127.0.0.1";
                                    edited => { root.update-tunnel-bind-host(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Listen port");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.tunnel-bind-port-text;
                                    placeholder-text: @tr("Listen port");
                                    edited => { root.update-tunnel-bind-port(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Target host");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.tunnel-target-host-text;
                                    placeholder-text: @tr("Target host");
                                    edited => { root.update-tunnel-target-host(self.text); }
                                }
                            }

                            FormRow {
                                label: @tr("Target port");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.tunnel-target-port-text;
                                    placeholder-text: @tr("Target port");
                                    edited => { root.update-tunnel-target-port(self.text); }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.spacing-8;

                                WinButton { text: @tr("Add Tunnel"); icon: "plus"; clicked => { root.add-tunnel(); } }
                                WinButton { text: @tr("Clear Tunnels"); icon: "trash"; subtle: true; clicked => { root.clear-tunnels(); } }
                            }

                            HintText { hint: root.tunnel-summary-text; }
                        }
                        if root.section == "logging" : VerticalLayout {
                            alignment: start;
                            spacing: Theme.spacing-12;

                            SectionTitle { heading: @tr("Logging"); }

                            GroupTitle { heading: @tr("Global Logging Policy"); }

                            HintText { hint: root.logging-summary-text; }

                            FormRow {
                                label: @tr("Toggle");

                                WinButton {
                                    text: root.logging-enabled-text == "enabled" ? @tr("Disable Logging") : @tr("Enable Logging");
                                    icon: root.logging-enabled-text == "enabled" ? "pause" : "play";
                                    clicked => { root.toggle-logging-enabled(); }
                                }
                                WinButton { text: @tr("Raw"); icon: root.logging-format-text == "raw" ? "check" : ""; clicked => { root.set-logging-format-raw(); } }
                                WinButton { text: @tr("Sanitized"); icon: root.logging-format-text == "sanitized" ? "check" : ""; clicked => { root.set-logging-format-sanitized(); } }
                            }

                            HintText { hint: @tr("Format: {0}", root.logging-format-text); }

                            FormRow {
                                label: @tr("Directory");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.logging-directory-text;
                                    placeholder-text: "logs";
                                    edited => { root.update-logging-directory(self.text); }
                                }

                                WinButton { text: @tr("Save Logging"); icon: "check"; clicked => { root.save-logging-settings(); } }
                            }

                            Rectangle { height: 1px; background: Theme.layer-stroke; }

                            GroupTitle { heading: @tr("Secret Store"); }

                            HintText { hint: root.secret-store-status-text; }

                            // 危险操作提示
                            Text {
                                text: @tr("Destructive: resetting the secret store permanently deletes the saved passwords and passphrases.");
                                color: Theme.critical;
                                font-size: Theme.font-caption;
                                wrap: word-wrap;
                            }

                            FormRow {
                                label: @tr("Confirmation");

                                WinTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.secret-reset-confirmation-text;
                                    placeholder-text: @tr("Type RESET SECRETS");
                                    edited => { root.update-secret-reset-confirmation(self.text); }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                spacing: Theme.spacing-8;

                                WinButton { text: @tr("Reset Secrets"); icon: "warning"; clicked => { root.reset-secrets(); } }
                            }

                            HintText { hint: @tr("Config Dir: {0}", root.config-dir-text); }
                        }
                        if root.section == "terminal" || root.section == "sftp" || root.section == "advanced" || root.section == "appearance" : VerticalLayout {
                            alignment: start;
                            spacing: Theme.spacing-12;

                            SectionTitle {
                                heading: root.section == "terminal" ? @tr("Terminal") : root.section == "sftp" ? @tr("SFTP") : root.section == "advanced" ? @tr("Advanced") : @tr("Appearance");
                            }

                            Text {
                                text: @tr("This modal section shell is now present, but its richer field model is still tracked by later Session Editor items in the progress document.");
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.layer-stroke; }

            // --- 底部操作区（右对齐，主操作在最右） -------------------------
            HorizontalLayout {
                alignment: end;
                spacing: Theme.spacing-8;

                WinButton { text: @tr("Cancel"); subtle: true; clicked => { root.close(); } }
                WinButton { text: @tr("Save"); clicked => { root.save(); } }
                WinButton { text: @tr("Save and Connect"); icon: "connect"; accent: true; clicked => { root.save-connect(); } }
            }
        }
    }
}
