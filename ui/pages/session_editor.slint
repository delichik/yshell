import { Theme } from "../theme.slint";
import { WinButton, WinNavItem, WinScrollIndicator } from "../components/basic/controls.slint";
import { Icon } from "../components/basic/icons.slint";
import { WinTextInput } from "../components/basic/text_input.slint";
import { TerminalPreview } from "../components/terminal_preview.slint";
import { AuthKeyOption } from "../components/auth_prompt_dialog.slint";
import { ProxyProfileOption } from "proxies.slint";
import { TriStateField, TriStateFieldSection } from "./folder_editor.slint";
import { ManagerDialogShell } from "../components/manager_dialog_shell.slint";

// 表单行：左侧固定宽度标签 + 右侧控件（可长高，避免 Method 等挤进 32px）。
component FormRow inherits Rectangle {
    in property <string> label: "";
    // 与 Theme.form-label-width 同源（禁止在别处再写一份字面量）
    in property <length> label-width: Theme.form-label-width;

    height: max(Theme.control-height, body.preferred-height);
    background: transparent;

    body := HorizontalLayout {
        spacing: Theme.spacing-12;
        cross-axis-alignment: center;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-body;
            width: root.label-width;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.spacing-8;
            cross-axis-alignment: center;
            @children
        }
    }
}

// 小节标题
component SectionTitle inherits Text {
    in property <string> heading: "";
    text: root.heading;
    color: Theme.text-primary;
    font-size: Theme.font-body-large;
    font-weight: Theme.weight-semibold;
}

// 字段说明 / 路径 / 状态：低对比小字
component HintText inherits Text {
    in property <string> hint: "";
    text: root.hint;
    color: Theme.text-tertiary;
    font-size: Theme.font-caption;
    wrap: word-wrap;
}

// 分区导航项：WinNavItem + 可选的禁用说明 tooltip。
component EditorNavItem inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "settings";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    /// 非空且禁用时，hover 显示"本版本未提供"一类说明（契约 §18：disabled 必须有 tooltip）
    in property <string> hint: "";
    callback clicked();

    height: Theme.row-height-nav;
    background: transparent;

    WinNavItem {
        width: parent.width;
        height: parent.height;
        text: root.text;
        icon: root.icon;
        selected: root.selected;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if !root.enabled && root.hint != "" : Tooltip {
        text: @markdown("\{root.hint}");
    }
}

// SSH-1：托管私钥下拉。选 Key 认证后只允许从密钥管理器条目里选择；不再提供
// 手输路径/口令。展开行显示 label + 算法/指纹（与认证弹窗同一 `AuthKeyOption`）。
component ManagedKeyPicker inherits Rectangle {
    in property <[AuthKeyOption]> options: [];
    in-out property <int> selected-index: -1;
    in property <string> placeholder-text: "";
    callback selected(int);

    private property <bool> has-selection:
        root.selected-index >= 0 && root.selected-index < root.options.length;
    private property <string> selected-label:
        root.has-selection ? root.options[root.selected-index].label : "";

    height: Theme.control-height;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: (picker_focus.has-focus || picker_touch.has-hover) ? Theme.accent : Theme.control-stroke;
    background: picker_touch.pressed ? Theme.control-fill-pressed
        : picker_touch.has-hover ? Theme.control-fill-hover
        : Theme.control-fill;
    animate background { duration: Theme.duration-faster; easing: ease-out; }
    animate border-color { duration: Theme.duration-faster; easing: ease-out; }

    accessible-role: combobox;
    accessible-label: root.has-selection ? root.selected-label : root.placeholder-text;

    HorizontalLayout {
        padding-left: Theme.spacing-12;
        padding-right: Theme.spacing-8;
        spacing: Theme.spacing-8;

        Text {
            text: root.has-selection ? root.selected-label : root.placeholder-text;
            color: root.has-selection ? Theme.text-primary : Theme.text-tertiary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: no-wrap;
            overflow: elide;
        }

        Rectangle {
            width: Theme.icon-size-small;
            vertical-stretch: 1;
            background: transparent;

            Icon {
                name: "chevron-down";
                icon-color: Theme.text-secondary;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    picker_focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                picker.show();
                return accept;
            }
            return reject;
        }
    }

    picker_touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                picker_focus.focus();
            }
        }
        clicked => { picker.show(); }
    }

    // close-on-click-outside：点选项本身由选项回调关闭（与 WinComboBox 一致）。
    picker := PopupWindow {
        width: max(root.width, 280px);
        y: root.height + 2px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.flyout-background;
            border-width: 1px;
            border-color: Theme.layer-stroke;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-color: Theme.shadow-color;
            drop-shadow-offset-y: Theme.shadow-offset-y;
            height: min(options_layout.preferred-height + 8px, 224px);

            Flickable {
                width: parent.width;
                height: parent.height;
                interactive: self.content-height > self.height;
                content-width: self.width;
                content-height: options_layout.preferred-height;

                options_layout := VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for option[index] in root.options : Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-control;
                        background: option_touch.pressed ? Theme.subtle-pressed
                            : option_touch.has-hover ? Theme.subtle-hover
                            : index == root.selected-index ? Theme.subtle-selected
                            : transparent;

                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 1px;

                            Text {
                                text: option.label;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                font-weight: index == root.selected-index ? Theme.weight-semibold : 400;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: option.detail;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-caption;
                                font-family: Theme.font-mono;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }

                        option_touch := TouchArea {
                            clicked => {
                                root.selected-index = index;
                                root.selected(index);
                                picker.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// NET-1：托管代理下拉。列表项显示名称 + 协议/地址/口令状态；会话只保存
// profile id，编辑管理器条目会影响所有引用会话。
component ProxyPicker inherits Rectangle {
    in property <[ProxyProfileOption]> options: [];
    in-out property <int> selected-index: -1;
    in property <string> placeholder-text: "";
    callback selected(int);

    private property <bool> has-selection:
        root.selected-index >= 0 && root.selected-index < root.options.length;
    private property <string> selected-label:
        root.has-selection ? root.options[root.selected-index].label : "";

    height: Theme.control-height;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: (picker_focus.has-focus || picker_touch.has-hover) ? Theme.accent : Theme.control-stroke;
    background: picker_touch.pressed ? Theme.control-fill-pressed
        : picker_touch.has-hover ? Theme.control-fill-hover
        : Theme.control-fill;
    animate background { duration: Theme.duration-faster; easing: ease-out; }
    animate border-color { duration: Theme.duration-faster; easing: ease-out; }

    accessible-role: combobox;
    accessible-label: root.has-selection ? root.selected-label : root.placeholder-text;

    HorizontalLayout {
        padding-left: Theme.spacing-12;
        padding-right: Theme.spacing-8;
        spacing: Theme.spacing-8;

        Text {
            text: root.has-selection ? root.selected-label : root.placeholder-text;
            color: root.has-selection ? Theme.text-primary : Theme.text-tertiary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: no-wrap;
            overflow: elide;
        }

        Rectangle {
            width: Theme.icon-size-small;
            vertical-stretch: 1;
            background: transparent;

            Icon {
                name: "chevron-down";
                icon-color: Theme.text-secondary;
                icon-size: Theme.icon-size-small;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    picker_focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                picker.show();
                return accept;
            }
            return reject;
        }
    }

    picker_touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                picker_focus.focus();
            }
        }
        clicked => { picker.show(); }
    }

    picker := PopupWindow {
        width: max(root.width, 280px);
        y: root.height + 2px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.flyout-background;
            border-width: 1px;
            border-color: Theme.layer-stroke;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: Theme.shadow-blur;
            drop-shadow-color: Theme.shadow-color;
            drop-shadow-offset-y: Theme.shadow-offset-y;
            height: min(options_layout.preferred-height + 8px, 224px);

            Flickable {
                width: parent.width;
                height: parent.height;
                interactive: self.content-height > self.height;
                content-width: self.width;
                content-height: options_layout.preferred-height;

                options_layout := VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for option[index] in root.options : Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-control;
                        background: option_touch.pressed ? Theme.subtle-pressed
                            : option_touch.has-hover ? Theme.subtle-hover
                            : index == root.selected-index ? Theme.subtle-selected
                            : transparent;

                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 1px;

                            Text {
                                text: option.label;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                font-weight: index == root.selected-index ? Theme.weight-semibold : 400;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: option.detail;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-caption;
                                font-family: Theme.font-mono;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }

                        option_touch := TouchArea {
                            clicked => {
                                root.selected-index = index;
                                root.selected(index);
                                picker.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SessionEditor inherits Rectangle {
    in property <bool> open: false;
    in property <string> section: "general";
    in property <string> target-text: "";
    in property <string> folder-text: "";
    in-out property <string> name-text: "";
    in-out property <string> host-text: "";
    in-out property <string> port-text: "22";
    in-out property <string> username-text: "";
    in property <string> auth-method-text: "agent";
    in-out property <string> password-text: "";
    // SSH-1：Key 认证的托管密钥选择（`AuthKeyOption`: id/label/detail）。
    in property <[AuthKeyOption]> key-options: [];
    in-out property <int> selected-key-index: -1;
    in property <bool> selected-key-missing: false;
    // 旧 path-only 私钥：只读展示并标记 legacy；选中托管密钥后迁移。
    in property <string> legacy-key-path-text: "";
    in property <bool> legacy-key-has-passphrase: false;
    in property <bool> has-stored-password: false;
    in property <string> auth-test-status-text: "";
    in property <string> proxy-mode-text: "none";
    // NET-1：托管代理下拉 + legacy 只读摘要；不再有 per-session 自定义字段。
    in property <[ProxyProfileOption]> proxy-options: [];
    in-out property <int> selected-proxy-index: -1;
    in property <string> proxy-selected-detail-text: "";
    in property <string> proxy-legacy-text: "";
    in property <bool> proxy-selected-missing: false;
    in property <string> tunnel-kind-text: "local";
    in-out property <string> tunnel-bind-host-text: "127.0.0.1";
    in-out property <string> tunnel-bind-port-text: "";
    in-out property <string> tunnel-target-host-text: "";
    in-out property <string> tunnel-target-port-text: "";
    in property <string> tunnel-summary-text: "";
    // N5：Appearance 三态覆盖字段（Rust 组装 TriStateField 模型）。
    // 字体 / 配色必须是 choice，禁止自由文本输入。
    in property <[TriStateField]> editor-appearance-fields: [];
    // TERM-4：外观分区的 live preview 位图（Rust 按窗口 DPR 渲染；仅在编辑器
    // 打开且停在外观分区时非空）。尺寸与 Rust 侧
    // `SESSION_EDITOR_PREVIEW_AREA_PX` 对应，1:1 物理像素显示、不拉伸。
    in property <image> preview-frame;
    /// 预览表面底色（跟随预览配色；见 `terminal_preview.slint`）。
    in property <color> preview-background: Theme.terminal-surface;

    callback close();
    callback select-general();
    callback select-authentication();
    callback select-tunnels();
    callback select-proxy();
    callback select-appearance();
    callback update-name(string);
    callback update-host(string);
    callback update-port(string);
    callback update-username(string);
    callback set-auth-method-agent();
    callback set-auth-method-password();
    callback set-auth-method-keyboard-interactive();
    callback set-auth-method-private-key();
    callback update-password(string);
    callback select-key(int);
    callback manage-keys();
    callback test-auth();
    callback set-proxy-mode-none();
    callback select-proxy-profile(int);
    callback manage-proxies();
    callback set-tunnel-kind-local();
    callback set-tunnel-kind-remote();
    callback set-tunnel-kind-dynamic();
    callback update-tunnel-bind-host(string);
    callback update-tunnel-bind-port(string);
    callback update-tunnel-target-host(string);
    callback update-tunnel-target-port(string);
    callback add-tunnel();
    callback clear-tunnels();
    callback save();
    callback save-connect();
    // N5：Appearance 三态字段动作。
    callback editor-theme-field-action(string, string);
    callback update-editor-theme-field(string, string);
    callback editor-select-scheme(int);
    callback editor-select-font(int);
    callback reset-all-editor-theme();

    private property <bool> show-password-auth:
        root.auth-method-text == "password" || root.auth-method-text == "keyboard_interactive";
    private property <bool> show-key-auth: root.auth-method-text == "private_key";
    private property <bool> show-tunnel-target: root.tunnel-kind-text != "dynamic";
    // SSH-1：Key 认证要么选中托管密钥，要么保留旧 path-only 会话（legacy）。
    private property <bool> has-selected-key:
        root.selected-key-index >= 0 && root.selected-key-index < root.key-options.length;
    private property <string> selected-key-detail:
        root.has-selected-key ? root.key-options[root.selected-key-index].detail : "";
    private property <bool> key-selection-valid:
        !root.show-key-auth || root.has-selected-key || root.legacy-key-path-text != "";

    // 保存校验（B 轮3 #16）：运行时要求会话名与主机非空；这里同步禁用并用就地提示替代
    // 只写在状态栏的英文错误（状态栏文案的本地化由 WS-D 处理）。
    // SSH-1：Key 认证还要求选中托管密钥（或保留旧 path-only legacy 会话）。
    private property <bool> save-blocked:
        root.name-text == "" || root.host-text == "" || !root.key-selection-valid;

    visible: root.open;
    background: transparent;

    shell := ManagerDialogShell {
        width: root.width;
        height: root.height;
        open: root.open;
        close => { root.close(); }

        // --- 主体：左侧分区导航 + 右侧表单 -----------------------------
        HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Theme.spacing-12;

                    // 分区导航（与 Settings 同用 Theme.nav-width）
                    Rectangle {
                        width: Theme.nav-width;
                        vertical-stretch: 1;
                        background: Theme.layer-fill;
                        border-radius: Theme.radius-panel;
                        border-width: 1px;
                        border-color: Theme.layer-stroke;

                        VerticalLayout {
                            padding: Theme.spacing-8;
                            spacing: 2px;
                            alignment: start;

                            EditorNavItem { text: @tr("General"); icon: "settings"; selected: root.section == "general"; clicked => { root.select-general(); } }
                            EditorNavItem { text: @tr("Authentication"); icon: "shield"; selected: root.section == "authentication"; clicked => { root.select-authentication(); } }
                            // SFTP / 高级本版本无字段；Terminal scrollback 归全局 Settings；Logging 走会话树/终端右键。
                            EditorNavItem { text: @tr("SFTP"); icon: "folder"; enabled: false; hint: @tr("Not available in this version."); }
                            EditorNavItem { text: @tr("Tunnels"); icon: "connect"; selected: root.section == "tunnels"; clicked => { root.select-tunnels(); } }
                            EditorNavItem { text: @tr("Proxy"); icon: "globe"; selected: root.section == "proxy"; clicked => { root.select-proxy(); } }
                            EditorNavItem { text: @tr("Advanced"); icon: "code"; enabled: false; hint: @tr("Not available in this version."); }
                            EditorNavItem { text: @tr("Appearance"); icon: "eye"; selected: root.section == "appearance"; clicked => { root.select-appearance(); } }
                        }
                    }

                    // 表单卡片
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.card-fill;
                        border-radius: Theme.radius-panel;
                        border-width: 1px;
                        border-color: Theme.card-stroke;

                        VerticalLayout {
                            padding: Theme.spacing-16;
                            spacing: Theme.spacing-12;

                            // TERM-4：外观分区的 live preview 固定在表单滚动区上方，
                            // 这样滚动到下方字段改配色/字体时预览仍可见（选择即预览）。
                            // 只在编辑器打开且当前分区是 Appearance 时由 Rust 投影位图；
                            // 其它分区不渲染、不占高度。
                            if root.section == "appearance" : VerticalLayout {
                                // 固定高度：不参与外层 VerticalLayout 的剩余空间分配，
                                // 剩余高度全部留给下方可滚动的字段区。
                                vertical-stretch: 0;
                                spacing: Theme.spacing-4;
                                alignment: start;

                                Text {
                                    text: @tr("Live preview");
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-semibold;
                                }

                                // 尺寸契约：卡内容宽 494px − 2px 边框 − 2×6px 终端
                                // 内边距 = 480px；高 100px − 2px 边框 = 98px，对应
                                // Rust 侧 `SESSION_EDITOR_PREVIEW_AREA_PX`。
                                TerminalPreview {
                                    frame: root.preview-frame;
                                    surface-background: root.preview-background;
                                    surface-height: 100px;
                                }
                            }

                            // 表单区：内容高于面板时在卡片内滚动（左侧导航与底部操作区固定不动）
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                background: transparent;

                                form-scroll := Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    interactive: true;
                                    content-width: self.width;
                                    content-height: form-content.preferred-height;

                                    form-content := VerticalLayout {
                                        alignment: start;
                                        spacing: Theme.spacing-12;

                                        if root.section == "general" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            SectionTitle { heading: @tr("General"); }

                                            // 文件夹只读：归属由会话树「New Session Here」决定；
                                            // 新建/改名文件夹走树右键，不在此对话框里选或建。
                                            if root.folder-text != "" : FormRow {
                                                label: @tr("Folder");

                                                Text {
                                                    text: root.folder-text;
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-body;
                                                    horizontal-stretch: 1;
                                                    height: Theme.control-height;
                                                    vertical-alignment: center;
                                                    wrap: no-wrap;
                                                    overflow: elide;
                                                }
                                            }

                                            FormRow {
                                                label: @tr("Session name");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.name-text;
                                                    placeholder-text: @tr("Session name");
                                                    edited => { root.update-name(self.text); }
                                                }
                                            }

                                            // Host + Port 同一行（与 Proxies 一致；Port 带标签）。
                                            FormRow {
                                                label: @tr("Host");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.host-text;
                                                    placeholder-text: @tr("Host");
                                                    edited => { root.update-host(self.text); }
                                                }

                                                Text {
                                                    text: @tr("Port");
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-caption;
                                                    vertical-alignment: center;
                                                    wrap: no-wrap;
                                                }

                                                WinTextInput {
                                                    width: Theme.form-port-width;
                                                    text <=> root.port-text;
                                                    placeholder-text: "22";
                                                    edited => { root.update-port(self.text); }
                                                }
                                            }

                                            FormRow {
                                                label: @tr("Username");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.username-text;
                                                    placeholder-text: @tr("Username");
                                                    edited => { root.update-username(self.text); }
                                                }
                                            }

                                            // B 轮3 #16：保存前就地校验（运行时仍会兜底校验；
                                            // 状态栏错误文案的本地化归 WS-D）。
                                            if root.save-blocked : Text {
                                                text: @tr("A session name and a host are required before saving.");
                                                color: Theme.critical;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }
                                        }
                                        if root.section == "authentication" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            SectionTitle { heading: @tr("Authentication"); }

                                            // Method：可长高 FormRow 内两行按钮，不再用空 label 续行。
                                            FormRow {
                                                label: @tr("Method");

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: Theme.spacing-8;

                                                    HorizontalLayout {
                                                        spacing: Theme.spacing-8;
                                                        WinButton { text: @tr("Agent"); accent: root.auth-method-text == "agent"; clicked => { root.set-auth-method-agent(); } }
                                                        WinButton { text: @tr("Password"); accent: root.auth-method-text == "password"; clicked => { root.set-auth-method-password(); } }
                                                    }

                                                    HorizontalLayout {
                                                        spacing: Theme.spacing-8;
                                                        WinButton { text: @tr("Keyboard Interactive"); accent: root.auth-method-text == "keyboard_interactive"; clicked => { root.set-auth-method-keyboard-interactive(); } }
                                                        WinButton { text: @tr("Key"); accent: root.auth-method-text == "private_key"; clicked => { root.set-auth-method-private-key(); } }
                                                    }
                                                }
                                            }

                                            // 主机密钥策略不在会话编辑器中暴露：所有会话默认走严格
                                            // known_hosts 校验；首次/变更密钥由主机密钥确认对话框询问。
                                            if root.show-password-auth : FormRow {
                                                label: @tr("Password");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.password-text;
                                                    input-type: password;
                                                    placeholder-text: root.has-stored-password
                                                        ? @tr("Leave blank to keep saved password")
                                                        : @tr("Password / keyboard-interactive secret");
                                                    edited => { root.update-password(self.text); }
                                                }
                                            }

                                            // SSH-1：Key 认证只从密钥管理器选择，不再手输路径/口令；
                                            // 空清单显示“去导入”引导，不渲染空下拉。
                                            if root.show-key-auth && root.key-options.length > 0 : FormRow {
                                                label: @tr("Private key");

                                                ManagedKeyPicker {
                                                    horizontal-stretch: 1;
                                                    options: root.key-options;
                                                    selected-index <=> root.selected-key-index;
                                                    placeholder-text: @tr("Choose a managed key");
                                                    selected(index) => { root.select-key(index); }
                                                }

                                                WinButton {
                                                    text: @tr("Manage keys…");
                                                    subtle: true;
                                                    clicked => { root.manage-keys(); }
                                                }
                                            }

                                            if root.show-key-auth && root.key-options.length == 0 : FormRow {
                                                label: @tr("Private key");

                                                Text {
                                                    text: @tr("No managed private keys yet.");
                                                    color: Theme.text-tertiary;
                                                    font-size: Theme.font-body;
                                                    horizontal-stretch: 1;
                                                    height: Theme.control-height;
                                                    vertical-alignment: center;
                                                    wrap: no-wrap;
                                                    overflow: elide;
                                                }

                                                WinButton {
                                                    text: @tr("Manage keys…");
                                                    subtle: true;
                                                    clicked => { root.manage-keys(); }
                                                }
                                            }

                                            if root.show-key-auth && root.key-options.length == 0 : HintText {
                                                hint: @tr("Import an OpenSSH private key in the Private Keys manager, then pick it here.");
                                            }

                                            if root.show-key-auth && root.has-selected-key : Text {
                                                text: root.selected-key-detail;
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                font-family: Theme.font-mono;
                                                wrap: no-wrap;
                                                overflow: elide;
                                            }

                                            if root.show-key-auth && root.selected-key-missing : Text {
                                                text: @tr("The selected managed key is no longer available. Choose another key or open Manage keys….");
                                                color: Theme.critical;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            // 旧 path-only 配置仍可连接：只读显示并标记 legacy；
                                            // 选中托管密钥后保存即迁移（草稿清空 path）。
                                            if root.show-key-auth && root.legacy-key-path-text != "" : FormRow {
                                                label: @tr("Legacy key");

                                                Text {
                                                    text: root.legacy-key-path-text;
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-body;
                                                    font-family: Theme.font-mono;
                                                    horizontal-stretch: 1;
                                                    height: Theme.control-height;
                                                    vertical-alignment: center;
                                                    wrap: no-wrap;
                                                    overflow: elide;
                                                }
                                            }

                                            if root.show-key-auth && root.legacy-key-path-text != "" : HintText {
                                                hint: root.legacy-key-has-passphrase
                                                    ? @tr("Legacy key path with a stored passphrase. Select a managed key to migrate this session.")
                                                    : @tr("Legacy key path. Select a managed key to migrate this session.");
                                            }

                                            if root.show-key-auth && !root.key-selection-valid : Text {
                                                text: @tr("Choose a managed private key before saving.");
                                                color: Theme.critical;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            FormRow {
                                                label: "";

                                                WinButton { text: @tr("Test Connection"); icon: "refresh"; clicked => { root.test-auth(); } }
                                            }

                                            HintText { hint: root.auth-test-status-text; }
                                        }
                                        if root.section == "proxy" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            SectionTitle { heading: @tr("Proxy"); }

                                            FormRow {
                                                label: @tr("Mode");

                                                WinButton {
                                                    text: @tr("No Proxy");
                                                    accent: root.proxy-mode-text == "none";
                                                    clicked => { root.set-proxy-mode-none(); }
                                                }

                                                WinButton {
                                                    text: @tr("Manage proxies…");
                                                    subtle: true;
                                                    clicked => { root.manage-proxies(); }
                                                }
                                            }

                                            if root.proxy-options.length > 0 : FormRow {
                                                label: @tr("Profile");

                                                ProxyPicker {
                                                    horizontal-stretch: 1;
                                                    options: root.proxy-options;
                                                    selected-index <=> root.selected-proxy-index;
                                                    placeholder-text: @tr("Choose a managed proxy");
                                                    selected(index) => { root.select-proxy-profile(index); }
                                                }
                                            }

                                            if root.proxy-options.length == 0 : FormRow {
                                                label: @tr("Profile");

                                                Text {
                                                    text: @tr("No managed proxies yet.");
                                                    color: Theme.text-tertiary;
                                                    font-size: Theme.font-body;
                                                    horizontal-stretch: 1;
                                                    height: Theme.control-height;
                                                    vertical-alignment: center;
                                                    wrap: no-wrap;
                                                    overflow: elide;
                                                }
                                            }

                                            // 选中托管代理：只读摘要（条目在管理器里编辑）。
                                            if root.proxy-mode-text == "managed" && root.proxy-selected-detail-text != "" : Text {
                                                text: root.proxy-selected-detail-text;
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-caption;
                                                font-family: Theme.font-mono;
                                                wrap: no-wrap;
                                                overflow: elide;
                                            }

                                            if root.proxy-selected-missing : Text {
                                                text: @tr("The selected managed proxy is no longer available. Choose another proxy or No Proxy.");
                                                color: Theme.critical;
                                                font-size: Theme.font-caption;
                                                wrap: word-wrap;
                                            }

                                            // 旧 per-session / 悬空引用：只读展示并标记 legacy，保持可连接。
                                            if root.proxy-mode-text == "legacy" && root.proxy-legacy-text != "" : FormRow {
                                                label: @tr("Legacy proxy");

                                                Text {
                                                    text: root.proxy-legacy-text;
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.font-body;
                                                    font-family: Theme.font-mono;
                                                    horizontal-stretch: 1;
                                                    height: Theme.control-height;
                                                    vertical-alignment: center;
                                                    wrap: no-wrap;
                                                    overflow: elide;
                                                }
                                            }

                                            if root.proxy-mode-text == "legacy" : HintText {
                                                hint: @tr("Legacy per-session proxy. Select a managed proxy to migrate this session, or choose No Proxy.");
                                            }

                                            if root.proxy-mode-text == "managed" : HintText {
                                                hint: @tr("Uses a managed proxy profile. Edits in the Proxy Manager apply to every session that references it.");
                                            }

                                            if root.proxy-mode-text == "none" : HintText {
                                                hint: @tr("Proxy disabled for this editor session.");
                                            }
                                        }
                                        if root.section == "tunnels" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            SectionTitle { heading: @tr("Tunnels"); }

                                            FormRow {
                                                label: @tr("Kind");

                                                WinButton { text: @tr("Local"); accent: root.tunnel-kind-text == "local"; clicked => { root.set-tunnel-kind-local(); } }
                                                WinButton { text: @tr("Remote"); accent: root.tunnel-kind-text == "remote"; clicked => { root.set-tunnel-kind-remote(); } }
                                                WinButton { text: @tr("Dynamic"); accent: root.tunnel-kind-text == "dynamic"; clicked => { root.set-tunnel-kind-dynamic(); } }
                                            }

                                            FormRow {
                                                label: @tr("Listen host");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.tunnel-bind-host-text;
                                                    placeholder-text: "127.0.0.1";
                                                    edited => { root.update-tunnel-bind-host(self.text); }
                                                }
                                            }

                                            FormRow {
                                                label: @tr("Listen port");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.tunnel-bind-port-text;
                                                    placeholder-text: @tr("Listen port");
                                                    edited => { root.update-tunnel-bind-port(self.text); }
                                                }
                                            }

                                            if root.show-tunnel-target : FormRow {
                                                label: @tr("Target host");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.tunnel-target-host-text;
                                                    placeholder-text: @tr("Target host");
                                                    edited => { root.update-tunnel-target-host(self.text); }
                                                }
                                            }

                                            if root.show-tunnel-target : FormRow {
                                                label: @tr("Target port");

                                                WinTextInput {
                                                    horizontal-stretch: 1;
                                                    text <=> root.tunnel-target-port-text;
                                                    placeholder-text: @tr("Target port");
                                                    edited => { root.update-tunnel-target-port(self.text); }
                                                }
                                            }

                                            FormRow {
                                                label: "";

                                                WinButton { text: @tr("Add Tunnel"); icon: "plus"; clicked => { root.add-tunnel(); } }
                                                WinButton { text: @tr("Clear Tunnels"); icon: "trash"; subtle: true; clicked => { root.clear-tunnels(); } }
                                            }

                                            HintText { hint: root.tunnel-summary-text; }
                                        }
                                        if root.section == "appearance" : VerticalLayout {
                                            alignment: start;
                                            spacing: Theme.spacing-12;

                                            SectionTitle { heading: @tr("Appearance"); }

                                            HintText { hint: @tr("Per-field overrides for this session. Inherited rows show the resolved value and where it comes from."); }

                                            TriStateFieldSection {
                                                fields: root.editor-appearance-fields;
                                                // TERM-4：下拉框需要完整的值区宽度；标签列收到
                                                // 110px 后当前配色名不再被省略（最长标签约 86px）。
                                                label-width: Theme.form-label-width;
                                                field-set-inherit(key) => { root.editor-theme-field-action(key, "inherit"); }
                                                field-set-explicit(key) => { root.editor-theme-field-action(key, "explicit"); }
                                                field-reset(key) => { root.editor-theme-field-action(key, "reset"); }
                                                field-edited(key, value) => { root.update-editor-theme-field(key, value); }
                                                field-toggled(key) => { }
                                                field-selected(key, index) => {
                                                    if (key == "appearance.color_scheme") {
                                                        root.editor-select-scheme(index);
                                                    } else if (key == "appearance.font_family") {
                                                        root.editor-select-font(index);
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: end;
                                                WinButton {
                                                    text: @tr("Reset All");
                                                    clicked => { root.reset-all-editor-theme(); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // 滚动指示：E22 可复用组件（内部按 `-content-y` 计算进度）。
                                WinScrollIndicator {
                                    x: form-scroll.width - self.width - Theme.spacing-4;
                                    y: Theme.spacing-4;
                                    height: parent.height - 2 * Theme.spacing-4;
                                    viewport-position: form-scroll.content-y;
                                    content-extent: form-scroll.content-height;
                                    viewport-extent: form-scroll.height;
                                    thumb-min-length: 24px;
                                }
                            }
                        }
                    }
                }

        Rectangle { height: 1px; background: Theme.layer-stroke; }

        // --- 底部操作区（右对齐，主操作在最右） -------------------------
        HorizontalLayout {
            alignment: end;
            spacing: Theme.spacing-8;

            WinButton { text: @tr("Cancel"); subtle: true; clicked => { root.close(); } }
            // B 轮3 #16：运行时要求会话名与主机非空；这里同步门限，避免只留一条
            // 被模态遮住的状态栏英文错误。
            WinButton { text: @tr("Save"); enabled: !root.save-blocked; clicked => { root.save(); } }
            WinButton { text: @tr("Save and Connect"); icon: "connect"; accent: true; enabled: !root.save-blocked; clicked => { root.save-connect(); } }
        }
    }

    /// L2：宿主在关闭上层弹窗后把键盘焦点交还给本弹窗（嵌套场景）。
    public function focus-dialog() {
        shell.focus-dialog();
    }

    changed open => {
        if (root.open) {
            shell.focus-dialog();
        }
    }
}
